# syntax=docker/dockerfile:1
FROM golang:1.22 AS build
WORKDIR /src
COPY sidecars/news-sentiment-go/ .
RUN go build -trimpath -ldflags="-s -w" -o /out/news-sentiment-go .

FROM gcr.io/distroless/base-debian12 AS runtime
WORKDIR /app
COPY --from=build /out/news-sentiment-go /app/news-sentiment-go
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/app/news-sentiment-go"]
