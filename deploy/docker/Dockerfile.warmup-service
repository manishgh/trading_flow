# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/TradingFlow.WarmupService/TradingFlow.WarmupService.csproj -c Release -o /out/warmup

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /out/warmup .
EXPOSE 8080
ENTRYPOINT ["dotnet", "TradingFlow.WarmupService.dll"]
