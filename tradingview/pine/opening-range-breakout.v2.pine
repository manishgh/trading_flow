//@version=5
indicator("Opening Range Breakout v2 - TradingFlow", overlay=true, max_labels_count=500)

strategyId = "research.opening-range-breakout.v2"
strategyName = "Opening Range Breakout"
strategyVersion = 2
signalTimeframe = "5m"
executionTimeframe = "5m"

openingRangeMinutes = 15
atr = ta.atr(14)
rsi = ta.rsi(close, 14)
vwapValue = ta.vwap(hlc3)
ema20 = ta.ema(close, 20)
[macdLine, signalLine, macdHist] = ta.macd(close, 12, 26, 9)
relativeVolume = volume / math.max(ta.sma(volume, 20), 1)
vwapExtensionAtr = atr > 0 ? math.max(close - vwapValue, 0) / atr : na

newDay = ta.change(time("D")) != 0
openTime = timestamp("America/New_York", year, month, dayofmonth, 9, 30)
minutesFromOpen = (time - openTime) / 60000.0
inOpeningRange = minutesFromOpen >= 0 and minutesFromOpen < openingRangeMinutes
afterOpeningRange = minutesFromOpen >= openingRangeMinutes

var float openingHigh = na
if newDay
    openingHigh := na
if inOpeningRange
    openingHigh := na(openingHigh) ? high : math.max(openingHigh, high)

breakout = afterOpeningRange and not na(openingHigh) and close > openingHigh and close[1] <= openingHigh
macdNotBearish = macdLine >= signalLine
entrySignal = barstate.isconfirmed and breakout and relativeVolume >= 1.8 and rsi >= 50 and rsi <= 78 and close > vwapValue and close > ema20 and macdHist > 0 and macdNotBearish and vwapExtensionAtr <= 2.0

var bool inTrade = false
var float stopLoss = na
var float takeProfit = na
var int entryTime = na
maxHoldMs = 23400000

jsonPayload(string action, string reason, float px) =>
    "{" +
    "\"schema_version\":\"1.0\"," +
    "\"source\":\"tradingview\"," +
    "\"event_id\":\"" + strategyId + ":" + syminfo.ticker + ":" + str.tostring(time) + ":" + action + "\"," +
    "\"strategy_id\":\"" + strategyId + "\"," +
    "\"strategy_name\":\"" + strategyName + "\"," +
    "\"strategy_version\":" + str.tostring(strategyVersion) + "," +
    "\"ticker\":\"" + syminfo.ticker + "\"," +
    "\"action\":\"" + action + "\"," +
    "\"side\":\"long\"," +
    "\"signal_timeframe\":\"" + signalTimeframe + "\"," +
    "\"execution_timeframe\":\"" + executionTimeframe + "\"," +
    "\"bar_time_epoch_ms\":" + str.tostring(time) + "," +
    "\"price\":" + str.tostring(px, format.mintick) + "," +
    "\"stop_loss\":" + str.tostring(stopLoss, format.mintick) + "," +
    "\"take_profit\":" + str.tostring(takeProfit, format.mintick) + "," +
    "\"exit_reason\":\"" + reason + "\"," +
    "\"signal_values\":{\"atr\":" + str.tostring(atr, format.mintick) + ",\"rsi\":" + str.tostring(rsi, "#.##") + ",\"relative_volume\":" + str.tostring(relativeVolume, "#.####") + ",\"opening_high\":" + str.tostring(openingHigh, format.mintick) + ",\"vwap\":" + str.tostring(vwapValue, format.mintick) + ",\"macd_histogram\":" + str.tostring(macdHist, "#.####") + "}" +
    "}"

if entrySignal and not inTrade and atr > 0
    stopLoss := close - (1.5 * atr)
    takeProfit := close + ((close - stopLoss) * 2.2)
    entryTime := time
    inTrade := true
    alert(jsonPayload("entry", "", close), alert.freq_once_per_bar_close)

exitReason = ""
exitPrice = close
if inTrade and low <= stopLoss
    exitReason := "stop_loss"
    exitPrice := stopLoss
else if inTrade and high >= takeProfit
    exitReason := "take_profit"
    exitPrice := takeProfit
else if inTrade and time - entryTime >= maxHoldMs
    exitReason := "max_hold"
    exitPrice := close

if inTrade and exitReason != ""
    alert(jsonPayload("exit", exitReason, exitPrice), alert.freq_once_per_bar_close)
    inTrade := false

plot(openingHigh, "Opening Range High", color=color.fuchsia)
plot(vwapValue, "VWAP", color=color.orange)
plotshape(entrySignal and not inTrade[1], title="Entry", style=shape.triangleup, color=color.lime, location=location.belowbar, size=size.tiny)
