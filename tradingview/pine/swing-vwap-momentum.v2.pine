//@version=5
indicator("Swing VWAP Momentum v2 - TradingFlow", overlay=true, max_labels_count=500)

strategyId = "financial-data.swing-vwap-momentum.v2"
strategyName = "Swing VWAP Momentum"
strategyVersion = 2
signalTimeframe = "15"
confluenceTimeframe = "60"
executionTimeframe = "5m"

sigClose = request.security(syminfo.tickerid, signalTimeframe, close, lookahead=barmerge.lookahead_off)
sigVolume = request.security(syminfo.tickerid, signalTimeframe, volume, lookahead=barmerge.lookahead_off)
sigAtr = request.security(syminfo.tickerid, signalTimeframe, ta.atr(14), lookahead=barmerge.lookahead_off)
sigRsi = request.security(syminfo.tickerid, signalTimeframe, ta.rsi(close, 14), lookahead=barmerge.lookahead_off)
sigVwap = request.security(syminfo.tickerid, signalTimeframe, ta.vwap(hlc3), lookahead=barmerge.lookahead_off)
sigBbMiddle = request.security(syminfo.tickerid, signalTimeframe, ta.sma(close, 20), lookahead=barmerge.lookahead_off)
[sigMacdLine, sigMacdSignal, sigMacdHist] = request.security(syminfo.tickerid, signalTimeframe, ta.macd(close, 12, 26, 9), lookahead=barmerge.lookahead_off)
sigRelVol = request.security(syminfo.tickerid, signalTimeframe, volume / math.max(ta.sma(volume, 20), 1), lookahead=barmerge.lookahead_off)
confClose = request.security(syminfo.tickerid, confluenceTimeframe, close, lookahead=barmerge.lookahead_off)
confEma50 = request.security(syminfo.tickerid, confluenceTimeframe, ta.ema(close, 50), lookahead=barmerge.lookahead_off)
[confMacdLine, confMacdSignal, confMacdHist] = request.security(syminfo.tickerid, confluenceTimeframe, ta.macd(close, 12, 26, 9), lookahead=barmerge.lookahead_off)

newSignalBar = ta.change(time(signalTimeframe)) != 0
macdNotBearish = sigMacdLine >= sigMacdSignal
confluencePass = confClose > confEma50 and confMacdLine >= confMacdSignal
entrySignal = barstate.isconfirmed and newSignalBar and sigClose > sigVwap and sigClose > sigBbMiddle and sigRelVol >= 1.5 and sigRsi >= 45 and sigRsi <= 75 and sigMacdHist > 0 and macdNotBearish and confluencePass

var bool inTrade = false
var float entryPrice = na
var float stopLoss = na
var float takeProfit = na
var float highestSinceEntry = na
var int entryTime = na
maxHoldMs = 172800000

jsonPayload(string action, string reason, float px) =>
    "{" +
    "\"schema_version\":\"1.0\"," +
    "\"source\":\"tradingview\"," +
    "\"event_id\":\"" + strategyId + ":" + syminfo.ticker + ":" + str.tostring(time) + ":" + action + "\"," +
    "\"strategy_id\":\"" + strategyId + "\"," +
    "\"strategy_name\":\"" + strategyName + "\"," +
    "\"strategy_version\":" + str.tostring(strategyVersion) + "," +
    "\"ticker\":\"" + syminfo.ticker + "\"," +
    "\"action\":\"" + action + "\"," +
    "\"side\":\"long\"," +
    "\"signal_timeframe\":\"15m\"," +
    "\"execution_timeframe\":\"" + executionTimeframe + "\"," +
    "\"bar_time_epoch_ms\":" + str.tostring(time) + "," +
    "\"price\":" + str.tostring(px, format.mintick) + "," +
    "\"stop_loss\":" + str.tostring(stopLoss, format.mintick) + "," +
    "\"take_profit\":" + str.tostring(takeProfit, format.mintick) + "," +
    "\"exit_reason\":\"" + reason + "\"," +
    "\"signal_values\":{\"atr\":" + str.tostring(sigAtr, format.mintick) + ",\"rsi\":" + str.tostring(sigRsi, "#.##") + ",\"relative_volume\":" + str.tostring(sigRelVol, "#.####") + ",\"vwap\":" + str.tostring(sigVwap, format.mintick) + ",\"macd_histogram\":" + str.tostring(sigMacdHist, "#.####") + ",\"confluence_ema50\":" + str.tostring(confEma50, format.mintick) + "}" +
    "}"

if entrySignal and not inTrade and sigAtr > 0
    entryPrice := close
    stopLoss := close - (3.5 * sigAtr)
    takeProfit := close + ((close - stopLoss) * 3.5)
    highestSinceEntry := high
    entryTime := time
    inTrade := true
    alert(jsonPayload("entry", "", close), alert.freq_once_per_bar_close)

if inTrade
    highestSinceEntry := math.max(highestSinceEntry, high)
    riskPerShare = entryPrice - stopLoss
    if riskPerShare > 0 and highestSinceEntry - entryPrice >= riskPerShare
        stopLoss := math.max(stopLoss, highestSinceEntry - (2.0 * sigAtr))

exitReason = ""
exitPrice = close
if inTrade and low <= stopLoss
    exitReason := "stop_loss"
    exitPrice := stopLoss
else if inTrade and high >= takeProfit
    exitReason := "take_profit"
    exitPrice := takeProfit
else if inTrade and time - entryTime >= maxHoldMs
    exitReason := "max_hold"
    exitPrice := close

if inTrade and exitReason != ""
    alert(jsonPayload("exit", exitReason, exitPrice), alert.freq_once_per_bar_close)
    inTrade := false

plot(sigVwap, "15M VWAP", color=color.orange)
plot(sigBbMiddle, "15M BB Middle", color=color.gray)
plot(confEma50, "1H EMA 50", color=color.blue)
plotshape(entrySignal and not inTrade[1], title="Entry", style=shape.triangleup, color=color.lime, location=location.belowbar, size=size.tiny)
