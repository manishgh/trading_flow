<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Semantic colour tokens.
         Mirrors src/TradingFlow.Web/wwwroot/css/site.css so both surfaces share one
         vocabulary and one set of contrast-verified values.

         Every pair is Light/Dark. Consume them with AppThemeBinding, never as a bare
         StaticResource, or the value will not follow the device theme:

           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                       Dark={StaticResource TextSecondaryDark}}"

         Body text is >= 4.5:1 on its surface. Control borders are >= 3:1 (WCAG 1.4.11).
         Gain/loss additionally differ in lightness, and direction is always paired with
         a sign or glyph so colour is never the only signal. -->

    <!-- Surfaces -->
    <Color x:Key="PageBackgroundLight">#F4F6F8</Color>
    <Color x:Key="PageBackgroundDark">#0F172A</Color>
    <Color x:Key="SurfacePanelLight">#FFFFFF</Color>
    <Color x:Key="SurfacePanelDark">#1E293B</Color>
    <Color x:Key="SurfaceSubtleLight">#FBFCFD</Color>
    <Color x:Key="SurfaceSubtleDark">#243244</Color>
    <Color x:Key="SurfaceInsetLight">#E7EDF2</Color>
    <Color x:Key="SurfaceInsetDark">#2A3A4F</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryLight">#17202A</Color>
    <Color x:Key="TextPrimaryDark">#E6EDF3</Color>
    <Color x:Key="TextSecondaryLight">#5F6B7A</Color>
    <Color x:Key="TextSecondaryDark">#9AA7B4</Color>

    <!-- Lines. BorderControl identifies an interactive control and meets 3:1.
         BorderDivider is decorative only and is deliberately subtler. -->
    <Color x:Key="BorderControlLight">#818B98</Color>
    <Color x:Key="BorderControlDark">#748094</Color>
    <Color x:Key="BorderDividerLight">#E6EBEF</Color>
    <Color x:Key="BorderDividerDark">#2F3F54</Color>

    <!-- Accent -->
    <Color x:Key="AccentLight">#176B87</Color>
    <Color x:Key="AccentDark">#1F6FEB</Color>
    <Color x:Key="AccentStrongLight">#104E62</Color>
    <Color x:Key="AccentStrongDark">#388BFD</Color>
    <Color x:Key="AccentSurfaceLight">#EAF2F8</Color>
    <Color x:Key="AccentSurfaceDark">#16283F</Color>
    <Color x:Key="OnAccentLight">#FFFFFF</Color>
    <Color x:Key="OnAccentDark">#FFFFFF</Color>

    <!-- Market direction -->
    <Color x:Key="StatePositiveLight">#0F7B3D</Color>
    <Color x:Key="StatePositiveDark">#3FB950</Color>
    <Color x:Key="StateNegativeLight">#C02626</Color>
    <Color x:Key="StateNegativeDark">#FF7B72</Color>
    <Color x:Key="StateWarningLight">#8A5700</Color>
    <Color x:Key="StateWarningDark">#E3B341</Color>

    <!-- Environment identity. Amber, never red: red is committed to loss. -->
    <Color x:Key="EnvironmentLiveLight">#B45309</Color>
    <Color x:Key="EnvironmentLiveDark">#E3B341</Color>

    <Color x:Key="FocusRingLight">#2563EB</Color>
    <Color x:Key="FocusRingDark">#58A6FF</Color>

    <!-- Compatibility aliases for the MAUI template defaults. -->
    <Color x:Key="Primary">#176B87</Color>
    <Color x:Key="PrimaryDark">#74C4DC</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880E5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1F1F1F</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
