<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TradingFlow.Mobile.Pages.BacktestsPage"
             Title="Strategies">
    <RefreshView x:Name="RefreshRoot" Refreshing="OnRefresh">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Simulated trading" Style="{StaticResource QuietButton}" Clicked="OnOpenPaperClicked" />
                    <Button Grid.Column="1" Text="Strategy positions" Style="{StaticResource QuietButton}" Clicked="OnOpenPositionsClicked" />
                </Grid>
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label x:Name="StatusLabel" Text="Checking backend..." FontSize="13" VerticalTextAlignment="Center" />
                        <ActivityIndicator x:Name="BusyIndicator" Grid.Column="1" IsRunning="False" IsVisible="False" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Research plan" FontAttributes="Bold" FontSize="18" />
                        <Label Text="Compare strategies in a backtest. Saving a plan does not start trading." Style="{StaticResource SubHeadline}" />
                        <VerticalStackLayout x:Name="StrategyChoices" Spacing="8" />
                        <Label Text="Stock group" FontAttributes="Bold" FontSize="12" />
                        <Picker x:Name="StockSourcePicker" Title="Choose a saved stock group" SelectedIndexChanged="OnStockSourcePicked" />
                        <Label Text="Stocks per group" FontAttributes="Bold" FontSize="12" />
                        <Entry x:Name="GroupSizeEntry" Keyboard="Numeric" TextChanged="OnFormChanged" />
                        <Button x:Name="AdvancedToggle" Text="Plan settings +" Style="{StaticResource QuietButton}" Clicked="OnToggleAdvanced" />
                        <VerticalStackLayout x:Name="AdvancedPanel" Spacing="10" IsVisible="False">
                        <Label Text="Backtest profile" FontAttributes="Bold" FontSize="12" />
                        <Picker x:Name="ConfigPicker" Title="Backtest profile" SelectedIndexChanged="OnBacktestProfileChanged" />
                        <Label Text="Research execution assumptions" FontAttributes="Bold" FontSize="12" />
                        <Picker x:Name="ExecutionReplayPicker" Title="Selected strategy / profile" SelectedIndexChanged="OnFormChanged" />
                        <Label Text="The selected strategy supplies its horizon. Day and swing strategies use separate saved plans; preview freezes the execution assumptions." FontSize="12" />
                        <Label Text="Optional approved decision-context evidence" FontAttributes="Bold" FontSize="12" />
                        <Picker x:Name="EvidencePicker" Title="No evidence selected" SelectedIndexChanged="OnEvidenceChanged" />
                        <Label x:Name="EvidenceChoiceLabel" FontSize="12" LineBreakMode="CharacterWrap" />

                            <Label Text="Optional test window (UTC). Enter both dates, or leave both blank to use lookback days." FontSize="12" />
                            <Entry x:Name="TestStartEntry" Placeholder="From UTC: YYYY-MM-DDTHH:MMZ" TextChanged="OnFormChanged" />
                            <Entry x:Name="TestEndEntry" Placeholder="To UTC: YYYY-MM-DDTHH:MMZ" TextChanged="OnFormChanged" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Lookback days" FontAttributes="Bold" FontSize="12" />
                                    <Entry x:Name="LookbackEntry" Placeholder="Days" Keyboard="Numeric" TextChanged="OnFormChanged" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Starting capital" FontAttributes="Bold" FontSize="12" />
                                    <Entry x:Name="CapitalEntry" Placeholder="Capital" Keyboard="Numeric" TextChanged="OnFormChanged" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Account risk budget %" FontAttributes="Bold" FontSize="12" />
                                    <Entry x:Name="RiskEntry" Placeholder="Risk budget %" Keyboard="Numeric" TextChanged="OnFormChanged" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Max position notional %" FontAttributes="Bold" FontSize="12" />
                                    <Entry x:Name="MaxPositionEntry" Placeholder="Max notional %" Keyboard="Numeric" TextChanged="OnFormChanged" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Max open positions" FontAttributes="Bold" FontSize="12" />
                                    <Entry x:Name="MaxConcurrentEntry" Placeholder="Max positions" Keyboard="Numeric" TextChanged="OnFormChanged" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Market data cache" FontAttributes="Bold" FontSize="12" />
                                    <Picker x:Name="CachePolicyPicker" Title="Data cache" SelectedIndexChanged="OnFormChanged" />
                                </VerticalStackLayout>
                            </Grid>
                        <Label Text="Exclude stocks" FontAttributes="Bold" />
                        <Entry x:Name="ExcludedSymbolsEntry" Placeholder="Optional comma-separated stock symbols" TextChanged="OnFormChanged" />
                        <Label Text="Exclusions apply to this plan. The original wishlist or saved Finviz list stays unchanged." FontSize="12" />
                        <Label Text="Or enter your own groups: one line per group as name | starting capital | comma-separated stocks. Leave stocks per group blank for manual groups." FontSize="12" />
                        <Editor x:Name="ManualCohortsEditor" AutoSize="TextChanges" MinimumHeightRequest="70" TextChanged="OnFormChanged" />
                        </VerticalStackLayout>
                        <Button x:Name="RunButton" Text="Preview groups" Clicked="OnStartBacktest" />
                        <Button x:Name="SavePlanButton" Text="Save plan" Style="{StaticResource QuietButton}" IsEnabled="False" Clicked="OnSaveBacktestPlan" />
                        <Picker x:Name="SavedPlanPicker" Title="Saved plans" SelectedIndexChanged="OnSavedPlanSelected" />
                        <Button x:Name="StartPlanButton" Text="Start saved plan" IsEnabled="False" Clicked="OnStartSavedPlan" />
                        <Label x:Name="PlanSummaryLabel" FontSize="13" />
                        <Button x:Name="PlanDetailsButton" Text="Frozen plan details +" IsVisible="False" Style="{StaticResource QuietButton}" Clicked="OnPlanDetailsClicked" />
                        <VerticalStackLayout x:Name="PlanDetailsPanel" IsVisible="False">
                            <Label x:Name="PlanPreviewLabel" FontSize="12" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Research runs" FontAttributes="Bold" FontSize="18" VerticalTextAlignment="Center" />
                    <Button Grid.Column="1" Text="Refresh" Style="{StaticResource QuietButton}" Clicked="OnRefreshClicked" Padding="12,6" />
                </Grid>

                <CollectionView x:Name="JobsView" SelectionMode="Single" SelectionChanged="OnJobSelected" HeightRequest="340">
                    <CollectionView.EmptyView>
                        <Label Text="No backtests yet." FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding RunName}" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" Text="{Binding Status}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                    </Grid>
                                    <Label Text="{Binding ProgressText}" FontSize="13" />
                                    <Label Text="{Binding ResultSummary}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Label Text="{Binding LatestEvent}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border x:Name="DetailCard" Style="{StaticResource CardBorder}" IsVisible="False">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="DetailTitle" FontAttributes="Bold" FontSize="17" />
                        <Label x:Name="DetailStatus" FontSize="13" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Refresh Detail" Clicked="OnRefreshClicked" />
                            <Button Grid.Column="1" Text="Cancel Backtest" Clicked="OnCancelSelectedJob" BackgroundColor="{AppThemeBinding Light={StaticResource StateNegativeLight}, Dark={StaticResource StateNegativeDark}}" />
                        </Grid>
                        <Label x:Name="ResultLabel" FontSize="13" />
                        <Label x:Name="PreparedDataLabel" IsVisible="False" FontSize="12" LineBreakMode="CharacterWrap" />
                        <Label x:Name="EvidenceDetailLabel" IsVisible="False" FontSize="12" LineBreakMode="CharacterWrap" />
                        <Label Text="Strategy Groups" FontAttributes="Bold" FontSize="14" />
                        <VerticalStackLayout x:Name="StrategyGroupsStack" Spacing="4" />
                        <Label Text="Recent Events" FontAttributes="Bold" FontSize="14" />
                        <VerticalStackLayout x:Name="EventsStack" Spacing="4" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
