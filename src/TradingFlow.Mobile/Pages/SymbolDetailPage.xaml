<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TradingFlow.Mobile.Controls"
             x:Class="TradingFlow.Mobile.Pages.SymbolDetailPage"
             Title="Symbol Detail">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="TickerLabel" Text="Symbol" Style="{StaticResource Headline}" />
                    <Label x:Name="UpdatedLabel" Text="Loading evidence..." Style="{StaticResource SubHeadline}" />
                </VerticalStackLayout>
                <controls:EnvironmentBadgeView Grid.Column="1" />
            </Grid>

            <ActivityIndicator x:Name="BusyIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="{StaticResource Primary}" />
            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   TextColor="{AppThemeBinding Light={StaticResource StateNegativeLight}, Dark={StaticResource StateNegativeDark}}" />

            <VerticalStackLayout Spacing="6">
                <Label Text="Quotes and holdings" FontAttributes="Bold" FontSize="18" />
                <Label x:Name="DecisionStatusLabel" FontAttributes="Bold" />
                <Label x:Name="DecisionReasonLabel" LineBreakMode="WordWrap" />
                <Label x:Name="QuoteLabel" FontFamily="monospace" />
                <Label x:Name="QuoteAgeLabel" Style="{StaticResource SubHeadline}" />
                <Label x:Name="PositionLabel" Style="{StaticResource SubHeadline}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Strategy" FontAttributes="Bold" FontSize="18" />
                <Picker x:Name="StrategyPicker" Title="Select a strategy" SelectedIndexChanged="OnStrategyChanged" />
                <Label x:Name="StrategyStatusLabel" Text="Select a strategy" LineBreakMode="WordWrap" />
                <Label x:Name="StrategyTimeLabel" Style="{StaticResource SubHeadline}" LineBreakMode="WordWrap" />
                <Button x:Name="CancelStrategyButton" Text="Cancel strategy checks" IsVisible="False" Clicked="OnCancelStrategyClicked" />
                <VerticalStackLayout x:Name="StrategyChecks" Spacing="8" />
                <Button Text="Open candidate review" Clicked="OnCandidateReviewClicked" />
                <Label Text="Strategy checks do not submit an order. Quotes may be newer than the strategy evaluation."
                       Style="{StaticResource SubHeadline}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderDividerLight}, Dark={StaticResource BorderDividerDark}}" />

            <VerticalStackLayout Spacing="8">
                <Label Text="Model Intelligence" FontAttributes="Bold" FontSize="18" />
                <Label Text="Read-only prediction evidence. It cannot override TradingFlow strategy or risk gates."
                       Style="{StaticResource SubHeadline}"
                       LineBreakMode="WordWrap" />
                <Label Text="Swing horizon" Style="{StaticResource SubHeadline}" />
                <Label x:Name="ModelStatusLabel"
                       FontAttributes="Bold" />
                <Label x:Name="ModelGeneratedLabel" Style="{StaticResource SubHeadline}" />
                <Label x:Name="ModelIdentityLabel" Style="{StaticResource SubHeadline}" LineBreakMode="WordWrap" />
                <Label x:Name="ModelUnavailableLabel"
                       IsVisible="False"
                       TextColor="{AppThemeBinding Light={StaticResource StateWarningLight}, Dark={StaticResource StateWarningDark}}"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="SwingSection" IsVisible="False" Spacing="4">
                <Label x:Name="SwingSignalLabel" FontAttributes="Bold" />
                <Label x:Name="SwingProbabilityLabel" />
                <Label x:Name="SwingContextLabel" Style="{StaticResource SubHeadline}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ReadinessSection" IsVisible="False" Spacing="4">
                <Label Text="Readiness evidence" FontAttributes="Bold" />
                <Label x:Name="ReadinessReasonsLabel" Style="{StaticResource SubHeadline}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Button Text="Refresh evidence"
                    Clicked="OnRefreshClicked"
                    SemanticProperties.Description="Refresh symbol quote, TradingFlow decision, and model evidence" />
            <Button x:Name="ReviewOrderButton"
                    Text="Review protected buy"
                    IsEnabled="False"
                    Clicked="OnReviewOrderClicked"
                    SemanticProperties.Description="Open a reviewed paper buy ticket for this symbol" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
