<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TradingFlow.Mobile.Controls"
             x:Class="TradingFlow.Mobile.Pages.SymbolDetailPage"
             Title="Symbol Detail">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="TickerLabel" Text="Symbol" Style="{StaticResource Headline}" />
                    <Label x:Name="UpdatedLabel" Text="Loading evidence..." Style="{StaticResource SubHeadline}" />
                </VerticalStackLayout>
                <controls:EnvironmentBadgeView Grid.Column="1" />
            </Grid>

            <ActivityIndicator x:Name="BusyIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="{StaticResource Primary}" />
            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   TextColor="{StaticResource StateError}" />

            <VerticalStackLayout Spacing="6">
                <Label Text="TradingFlow Decision" FontAttributes="Bold" FontSize="18" />
                <Label x:Name="DecisionStatusLabel" FontAttributes="Bold" />
                <Label x:Name="DecisionReasonLabel" LineBreakMode="WordWrap" />
                <Label x:Name="QuoteLabel" FontFamily="monospace" />
                <Label x:Name="QuoteAgeLabel" Style="{StaticResource Caption}" />
                <Label x:Name="PositionLabel" Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{StaticResource BorderDefault}" />

            <VerticalStackLayout Spacing="8">
                <Label Text="Model Intelligence" FontAttributes="Bold" FontSize="18" />
                <Label Text="Read-only prediction evidence. It cannot override TradingFlow strategy or risk gates."
                       Style="{StaticResource Caption}"
                       LineBreakMode="WordWrap" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Button x:Name="UnifiedButton" Text="Unified" CommandParameter="unified" Clicked="OnModeSelected" />
                    <Button x:Name="SwingButton" Grid.Column="1" Text="Swing" CommandParameter="swing" Clicked="OnModeSelected" />
                    <Button x:Name="IntradayButton" Grid.Column="2" Text="Intraday" CommandParameter="intraday" Clicked="OnModeSelected" />
                </Grid>
                <Label x:Name="ModelStatusLabel"
                       FontAttributes="Bold" />
                <Label x:Name="ModelGeneratedLabel" Style="{StaticResource Caption}" />
                <Label x:Name="ModelIdentityLabel" Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
                <Label x:Name="ModelUnavailableLabel"
                       IsVisible="False"
                       TextColor="{StaticResource StateWarning}"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="SwingSection" IsVisible="False" Spacing="4">
                <Label x:Name="SwingSignalLabel" FontAttributes="Bold" />
                <Label x:Name="SwingProbabilityLabel" />
                <Label x:Name="SwingContextLabel" Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="IntradaySection" IsVisible="False" Spacing="4">
                <Label x:Name="IntradaySignalLabel" FontAttributes="Bold" />
                <Label x:Name="IntradayProbabilityLabel" />
                <Label x:Name="IntradayTechnicalLabel" Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ReadinessSection" IsVisible="False" Spacing="4">
                <Label Text="Readiness evidence" FontAttributes="Bold" />
                <Label x:Name="ReadinessReasonsLabel" Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Button Text="Refresh evidence"
                    Clicked="OnRefreshClicked"
                    SemanticProperties.Description="Refresh symbol quote, TradingFlow decision, and model evidence" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
