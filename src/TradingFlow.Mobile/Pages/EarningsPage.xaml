<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TradingFlow.Mobile.Controls"
             x:Class="TradingFlow.Mobile.Pages.EarningsPage"
             Title="Earnings">
    <RefreshView x:Name="RefreshRoot" Refreshing="OnRefresh">
        <CollectionView x:Name="EarningsView"
                        Margin="12,0"
                        IsGrouped="True"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.Header>
                <VerticalStackLayout Padding="0,12,0,10" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Reporting calendar · New York dates"
                                   Style="{StaticResource SubHeadline}" />
                        </VerticalStackLayout>
                        <controls:EnvironmentBadgeView Grid.Column="1" />
                    </Grid>

                    <Border Style="{StaticResource CardBorder}" Padding="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="6">
                                <Label x:Name="StatusLabel"
                                       Text="Loading earnings calendar..."
                                       FontSize="13"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <ActivityIndicator x:Name="BusyIndicator"
                                               Grid.Column="1"
                                               IsRunning="False"
                                               IsVisible="False" />
                        </Grid>
                    </Border>

                    <Button x:Name="RefreshProvidersButton" IsVisible="False" Text="Refresh Providers"
                            Clicked="OnRefreshProviders"
                            SemanticProperties.Description="Refresh Finviz earnings, Alpaca bars, and analysis" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Release session" FontSize="12" FontAttributes="Bold" />
                            <Picker x:Name="SessionPicker"
                                    SelectedIndexChanged="OnFilterChanged"
                                    ItemDisplayBinding="{Binding Label}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Market cap" FontSize="12" FontAttributes="Bold" />
                            <Picker x:Name="MarketCapPicker"
                                    SelectedIndexChanged="OnFilterChanged"
                                    ItemDisplayBinding="{Binding Label}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button Text="Filters +" Style="{StaticResource QuietButton}" HorizontalOptions="Start" Clicked="OnToggleFilters" />
                    <Label x:Name="ProviderStatusLabel" IsVisible="False" FontSize="13" LineBreakMode="WordWrap" />
                    <VerticalStackLayout x:Name="FilterHost" IsVisible="False" Spacing="6">
                        <HorizontalStackLayout Spacing="8">
                            <Switch x:Name="CalendarSwitch" Toggled="OnCalendarChanged" />
                            <Label Text="Use date range (maximum 35 days)" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <DatePicker x:Name="FromDate" DateSelected="OnDateChanged" Format="yyyy-MM-dd" />
                            <DatePicker x:Name="ToDate" Grid.Column="1" DateSelected="OnDateChanged" Format="yyyy-MM-dd" />
                        </Grid>
                        <Button Text="This week in New York" Clicked="OnThisWeek" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Grid Padding="2,14,2,8" ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGroupHeaderTapped" CommandParameter="{Binding}" />
                        </Grid.GestureRecognizers>
                        <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding CountText}" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="12,28" Spacing="6">
                    <Label x:Name="EmptyTitleLabel" Text="Loading earnings"
                           FontAttributes="Bold"
                           FontSize="16"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="EmptyDetailLabel" Text="Waiting for a calendar response."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="10">
                        <VerticalStackLayout Spacing="7">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Item.Ticker}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Item.CompanyName}"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2"
                                       Text="{Binding Item.ResultText}"
                                       FontSize="12" />
                            </Grid>
                            <Label Text="{Binding Item.MarketCapText}"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Text="{Binding Item.ReleaseText}"
                                   FontSize="13"
                                   IsVisible="{Binding Item.HasReleaseText}" />
                            <Label Text="{Binding Item.ScheduleText}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Text="{Binding Item.SlotWarningText}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource StateWarningLight}, Dark={StaticResource StateWarningDark}}"
                                   IsVisible="{Binding Item.HasSlotWarning}" />
                            <Label Text="{Binding Item.PriceText}"
                                   FontSize="13"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding Item.ReactionText}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Item.SurpriseText}" FontSize="13" />
                                <Label Grid.Column="1" Text="{Binding Item.MoveText}" FontSize="13" />
                            </Grid>
                            <Label Text="{Binding Item.EpsValuesText}" FontSize="12" />
                            <Label Text="{Binding Item.PreviousEpsText}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   LineBreakMode="WordWrap" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Button Text="Details"
                                        Padding="10,5"
                                        MinimumHeightRequest="36"
                                        CommandParameter="{Binding}"
                                        Clicked="OnToggleDetails" />
                                <Button Grid.Column="1"
                                        Text="News"
                                        Padding="10,5"
                                        MinimumHeightRequest="36"
                                        IsVisible="{Binding Item.HasNews}"
                                        CommandParameter="{Binding}"
                                        Clicked="OnOpenNews" />
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="5">
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderDividerLight}, Dark={StaticResource BorderDividerDark}}" />
                                <Label Text="{Binding Item.AnalysisReason}"
                                       FontSize="13"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding TechnicalText}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding Item.ScheduledNewYorkText, StringFormat='New York {0}'}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Text="{Binding Item.ScheduledUtcText}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Text="{Binding ResultObservedText}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                       IsVisible="{Binding HasResultObservedTime}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
