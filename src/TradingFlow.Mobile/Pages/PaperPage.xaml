<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TradingFlow.Mobile.Pages.PaperPage"
             Title="Paper">
    <RefreshView x:Name="RefreshRoot" Refreshing="OnRefresh">
        <ScrollView>
            <VerticalStackLayout Padding="12" Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Paper" Style="{StaticResource Headline}" FontSize="22" />
                        <Label Text="Run a wishlist plus optional Finviz symbols with one selected strategy." Style="{StaticResource SubHeadline}" FontSize="12" />
                    </VerticalStackLayout>
                    <ActivityIndicator x:Name="BusyIndicator" Grid.Column="1" IsRunning="False" IsVisible="False" />
                </Grid>

                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label x:Name="StatusLabel" Text="Checking backend..." FontSize="13" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="10">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Quick Run" FontAttributes="Bold" FontSize="16" />
                                <Label Text="Wishlist is the trading universe; Finviz can add today's screeners." FontSize="12" TextColor="{StaticResource SecondaryTextColor}" />
                            </VerticalStackLayout>
                            <Button x:Name="RunButton" Grid.Column="1" Text="Start" Clicked="OnStartPaperRun" Padding="14,8" />
                        </Grid>
                        <Picker x:Name="WishlistPicker" Title="Wishlist" SelectedIndexChanged="OnWishlistPicked" />
                        <Picker x:Name="ConfigPicker" Title="Paper profile" SelectedIndexChanged="OnFormChanged" IsVisible="False" />
                        <Picker x:Name="StrategyPicker" Title="Strategy" SelectedIndexChanged="OnFormChanged" />
                        <Entry x:Name="ScreenerEntry" Placeholder="Optional Finviz query or URL" Keyboard="Url" TextChanged="OnFormChanged" />

                        <Button x:Name="AdvancedToggle" Text="Advanced" Clicked="OnToggleAdvanced" Padding="12,7" BackgroundColor="#475467" />
                        <VerticalStackLayout x:Name="AdvancedPanel" Spacing="8" IsVisible="False">
                            <Entry x:Name="RunNameEntry" Placeholder="Run name, optional" TextChanged="OnFormChanged" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox x:Name="AllowExtendedHoursTradingCheck" IsChecked="False" Scale="0.72" CheckedChanged="OnFormChanged" />
                                    <Label Text="Extended hours" VerticalTextAlignment="Center" FontSize="13" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                    <CheckBox x:Name="NewsCheck" IsChecked="False" Scale="0.72" CheckedChanged="OnFormChanged" />
                                    <Label Text="Use news" VerticalTextAlignment="Center" FontSize="13" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Picker x:Name="OrderExpirationPicker" Title="Order expiry" SelectedIndexChanged="OnFormChanged" />
                                <Picker x:Name="EntryOrderTypePicker" Grid.Column="1" Title="Entry order" SelectedIndexChanged="OnFormChanged" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="News Catalysts" FontAttributes="Bold" FontSize="18" VerticalTextAlignment="Center" />
                            <Button Grid.Column="1" Text="Test News" Clicked="OnTestNews" Padding="12,6" />
                        </Grid>
                        <Label x:Name="NewsStatusLabel" Text="Preview catalysts for selected tickers. Paper runs only use news when the News checkbox is on." FontSize="12" TextColor="{StaticResource SecondaryTextColor}" />
                        <CollectionView x:Name="NewsView" HeightRequest="240">
                            <CollectionView.EmptyView>
                                <Label Text="No catalyst news loaded." FontSize="13" TextColor="{StaticResource SecondaryTextColor}" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                        <VerticalStackLayout Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Ticker}" FontAttributes="Bold" FontSize="13" />
                                                <Label Grid.Column="1" Text="{Binding SentimentText}" FontSize="12" TextColor="{StaticResource AccentColor}" />
                                            </Grid>
                                            <Label Text="{Binding DisplayHeadline}" FontSize="12" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding DisplaySource}" FontSize="11" TextColor="{StaticResource SecondaryTextColor}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="LastRunCard" Style="{StaticResource CardBorder}" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Last Run" FontAttributes="Bold" FontSize="14" />
                            <Label x:Name="LastRunNameLabel" FontSize="13" LineBreakMode="TailTruncation" />
                            <Label x:Name="LastRunStatusLabel" FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Details" Clicked="OnOpenLastRunDetails" Padding="12,6" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Active Runs" FontAttributes="Bold" FontSize="17" />
                        <Label Text="Tap a run for positions, P/L and recent events." FontSize="12" TextColor="{StaticResource SecondaryTextColor}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Refresh" Clicked="OnRefreshClicked" Padding="12,6" />
                </Grid>

                <Border Style="{StaticResource CardBorder}" Padding="10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Stock Pulse Sessions" FontAttributes="Bold" FontSize="16" />
                        <CollectionView x:Name="AutomationSessionsView" HeightRequest="150">
                            <CollectionView.EmptyView>
                                <Label Text="No alert-triggered paper sessions." FontSize="13" TextColor="{StaticResource SecondaryTextColor}" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                        <VerticalStackLayout Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding DisplayTitle}" FontAttributes="Bold" FontSize="14" LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="1" Text="{Binding Status}" FontSize="12" TextColor="{StaticResource AccentColor}" />
                                            </Grid>
                                            <Label Text="{Binding RunDetail}" FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding LatestEvent}" FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <CollectionView x:Name="JobsView" SelectionMode="Single" SelectionChanged="OnJobSelected" HeightRequest="280">
                    <CollectionView.EmptyView>
                        <Label Text="No active paper runs. Use Last Run for the most recent completed, failed, or cancelled run." FontSize="13" TextColor="{StaticResource SecondaryTextColor}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding RunName}" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" Text="{Binding Status}" FontSize="12" TextColor="{StaticResource AccentColor}" />
                                    </Grid>
                                    <Label Text="{Binding ProgressText}" FontSize="13" />
                                    <Label Text="{Binding ResultSummary}" FontSize="12" TextColor="{StaticResource SecondaryTextColor}" />
                                    <Label Text="{Binding LatestEvent}" FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="TailTruncation" />
                                    <Button Text="Details" Clicked="OnJobDetailsClicked" CommandParameter="{Binding .}" Padding="12,6" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border x:Name="DetailCard" Style="{StaticResource CardBorder}" IsVisible="False">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="DetailTitle" FontAttributes="Bold" FontSize="17" />
                        <Label x:Name="DetailStatus" FontSize="13" />
                        <Label x:Name="ResultLabel" FontSize="13" />
                        <Button Text="Cancel Run" Clicked="OnCancelSelectedJob" BackgroundColor="#B42318" />
                        <Button Text="Cancel Broker Orders" Clicked="OnCancelBrokerOrders" BackgroundColor="#7A271A" />
                        <Label Text="Open Positions" FontAttributes="Bold" FontSize="14" />
                        <Label x:Name="PositionsEmptyLabel" Text="No open positions for this run." FontSize="12" TextColor="{StaticResource SecondaryTextColor}" />
                        <CollectionView x:Name="PositionsView" HeightRequest="150">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,2">
                                        <VerticalStackLayout Spacing="0">
                                            <Label Text="{Binding HeaderText}" FontAttributes="Bold" FontSize="13" />
                                            <Label Text="{Binding DetailText}" FontSize="11" TextColor="{StaticResource SecondaryTextColor}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding PnlText}" FontSize="13" VerticalTextAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="Recent Events" FontAttributes="Bold" FontSize="14" />
                        <VerticalStackLayout x:Name="EventsStack" Spacing="4" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
