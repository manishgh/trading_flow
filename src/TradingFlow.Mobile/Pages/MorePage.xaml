<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TradingFlow.Mobile.Controls"
             x:Class="TradingFlow.Mobile.Pages.MorePage"
             Title="More">
    <CollectionView x:Name="ToolsView"
                    SelectionMode="Single"
                    SelectionChanged="OnToolSelected"
                    Margin="12,0">
        <CollectionView.Header>
            <VerticalStackLayout Padding="0,12,0,10" Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="More" Style="{StaticResource Headline}" />
                        <Label Text="Research, news, automation, and operational tools."
                               Style="{StaticResource SubHeadline}" />
                    </VerticalStackLayout>
                    <controls:EnvironmentBadgeView Grid.Column="1" />
                </Grid>
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource CardBorder}"
                        Margin="0,0,0,8"
                        Padding="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   FontSize="16" />
                            <Label Text="{Binding Description}"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="›"
                               FontSize="24"
                               TextColor="{StaticResource Primary}"
                               VerticalTextAlignment="Center"
                               SemanticProperties.Description="Open tool" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
