<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TradingFlow.Mobile.Pages.AutomationPage"
             Title="Automation">
    <RefreshView x:Name="RefreshRoot" Refreshing="OnRefresh">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">
                <Label Text="Android Automation" Style="{StaticResource Headline}" FontSize="24" />
                <Label Text="Capture a trusted alert app, parse the ticker, start paper entry, and let TradingFlow manage the exit." Style="{StaticResource SubHeadline}" FontSize="13" />
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label x:Name="StatusLabel" Text="Checking backend..." FontSize="13" VerticalTextAlignment="Center" />
                        <ActivityIndicator x:Name="BusyIndicator" Grid.Column="1" IsRunning="False" IsVisible="False" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="External Alert Entry" FontAttributes="Bold" FontSize="18" />
                        <Label x:Name="NotificationAccessLabel" FontSize="13" />
                        <Button Text="1. Enable Notification Access" Clicked="OnOpenNotificationSettings" />
                        <Label Text="2. Type the app display name, tap Find, then choose the exact installed app." FontSize="12" TextColor="{StaticResource SecondaryTextColor}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry x:Name="SourceAppSearchEntry" Placeholder="App name: Stock Pulse" />
                            <Button Grid.Column="1" Text="Find" Clicked="OnFindSourceApp" Padding="12,6" />
                        </Grid>
                        <Picker x:Name="AppMatchPicker" Title="Matching installed apps" />
                        <Label x:Name="SourceAppStatusLabel" Text="No source app verified yet." FontSize="12" TextColor="{StaticResource SecondaryTextColor}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Use Matched App" Clicked="OnUseMatchedApp" />
                            <Button Grid.Column="1" Text="Clear Filter" Clicked="OnClearSourceApp" />
                        </Grid>
                        <Label Text="Selected source app" FontAttributes="Bold" FontSize="12" />
                        <Label x:Name="SourceAppLabel" Text="None selected" FontSize="13" />
                        <Entry x:Name="PackageEntry" IsReadOnly="True" FontSize="11" Placeholder="Exact Android package is saved after app lookup or captured alert" />
                        <Label Text="Paper profile" FontAttributes="Bold" FontSize="12" />
                        <Picker x:Name="ConfigPicker" Title="Mode / broker profile" />
                        <Label Text="Exit strategy" FontAttributes="Bold" FontSize="12" />
                        <Picker x:Name="StrategyPicker" Title="Entry playbook + exit strategy" />
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="AutoForwardCheck" Scale="0.85" />
                            <Label Text="Auto-start paper trade when this app sends a parsed entry alert" VerticalTextAlignment="Center" FontSize="13" />
                        </HorizontalStackLayout>
                        <Button Text="Save Automation Defaults" Clicked="OnSaveDefaults" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Run Now" FontAttributes="Bold" FontSize="18" />
                        <Label Text="Start one ticker immediately using the selected playbook. Exit remains strategy-managed." FontSize="13" TextColor="{StaticResource SecondaryTextColor}" />
                        <Label Text="Ticker" FontAttributes="Bold" FontSize="12" />
                        <Entry x:Name="ManualTickerEntry" Placeholder="Ticker: POET" />
                        <Button Text="Run Ticker Now" Clicked="OnRunNow" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Automation Sessions" FontAttributes="Bold" FontSize="18" VerticalTextAlignment="Center" />
                    <Button Grid.Column="1" Text="Refresh" Clicked="OnRefreshClicked" Padding="12,6" />
                </Grid>

                <CollectionView x:Name="SessionsView" SelectionMode="Single" SelectionChanged="OnSessionSelected">
                    <CollectionView.EmptyView>
                        <Label Text="No automation sessions yet." FontSize="13" TextColor="{StaticResource SecondaryTextColor}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Ticker}" FontAttributes="Bold" FontSize="16" />
                                        <Label Grid.Column="1" Text="{Binding Status}" FontSize="12" TextColor="{StaticResource AccentColor}" />
                                    </Grid>
                                    <Label Text="{Binding ProgressText}" FontSize="13" />
                                    <Label Text="{Binding LatestEvent}" FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border x:Name="DetailCard" Style="{StaticResource CardBorder}" IsVisible="False">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="DetailTitle" FontAttributes="Bold" FontSize="17" />
                        <Label x:Name="DetailStatus" FontSize="13" />
                        <Button Text="Cancel Session" Clicked="OnCancelSession" BackgroundColor="#B42318" />
                        <Label Text="Recent Events" FontAttributes="Bold" FontSize="14" />
                        <VerticalStackLayout x:Name="EventsStack" Spacing="4" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Captured Alerts" FontAttributes="Bold" FontSize="18" />
                <Label x:Name="SelectedAlertLabel" Text="Select an alert below. TradingFlow extracts the ticker; auto-start only listens to the saved source app." FontSize="12" TextColor="{StaticResource SecondaryTextColor}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Use Alert App" Clicked="OnUseSelectedApp" />
                    <Button Grid.Column="1" Text="Start Paper" Clicked="OnForwardAlert" />
                </Grid>
                <Button Text="Clear Alerts" Clicked="OnClearAlerts" BackgroundColor="#475467" />
                <CollectionView x:Name="AlertsView" SelectionMode="Single" SelectionChanged="OnAlertSelected">
                    <CollectionView.EmptyView>
                        <Label Text="No captured alerts yet." FontSize="13" TextColor="{StaticResource SecondaryTextColor}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding AppName}" FontAttributes="Bold" FontSize="14" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" Text="{Binding ParsedTickerText}" FontSize="12" TextColor="{StaticResource AccentColor}" />
                                    </Grid>
                                    <Label Text="{Binding Title}" FontSize="12" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Message}" FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding CaptureSummary}" FontSize="11" TextColor="{StaticResource AccentColor}" />
                                    <Label Text="{Binding PackageName}" FontSize="11" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding ForwardStatus}" FontSize="11" TextColor="{StaticResource SecondaryTextColor}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
