<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TradingFlow.Mobile.Pages.AutomationPage"
             Title="Automation">
    <RefreshView x:Name="RefreshRoot" Refreshing="OnRefresh">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Trade Automation" Style="{StaticResource Headline}" FontSize="24" />
                    </VerticalStackLayout>
                    <ActivityIndicator x:Name="BusyIndicator" Grid.Column="1" IsRunning="False" IsVisible="False" />
                </Grid>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="StatusLabel" Text="Checking backend..." FontSize="13" />
                        <Label x:Name="NotificationAccessLabel" FontSize="13" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Text="Notification Access" Clicked="OnOpenNotificationSettings" />
                            <Button Grid.Column="1" Text="Refresh" Clicked="OnRefreshClicked" Padding="12,6" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Run Ticker" FontAttributes="Bold" FontSize="18" />
                        <Entry x:Name="ManualTickerEntry" Placeholder="POET, RGTI, NVTS..." Keyboard="Text" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Picker x:Name="ConfigPicker" Title="Paper profile" />
                            <Picker x:Name="StrategyPicker" Grid.Column="1" Title="Strategy" />
                        </Grid>
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ValidateStrategyCheck" Scale="0.82" CheckedChanged="OnAutomationOptionChanged" />
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Require strategy gates before entry" VerticalTextAlignment="Center" FontSize="13" />
                                <Label Text="Off = enter on Stock Pulse alert, then guardian manages exit." FontSize="11" TextColor="{StaticResource SecondaryTextColor}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Button Text="Start Paper Trade" Clicked="OnRunNow" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Stock Pulse Alerts" FontAttributes="Bold" FontSize="18" />
                                <Label x:Name="SelectedAlertLabel" Text="Captured alerts appear here after notification access is enabled." FontSize="12" TextColor="{StaticResource SecondaryTextColor}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Clear" Clicked="OnClearAlerts" Padding="12,6" BackgroundColor="#475467" />
                        </Grid>

                        <Button Text="Start Selected" Clicked="OnForwardAlert" />

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="AutoForwardCheck" Scale="0.82" CheckedChanged="OnAutomationOptionChanged" />
                            <Label Text="Auto-start when Stock Pulse sends a buy alert" VerticalTextAlignment="Center" FontSize="13" />
                        </HorizontalStackLayout>
                        <Button Text="Save Defaults" Clicked="OnSaveDefaults" />

                        <CollectionView x:Name="AlertsView" SelectionMode="Single" SelectionChanged="OnAlertSelected" HeightRequest="300">
                            <CollectionView.EmptyView>
                                <Label Text="No captured alerts yet." FontSize="13" TextColor="{StaticResource SecondaryTextColor}" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                        <VerticalStackLayout Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding AppName}" FontAttributes="Bold" FontSize="14" LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="1" Text="{Binding ParsedTickerText}" FontSize="12" TextColor="{StaticResource AccentColor}" />
                                            </Grid>
                                            <Label Text="{Binding Title}" FontSize="12" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Message}" FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding ForwardStatus}" FontSize="11" TextColor="{StaticResource SecondaryTextColor}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Source" FontAttributes="Bold" FontSize="18" />
                        <Label Text="Stock Pulse only" FontSize="14" TextColor="{StaticResource AccentColor}" />
                        <Label Text="TradingFlow captures and forwards parsed ticker alerts only from Stock Pulse. Other app notifications are ignored." FontSize="12" TextColor="{StaticResource SecondaryTextColor}" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="Automation Sessions" FontAttributes="Bold" FontSize="18" VerticalTextAlignment="Center" />
                    <Button Grid.Column="1" Text="Refresh" Clicked="OnRefreshClicked" Padding="12,6" />
                </Grid>

                <CollectionView x:Name="SessionsView" SelectionMode="Single" SelectionChanged="OnSessionSelected" HeightRequest="320">
                    <CollectionView.EmptyView>
                        <Label Text="No automation sessions yet." FontSize="13" TextColor="{StaticResource SecondaryTextColor}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Ticker}" FontAttributes="Bold" FontSize="16" />
                                        <Label Grid.Column="1" Text="{Binding Status}" FontSize="12" TextColor="{StaticResource AccentColor}" />
                                    </Grid>
                                    <Label Text="{Binding ProgressText}" FontSize="13" />
                                    <Label Text="{Binding LatestEvent}" FontSize="12" TextColor="{StaticResource SecondaryTextColor}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border x:Name="DetailCard" Style="{StaticResource CardBorder}" IsVisible="False">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="DetailTitle" FontAttributes="Bold" FontSize="17" />
                        <Label x:Name="DetailStatus" FontSize="13" />
                        <Button Text="Cancel Session" Clicked="OnCancelSession" BackgroundColor="#B42318" />
                        <Label Text="Recent Events" FontAttributes="Bold" FontSize="14" />
                        <VerticalStackLayout x:Name="EventsStack" Spacing="4" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
