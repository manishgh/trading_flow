<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TradingFlow.Mobile.Pages.WishlistsPage" Title="Stocks">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="20,8,20,12" Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Picker x:Name="WishlistPicker" Title="Choose a stock group" SelectedIndexChanged="OnWishlistChanged"
                        SemanticProperties.Description="Choose the stock group to follow" />
                <Button Grid.Column="1" Text="Manage" Clicked="OnManageClicked" Style="{StaticResource QuietButton}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label x:Name="StatusLabel" Text="Loading stocks…" Style="{StaticResource SubHeadline}" VerticalTextAlignment="Center" LineBreakMode="WordWrap" />
                <ActivityIndicator x:Name="BusyIndicator" Grid.Column="1" IsRunning="False" IsVisible="False" />
            </Grid>
            <SearchBar x:Name="WatchSearchBar" Placeholder="Search your stocks" TextChanged="OnWatchFilterChanged" />
            <Label x:Name="WatchCountLabel" Style="{StaticResource SubHeadline}" />
        </VerticalStackLayout>
        <RefreshView x:Name="RefreshRoot" Grid.Row="1" Refreshing="OnRefresh">
            <CollectionView x:Name="ItemsView" SelectionMode="Single" SelectionChanged="OnStockSelected"
                            ItemsUpdatingScrollMode="KeepScrollOffset">
                <CollectionView.Header>
<VerticalStackLayout x:Name="ManagePanel" IsVisible="False" Padding="20,0,20,16" Spacing="8">
                <Label x:Name="WishlistDetailLabel" Style="{StaticResource SubHeadline}" />
                <Label x:Name="StockCountLabel" Style="{StaticResource SubHeadline}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry x:Name="TickerEntry" Placeholder="Add ticker" TextChanged="OnTickerSearchChanged" />
                    <Button Grid.Column="1" Text="Add" Clicked="OnAddTicker" />
                </Grid>
                <Picker x:Name="SuggestionsPicker" Title="Matching symbols" IsVisible="False" SelectedIndexChanged="OnSuggestionSelected" />
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Button x:Name="WatchAllButton" Text="All" Style="{StaticResource QuietButton}" Clicked="OnWatchScopeSelected" CommandParameter="all" />
                        <Button x:Name="WatchSignalButton" Text="Past alerts" Style="{StaticResource QuietButton}" Clicked="OnWatchScopeSelected" CommandParameter="signal" SemanticProperties.Description="Historical alerts, not current executable signals" />
                        <Button x:Name="WatchTradeButton" Text="In trade" Style="{StaticResource QuietButton}" Clicked="OnWatchScopeSelected" CommandParameter="trade" />
                        <Button x:Name="WatchNewsButton" Text="News" Style="{StaticResource QuietButton}" Clicked="OnWatchScopeSelected" CommandParameter="news" />
                    </HorizontalStackLayout>
                </ScrollView>
                <Button Text="Refresh stocks" Clicked="OnRefreshClicked" Style="{StaticResource QuietButton}" />
            </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24,36" Spacing="8">
                        <Label x:Name="EmptyTitleLabel" Text="Loading stocks" FontAttributes="Bold" FontSize="18" HorizontalTextAlignment="Center" />
                        <Label x:Name="EmptyDetailLabel" Text="Your saved stock groups appear here." Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                        <Button x:Name="EmptyActionButton" Text="Sign in" Clicked="OnEmptyActionClicked" IsVisible="False" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems><SwipeItem Text="News" BackgroundColor="{AppThemeBinding Light={StaticResource AccentStrongLight}, Dark={StaticResource AccentSurfaceDark}}" IsEnabled="{Binding HasNewsLink}" CommandParameter="{Binding .}" Invoked="OnOpenTickerNews" /></SwipeItems>
                            </SwipeView.RightItems>
                        <VerticalStackLayout Spacing="0">
                            <Grid Padding="20,12" MinimumHeightRequest="72" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Ticker}" FontSize="17" FontAttributes="Bold" />
                                    <Label Text="{Binding CompanyName}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" MaxLines="1" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center" HorizontalOptions="End">
                                    <Label Text="{Binding PriceText}" FontSize="17" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding MovementText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Margin="20,0" Color="{AppThemeBinding Light={StaticResource BorderDividerLight}, Dark={StaticResource BorderDividerDark}}" />
                        </VerticalStackLayout>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
