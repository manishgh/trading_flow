<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TradingFlow.Mobile.Controls"
             x:Class="TradingFlow.Mobile.Pages.WishlistsPage"
             Title="Watch">
    <RefreshView x:Name="RefreshRoot" Refreshing="OnRefresh">
        <CollectionView x:Name="ItemsView"
                        Margin="12,0"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.Header>
                <VerticalStackLayout Padding="0,12,0,10" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Watch" Style="{StaticResource Headline}" />
                            <Label Text="Scan candidates and inspect current TradingFlow eligibility."
                                   Style="{StaticResource SubHeadline}" />
                        </VerticalStackLayout>
                        <controls:EnvironmentBadgeView Grid.Column="1" />
                    </Grid>

                    <Border Style="{StaticResource CardBorder}" Padding="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label x:Name="StatusLabel"
                                   Text="Checking backend..."
                                   FontSize="13"
                                   LineBreakMode="WordWrap" />
                            <ActivityIndicator x:Name="BusyIndicator"
                                               Grid.Column="1"
                                               IsRunning="False"
                                               IsVisible="False" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Picker x:Name="WishlistPicker"
                                Title="Wishlist"
                                SelectedIndexChanged="OnWishlistChanged"
                                SemanticProperties.Description="Choose the watchlist to monitor" />
                        <Button Grid.Column="1"
                                Text="Refresh"
                                Clicked="OnRefreshClicked"
                                SemanticProperties.Description="Refresh watchlist status" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="1">
                            <Label x:Name="WishlistDetailLabel"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                            <Label x:Name="StockCountLabel"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Button x:Name="ObserveButton"
                                Grid.Column="1"
                                Text="Observe"
                                Clicked="OnToggleObserve"
                                SemanticProperties.Description="Start or pause continuous watchlist observation" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry x:Name="TickerEntry"
                               Placeholder="Add ticker"
                               Keyboard="Text"
                               TextChanged="OnTickerSearchChanged"
                               SemanticProperties.Description="Ticker symbol to add to this watchlist" />
                        <Button Grid.Column="1"
                                Text="Add"
                                Clicked="OnAddTicker"
                                SemanticProperties.Description="Add ticker to this watchlist" />
                    </Grid>

                    <Picker x:Name="SuggestionsPicker"
                            Title="Matching known symbols"
                            IsVisible="False"
                            SelectedIndexChanged="OnSuggestionSelected"
                            SemanticProperties.Description="Matching known ticker symbols" />

                    <Label Text="Markets"
                           FontAttributes="Bold"
                           FontSize="18" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="12,28" Spacing="6">
                    <Label Text="No watched symbols"
                           FontAttributes="Bold"
                           FontSize="16"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Add a ticker above or choose another wishlist."
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}"
                            Margin="0,0,0,8"
                            Padding="10">
                        <VerticalStackLayout Spacing="7">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding DisplayTitle}"
                                           FontAttributes="Bold"
                                           FontSize="16" />
                                    <Label Text="{Binding DetailText}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextSecondary}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="End">
                                    <Label Text="{Binding PriceText}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           HorizontalTextAlignment="End" />
                                    <Label Text="{Binding BidAskText}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextSecondary}"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="{Binding StatusText}"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       TextColor="{Binding StatusColor}"
                                       VerticalTextAlignment="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding MovementText}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       HorizontalTextAlignment="End"
                                       IsVisible="{Binding HasMovement}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="Details"
                                       Clicked="OnToggleTickerDetails"
                                       CommandParameter="{Binding .}"
                                        SemanticProperties.Description="Open market, eligibility, and model evidence details" />
                                <Button Grid.Column="1"
                                        Text="News"
                                        Clicked="OnOpenTickerNews"
                                        CommandParameter="{Binding .}"
                                        IsEnabled="{Binding HasNewsLink}"
                                        SemanticProperties.Description="Open the latest related news article" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
