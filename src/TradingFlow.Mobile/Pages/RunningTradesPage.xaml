<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TradingFlow.Mobile.Controls"
             x:Class="TradingFlow.Mobile.Pages.RunningTradesPage"
             Title="Positions">
    <RefreshView x:Name="RefreshRoot" Refreshing="OnRefresh">
        <CollectionView x:Name="TradesView"
                        Margin="12,0"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.Header>
                <VerticalStackLayout Padding="0,12,0,10" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Positions" Style="{StaticResource Headline}" />
                            <Label Text="Open exposure, protection, and unrealized P/L."
                                   Style="{StaticResource SubHeadline}" />
                        </VerticalStackLayout>
                        <controls:EnvironmentBadgeView Grid.Column="1" />
                    </Grid>

                    <Border Style="{StaticResource CardBorder}" Padding="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="3">
                                <Label x:Name="StatusLabel"
                                       Text="Checking backend..."
                                       FontSize="13"
                                       LineBreakMode="WordWrap" />
                                <Label x:Name="TotalLabel"
                                       Text="Total P/L --"
                                       FontSize="20"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <ActivityIndicator x:Name="BusyIndicator"
                                               Grid.Column="1"
                                               IsRunning="False"
                                               IsVisible="False" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Button x:Name="AllButton"
                                Text="All"
                                Clicked="OnSourceSelected"
                                CommandParameter="all" />
                        <Button x:Name="WishlistButton"
                                Grid.Column="1"
                                Text="Wishlist"
                                Clicked="OnSourceSelected"
                                CommandParameter="wishlist" />
                        <Button x:Name="StockPulseButton"
                                Grid.Row="1"
                                Text="Stock Pulse"
                                Clicked="OnSourceSelected"
                                CommandParameter="stockpulse" />
                        <Button x:Name="ManualButton"
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="Manual"
                                Clicked="OnSourceSelected"
                                CommandParameter="manual" />
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="12,28" Spacing="6">
                    <Label Text="No open positions"
                           FontAttributes="Bold"
                           FontSize="16"
                           HorizontalTextAlignment="Center" />
                    <Label Text="No running trades match this source filter."
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}"
                            Margin="0,0,0,8"
                            Padding="10">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding Trade.HeaderText}"
                                           FontAttributes="Bold"
                                           FontSize="16" />
                                    <Label Text="{Binding Trade.DetailText}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextSecondary}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding Trade.PlText}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="{Binding PlColor}"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Trade.PriceText}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalTextAlignment="Center" />
                                <Button Grid.Column="1"
                                        Text="Review Exit"
                                        Clicked="OnSell"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{StaticResource StateNegative}"
                                        SemanticProperties.Description="Review closing this paper position" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
