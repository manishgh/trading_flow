<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TradingFlow.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TradingFlow.Mobile.Pages"
    Title="TradingFlow"
    Shell.TabBarBackgroundColor="{StaticResource SurfacePanel}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarTitleColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource TextSecondary}"
    SemanticProperties.Description="TradingFlow primary navigation">

    <TabBar>
        <ShellContent
            Title="Desk"
            ContentTemplate="{DataTemplate pages:WishlistsPage}"
            Route="WishlistsPage" />

        <ShellContent
            Title="Trades"
            ContentTemplate="{DataTemplate pages:RunningTradesPage}"
            Route="RunningTradesPage" />

        <ShellContent
            Title="Paper"
            ContentTemplate="{DataTemplate pages:PaperPage}"
            Route="PaperPage" />

        <ShellContent
            Title="News"
            ContentTemplate="{DataTemplate pages:NewsPage}"
            Route="NewsPage" />

        <Tab Title="More">
            <ShellContent
                Title="Automation"
                ContentTemplate="{DataTemplate pages:AutomationPage}"
                Route="AutomationPage" />

            <ShellContent
                Title="Backtests"
                ContentTemplate="{DataTemplate pages:BacktestsPage}"
                Route="BacktestsPage" />

            <ShellContent
                Title="Alerts"
                ContentTemplate="{DataTemplate pages:NotificationsPage}"
                Route="NotificationsPage" />

            <ShellContent
                Title="Settings"
                ContentTemplate="{DataTemplate pages:SettingsPage}"
                Route="SettingsPage" />
        </Tab>
    </TabBar>

</Shell>
