<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TradingFlow.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TradingFlow.Mobile.Pages"
    Title="TradingFlow"
    Shell.TabBarBackgroundColor="{StaticResource SurfacePanel}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarTitleColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource TextSecondary}"
    SemanticProperties.Description="TradingFlow primary navigation">

    <TabBar>
        <ShellContent
            Title="Watch"
            ContentTemplate="{DataTemplate pages:WishlistsPage}"
            Route="WishlistsPage" />

        <ShellContent
            Title="Positions"
            ContentTemplate="{DataTemplate pages:RunningTradesPage}"
            Route="RunningTradesPage" />

        <ShellContent
            Title="Activity"
            ContentTemplate="{DataTemplate pages:NotificationsPage}"
            Route="NotificationsPage" />

        <ShellContent
            Title="More"
            ContentTemplate="{DataTemplate pages:MorePage}"
            Route="MorePage" />
    </TabBar>

</Shell>
