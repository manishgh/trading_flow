<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TradingFlow.Mobile.Controls.EnvironmentBadgeView"
             MinimumHeightRequest="48"
             SemanticProperties.Hint="Open UTC, New York and local clocks"
             SemanticProperties.Description="Paper trading environment, New York market time, and device local time">
    <ContentView.GestureRecognizers><TapGestureRecognizer Tapped="OnClocksTapped" /></ContentView.GestureRecognizers>
    <Border Padding="8,4"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderDividerLight}, Dark={StaticResource BorderDividerDark}}"
            StrokeShape="RoundRectangle 6"
            HorizontalOptions="End"
            VerticalOptions="Center">
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="1">
            <HorizontalStackLayout Spacing="5">
                <BoxView WidthRequest="7"
                         HeightRequest="7"
                         CornerRadius="4"
                         Color="{AppThemeBinding Light={StaticResource StateWarningLight}, Dark={StaticResource StateWarningDark}}"
                         VerticalOptions="Center" />
                <Label Text="Paper"
                       FontAttributes="Bold"
                       FontSize="10"
                       TextColor="{AppThemeBinding Light={StaticResource StateWarningLight}, Dark={StaticResource StateWarningDark}}"
                       VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <Label x:Name="MarketClockLabel"
                   Grid.Column="1"
                   FontAttributes="Bold"
                   FontSize="10"
                   HorizontalTextAlignment="End"
                   LineBreakMode="NoWrap" />
            <Label x:Name="LocalClockLabel"
                   IsVisible="False"
                   FontSize="10"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                   HorizontalTextAlignment="End"
                   LineBreakMode="NoWrap" />
        </Grid>
    </Border>
</ContentView>
