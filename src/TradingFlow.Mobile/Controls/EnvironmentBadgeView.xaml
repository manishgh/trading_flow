<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TradingFlow.Mobile.Controls.EnvironmentBadgeView"
             SemanticProperties.Description="Paper trading environment">
    <Border Padding="9,5"
            BackgroundColor="{StaticResource SurfaceSubtle}"
            Stroke="{StaticResource BorderDefault}"
            StrokeShape="RoundRectangle 6"
            HorizontalOptions="End"
            VerticalOptions="Center">
        <HorizontalStackLayout Spacing="6">
            <BoxView WidthRequest="8"
                     HeightRequest="8"
                     CornerRadius="4"
                     Color="{StaticResource StateWarning}"
                     VerticalOptions="Center" />
            <Label Text="PAPER"
                   FontAttributes="Bold"
                   FontSize="12"
                   TextColor="{StaticResource StateWarning}"
                   VerticalTextAlignment="Center" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
