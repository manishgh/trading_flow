@page
@model TradingFlow.Web.Pages.OrdersModel
@using TradingFlow.Domain.Orders
@{
    ViewData["Title"] = "Orders";
    ViewData["MainClass"] = "shell-flush orders-page";

    static string StateLabel(OrderState state) => state switch
    {
        OrderState.PartiallyFilled => "Partially filled",
        OrderState.CancelPending => "Cancel pending",
        _ => state.ToString()
    };
    static string PriceSummary(TradingFlow.Domain.Persistence.OrderActivitySnapshot item) =>
        item.FillPrice is { } fill ? $"Fill {fill:C2}" :
        item.LimitPrice is { } limit ? $"Limit {limit:C2}" :
        item.StopPrice is { } stop ? $"Stop {stop:C2}" : "Market";

    // One list drives the header row so the sortable and fixed columns stay in the
    // same order as the body cells. A null key means the column carries no ordering.
    var orderColumns = new (string? Key, string Label, string? Class)[]
    {
        ("updated", "Updated", null),
        ("symbol", "Symbol", null),
        ("status", "Status", null),
        ("requested", "Requested", "num"),
        ("filled", "Filled", "num"),
        (null, "Order", null),
        (null, "Price", null),
        (null, "Strategy", null),
        (null, "Client order", null)
    };
}

@functions {
    // Working states are the ones that still need a decision, so they carry the
    // accent. Terminal states are neutral or outlined - nothing to act on.
    static string StateTagClass(OrderState state) => state switch
    {
        OrderState.Intent or OrderState.Submitted or OrderState.Acked
            or OrderState.PartiallyFilled or OrderState.CancelPending => "tag tag-accent",
        OrderState.Filled => "tag tag-neutral",
        _ => "tag tag-outline"
    };

    // A partial fill is a state that needs a decision, so the quantity is marked
    // rather than left to be spotted against the requested figure.
    static string FilledClass(TradingFlow.Domain.Persistence.OrderActivitySnapshot item)
    {
        var filled = item.FilledQuantity ?? 0m;
        if (filled <= 0m) return "unknown";
        return filled < item.RequestedQuantity ? "accent-note" : null!;
    }
}

<div class="page-head">
    <div>
        <span class="eyebrow">Broker lifecycle</span>
        <h1>Orders</h1>
        <p class="standfirst">
            Durable order state from intent through terminal state. Replace is cancel plus a fresh
            reviewed ticket, so an amended order is re-checked against quote, spread and session.
        </p>
    </div>
    <a class="btn btn-secondary btn-md" asp-page="/RunningTrades" asp-route-env="@Model.Env">Open positions</a>
</div>

@if (!String.IsNullOrWhiteSpace(Model.StatusMessage))
{
    @* The banner is the outcome of a cancel round-trip. It carries tabindex="-1" so
       orders.js can move focus here instead of leaving it on <body> after the POST. *@
    <div class="status-banner" role="status" tabindex="-1" data-orders-banner>@Model.StatusMessage</div>
}
@if (!String.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="status-banner error" role="alert" tabindex="-1" data-orders-banner>@Model.ErrorMessage</div>
}

<section class="metric-strip metric-strip-lg orders-summary" data-orders-page data-filter="@Model.Filter"
         aria-label="Order summary">
    <div>
        <span class="micro-label">Working</span>
        <strong class="metric-value orders-working">@Model.WorkingCount</strong>
    </div>
    <div>
        <span class="micro-label">Filled</span>
        <strong class="metric-value">@Model.FilledCount</strong>
    </div>
    <div>
        <span class="micro-label">Rejected</span>
        <strong class="metric-value orders-rejected">@Model.RejectedCount</strong>
    </div>
    <div>
        <span class="micro-label">Cancelled / expired</span>
        <strong class="metric-value unknown">@Model.ClosedCount</strong>
    </div>
    <div>
        <span class="micro-label">Total today</span>
        <strong class="metric-value">@(Model.WorkingCount + Model.FilledCount + Model.RejectedCount + Model.ClosedCount)</strong>
    </div>
</section>

<div class="orders-body">
    <div class="orders-controls">
        <nav class="tab-strip" aria-label="Order status filters">
            @foreach (var (key, label) in TradingFlow.Web.Pages.OrdersModel.Filters)
            {
                var active = Model.Filter == key;
                @* Tabs carry the sort state so narrowing the status never silently
                   discards the column the operator chose to order by. *@
                <a asp-page="/Orders" asp-route-filter="@key"
                   asp-route-sort="@Model.Sort"
                   asp-route-dir="@Model.Dir"
                   asp-route-env="@Model.Env"
                   aria-current="@(active ? "page" : null)">@label</a>
            }
        </nav>
        <p id="OrdersConnection" class="note" role="status" aria-live="polite" data-state="live">
            Latest persisted state · checking every 10 s
        </p>
    </div>

    @if (Model.Items.Count == 0)
    {
        <p class="empty-state" data-orders-empty>
            @Model.EmptyStateTitle @Model.EmptyStateHint
        </p>
        @if (Model.EmptyStateOffersAllFilter)
        {
            <a class="btn btn-secondary btn-md orders-empty-action" asp-page="/Orders" asp-route-filter="all"
               asp-route-sort="@Model.Sort" asp-route-dir="@Model.Dir"
               asp-route-env="@Model.Env">Show all orders</a>
        }
        else
        {
            <a class="btn btn-secondary btn-md orders-empty-action" asp-page="/TradeDesk" asp-route-env="@Model.Env">Open the desk</a>
        }
    }
    else
    {
        <div class="table-scroll" role="region" aria-label="Order lifecycle table" tabindex="0">
            <table class="grid-table orders-table">
                <thead>
                    <tr>
                        @foreach (var column in orderColumns)
                        {
                            <th scope="col" class="@column.Class" aria-sort="@(column.Key is null ? null : Model.AriaSortFor(column.Key))">
                                @if (column.Key is null)
                                {
                                    @column.Label
                                }
                                else
                                {
                                    <a class="sort-header"
                                       asp-page="/Orders"
                                       asp-route-filter="@Model.Filter"
                                       asp-route-env="@Model.Env"
                                       asp-route-sort="@column.Key"
                                       asp-route-dir="@Model.NextDirectionFor(column.Key)">@column.Label</a>
                                }
                            </th>
                        }
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody data-orders-body>
                    @foreach (var item in Model.Items)
                    {
                        <tr data-client-order-id="@item.ClientOrderId">
                            <td>
                                <time data-order-time datetime="@item.UpdatedAtUtc.ToUniversalTime().ToString("O")">
                                    @item.UpdatedAtUtc.ToUniversalTime().ToString("dd MMM HH:mm:ss") UTC
                                </time>
                                <span class="cell-sub" data-order-local-time></span>
                            </td>
                            <td>
                                <strong>@item.Symbol</strong>
                                <span class="cell-sub">@item.Side.ToUpperInvariant()</span>
                            </td>
                            <td><span class="@StateTagClass(item.State)" data-order-state>@StateLabel(item.State)</span></td>
                            <td class="num">@item.RequestedQuantity.ToString("0.####")</td>
                            <td class="num @FilledClass(item)" data-order-filled>@((item.FilledQuantity ?? 0m).ToString("0.####"))</td>
                            <td>@item.OrderType / @item.TimeInForce</td>
                            <td data-order-price>@PriceSummary(item)</td>
                            <td>@item.StrategyId</td>
                            <td class="mono order-identity">@item.ClientOrderId</td>
                            <td class="order-actions">
                                @if (TradingFlow.Web.Pages.OrdersModel.CanCancel(item) && Model.EnvironmentState.IsEnabled)
                                {
                                    @* The handler posts back to the page, so the view state the operator
                                       chose has to travel with the request; without these the re-render
                                       dropped back to the unsorted All tab. Plain name/value pairs, not
                                       asp-for: a tag helper would stamp one id onto every row. *@
                                    <form method="post" asp-page-handler="Cancel">
                                        <input type="hidden" name="brokerOrderId" value="@item.BrokerOrderId" />
                                        <input type="hidden" name="Env" value="@Model.Env" />
                                        <input type="hidden" name="Filter" value="@Model.Filter" />
                                        <input type="hidden" name="Sort" value="@Model.Sort" />
                                        <input type="hidden" name="Dir" value="@Model.Dir" />
                                        <button class="btn btn-danger btn-sm" type="submit"
                                                data-confirm="Cancel the working @item.Symbol order? The broker may still fill it before the cancel is acknowledged.">Cancel</button>
                                    </form>
                                    @* Replace is cancel plus a fresh reviewed ticket, so an amended
                                       order is re-checked against quote, spread, and session. *@
                                    <a class="btn btn-secondary btn-sm"
                                       asp-page="/OrderTicket"
                                       asp-route-ticker="@item.Symbol"
                                       asp-route-side="@item.Side.ToLowerInvariant()"
                                       asp-route-limitPrice="@item.LimitPrice"
                                       asp-route-env="@Model.Env"
                                       title="Replace opens a fresh reviewed ticket; it does not amend this order in place.">Replace</a>
                                }
                                else
                                {
                                    @* A terminal row says so rather than showing empty space, which
                                       reads as a control that failed to render. *@
                                    <span class="note orders-terminal">Terminal · no action</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <p class="note orders-footnote">
        Broker writes are idempotent and audited. An order keeps its client order id through a cancel.
    </p>
</div>

@section Scripts {
    <script src="~/js/orders.js" asp-append-version="true"></script>
}
