@page
@model TradingFlow.Web.Pages.OrdersModel
@using TradingFlow.Domain.Orders
@using TradingFlow.Web.Pages.Shared
@using TradingFlow.Web.Services.Wishlists
@{
    ViewData["Title"] = "Trading";
    ViewData["MainClass"] = "shell-flush orders-page execution-workspace";
    var status = Model.OperationalStatus;
    var portfolio = Model.Portfolio;
    var streamTickers = Model.StreamSymbols;

    static string StateLabel(OrderState state) => state switch
    {
        OrderState.PartiallyFilled => "Partially filled",
        OrderState.CancelPending => "Cancel pending",
        _ => state.ToString()
    };
    static string PriceSummary(TradingFlow.Domain.Persistence.OrderActivitySnapshot item) =>
        item.FillPrice is { } fill ? $"Fill {fill:C2}" :
        item.LimitPrice is { } limit ? $"Limit {limit:C2}" :
        item.StopPrice is { } stop ? $"Stop {stop:C2}" : "Market";

    // One list drives the header row so the sortable and fixed columns stay in the
    // same order as the body cells. A null key means the column carries no ordering.
    var orderColumns = new (string? Key, string Label, string? Class)[]
    {
        ("updated", "Updated", null),
        ("symbol", "Symbol", null),
        (null, "Last", "num"),
        ("status", "Status", null),
        ("requested", "Requested", "num"),
        ("filled", "Filled", "num"),
        (null, "Order", null),
        (null, "Price", null),
        (null, "Strategy", null),
        (null, "Client order", null)
    };
}

@functions {
    static string Money(decimal? value) => value is null ? "unknown" : value.Value.ToString("C2");

    static string SignedClass(decimal? value) =>
        value is null ? "value-signed flat" : value > 0 ? "value-signed up" : value < 0 ? "value-signed down" : "value-signed flat";

    static string SignedMoney(decimal? value) => value is null
        ? "—"
        : (value > 0 ? "+" : value < 0 ? "−" : String.Empty) + Math.Abs(value.Value).ToString("C2");

    static string SignedPercent(decimal? value) => value is null
        ? "—"
        : (value > 0 ? "+" : value < 0 ? "−" : String.Empty) + Math.Abs(value.Value).ToString("0.00") + "%";

    // Working states are the ones that still need a decision, so they carry the
    // accent. Terminal states are neutral or outlined - nothing to act on.
    static string StateTagClass(OrderState state) => state switch
    {
        OrderState.Intent or OrderState.Submitted or OrderState.Acked
            or OrderState.PartiallyFilled or OrderState.CancelPending => "tag tag-accent",
        OrderState.Filled => "tag tag-neutral",
        _ => "tag tag-outline"
    };

    // A partial fill is a state that needs a decision, so the quantity is marked
    // rather than left to be spotted against the requested figure.
    static string FilledClass(TradingFlow.Domain.Persistence.OrderActivitySnapshot item)
    {
        var filled = item.FilledQuantity ?? 0m;
        if (filled <= 0m) return "unknown";
        return filled < item.RequestedQuantity ? "accent-note" : null!;
    }
}

<div class="page-head">
    <div>
        <span class="eyebrow">Execution workspace</span>
        <h1>Trading</h1>
        <p class="standfirst">
            Your positions and orders. Open a ticket when you need it.
        </p>
    </div>
    <div class="orders-head-actions">
        <a class="btn btn-secondary btn-md" asp-page="/Desk" asp-route-env="@Model.Env">Open the desk</a>
        <a class="btn btn-secondary btn-md" href="#TradingPositions">Positions</a>
    </div>
</div>

@if (!String.IsNullOrWhiteSpace(Model.StatusMessage))
{
    @* The banner is the outcome of a cancel round-trip. It carries tabindex="-1" so
       orders.js can move focus here instead of leaving it on <body> after the POST. *@
    <div class="status-banner" role="status" tabindex="-1" data-orders-banner>@Model.StatusMessage</div>
}
@if (!String.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="status-banner error" role="alert" tabindex="-1" data-orders-banner>@Model.ErrorMessage</div>
}

@* The desk's account cells, so an order is placed knowing the session, the entry
   gate, the book and the buying power. Separate from the order counts, which
   orders.js keeps current in place. *@
<section class="metric-strip orders-account" aria-label="Session and account">
    <div>
        <span class="micro-label">Market session</span>
        <span class="metric-value" title="@status.MarketSessionDetail">@status.MarketSession</span>
    </div>
    <div class="@(status.AdmissionStatus == "allowed" ? null : "is-attention")">
        <span class="micro-label">Entry gate</span>
        <span class="metric-value" title="@status.AdmissionDetail">@status.AdmissionStatus</span>
    </div>
    <div data-orders-portfolio>
        <span class="micro-label">Portfolio · @(Model.Account.Available ? Model.Account.Holdings.Count + " open" : "unavailable")</span>
        <span class="metric-value">@Money(Model.Account.Available ? portfolio.MarketValue : null)</span>
        <span class="metric-detail">
            cost @Money(Model.Account.Available ? portfolio.CostBasis : null) ·
            <span class="@SignedClass(portfolio.UnrealizedPl)">@SignedMoney(Model.Account.Available ? portfolio.UnrealizedPl : null) (@SignedPercent(Model.Account.Available ? portfolio.UnrealizedPlPct : null))</span>
        </span>
    </div>
    <div>
        <span class="micro-label">Buying power</span>
        <span class="metric-value @(status.BuyingPower is null ? "unknown" : null)" title="@status.AccountDetail">@Money(status.BuyingPower)</span>
    </div>
</section>



<div class="orders-shell" data-orders-stream-tickers="@String.Join(",", streamTickers)">
<div class="orders-body">
    @if (Model.EnvironmentState.IsEnabled && Model.EnvironmentState.Environment == TradingFlow.Web.Services.TradingEnvironment.Paper)
    {
    <section id="TradingPositions" class="trading-positions" data-trading-positions data-read-at="@(Model.Account.Available ? Model.Account.ReadAtUtc.ToUniversalTime().ToString("O") : null)" data-env="@Model.Env" data-can-review="@Model.EnvironmentState.IsEnabled.ToString().ToLowerInvariant()" aria-labelledby="TradingPositionsTitle">
        <div class="execution-section-head">
            <div><span class="eyebrow">Account holdings</span><h2 id="TradingPositionsTitle">Positions <span class="execution-count" data-position-count>@(Model.Account.Available ? Model.Account.Holdings.Count.ToString() : "Unknown")</span></h2></div>
            <p class="note" data-position-status role="status" aria-live="polite" data-state="@(Model.Account.Available ? "loading" : "stale")">@Model.Account.Detail · @Model.Account.ReadAtUtc.ToUniversalTime().ToString("dd MMM HH:mm:ss") UTC</p>
        </div>
        <p class="note" data-position-empty hidden="@(Model.Account.Available && Model.Account.Holdings.Count > 0)">@(Model.Account.Available ? "No open positions in the account." : "Account holdings are unavailable. This does not mean the account has no positions.")</p>
        <div class="table-scroll" role="region" aria-label="Account positions" tabindex="0" hidden="@(!Model.Account.Available || Model.Account.Holdings.Count == 0)">
            <table class="grid-table trading-position-table">
                <thead><tr><th scope="col">Symbol</th><th scope="col" class="num">Quantity</th><th scope="col" class="num">Avg entry</th><th scope="col" class="num">Value</th><th scope="col" class="num">Open P/L</th><th scope="col">Broker protection</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody data-position-body>
                @if (Model.Account.Available)
                {
                    @foreach (var holding in Model.Account.Holdings)
                    {
                        <tr data-position-symbol="@holding.Symbol">
                            <td><strong>@holding.Symbol</strong></td>
                            <td class="num">@holding.Quantity.ToString("0.####")</td>
                            <td class="num">@Money(holding.AverageEntry)</td>
                            <td class="num">@Money(holding.MarketValue)</td>
                            <td class="num @SignedClass(holding.UnrealizedPl)">@SignedMoney(holding.UnrealizedPl)</td>
                            <td class="unknown">Checking broker protection…</td>
                            <td>
                                @if (Model.EnvironmentState.IsEnabled && holding.Quantity > 0)
                                {
                                    <a class="btn btn-secondary btn-sm" aria-haspopup="dialog" data-position-review asp-page="/Orders" asp-all-route-data='Model.RouteWith(("ticker", holding.Symbol), ("side", "sell"), ("limitPrice", null))'>Review</a>
                                }
                                else if (holding.Quantity < 0)
                                {
                                    <span class="note">Short position · close review unavailable</span>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <p class="note" data-position-protection-summary>Broker protection has not been read.</p>
    </section>
    }

    <div class="execution-section-head orders-journal-head"><div><span class="eyebrow">Broker lifecycle</span><h2>Orders</h2></div></div>
<section class="metric-strip metric-strip-lg orders-summary" data-orders-page data-filter="@Model.Filter"
         aria-label="Order summary">
    <div>
        <span class="micro-label">Working</span>
        <strong class="metric-value orders-working">@Model.WorkingCount</strong>
    </div>
    <div>
        <span class="micro-label">Filled</span>
        <strong class="metric-value">@Model.FilledCount</strong>
    </div>
    <div>
        <span class="micro-label">Rejected</span>
        <strong class="metric-value orders-rejected">@Model.RejectedCount</strong>
    </div>
    <div>
        <span class="micro-label">Cancelled / expired</span>
        <strong class="metric-value unknown">@Model.ClosedCount</strong>
    </div>
    <div>
        <span class="micro-label">Total today</span>
        <strong class="metric-value">@(Model.WorkingCount + Model.FilledCount + Model.RejectedCount + Model.ClosedCount)</strong>
    </div>
</section>
    @* A plain GET remains available without JavaScript; the popup opens locally when enabled. *@
    @if (Model.EnvironmentState.IsEnabled)
    {
    <form method="get" class="orders-new-order" role="search" aria-label="New order">
        <label for="OrdersNewTicker">New order</label>
        <input class="input input-mono" id="OrdersNewTicker" name="ticker" type="text" list="OrdersSymbolChoices"
               value="@Model.Ticker" autocomplete="off" autocapitalize="characters" spellcheck="false"
               pattern="[A-Za-z][A-Za-z0-9.\-]{0,14}" required placeholder="Symbol, e.g. MSFT" />
        <datalist id="OrdersSymbolChoices">
            @foreach (var symbol in Model.SymbolChoices)
            {
                <option value="@symbol"></option>
            }
        </datalist>
        <input type="hidden" name="filter" value="@(Model.Filter == "all" ? null : Model.Filter)" />
        <input type="hidden" name="sort" value="@Model.Sort" />
        <input type="hidden" name="dir" value="@Model.Dir" />
        <input type="hidden" name="env" value="@Model.Env" />
        <button class="btn btn-primary btn-md" type="submit">Open ticket</button>
    </form>
    }

    <div class="orders-controls">
        <nav class="tab-strip" aria-label="Order status filters">
            @foreach (var (key, label) in TradingFlow.Web.Pages.OrdersModel.Filters)
            {
                var active = Model.Filter == key;
                @* Tabs carry the sort state so narrowing the status never silently
                   discards the column the operator chose to order by. *@
                <a asp-page="/Orders" asp-all-route-data='Model.RouteWith(("filter", key))'
                   aria-current="@(active ? "page" : null)">@label</a>
            }
        </nav>
        <p id="OrdersConnection" class="note" role="status" aria-live="polite" data-state="live">
            Latest persisted state · checking every 10 s
        </p>
        <p id="OrdersQuoteState" class="note" data-state="idle">@(Model.StreamSymbols.Count == 0 ? "No working order to quote" : "Quotes connecting")</p>
    </div>

    @if (Model.Items.Count == 0)
    {
        <p class="empty-state" data-orders-empty>
            @Model.EmptyStateTitle @Model.EmptyStateHint
        </p>
        @if (Model.EmptyStateOffersAllFilter)
        {
            <a class="btn btn-secondary btn-md orders-empty-action" asp-page="/Orders"
               asp-all-route-data='Model.RouteWith(("filter", null))'>Show all orders</a>
        }
        else
        {
            <a class="btn btn-secondary btn-md orders-empty-action" asp-page="/Desk" asp-route-env="@Model.Env">Open the desk</a>
        }
    }
    else
    {
        <div class="table-scroll" data-orders-region role="region" aria-label="Order lifecycle table" tabindex="0">
            <table class="grid-table orders-table">
                <thead>
                    <tr>
                        @foreach (var column in orderColumns)
                        {
                            <th scope="col" class="@column.Class" aria-sort="@(column.Key is null ? null : Model.AriaSortFor(column.Key))">
                                @if (column.Key is null)
                                {
                                    @column.Label
                                }
                                else
                                {
                                    <a class="sort-header"
                                       asp-page="/Orders"
                                       asp-all-route-data='Model.RouteWith(("sort", column.Key), ("dir", Model.NextDirectionFor(column.Key)))'>@column.Label</a>
                                }
                            </th>
                        }
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody data-orders-body>
                    @foreach (var item in Model.Items)
                    {
                        var isSelected = Model.Ticker?.Equals(item.Symbol, StringComparison.OrdinalIgnoreCase) == true;
                        <tr data-client-order-id="@item.ClientOrderId" data-quote-row="@item.Symbol.ToUpperInvariant()"
                            aria-selected="@(isSelected ? "true" : null)">
                            <td>
                                <time data-order-time datetime="@item.UpdatedAtUtc.ToUniversalTime().ToString("O")">
                                    @item.UpdatedAtUtc.ToUniversalTime().ToString("dd MMM HH:mm:ss") UTC
                                </time>
                                <span class="cell-sub" data-order-local-time></span>
                            </td>
                            <td>
                                @* The symbol opens the popup ticket on it: the journal is where
                                   the next order for a name usually starts. *@
                                <a class="order-symbol" asp-page="/Orders"
                                   asp-all-route-data='Model.RouteWith(("ticker", item.Symbol), ("side", null), ("limitPrice", null))'
                                   aria-haspopup="dialog" aria-label="Open ticket for @item.Symbol"><strong>@item.Symbol</strong></a>
                                <span class="cell-sub">@item.Side.ToUpperInvariant()</span>
                            </td>
                            <td class="num"><span data-quote-field="mid">—</span></td>
                            <td><span class="@StateTagClass(item.State)" data-order-state>@StateLabel(item.State)</span></td>
                            <td class="num">@item.RequestedQuantity.ToString("0.####")</td>
                            <td class="num @FilledClass(item)" data-order-filled>@((item.FilledQuantity ?? 0m).ToString("0.####"))</td>
                            <td>@item.OrderType / @item.TimeInForce</td>
                            <td data-order-price>@PriceSummary(item)</td>
                            <td>@item.StrategyId</td>
                            <td class="mono order-identity">@item.ClientOrderId</td>
                            <td class="order-actions">
                                @if (TradingFlow.Web.Pages.OrdersModel.CanCancel(item) && Model.EnvironmentState.IsEnabled)
                                {
                                    @* The handler posts back to the page, so the view state the operator
                                       chose has to travel with the request; without these the re-render
                                       dropped back to the unsorted All tab. Plain name/value pairs, not
                                       asp-for: a tag helper would stamp one id onto every row. *@
                                    <form method="post" asp-page-handler="Cancel">
                                        <input type="hidden" name="idempotencyKey" value="@Guid.NewGuid().ToString("N")" />
                                        <input type="hidden" name="clientOrderId" value="@item.ClientOrderId" />
                                        <input type="hidden" name="Env" value="@Model.Env" />
                                        <input type="hidden" name="Filter" value="@Model.Filter" />
                                        <input type="hidden" name="Sort" value="@Model.Sort" />
                                        <input type="hidden" name="Dir" value="@Model.Dir" />
                                        <input type="hidden" name="Ticker" value="@Model.Ticker" />
                                        <button class="btn btn-danger btn-sm" type="submit"
                                                data-confirm="Cancel the working @item.Symbol order? The broker may still fill it before the cancel is acknowledged.">Cancel</button>
                                    </form>
                                    @if(Model.ReplacementClientIds.Contains(item.ClientOrderId)){
                                        <button class="btn btn-secondary btn-sm" type="button" data-replacement-order="@item.ClientOrderId">Replace</button>
                                    }
                                    @* A new ticket is a separate command; cancellation is explicit above. *@
                                    <a class="btn btn-secondary btn-sm"
                                       asp-page="/Orders"
                                       asp-all-route-data='Model.RouteWith(("ticker", item.Symbol), ("side", item.Side.ToLowerInvariant()), ("quantity", item.RequestedQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)), ("limitPrice", item.LimitPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)))'
                                       title="Open a new reviewed ticket. This does not cancel or amend the existing order." data-order-new-ticket aria-haspopup="dialog">New ticket</a>
                                }
                                else
                                {
                                    @* A terminal row says so rather than showing empty space, which
                                       reads as a control that failed to render. *@
                                    <span class="note orders-terminal">Terminal · no action</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <details class="orders-footnote execution-help">
        <summary>Cancel, replace &amp; new ticket</summary>
        <p class="note">Replace waits for a cancellation acknowledgment with zero fills before opening a fresh review. New ticket leaves the existing order active. Broker writes are idempotent and audited; cancellation keeps the client order ID.</p>
    </details>
</div>

</div>
@if (!Model.EnvironmentState.IsEnabled)
{
    <partial name="_EnvironmentLock" model="Model.EnvironmentState" />
}
else
{
    <span hidden data-order-popup-start="@Model.Ticker"></span>
    <partial name="_OrderPopup" />
}


<link rel="stylesheet" href="~/css/execution-workspace.css" asp-append-version="true" />

@section Scripts {
    <script src="~/js/trading-positions.js" asp-append-version="true" defer></script>
    <script src="~/js/order-replacement.js" asp-append-version="true" defer></script>
    <script src="~/js/orders.js" asp-append-version="true"></script>
    <script type="module" src="~/js/orders-quotes.js" asp-append-version="true"></script>
    <script src="~/js/order-popup.js" asp-append-version="true" defer></script>
}


@if (Model.EnvironmentState.IsEnabled)
{
    <button id="ReplacementResume" class="btn btn-secondary" type="button" hidden>Resume replacement review</button>
    <dialog id="ReplacementDialog" aria-labelledby="ReplacementTitle" data-operator-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
        <h2 id="ReplacementTitle">Cancel before replacement review</h2>
        <p id="ReplacementIdentity"></p>
        <p>Cancellation may race with fills. Wait for broker acknowledgment and zero cumulative fills. Review the new candidate or current position, quantity and prices separately.</p>
        <p id="ReplacementStatus" role="status"></p>
        <div class="actions"><button class="btn btn-danger" type="button" id="ReplacementCancel">Request cancellation</button>
        <button class="btn btn-secondary" type="button" id="ReplacementRefresh">Check acknowledgment</button>
        <a id="ReplacementReview" class="btn btn-primary" hidden>Open fresh reviewed ticket</a>
        <button class="btn btn-secondary" type="button" id="ReplacementRelease" hidden>End this replacement review</button>
        <button class="btn btn-secondary" type="button" id="ReplacementClose">Close</button></div>
    </dialog>
    <template data-order-cancel-template>
        <form method="post" action="/Orders?handler=Cancel">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Filter" value="@Model.Filter" />
            <input type="hidden" name="Env" value="@Model.Env" />
            <button type="submit" class="btn btn-danger btn-sm">Cancel</button>
        </form>
    </template>
}
