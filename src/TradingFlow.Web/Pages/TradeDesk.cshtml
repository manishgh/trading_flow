@page "/TradeDesk"
@using TradingFlow.Web.Pages.Shared
@using TradingFlow.Web.Services
@using TradingFlow.Web.Services.Wishlists
@using TradingFlow.Finviz
@model TradingFlow.Web.Pages.TradeDeskModel
@{
    ViewData["Title"] = "Candidates";
    ViewData["MainClass"] = "shell-flush desk-page";
    var selectedName = Model.Universe.Label;
    var portfolio = Model.Portfolio;
    var prep = Model.Preparation;
    var status = Model.OperationalStatus;
    var selected = Model.SelectedRow;
    var screener = Model.ScreenerResult;
    var hasRangeFilter = Model.MinPrice is not null || Model.MaxPrice is not null ||
        Model.MaxSpreadBps is not null || Model.MinChange is not null || Model.MaxChange is not null ||
        Model.MinVolumeZ20 is not null || Model.MaxVolumeZ20 is not null || !String.IsNullOrWhiteSpace(Model.Tracked);

    // The server renders every column and marks the ones that start hidden. The
    // chooser then reconciles the operator's stored preference over that baseline,
    // so a first paint without JavaScript still shows a sensible default grid.
    var startsHidden = TradeDeskModel.Columns
        .Where(column => !column.VisibleByDefault)
        .Select(column => column.Key)
        .ToHashSet(StringComparer.Ordinal);

    var selectedStrategy = Model.Strategies.FirstOrDefault(strategy =>
        strategy.Definition.StrategyId.Equals(Model.SelectedStrategyId, StringComparison.OrdinalIgnoreCase));
}

@functions {
    static string Money(decimal? value) => value is null ? "unknown" : value.Value.ToString("C2");
    static string Number(decimal? value, string format = "0.00") => value?.ToString(format) ?? "--";
    static string Percent(decimal? value) => value is null ? "--" : value.Value.ToString("P1");
    static string Clock(DateTimeOffset? value) => value is null ? "--" : $"{value.Value:HH:mm:ss} UTC";

    // Direction is glyph, sign and colour together - never colour alone. The
    // minus is U+2212 so figures line up in tabular numerals.
    static string SignedClass(decimal? value) =>
        value is null ? "value-signed flat" : value > 0 ? "value-signed up" : value < 0 ? "value-signed down" : "value-signed flat";

    static string Signed(decimal? value, string format = "0.00") => value is null
        ? "—"
        : (value > 0 ? "+" : value < 0 ? "−" : String.Empty) + Math.Abs(value.Value).ToString(format);

    static string SignedMoney(decimal? value) => value is null
        ? "—"
        : (value > 0 ? "+" : value < 0 ? "−" : String.Empty) + Math.Abs(value.Value).ToString("C2");

    static string SignedPercent(decimal? value) => value is null
        ? "—"
        : (value > 0 ? "+" : value < 0 ? "−" : String.Empty) + Math.Abs(value.Value).ToString("0.00") + "%";

    static string SourceLabel(string source) => source switch
    {
        "stockpulse" => "Stock Pulse",
        "wishlist" => "Wishlist",
        "manual" => "Manual",
        _ => source
    };

    // Change against the previous session close, with its date and price in the
    // title, so the reference is never implied. Unknown renders as a dash.
    static string ChangeText(decimal? change, decimal? pct) =>
        change is null || pct is null ? "—" : $"{Signed(change, "0.00")} ({SignedPercent(pct)})";

    static string ChangeTitle(AlpacaPreviousClose? close) => close is null
        ? "No previous close from Alpaca for this symbol."
        : $"Change vs the {close.SessionDate:dd MMM} close of {close.Close:C2}.";

    static string? PreviousCloseValue(AlpacaPreviousClose? close) =>
        close?.Close.ToString(System.Globalization.CultureInfo.InvariantCulture);

    static string ListsText(IReadOnlyList<string> lists) =>
        lists.Count == 0 ? "Not on a list" : String.Join(", ", lists);

    static string Verdict(bool hasSignal, bool hasQuote) =>
        hasSignal ? "OBSERVED SETUP" : hasQuote ? "WATCHING" : "NO QUOTE";

    static string ShortVerdict(bool hasSignal, bool hasQuote) =>
        hasSignal ? "SETUP" : hasQuote ? "WATCH" : "NO QUOTE";
}

@if (!Model.EnvironmentState.IsEnabled)
{
    <partial name="_EnvironmentLock" model="Model.EnvironmentState" />
    return;
}

@* The desk carries no visible page title - the design gives the screen to the
   grid and the chrome names it. The heading still exists for assistive tech, so
   the page has exactly one h1 like every other screen. *@
<div class="page-head"><div><h1>Candidates</h1><p>Review a strategy run, or explore your source symbols.</p></div></div>
<div class="view-switch" role="group" aria-label="Candidate view">
    <button type="button" data-desk-view="candidates" aria-pressed="true">Strategy candidates</button>
    <button type="button" data-desk-view="market" aria-pressed="false">Market explorer</button>
</div>
<div data-desk-panel="candidates"><partial name="_CandidateWorkflow" /></div>
<div data-desk-panel="market" hidden>
<div id="DeskConnectionAnnouncement" class="visually-hidden" role="status" aria-live="polite"></div>

@if (!String.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="status-banner" role="status">@Model.StatusMessage</div>
}
@if (!String.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="status-banner error" role="alert">@Model.ErrorMessage</div>
}

@* ===========================================================================
   1. Operational strip
   Seven cells, flat rather than collapsed. At seven it is still scannable, and
   the entry gate is the one an operator must not miss.
   =========================================================================== *@
<section class="metric-strip desk-operational" aria-label="Trading operational status">
    <div>
        <span class="micro-label">Environment</span>
        <span class="metric-value">@status.Environment · alpaca</span>
    </div>
    <div>
        <span class="micro-label">Market session</span>
        <span class="metric-value" title="@status.MarketSessionDetail">@status.MarketSession</span>
    </div>
    <div>
        <span class="micro-label">Quotes · feed</span>
        <span class="metric-value" id="DeskQuoteConnection" title="@status.QuoteDetail">@status.QuoteStatus · @status.QuoteFeed</span>
        <span class="metric-detail" id="DeskQuoteFreshness">@status.QuoteDetail</span>
    </div>
    <div>
        <span class="micro-label">Predictor</span>
        <span class="metric-value">@status.ModelStatus</span>
    </div>
    <div class="@(status.AdmissionStatus == "allowed" ? null : "is-attention")">
        <span class="micro-label">Entry gate</span>
        <span class="metric-value" title="@status.AdmissionDetail">@status.AdmissionStatus</span>
    </div>
    <div>
        <span class="micro-label">Open P/L · this view</span>
        <span class="metric-value @SignedClass(Model.TotalPl)">@SignedMoney(Model.TotalPl)</span>
    </div>
    @* Account-wide, not scoped to the view: the operator's whole book should be
       one glance away whichever list or screener is on screen. *@
    <div data-desk-portfolio>
        <span class="micro-label">Portfolio · @(Model.Account.Available ? Model.Account.Holdings.Count + " open" : "unavailable")</span>
        <span class="metric-value">@Money(Model.Account.Available ? portfolio.MarketValue : null)</span>
        <span class="metric-detail">
            cost @Money(Model.Account.Available ? portfolio.CostBasis : null) ·
            <span class="@SignedClass(portfolio.UnrealizedPl)">@SignedMoney(Model.Account.Available ? portfolio.UnrealizedPl : null) (@SignedPercent(Model.Account.Available ? portfolio.UnrealizedPlPct : null))</span>
        </span>
    </div>
    <div>
        <span class="micro-label">Buying power</span>
        @* Null renders as unknown. A placeholder number on a trading screen is
           worse than no number at all. *@
        <span class="metric-value @(status.BuyingPower is null ? "unknown" : null)"
              title="@status.AccountDetail">@Money(status.BuyingPower)</span>
    </div>
</section>

@* ===========================================================================
   2. Context row
   Hidden inputs carry source, sort, dir and env so filtering never drops the
   sort state an operator chose.
   =========================================================================== *@
@* The universe decides which symbols are on screen: every wishlist (default),
   one wishlist, or a screener's hits. Switching is a plain link so it survives
   reload and can be bookmarked like every other view state here. *@
<nav class="desk-universe-switch seg" aria-label="Universe">
    <a class="seg-opt" asp-page="/TradeDesk"
       asp-all-route-data='Model.RouteWith(("scope", null), ("screenerQuery", null), ("targetId", null), ("ticker", null))'
       aria-current="@(Model.IsScreenerScope ? null : "page")">Wishlists</a>
    <a class="seg-opt" asp-page="/TradeDesk"
       asp-all-route-data='Model.RouteWith(("scope", "screener"), ("id", null), ("ticker", null))'
       aria-current="@(Model.IsScreenerScope ? "page" : null)">Screener</a>
</nav>

<form method="get" class="desk-context" id="DeskFilterForm">
    @if (Model.IsScreenerScope)
    {
        <div class="field desk-universe-field">
            <label for="ScreenerPick">Screener</label>
            <select class="input" id="ScreenerPick" name="screenerQuery" data-auto-submit>
                <option value="" selected="@String.IsNullOrWhiteSpace(Model.ScreenerQuery)">Choose a screener…</option>
                @if (Model.ScreenerPresets.Count > 0)
                {
                    <optgroup label="My saved screens">
                        @foreach (var preset in Model.ScreenerPresets)
                        {
                            <option value="@preset.Name" selected="@(String.Equals(Model.ScreenerQuery?.Trim(), preset.Name, StringComparison.Ordinal))">@preset.Name@(preset.IsVerified ? " · verified" : "")</option>
                        }
                    </optgroup>
                }
                @foreach (var group in TradeDeskModel.SignalGroups)
                {
                    <optgroup label="Finviz · @group.Key">
                        @foreach (var signal in group)
                        {
                            var value = FinvizSignalCatalog.ToInput(signal);
                            <option value="@value" selected="@(String.Equals(Model.ScreenerQuery?.Trim(), value, StringComparison.OrdinalIgnoreCase))">@signal.Label</option>
                        }
                    </optgroup>
                }
                @if (!String.IsNullOrWhiteSpace(Model.ScreenerQuery) && !Model.ScreenerIsFromPicker)
                {
                    <option value="@Model.ScreenerQuery" selected>Custom · @Model.ScreenerQuery</option>
                }
            </select>
        </div>
        <input type="hidden" name="scope" value="screener" />
        <input type="hidden" name="targetId" value="@Model.TargetId" />
    }
    else
    {
        <div class="field desk-universe-field">
            <label for="WishlistSelect">Wishlist</label>
            <select class="input" id="WishlistSelect" name="id" data-auto-submit>
                @{
                    var everySymbol = DeskUniverse.ForAllWishlists(Model.Wishlists).Members.Count;
                }
                <option value="" selected="@(Model.SelectedWishlist is null)">All wishlists · @everySymbol symbols</option>
                @foreach (var wishlist in Model.Wishlists)
                {
                    <option value="@wishlist.Id" selected="@(Model.SelectedWishlist?.Id == wishlist.Id)">@wishlist.Name · @wishlist.Items.Count(item => item.Active)</option>
                }
            </select>
        </div>
    }
    <div class="field">
        <label for="StrategyId">Strategy context</label>
        <select class="input" id="StrategyId" name="strategyId" data-auto-submit>
            @foreach (var strategy in Model.Strategies)
            {
                var lifecycle = strategy.Lifecycle == TradingFlow.Domain.Strategies.StrategyLifecycleState.Research
                    ? "RESEARCH ONLY"
                    : strategy.Lifecycle.ToString().ToUpperInvariant();
                <option value="@strategy.Definition.StrategyId" selected="@(Model.SelectedStrategyId == strategy.Definition.StrategyId)">@strategy.Definition.StrategyName · @lifecycle</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="Search">Search</label>
        <input class="input" id="Search" name="search" type="search" value="@Model.Search"
               placeholder="Ticker or name" autocomplete="off" />
    </div>
    <input type="hidden" name="source" value="@Model.Source" />
    <input type="hidden" name="sort" value="@Model.Sort" />
    <input type="hidden" name="dir" value="@Model.Dir" />
    <input type="hidden" name="env" value="@Model.Env" />
    <input type="hidden" name="ticker" value="@Model.Ticker" />
    <div class="desk-context-actions">
        @if (Model.IsScreenerScope)
        {
            <button class="btn btn-secondary" type="submit" formmethod="post" formaction="?handler=SyncScreener">
                <partial name="_Icon" model='new IconModel("refresh-cw", 14)' />Refresh screener
            </button>
        }
        @* Administration lives on its own screen. The desk monitors and routes; it
           never edits the universe, so this is a link out rather than a form. *@
        <a class="btn btn-secondary" asp-page="/Wishlists" asp-route-id="@Model.SelectedWishlist?.Id">Manage wishlists</a>
    </div>
</form>

@if (Model.IsScreenerScope)
{
    @* A one-off Finviz URL or filter string, for a screen that is neither saved
       nor in the catalogue. Saving it by name happens on the Wishlists screen. *@
    <details class="desk-custom-screen" open="@(!String.IsNullOrWhiteSpace(Model.ScreenerQuery) && !Model.ScreenerIsFromPicker)">
        <summary>Custom Finviz query</summary>
        <form method="get" class="desk-custom-screen-form">
            <input type="hidden" name="scope" value="screener" />
            <input type="hidden" name="env" value="@Model.Env" />
            <input type="hidden" name="strategyId" value="@Model.StrategyId" />
            <input type="hidden" name="targetId" value="@Model.TargetId" />
            <label class="visually-hidden" for="CustomScreenerQuery">Finviz URL or filter query</label>
            <input class="input input-mono" id="CustomScreenerQuery" name="screenerQuery" type="text"
                   value="@(Model.ScreenerIsFromPicker ? null : Model.ScreenerQuery)" autocomplete="off"
                   placeholder="Finviz Elite URL, f=… filter string, or s=… signal" />
            <button class="btn btn-secondary" type="submit">Run screen</button>
        </form>
        @if (!String.IsNullOrWhiteSpace(Model.ScreenerQuery) && !Model.ScreenerIsFromPicker)
        {
            @* Finviz cannot list the screens saved in its own UI. Pasting one here,
               running it and saving it by name makes it pickable from then on. *@
            <form method="post" asp-page-handler="SaveScreener" asp-all-route-data="Model.RouteWith()" class="desk-custom-screen-form">
                <label class="visually-hidden" for="PresetName">Preset name</label>
                <input class="input" id="PresetName" name="presetName" type="text" maxlength="120" required
                       autocomplete="off" placeholder="Name this screen to save it" />
                <button class="btn btn-secondary" type="submit">Save as preset</button>
            </form>
        }
    </details>
}

@* ===========================================================================
   3. Screener result band - screener scope only. The hits are the rows below;
   this band says what the screen returned and offers to keep the new ones.
   =========================================================================== *@
@if (Model.IsScreenerScope && screener is not null)
{
    <section class="desk-screener-band @(screener.Succeeded ? null : "is-error")" aria-label="Screener result">
        <span class="desk-screener-scope-label">@Model.ScreenerDisplayName</span>
        @if (screener.Succeeded)
        {
            <span class="desk-screener-summary">
                @screener.Symbols.Count hit@(screener.Symbols.Count == 1 ? "" : "s"),
                @screener.NotInWishlist.Count not yet in @(Model.TargetWishlist?.Name ?? "a wishlist")
            </span>
            <span class="desk-screener-synced">Synced @screener.SyncedAtUtc.UtcDateTime.ToString("HH:mm:ss") UTC</span>
            @if (Model.Wishlists.Count > 0)
            {
                <form method="post" asp-page-handler="AddScreener" asp-all-route-data="Model.RouteWith()" class="desk-screener-add">
                    <label class="visually-hidden" for="ScreenerTarget">Add to wishlist</label>
                    <select class="input" id="ScreenerTarget" name="targetId">
                        @foreach (var wishlist in Model.Wishlists)
                        {
                            <option value="@wishlist.Id" selected="@(Model.TargetWishlist?.Id == wishlist.Id)">@wishlist.Name</option>
                        }
                    </select>
                    <button class="btn btn-primary btn-md" type="submit" disabled="@(screener.NotInWishlist.Count == 0)">
                        Add @screener.NotInWishlist.Count new to wishlist
                    </button>
                </form>
            }
        }
        else
        {
            <span class="desk-screener-summary">@screener.Error</span>
        }
    </section>
}
else if (Model.IsScreenerScope)
{
    <p class="empty-state desk-screener-empty">
        Choose one of your saved screens or a Finviz signal. Its hits become the monitored rows, with live quotes, news and any position you hold.
    </p>
}

@* ===========================================================================
   Preparation band. Preparation is the warmup service caching candles,
   indicators and news catalysts before a session needs them; the desk reads
   that state for every symbol on screen and can queue the ones that are not
   ready. The warmup service is a separate process, so its absence renders as
   unknown and never blocks the desk.
   =========================================================================== *@
<section class="desk-prep-band @(prep.Available ? null : "is-error")" aria-labelledby="DeskPrepHeading" data-desk-preparation>
    <h2 id="DeskPrepHeading" class="desk-prep-title">Market-data warmup</h2>
    <span class="desk-prep-session" title="@status.MarketSessionDetail">Session · @status.MarketSession</span>
    @if (prep.Available)
    {
        <span class="desk-prep-counts">
            <span>@prep.Count(DeskPreparationState.Ready) ready</span>
            <span>@prep.Count(DeskPreparationState.Queued) queued</span>
            <span>@prep.Count(DeskPreparationState.Stale) stale</span>
            <span>@prep.Count(DeskPreparationState.Failed) failed</span>
            <span>@prep.Count(DeskPreparationState.NotPrepared) not prepared</span>
        </span>
        @if (prep.LatestRun is { } run)
        {
            <span class="desk-prep-run">
                Last run @run.Status · @run.StartedAtUtc.UtcDateTime.ToString("dd/MM HH:mm") UTC ·
                @run.SucceededTickerCount/@run.RequestedTickerCount ok
            </span>
        }
        <form method="post" asp-page-handler="Prepare" asp-all-route-data="Model.RouteWith()">
            <button class="btn btn-primary btn-md" type="submit" disabled="@(prep.NeedingPreparation.Count == 0)">
                @(prep.NeedingPreparation.Count == 0 ? "All prepared" : $"Prepare {prep.NeedingPreparation.Count} symbol{(prep.NeedingPreparation.Count == 1 ? "" : "s")}")
            </button>
        </form>
    }
    else
    {
        <span class="desk-prep-counts">@prep.Error</span>
    }
    <a class="btn btn-secondary btn-md" asp-page="/Warmup">Warmup details</a>
</section>

@* ===========================================================================
   4. View controls
   =========================================================================== *@
<section class="desk-view-controls" aria-label="View controls">
    <nav class="tab-strip" aria-label="Desk views">
        @foreach (var (key, label) in TradeDeskModel.Filters)
        {
            var active = Model.Source.Equals(key, StringComparison.OrdinalIgnoreCase);
            <a asp-page="/TradeDesk"
               asp-all-route-data='Model.RouteWith(("source", key))'
               aria-current="@(active ? "page" : null)">@label<span class="count">@Model.CountFor(key)</span></a>
        }
    </nav>
    <nav class="tab-strip" aria-label="Evidence quick filters">
        <a asp-page="/TradeDesk" asp-all-route-data='Model.RouteWith(("catalystOnly", "true"), ("pageNumber", null))'>Observed catalyst</a>
        <a asp-page="/TradeDesk" asp-all-route-data='Model.RouteWith(("maxEarningsDays", "0"), ("pageNumber", null))'>Earnings today · stored</a>
        <a asp-page="/TradeDesk" asp-all-route-data='Model.RouteWith(("catalystOnly", null), ("maxEarningsDays", null), ("pageNumber", null))'>Clear catalyst / earnings</a>
    </nav>
    <span class="note">@selectedName · @Model.MatchingCount of @Model.UnfilteredCount symbols · @Model.Rows.Count on this page · ranked on @Model.DeskHorizon weights @Model.RankConfig.WeightsVersion</span>
    <div class="desk-view-options">
        <div class="seg" role="group" aria-label="Layout" data-desk-layout-group>
            <button type="button" class="seg-opt" data-desk-layout="rail" aria-pressed="true">Grid + rail</button>
            <button type="button" class="seg-opt" data-desk-layout="focus" aria-pressed="false">Ladder + focus</button>
        </div>
        <div class="seg" role="group" aria-label="Row density" data-desk-density-group>
            <button type="button" class="seg-opt" data-desk-density="comfortable" aria-pressed="true">Comfortable</button>
            <button type="button" class="seg-opt" data-desk-density="compact" aria-pressed="false">Compact</button>
        </div>
        <div class="check-strip" data-desk-column-chooser>
            @foreach (var column in TradeDeskModel.OptionalColumns)
            {
                <button type="button" class="check-chip" data-desk-column-toggle value="@column.Key"
                        aria-pressed="@(column.VisibleByDefault ? "true" : "false")"
                        title="@column.Description">
                    <partial name="_Icon" model='new IconModel("check", 13)' />@column.Label
                </button>
            }
        </div>
        <details class="desk-advanced" open="@hasRangeFilter">
            <summary>Market filters@(hasRangeFilter ? " · on" : "")</summary>
            <div class="desk-range-grid">
                <div class="field">
                    <label for="MinPrice">Min price</label>
                    <input class="input" id="MinPrice" form="DeskFilterForm" name="minPrice" type="number" step="0.01" min="0" value="@Model.MinPrice" />
                </div>
                <div class="field">
                    <label for="MaxPrice">Max price</label>
                    <input class="input" id="MaxPrice" form="DeskFilterForm" name="maxPrice" type="number" step="0.01" min="0" value="@Model.MaxPrice" />
                </div>
                <div class="field">
                    <label for="MaxSpreadBps">Max spread (bps)</label>
                    <input class="input" id="MaxSpreadBps" form="DeskFilterForm" name="maxSpreadBps" type="number" step="1" min="0" value="@Model.MaxSpreadBps" />
                </div>
                <div class="field"><label for="MinChange">Min change %</label><input class="input" id="MinChange" form="DeskFilterForm" name="minChange" type="number" step="0.01" value="@Model.MinChange" /></div>
                <div class="field"><label for="MaxChange">Max change %</label><input class="input" id="MaxChange" form="DeskFilterForm" name="maxChange" type="number" step="0.01" value="@Model.MaxChange" /></div>
                <div class="field"><label for="MinVolumeZ20">Min volume Z20</label><input class="input" id="MinVolumeZ20" form="DeskFilterForm" name="minVolumeZ20" type="number" step="0.1" value="@Model.MinVolumeZ20" /></div>
                <div class="field"><label for="MaxVolumeZ20">Max volume Z20</label><input class="input" id="MaxVolumeZ20" form="DeskFilterForm" name="maxVolumeZ20" type="number" step="0.1" value="@Model.MaxVolumeZ20" /></div>
                <div class="field"><label for="Tracked">Tracked position</label><select class="input" id="Tracked" form="DeskFilterForm" name="tracked"><option value="all" selected="@(String.IsNullOrEmpty(Model.Tracked) || Model.Tracked == "all")">All</option><option value="tracked" selected="@(Model.Tracked == "tracked")">Tracked</option><option value="untracked" selected="@(Model.Tracked == "untracked")">Untracked</option></select></div>
                <div class="field"><label for="DeskPageSize">Rows per page</label><select class="input" id="DeskPageSize" form="DeskFilterForm" name="pageSize">@foreach(var size in new[]{25,50,100}){<option value="@size" selected="@(Model.PageSize == size)">@size</option>}</select></div>
                <div class="field"><label for="Sector">Sector · Finviz</label><input class="input" id="Sector" name="sector" form="DeskFilterForm" type="text" maxlength="120" value="@Model.Sector" /></div>
                <div class="field"><label for="MinMarketCap">Min cap · USD millions</label><input class="input" id="MinMarketCap" name="minMarketCap" form="DeskFilterForm" type="number" min="0" step="0.01" value="@Model.MinMarketCap" /></div>
                <div class="field"><label for="MaxMarketCap">Max cap · USD millions</label><input class="input" id="MaxMarketCap" name="maxMarketCap" form="DeskFilterForm" type="number" min="0" step="0.01" value="@Model.MaxMarketCap" /></div>
                <div class="field"><label for="MinVolume">Min completed daily volume</label><input class="input" id="MinVolume" name="minVolume" form="DeskFilterForm" type="number" min="0" step="1" value="@Model.MinVolume" /></div>
                <div class="field"><label for="MinRvol">Min daily RVOL · SIP</label><input class="input" id="MinRvol" name="minRvol" form="DeskFilterForm" type="number" min="0" step="0.01" value="@Model.MinRvol" /></div>
                <div class="field"><label for="MaxRvol">Max daily RVOL · SIP</label><input class="input" id="MaxRvol" name="maxRvol" form="DeskFilterForm" type="number" min="0" step="0.01" value="@Model.MaxRvol" /></div>
                <div class="field"><label for="MinAtrPercent">Min daily ATR %</label><input class="input" id="MinAtrPercent" name="minAtrPercent" form="DeskFilterForm" type="number" min="0" step="0.01" value="@Model.MinAtrPercent" /></div>
                <div class="field"><label for="MaxAtrPercent">Max daily ATR %</label><input class="input" id="MaxAtrPercent" name="maxAtrPercent" form="DeskFilterForm" type="number" min="0" step="0.01" value="@Model.MaxAtrPercent" /></div>
                <div class="field"><label for="MinGap">Min completed daily gap %</label><input class="input" id="MinGap" name="minGap" form="DeskFilterForm" type="number" step="0.01" value="@Model.MinGap" /></div>
                <div class="field"><label for="MaxGap">Max completed daily gap %</label><input class="input" id="MaxGap" name="maxGap" form="DeskFilterForm" type="number" step="0.01" value="@Model.MaxGap" /></div>
                <div class="field"><label for="MinVwapDistance">Min session VWAP distance %</label><input class="input" id="MinVwapDistance" name="minVwapDistance" form="DeskFilterForm" type="number" step="0.01" value="@Model.MinVwapDistance" /></div>
                <div class="field"><label for="MaxVwapDistance">Max session VWAP distance %</label><input class="input" id="MaxVwapDistance" name="maxVwapDistance" form="DeskFilterForm" type="number" step="0.01" value="@Model.MaxVwapDistance" /></div>
                <div class="field"><label for="MinRsi">Min daily RSI14</label><input class="input" id="MinRsi" name="minRsi" form="DeskFilterForm" type="number" min="0" step="0.01" value="@Model.MinRsi" /></div>
                <div class="field"><label for="MaxRsi">Max daily RSI14</label><input class="input" id="MaxRsi" name="maxRsi" form="DeskFilterForm" type="number" min="0" step="0.01" value="@Model.MaxRsi" /></div>
                <div class="field"><label for="MaxEarningsDays">Earnings within NY days · stored</label><input class="input" id="MaxEarningsDays" name="maxEarningsDays" form="DeskFilterForm" type="number" min="0" step="1" value="@Model.MaxEarningsDays" /></div>
                <div class="field"><label for="CatalystOnly">Observed catalyst only</label><select class="input" id="CatalystOnly" name="catalystOnly" form="DeskFilterForm"><option value="" selected="@(Model.CatalystOnly != true)">All / unknown included</option><option value="true" selected="@(Model.CatalystOnly == true)">Observed catalyst</option></select></div>
                <div class="field"><label for="SignalState">Signal state</label><select class="input" id="SignalState" name="signalState" form="DeskFilterForm"><option value="all" selected="@(String.IsNullOrEmpty(Model.SignalState) || Model.SignalState == "all")">All</option><option value="signal" selected="@(Model.SignalState == "signal")">Signal</option><option value="none" selected="@(Model.SignalState == "none")">No signal</option></select></div>
                <button class="btn btn-secondary" type="submit" form="DeskFilterForm">Apply filters</button>
            </div>
            <p class="note">Unknown values do not pass numeric bounds. Volume Z20 is advisory and is not relative volume. Daily volume, RVOL, ATR14, RSI14 and gap use completed SIP/all daily observations; session VWAP uses completed warm 1m state. Sector/cap come from available Finviz exports or stored earnings cap data. Missing calendar/catalyst coverage remains unknown; these display filters never authorize trading. Tracked positions are application trade records.</p>
        </details>
        <div class="field"><label for="DeskPreset">My filter presets</label><select class="input" id="DeskPreset"><option value="">Choose preset</option></select></div>
        <div class="field"><label for="DeskPresetName">Preset name</label><input class="input" id="DeskPresetName" maxlength="40" /></div>
        <button class="btn btn-secondary" type="button" id="DeskPresetSave">Save filters</button>
        <button class="btn btn-secondary" type="button" id="DeskPresetDelete">Delete preset</button>
        <p class="note" role="status" id="DeskPresetStatus"></p>
    </div>
</section>
<nav class="pagination" aria-label="Market list pages">
    @if(Model.PageNumber > 1){<a asp-page="/TradeDesk" asp-all-route-data='Model.RouteWith(("pageNumber", (Model.PageNumber-1).ToString()))'>Previous</a>}
    <span>Page @Model.PageNumber of @Model.PageCount · at most 100 rows per page</span>
    @if(Model.PageNumber < Model.PageCount){<a asp-page="/TradeDesk" asp-all-route-data='Model.RouteWith(("pageNumber", (Model.PageNumber+1).ToString()))'>Next</a>}
</nav>

@* ===========================================================================
   5 & 6. Shell
   Both layouts are rendered and one is hidden. The layout choice is an operator
   preference reconciled from localStorage over the server default, so switching
   costs no round trip and no loss of scroll position.
   =========================================================================== *@
@* ===========================================================================
   Phone treatment - screen 05, as a breakpoint of this screen rather than a
   second implementation of the same evidence.

   Three levels and one back path, carried in the query string like every other
   view state here: no ticker is the list, a ticker is the evidence, and
   ticket=true is the ticket. A reload lands where the operator was.
   =========================================================================== *@
<section class="desk-mobile-summary metric-strip" aria-label="Desk summary">
    <div>
        <span class="micro-label">Open P/L</span>
        <span class="metric-value @SignedClass(Model.TotalPl)">@SignedMoney(Model.TotalPl)</span>
    </div>
    <div>
        <span class="micro-label">Observed setups</span>
        <span class="metric-value">@Model.CountFor("signal")</span>
    </div>
    <div class="@(status.AdmissionStatus == "allowed" ? null : "is-attention")">
        <span class="micro-label">Entry gate</span>
        <span class="metric-value">@status.AdmissionStatus</span>
    </div>
</section>

<nav class="desk-mobile-tabs" aria-label="Desk views">
    @* Four tabs fit a 320px phone. News and preparation are desktop views: the
       phone has no preparation band and keeps news in the symbol level. *@
    @foreach (var (key, label) in TradeDeskModel.Filters.Where(filter => filter.Key is not ("news" or "prep")))
    {
        var active = Model.Source.Equals(key, StringComparison.OrdinalIgnoreCase);
        <a asp-page="/TradeDesk"
           asp-all-route-data='Model.RouteWith(("source", key), ("ticker", null))'
           aria-current="@(active ? "page" : null)">@label<span class="count">@Model.CountFor(key)</span></a>
    }
</nav>

@if (selected is not null)
{
    <a class="desk-mobile-back"
       asp-page="/TradeDesk"
       asp-all-route-data='Model.RouteWith(("ticker", Model.Ticket ? Model.Ticker : null))'>
        <partial name="_Icon" model='new IconModel("chevron-left", 16)' />
        @(Model.Ticket ? $"{selected.Ticker} evidence" : "All markets")
    </a>
}

<div class="desk-mobile-list" aria-label="Ranked markets">
    @foreach (var ranked in Model.Rows)
    {
        var row = ranked.Row;
        var isSelected = selected?.Ticker.Equals(row.Ticker, StringComparison.OrdinalIgnoreCase) == true;
        <a class="desk-mobile-row @(isSelected ? "is-selected" : null)"
           data-symbol-row data-symbol="@row.Ticker.ToUpperInvariant()"
           data-quote-row="@row.Ticker.ToUpperInvariant()"
           asp-page="/TradeDesk"
           asp-all-route-data='Model.RouteWith(("ticker", row.Ticker))'>
            <span class="desk-mobile-line">
                <span class="desk-mobile-identity">
                    <strong>@row.Ticker</strong>
                    <span class="desk-mobile-name">@row.DisplayName</span>
                </span>
                <span class="desk-mobile-quote">
                    <strong data-quote-field="mid">@row.Quote.DisplayPrice</strong>
                    <span class="@SignedClass(row.Trade?.UnrealizedPlPct)">@(row.Trade is null ? "—" : SignedPercent(row.Trade.UnrealizedPlPct))</span>
                </span>
            </span>
            <span class="desk-mobile-line">
                <span class="desk-mobile-verdict">
                    <span class="tag @(row.HasSignal ? "tag-accent" : "tag-neutral")">@Verdict(row.HasSignal, row.HasQuote)</span>
                    <span class="@ranked.AgreementCssClass">@ranked.AgreementLabel</span>
                </span>
                <span class="@SignedClass(row.Trade?.UnrealizedPl)">@(row.Trade is null ? "—" : SignedMoney(row.Trade.UnrealizedPl))</span>
            </span>
            <span class="desk-mobile-reason">@row.EligibilityReason</span>
        </a>
    }
    <p class="note desk-mobile-note">
        Rows are read-only. Tap a symbol to inspect its evidence and open a reviewed ticket.
    </p>
</div>

@if (selected is not null && !Model.Ticket)
{
    @* Floating action. It opens the ticket; it never submits one. *@
    <a class="btn btn-primary desk-mobile-action"
       asp-page="/TradeDesk"
       asp-all-route-data='Model.RouteWith(("ticker", selected.Ticker), ("ticket", "true"))'>
        @(selected.Row.Trade is null ? $"Review protected buy · {selected.Ticker}" : $"Open ticket · {selected.Ticker}")
    </a>
}

<nav class="desk-mobile-tabbar" aria-label="Application">
    <a asp-page="/TradeDesk" asp-route-env="@Model.Env" aria-current="page">
        <partial name="_Icon" model='new IconModel("area-chart", 19)' />Desk
    </a>
    <a asp-page="/RunningTrades" asp-route-env="@Model.Env">
        <partial name="_Icon" model='new IconModel("briefcase", 19)' />Positions
    </a>
    <a asp-page="/Orders" asp-route-env="@Model.Env">
        <partial name="_Icon" model='new IconModel("arrow-right", 19)' />Orders
    </a>
    <a asp-page="/Earnings">
        <partial name="_Icon" model='new IconModel("calendar", 19)' />Earnings
    </a>
    <a asp-page="/News" asp-route-env="@Model.Env">
        <partial name="_Icon" model='new IconModel("bell", 19)' />Alerts
    </a>
</nav>

@* The live streams follow the exact symbols rendered here - every wishlist plus
   held positions, one wishlist, or a screener's hits - not a wishlist id. *@
<section class="desk-shell" data-desk-root data-layout="rail" data-mobile-level="@Model.MobileLevel"
         data-stream-tickers="@String.Join(",", Model.Rows.Select(row => row.Ticker).Concat(Model.Ticker is null ? Array.Empty<string>() : new[]{Model.Ticker}).Distinct(StringComparer.OrdinalIgnoreCase))"
         data-operator-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" data-environment="@(String.Equals(Model.Env, "live", StringComparison.OrdinalIgnoreCase) ? "live" : "paper")"
         data-selected-ticker="@Model.Ticker">

    @* --- Layout B: symbol ladder ------------------------------------------ *@
    <nav class="desk-ladder" aria-label="Symbol ladder" data-desk-ladder hidden>
        <div class="desk-ladder-head">Ranked universe</div>
        @foreach (var ranked in Model.Rows)
        {
            var row = ranked.Row;
            var isSelected = selected?.Ticker.Equals(row.Ticker, StringComparison.OrdinalIgnoreCase) == true;
            <a class="desk-ladder-row @(isSelected ? "is-selected" : null)"
               asp-page="/TradeDesk"
               asp-all-route-data='Model.RouteWith(("ticker", row.Ticker))'
               aria-current="@(isSelected ? "true" : null)">
                <span class="ladder-line">
                    <strong>@row.Ticker</strong>
                    <span data-quote-field="mid">@row.Quote.DisplayPrice</span>
                </span>
                <span class="ladder-line ladder-sub">
                    <span class="ladder-verdict">@ShortVerdict(row.HasSignal, row.HasQuote)</span>
                    <span class="@SignedClass(row.Trade?.UnrealizedPlPct)">@(row.Trade is null ? "—" : SignedPercent(row.Trade.UnrealizedPlPct))</span>
                </span>
            </a>
        }
    </nav>

    @* --- Layout A: market grid -------------------------------------------- *@
    <div class="desk-main" data-desk-grid data-bulk-form>
        <div class="actions" data-bulk-bar hidden><span><span data-bulk-count>0</span> selected on this page</span>
            <button class="btn btn-secondary" type="button" data-group-action="add">Add to group</button>
            @if(Model.SelectedWishlist is not null && !Model.IsScreenerScope){
                <button class="btn btn-secondary" type="button" data-group-action="copy" data-source-id="@Model.SelectedWishlist.Id">Copy to group</button>
                <button class="btn btn-secondary" type="button" data-group-action="move" data-source-id="@Model.SelectedWishlist.Id">Move to group</button>
                <button class="btn btn-secondary" type="button" data-group-action="tag" data-source-id="@Model.SelectedWishlist.Id">Tag</button>
                <button class="btn btn-secondary" type="button" data-group-action="untag" data-source-id="@Model.SelectedWishlist.Id">Remove tag</button>
                <button class="btn btn-danger" type="button" data-group-action="remove" data-source-id="@Model.SelectedWishlist.Id">Review removal</button>
            }
            <button class="btn btn-secondary" type="button" data-bulk-clear>Clear selection</button>
        </div>
        @if (Model.Rows.Count == 0)
        {
            <p class="empty-state" data-desk-empty>
                @(Model.IsScreenerScope
                    ? "No symbols in this view. Choose a screener, or check the screener result above."
                    : "No symbols match this view. Change the view, clear the search, or manage the selected wishlist.")
            </p>
        }
        else
        {
            <div class="table-scroll" role="region" aria-label="Ranked markets" tabindex="0" data-desk-table>
                <table class="grid-table trade-desk-table" data-density="comfortable">
                    <thead>
                        <tr>
                            <th scope="col" class="select-column"><input type="checkbox" data-bulk-toggle-all aria-label="Select this page" /></th>
                            @foreach (var column in TradeDeskModel.Columns)
                            {
                                <th scope="col" class="@column.CssClass @(column.Numeric ? "num" : null)"
                                    data-column="@column.Key"
                                    hidden="@startsHidden.Contains(column.Key)"
                                    aria-sort="@Model.AriaSortFor(column.Key)">
                                    <a class="sort-header"
                                       asp-page="/TradeDesk"
                                       asp-all-route-data='Model.RouteWith(("sort", column.Key), ("dir", Model.NextDirectionFor(column.Key)))'>@column.Label</a>
                                </th>
                            }
                            <th scope="col" class="action-column"><span class="visually-hidden">Select</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ranked in Model.Rows)
                        {
                            var row = ranked.Row;
                            var isSelected = selected?.Ticker.Equals(row.Ticker, StringComparison.OrdinalIgnoreCase) == true;
                            <tr data-symbol-row data-symbol="@row.Ticker.ToUpperInvariant()"
                                data-quote-row="@row.Ticker.ToUpperInvariant()"
                                aria-selected="@(isSelected ? "true" : null)">
                                @* Which lists hold the symbol rides under the name rather than
                                   in a column of its own: in the all-wishlists view it is how a
                                   row says why it is on screen, without taking grid width. *@
                                <td class="select-column"><input type="checkbox" value="@row.Ticker" data-bulk-item aria-label="Select @row.Ticker" /></td>
                                <td class="market-cell" data-column="ticker">
                                    <strong class="market-symbol">@row.Ticker</strong>
                                    <span class="cell-sub">@row.DisplayName</span>
                                    <span class="cell-sub market-lists @(row.IsPositionOnly ? "is-position-only" : null)" title="@ListsText(row.Lists)">@ListsText(row.Lists)</span>
                                </td>
                                @* Change against the previous session close from Alpaca's
                                   snapshot. Unknown stays unknown rather than borrowing the
                                   position's P/L, which would read as a price move it is not.
                                   The desk script recomputes it on every live quote. *@
                                <td class="num" data-column="price">
                                    <strong data-quote-field="mid">@row.Quote.DisplayPrice</strong>
                                    <span class="cell-sub @SignedClass(row.ChangePct)" data-change-field
                                          data-prev-close="@PreviousCloseValue(row.PreviousClose)"
                                          title="@ChangeTitle(row.PreviousClose)">@ChangeText(row.Change, row.ChangePct)</span>
                                </td>
                                <td class="num" data-column="change" hidden="@startsHidden.Contains("change")">
                                    <span class="@SignedClass(row.ChangePct)" data-change-field data-change-mode="pct"
                                          data-prev-close="@PreviousCloseValue(row.PreviousClose)"
                                          title="@ChangeTitle(row.PreviousClose)">@SignedPercent(row.ChangePct)</span>
                                </td>
                                <td class="quote-cell" data-column="bidask">
                                    <span data-quote-field="bid">@row.Quote.DisplayBid</span> / <span data-quote-field="ask">@row.Quote.DisplayAsk</span>
                                    <span class="cell-sub">@Number(row.BidSize, "#,##0.###") × @Number(row.AskSize, "#,##0.###")</span>
                                </td>
                                <td class="num @(row.SpreadBps > 8m ? "is-wide" : null)" data-column="spread" data-spread-cell>
                                    @(row.SpreadBps is null ? "—" : row.SpreadBps.Value.ToString("0.0") + " bps")
                                </td>
                                <td class="num" data-column="z20" hidden="@startsHidden.Contains("z20")">
                                    @(ranked.Evidence.Swing?.VolumeZ20 is { } volumeZ ? volumeZ.ToString("0.00") + " z" : "—")
                                </td>
                                @{ var evidence = Model.EvidenceFor(row.Ticker); }
                                <td class="num" data-column="sector" hidden="@startsHidden.Contains("sector")" title="@(evidence.Detail)">@(evidence.Sector ?? "—")</td>
                                <td class="num" data-column="cap" hidden="@startsHidden.Contains("cap")" title="@(evidence.Detail)">@(Number(evidence.MarketCapMillions, "#,##0.##"))</td>
                                <td class="num" data-column="volume" hidden="@startsHidden.Contains("volume")" title="@(evidence.Detail)">@(Number(evidence.Volume, "#,##0"))</td>
                                <td class="num" data-column="rvol" hidden="@startsHidden.Contains("rvol")" title="@(evidence.Detail)">@(Number(evidence.DailyRvol, "0.00"))</td>
                                <td class="num" data-column="atr" hidden="@startsHidden.Contains("atr")" title="@(evidence.Detail)">@(Number(evidence.AtrPercent, "0.00"))</td>
                                <td class="num" data-column="gap" hidden="@startsHidden.Contains("gap")" title="@(evidence.Detail)">@(SignedPercent(evidence.GapPercent))</td>
                                <td class="num" data-column="vwap" hidden="@startsHidden.Contains("vwap")" title="@(evidence.Detail)">@(SignedPercent(evidence.VwapDistancePercent))</td>
                                <td class="num" data-column="rsi" hidden="@startsHidden.Contains("rsi")" title="@(evidence.Detail)">@(Number(evidence.Rsi, "0.00"))</td>
                                <td class="num" data-column="catalyst" hidden="@startsHidden.Contains("catalyst")" title="@(evidence.Detail)">@(evidence.HasCatalyst == true ? "Observed" : "Unknown coverage")</td>
                                <td class="num" data-column="earnings" hidden="@startsHidden.Contains("earnings")" title="@(evidence.EarningsDetail)">@(evidence.EarningsInDays is { } days ? days.ToString() + " NY days" : "Unknown coverage")</td>
                                <td class="eligibility-cell" data-column="eligibility">
                                    <span class="tag @(row.HasSignal ? "tag-accent" : "tag-neutral")" data-signal-badge>@Verdict(row.HasSignal, row.HasQuote)</span>
                                    <span class="cell-sub" data-signal-status title="@row.EligibilityReason">@row.EligibilityReason</span>
                                </td>
                                <td class="predictor-cell" data-column="predictor">
                                    <strong>@ranked.Evidence.FinalSignal</strong>
                                    <span class="cell-sub">
                                        @{
                                            var probability = ranked.Evidence.Swing?.Probability;
                                        }
                                        @Percent(probability) · @ranked.Evidence.ResolvedHorizon
                                    </span>
                                </td>
                                <td data-column="sync">
                                    <span class="@ranked.AgreementCssClass">@ranked.AgreementLabel</span>
                                </td>
                                @{
                                    var rowPrep = Model.Preparation.For(row.Ticker);
                                }
                                <td class="prep-cell" data-column="prep" hidden="@startsHidden.Contains("prep")">
                                    <span class="@rowPrep.CssClass" title="@rowPrep.Detail">@rowPrep.Label</span>
                                    @if (rowPrep.LastWarmedAtUtc is { } warmedAt)
                                    {
                                        <span class="cell-sub">@warmedAt.UtcDateTime.ToString("dd/MM HH:mm") UTC</span>
                                    }
                                </td>
                                <td class="num" data-column="pl">
                                    @if (row.Trade is null)
                                    {
                                        <span class="unknown">No position</span>
                                    }
                                    else
                                    {
                                        <strong>@row.Trade.Quantity.ToString("0.####") sh @@ @row.Trade.EntryPrice.ToString("C2")</strong>
                                        <span class="cell-sub">cost @Money(row.PositionCost) · value @Money(row.PositionValue)</span>
                                    }
                                </td>
                                <td class="num" data-column="pnl">
                                    @if (row.Trade is null)
                                    {
                                        <span class="unknown">—</span>
                                    }
                                    else
                                    {
                                        <strong class="@SignedClass(row.Trade.UnrealizedPl)">@SignedMoney(row.Trade.UnrealizedPl)</strong>
                                        <span class="cell-sub @SignedClass(row.Trade.UnrealizedPlPct)">@SignedPercent(row.Trade.UnrealizedPlPct)</span>
                                    }
                                </td>
                                <td class="news-cell" data-column="news" hidden="@startsHidden.Contains("news")">
                                    <span class="news-headline" title="@row.NewsHeadline">@row.NewsHeadline</span>
                                    <span class="cell-sub">@Clock(row.NewsTimestamp)</span>
                                </td>
                                <td class="action-cell">
                                    <a class="btn btn-secondary btn-sm"
                                       data-desk-inspect
                                       asp-page="/TradeDesk"
                                       asp-all-route-data='Model.RouteWith(("ticker", row.Ticker))'
                                       aria-label="Inspect @row.Ticker"
                                       aria-current="@(isSelected ? "true" : null)">Inspect</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="note desk-grid-note">
                Rows are read-only. Use <kbd>&#8593;</kbd><kbd>&#8595;</kbd> to move and <kbd>Enter</kbd> to inspect.
            </p>
        }
    </div>

    @* --- Layout B: focus column ------------------------------------------- *@
    <div class="desk-focus" data-desk-focus hidden>
        @if (selected is null)
        {
            <p class="empty-state">Choose a symbol from the ladder to read its evidence.</p>
        }
        else
        {
            var row = selected.Row;
            <header class="desk-focus-head">
                <div>
                    <span class="eyebrow">Selected market</span>
                    @* h2, not h1: the page already has one heading, and the focus
                       column is a section of it rather than a page of its own. *@
                    <h2 class="desk-focus-ticker">@row.Ticker</h2>
                    <p class="desk-focus-name">@row.DisplayName</p>
                </div>
                <div class="desk-focus-price">
                    <strong data-selected-quote="mid">@row.Quote.DisplayPrice</strong>
                    <span class="@SignedClass(row.ChangePct)" data-selected-change
                          data-prev-close="@PreviousCloseValue(row.PreviousClose)"
                          title="@ChangeTitle(row.PreviousClose)">@ChangeText(row.Change, row.ChangePct)</span>
                </div>
                <div class="cell-strip desk-focus-strip">
                    <div><span class="cell-label">Bid</span><span class="cell-value" data-selected-quote="bid">@row.Quote.DisplayBid</span></div>
                    <div><span class="cell-label">Ask</span><span class="cell-value" data-selected-quote="ask">@row.Quote.DisplayAsk</span></div>
                    <div><span class="cell-label">Spread</span><span class="cell-value">@(row.SpreadBps is null ? "—" : row.SpreadBps.Value.ToString("0.0") + " bps")</span></div>
                    <div><span class="cell-label">Volume Z20</span><span class="cell-value">@(selected.Evidence.Swing?.VolumeZ20 is { } volumeZ ? volumeZ.ToString("0.00") : "—")</span></div>
                </div>
            </header>
            <partial name="_DeskEvidencePair" model="new DeskEvidenceModel(selected, false)" />
            <partial name="_DeskAgreementBand" model="selected" />
            <section class="desk-open-book" aria-labelledby="OpenBookHeading">
                <h2 id="OpenBookHeading" class="section-heading">Open book</h2>
                @if (Model.RunningTrades.Count == 0)
                {
                    <p class="empty-state">No open position in this environment.</p>
                }
                else
                {
                    <table class="grid-table">
                        <thead>
                            <tr>
                                <th scope="col">Ticker</th>
                                <th scope="col">Source</th>
                                <th scope="col" class="num">Qty</th>
                                <th scope="col" class="num">Entry</th>
                                <th scope="col" class="num">Last</th>
                                <th scope="col" class="num">P/L</th>
                                <th scope="col">Protection</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trade in Model.RunningTrades)
                            {
                                <tr>
                                    <td><strong>@trade.Ticker</strong><span class="cell-sub">@trade.Status</span></td>
                                    <td><span class="tag tag-neutral">@SourceLabel(trade.Source)</span></td>
                                    <td class="num">@trade.Quantity.ToString("0.####")</td>
                                    <td class="num">@trade.EntryPrice.ToString("C2")</td>
                                    <td class="num">@trade.CurrentPrice.ToString("C2")</td>
                                    <td class="num @SignedClass(trade.UnrealizedPl)">@SignedMoney(trade.UnrealizedPl)</td>
                                    <td class="@(String.IsNullOrWhiteSpace(trade.ProtectionSummary) ? "accent-note" : null)">
                                        @(String.IsNullOrWhiteSpace(trade.ProtectionSummary) ? "No broker stop on file" : trade.ProtectionSummary)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        }
    </div>

    @* --- Right rail, shared by both layouts -------------------------------- *@
    <aside id="symbol-detail" class="desk-rail" aria-label="Selected symbol detail">
        @if (selected is null)
        {
            <section class="desk-rail-block">
                <p class="empty-state">
                    Select a symbol to read its quote, the TradingFlow verdict, the model's evidence, and to open a reviewed ticket.
                </p>
            </section>
        }
        else
        {
            var row = selected.Row;
            <section class="desk-rail-block desk-rail-symbol" data-selected-symbol="@row.Ticker.ToUpperInvariant()" data-desk-rail-selected>
                <div class="desk-rail-identity">
                    <div>
                        <span class="eyebrow">Selected</span>
                        <strong class="desk-rail-ticker">@row.Ticker</strong>
                        <span class="desk-rail-name">@row.DisplayName</span>
                    </div>
                    <div class="desk-rail-price">
                        <strong data-selected-quote="mid">@row.Quote.DisplayPrice</strong>
                        <span class="@SignedClass(row.ChangePct)" data-selected-change
                              data-prev-close="@PreviousCloseValue(row.PreviousClose)"
                              title="@ChangeTitle(row.PreviousClose)">@ChangeText(row.Change, row.ChangePct)</span>
                    </div>
                </div>
                <div class="cell-strip">
                    <div><span class="cell-label">Bid</span><span class="cell-value" data-selected-quote="bid">@row.Quote.DisplayBid</span></div>
                    <div><span class="cell-label">Ask</span><span class="cell-value" data-selected-quote="ask">@row.Quote.DisplayAsk</span></div>
                    <div><span class="cell-label">Spread</span><span class="cell-value">@(row.SpreadBps is null ? "—" : row.SpreadBps.Value.ToString("0.0") + " bps")</span></div>
                    <div><span class="cell-label">Volume Z20</span><span class="cell-value">@(selected.Evidence.Swing?.VolumeZ20 is { } railVolumeZ ? railVolumeZ.ToString("0.00") : "—")</span></div>
                </div>
                @{
                    var railPrep = Model.Preparation.For(row.Ticker);
                }
                <div class="desk-rail-membership">
                    <span class="cell-label">Lists</span>
                    <span>@ListsText(row.Lists)</span>
                    <span class="cell-label">Warmup</span>
                    <span class="desk-rail-prep">
                        <span class="@railPrep.CssClass" title="@railPrep.Detail">@railPrep.Label</span>
                        @if (Model.Preparation.Available && railPrep.NeedsPreparation)
                        {
                            <form method="post" asp-page-handler="Prepare" asp-all-route-data="Model.RouteWith()">
                                <input type="hidden" name="prepareTicker" value="@row.Ticker" />
                                <button class="btn btn-secondary btn-sm" type="submit">Prepare @row.Ticker</button>
                            </form>
                        }
                    </span>
                </div>
                @if (row.Trade is { } held)
                {
                    <div class="cell-strip desk-rail-position" aria-label="Position in @row.Ticker">
                        <div><span class="cell-label">Shares</span><span class="cell-value">@held.Quantity.ToString("0.####")</span></div>
                        <div><span class="cell-label">Avg entry</span><span class="cell-value">@held.EntryPrice.ToString("C2")</span></div>
                        <div><span class="cell-label">Invested</span><span class="cell-value">@Money(row.PositionCost)</span></div>
                        <div><span class="cell-label">Value</span><span class="cell-value">@Money(row.PositionValue)</span></div>
                        <div><span class="cell-label">Open P/L</span><span class="cell-value @SignedClass(held.UnrealizedPl)">@SignedMoney(held.UnrealizedPl) · @SignedPercent(held.UnrealizedPlPct)</span></div>
                    </div>
                }
                @* The Orders screen is the desk's order subset: the journal for this
                   symbol, with the same reviewed ticket beside it. *@
                <a class="btn btn-secondary btn-sm desk-rail-orders" asp-page="/Orders"
                   asp-route-ticker="@row.Ticker" asp-route-env="@Model.Env">Orders in @row.Ticker</a>
                @if (Model.EnvironmentState.Environment != TradingEnvironment.Live)
                {
                    <a class="btn btn-secondary btn-sm" data-order-shortcut="buy" asp-page="/Orders" asp-route-ticker="@row.Ticker" asp-route-env="@Model.Env" asp-route-side="buy">Review buy <kbd>B</kbd></a>
                    @if (row.HasTrade)
                    {
                        <a class="btn btn-secondary btn-sm" data-order-shortcut="sell" asp-page="/Orders" asp-route-ticker="@row.Ticker" asp-route-env="@Model.Env" asp-route-side="sell">Review sell <kbd>S</kbd></a>
                    }
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="btn btn-secondary btn-sm" type="button" data-group-action="add"
                            data-tickers="@row.Ticker">Add @row.Ticker to group</button>
                }
            </section>

            <partial name="_DeskEvidencePair" model="new DeskEvidenceModel(selected, true)" />
            <partial name="_DeskAgreementBand" model="selected" />

            <section class="desk-rail-block"><h2 class="section-heading">Reviewed order</h2><partial name="_OrderWorkflow" /></section>
        }

        <section class="desk-rail-block desk-rail-news" aria-labelledby="DeskNewsHeading"
                 data-selected-ticker-scope="@(selected?.Ticker.ToUpperInvariant())">
            <div class="desk-rail-head">
                <h2 id="DeskNewsHeading" class="section-heading">News</h2>
                <div class="seg" role="group" aria-label="News scope">
                    <button type="button" class="seg-opt" data-news-scope="group" aria-pressed="true">Group</button>
                    <button type="button" class="seg-opt" data-news-scope="symbol" aria-pressed="false"
                            disabled="@(selected is null)">@(selected?.Ticker ?? "Symbol")</button>
                </div>
            </div>
            <p class="empty-state" data-wishlist-news-empty hidden="@(Model.RelatedNews.Count > 0)">
                No wishlist news matched the rolling four-hour window.
            </p>
            <div data-wishlist-news-list>
                @foreach (var news in Model.RelatedNews)
                {
                    <partial name="_NewsEvidence" model="TradingFlow.Web.Models.NewsPresentation.From(news)" />
                }
            </div>
        </section>
    </aside>
</section>

</div>
<partial name="_GroupActions" />
@section Scripts {
    <script type="module" src="~/js/group-actions.js" asp-append-version="true"></script>
    <script src="~/js/desk-presets.js" asp-append-version="true" defer></script>
    <script src="~/js/candidate-workflow.js" asp-append-version="true" defer></script>
    <script type="module" src="~/js/trading-flow-desk.js" asp-append-version="true"></script>
    <script src="~/js/desk-layout.js" asp-append-version="true" defer></script>
    <script src="~/js/order-workflow.js" asp-append-version="true" defer></script>
}
