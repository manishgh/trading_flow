@page "/TradeDesk"
@using System.Globalization
@using TradingFlow.Engine.Execution
@model TradingFlow.Web.Pages.TradeDeskModel
@inject ManualEntryOptions ManualEntryOptions
@{
    ViewData["Title"] = "Trade Desk";
    var selectedId = Model.SelectedWishlist?.Id;
    var selectedName = Model.SelectedWishlist?.Name ?? "wishlist_breakout";

    static string PlClass(decimal value) => value > 0 ? "good" : value < 0 ? "bad" : "muted";
    static string SourceLabel(string source) => source switch
    {
        "stockpulse" => "Stock Pulse",
        "wishlist" => "Wishlist",
        "manual" => "Manual",
        _ => source
    };
}

<div class="page-header">
    <div>
        <h1>Trade Desk</h1>
        <p>Wishlist monitoring, active trades, bid/ask actions, technical signals, and related news in one compact screen.</p>
    </div>
    <div class="actions">
        <a class="button secondary" asp-page="/RunningTrades">Running Trades</a>
        <a class="button secondary" asp-page="/Paper" asp-route-wishlistId="@selectedId">Paper Lab</a>
        <button class="secondary" type="button" id="EnableDeskAlertsButton">Enable Alerts</button>
    </div>
</div>

@if (!String.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="status-banner">@Model.StatusMessage</div>
}
@if (!String.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="status-banner error">@Model.ErrorMessage</div>
}
<div id="SignalToast" class="signal-toast" role="status" aria-live="polite"></div>

<section class="trade-desk-layout">
    <div class="trade-desk-main">
        <section class="panel">
            <form method="get" class="trade-desk-toolbar">
                <div>
                    <label for="WishlistSelect">Wishlist</label>
                    <select id="WishlistSelect" name="id">
                        @foreach (var wishlist in Model.Wishlists)
                        {
                            <option value="@wishlist.Id" selected="@(Model.SelectedWishlist?.Id == wishlist.Id)">@wishlist.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="StrategyPath">Strategy</label>
                    <select id="StrategyPath" name="strategyPath">
                        @foreach (var strategy in Model.Strategies)
                        {
                            <option value="@strategy.Path" selected="@(Model.SelectedStrategyPath == strategy.Path)">@strategy.Definition.StrategyName</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="Source">Filter</label>
                    <select id="Source" name="source">
                        @foreach (var (key, label) in TradeDeskModel.Filters)
                        {
                            <option value="@key" selected="@(Model.Source.Equals(key, StringComparison.OrdinalIgnoreCase))">@label</option>
                        }
                    </select>
                </div>
                <button type="submit">Open</button>
            </form>
        </section>

        <section class="trade-summary-grid">
            <div class="summary-card">
                <span>Wishlist</span>
                <strong>@selectedName</strong>
            </div>
            <div class="summary-card">
                <span>Open P/L</span>
                <strong class="@PlClass(Model.TotalPl)">@Model.TotalPl.ToString("C2")</strong>
            </div>
            <div class="summary-card">
                <span>Rows</span>
                <strong>@Model.Rows.Count</strong>
            </div>
        </section>

        <section class="panel">
            <div class="watchlist-header">
                <div>
                    <h2>@selectedName</h2>
                    <div class="watchlist-meta">
                        @(Model.SelectedWishlist?.Description ?? "Custom wishlist")
                        @if (Model.SelectedWishlist?.IncludeExtendedHours == true)
                        {
                            <span> - Extended hours</span>
                        }
                        @if (Model.SelectedWishlist?.IsObserved == true)
                        {
                            <span> - Observing</span>
                        }
                    </div>
                </div>
                @if (Model.SelectedWishlist is not null)
                {
                    <form method="post" asp-page-handler="SetObserved">
                        <input type="hidden" name="WishlistId" value="@Model.SelectedWishlist.Id" />
                        <input type="hidden" name="IsObserved" value="@(Model.SelectedWishlist.IsObserved ? "false" : "true")" />
                        <input type="hidden" name="Source" value="@Model.Source" />
                        <input type="hidden" name="StrategyPath" value="@Model.SelectedStrategyPath" />
                        <button class="secondary" type="submit">@(Model.SelectedWishlist.IsObserved ? "Pause Observe" : "Observe")</button>
                    </form>
                }
            </div>

            @if (Model.SelectedWishlist is not null)
            {
                <form method="post" asp-page-handler="AddTicker" class="trade-desk-add-row">
                    <input type="hidden" name="TargetWishlistId" value="@Model.SelectedWishlist.Id" />
                    <input type="hidden" name="Source" value="@Model.Source" />
                    <input type="hidden" name="StrategyPath" value="@Model.SelectedStrategyPath" />
                    <input name="Ticker" placeholder="Ticker" autocomplete="off" />
                    <input name="DisplayName" placeholder="Name optional" />
                    <input name="Notes" placeholder="Notes / catalyst / setup" />
                    <button type="submit">Add</button>
                </form>
                <form method="post" asp-page-handler="ImportFinviz" class="trade-desk-finviz-row">
                    <input type="hidden" name="TargetWishlistId" value="@Model.SelectedWishlist.Id" />
                    <input type="hidden" name="Source" value="@Model.Source" />
                    <input type="hidden" name="StrategyPath" value="@Model.SelectedStrategyPath" />
                    <input name="FinvizFilter" placeholder="Paste Finviz Elite screener URL or query" />
                    <button class="secondary" type="submit">Import Finviz</button>
                </form>
            }

            <nav class="source-tabs" aria-label="Trade Desk filters">
                @foreach (var (key, label) in TradeDeskModel.Filters)
                {
                    var active = Model.Source.Equals(key, StringComparison.OrdinalIgnoreCase);
                    <a asp-page="/TradeDesk" asp-route-id="@selectedId" asp-route-source="@key" asp-route-strategyPath="@Model.SelectedStrategyPath" class="@(active ? "active" : null)">@label</a>
                }
            </nav>

            @if (Model.Rows.Count == 0)
            {
                <div class="empty-state">No rows for this filter.</div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="trade-desk-table">
                        <thead>
                            <tr>
                                <th>Ticker</th>
                                <th>Price</th>
                                <th>Eligibility</th>
                                <th>Active Trade</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var rowKey = row.Ticker.Replace(".", "_", StringComparison.OrdinalIgnoreCase);
                            <tr data-quote-row="@row.Ticker.ToUpperInvariant()" class="operator-row @(row.HasSignal ? "eligible-row" : null)">
                                <td>
                                    <strong>@row.Ticker</strong>
                                    <div class="muted">@row.DisplayName</div>
                                    @if (!String.IsNullOrWhiteSpace(row.Item.Notes))
                                    {
                                        <div class="muted">@row.Item.Notes</div>
                                    }
                                    @if (row.LatestNews is not null)
                                    {
                                        if (!String.IsNullOrWhiteSpace(row.LatestNews.Url))
                                        {
                                            <a class="news-inline-link" href="@row.LatestNews.Url" target="_blank" rel="noopener noreferrer">@row.LatestNews.Headline</a>
                                        }
                                        else
                                        {
                                            <div class="news-inline-static">@row.LatestNews.Headline</div>
                                        }
                                    }
                                </td>
                                <td>
                                    <div class="price-stack">
                                        <div><span class="muted">Mid</span> <span class="quote-pill @(row.HasQuote ? "" : "empty")" data-quote-field="mid">@row.Quote.DisplayPrice</span></div>
                                        <div><span class="muted">Bid</span> <span class="quote-pill @(row.Quote.BidPrice is null ? "empty" : "")" data-quote-field="bid">@row.Quote.DisplayBid</span></div>
                                        <div><span class="muted">Ask</span> <span class="quote-pill @(row.Quote.AskPrice is null ? "empty" : "")" data-quote-field="ask">@row.Quote.DisplayAsk</span></div>
                                    </div>
                                </td>
                                <td>
                                    <span class="signal-badge @(row.HasSignal ? "eligible" : "watching")" data-signal-badge>@row.EligibilityLabel</span>
                                    <div class="muted" data-signal-status>@row.EligibilityReason</div>
                                    @if (row.LatestSignal is not null)
                                    {
                                        <div class="signal-type-line">@row.LatestSignal.SignalType</div>
                                    }
                                </td>
                                <td>
                                    @if (row.Trade is null)
                                    {
                                        <span class="muted">No open trade</span>
                                    }
                                    else
                                    {
                                        <strong>@SourceLabel(row.Trade.Source)</strong>
                                        <div>@row.Trade.Quantity.ToString("0.####") sh @@ @row.Trade.EntryPrice.ToString("C2")</div>
                                        <div class="muted">@row.Trade.ProtectionSummary</div>
                                        <div class="@(PlClass(row.Trade.UnrealizedPl))">@row.Trade.UnrealizedPl.ToString("C2")</div>
                                    }
                                </td>
                                <td>
                                    <div class="row-actions">
                                        @if (ManualEntryOptions.Policy == ManualEntryPolicy.OperatorDirect)
                                        {
                                            <button class="button buy mini-button"
                                                    type="button"
                                                    disabled="@(row.Quote.AskPrice is null)"
                                                    data-operator-direct-buy
                                                    data-ticker="@row.Ticker"
                                                    data-limit="@row.Quote.AskPrice?.ToString(CultureInfo.InvariantCulture)"
                                                    data-display-limit="@row.Quote.DisplayAsk">Buy @row.Quote.DisplayAsk</button>
                                        }
                                        <form method="post" asp-page-handler="ManualOrder">
                                            <input type="hidden" name="WishlistId" value="@Model.SelectedWishlist?.Id" />
                                            <input type="hidden" name="Ticker" value="@row.Ticker" />
                                            <input type="hidden" name="Side" value="sell" />
                                            <input type="hidden" name="Quantity" value="1" />
                                            <input type="hidden" name="Source" value="@Model.Source" />
                                            <input type="hidden" name="StrategyPath" value="@Model.SelectedStrategyPath" />
                                            <input type="hidden" name="LimitPrice" value="@row.Quote.BidPrice?.ToString(CultureInfo.InvariantCulture)" data-quote-input="sell" />
                                            <button class="button sell mini-button" type="submit" disabled="@(row.Quote.BidPrice is null)" data-quote-button="sell">Sell @row.Quote.DisplayBid</button>
                                        </form>
                                        <form method="post" asp-page-handler="RunStrategy">
                                            <input type="hidden" name="WishlistId" value="@Model.SelectedWishlist?.Id" />
                                            <input type="hidden" name="Ticker" value="@row.Ticker" />
                                            <input type="hidden" name="StrategyPath" value="@Model.SelectedStrategyPath" />
                                            <input type="hidden" name="Source" value="@Model.Source" />
                                            <button class="secondary mini-button" type="submit" disabled="@(String.IsNullOrWhiteSpace(Model.SelectedStrategyPath))">Run Strategy</button>
                                        </form>
                                        @if (row.Trade is not null)
                                        {
                                            <form method="post" asp-page-handler="CloseTrade">
                                                <input type="hidden" name="WishlistId" value="@Model.SelectedWishlist?.Id" />
                                                <input type="hidden" name="closeKind" value="@row.Trade.CloseKind" />
                                                <input type="hidden" name="jobId" value="@(row.Trade.JobId?.ToString())" />
                                                <input type="hidden" name="sessionId" value="@(row.Trade.SessionId?.ToString())" />
                                                <input type="hidden" name="ticker" value="@row.Ticker" />
                                                <input type="hidden" name="Source" value="@Model.Source" />
                                                <input type="hidden" name="StrategyPath" value="@Model.SelectedStrategyPath" />
                                                <button class="danger mini-button" type="submit" onclick="return confirm('Close tracked trade for @row.Ticker?');">Close</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <aside class="intelligence-rail">
        <section class="panel">
            <div class="panel-header compact">
                <div>
                    <h2>Technical Signals</h2>
                    <p>Last 20 minutes.</p>
                </div>
            </div>
            <div id="TechnicalSignalsList" class="rail-scroll">
                @if (Model.RecentSignals.Count == 0)
                {
                    <div class="empty-state">No recent technical signals.</div>
                }
                else
                {
                    @foreach (var signal in Model.RecentSignals)
                    {
                        <div class="rail-item" data-signal-id="@signal.Id">
                            <div class="rail-line"><span class="rail-ticker">@signal.Ticker</span><span class="muted">@signal.DetectedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</span></div>
                            <div class="rail-title">@signal.SignalType</div>
                            <div class="rail-summary">@signal.Reason</div>
                        </div>
                    }
                }
            </div>
        </section>

        <section class="panel">
            <div class="panel-header compact">
                <div>
                    <h2>Related News</h2>
                    <p>Rolling 4h context.</p>
                </div>
            </div>
            <div id="RelatedNewsList" class="rail-scroll">
                @if (Model.RelatedNews.Count == 0)
                {
                    <div class="empty-state">No related news in the rolling window.</div>
                }
                else
                {
                    @foreach (var news in Model.RelatedNews)
                    {
                        if (!String.IsNullOrWhiteSpace(news.Url))
                        {
                            <a class="rail-item news-link-card" href="@news.Url" target="_blank" rel="noopener noreferrer">
                                <div class="rail-line"><span class="rail-ticker">@news.Ticker</span><span class="muted">@news.Timestamp.ToLocalTime().ToString("dd/MM HH:mm")</span></div>
                                <div class="rail-title">@news.Headline</div>
                                @if (!String.IsNullOrWhiteSpace(news.Summary))
                                {
                                    <div class="rail-summary">@news.Summary</div>
                                }
                                <div class="rail-summary">@news.Provider @(!String.IsNullOrWhiteSpace(news.Source) ? $"- {news.Source}" : "")</div>
                            </a>
                        }
                        else
                        {
                            <div class="rail-item">
                                <div class="rail-line"><span class="rail-ticker">@news.Ticker</span><span class="muted">@news.Timestamp.ToLocalTime().ToString("dd/MM HH:mm")</span></div>
                                <div class="rail-title">@news.Headline</div>
                                @if (!String.IsNullOrWhiteSpace(news.Summary))
                                {
                                    <div class="rail-summary">@news.Summary</div>
                                }
                                <div class="rail-summary">@news.Provider @(!String.IsNullOrWhiteSpace(news.Source) ? $"- {news.Source}" : "")</div>
                            </div>
                        }
                    }
                }
            </div>
        </section>
    </aside>
</section>

@if (ManualEntryOptions.Policy == ManualEntryPolicy.OperatorDirect)
{
    <partial name="_ManualOrderDialog" model="new TradingFlow.Web.Pages.Shared.ManualOrderDialogModel(Model.SelectedWishlist?.Id, Model.Source, Model.SelectedStrategyPath)" />
}

@section Scripts {
    <script>
        const selectedWishlistId = '@selectedId';
        const htmlEncode = (value) => {
            const div = document.createElement('div');
            div.textContent = value ?? '';
            return div.innerHTML;
        };
        const seenSignalIds = new Set(Array.from(document.querySelectorAll('[data-signal-id]')).map(element => element.dataset.signalId));

        function requestDeskAlerts() {
            if (!('Notification' in window)) {
                showSignalToast({ ticker: 'Alerts', signalType: 'Browser notifications unavailable', reason: 'This browser does not support desktop notifications.' }, false);
                return;
            }

            Notification.requestPermission().then(permission => {
                const text = permission === 'granted'
                    ? 'Browser signal alerts enabled for this device.'
                    : 'Browser signal alerts are not enabled. In-page alerts will still show.';
                showSignalToast({ ticker: 'Alerts', signalType: text, reason: '' }, false);
            });
        }

        document.getElementById('EnableDeskAlertsButton')?.addEventListener('click', requestDeskAlerts);

        function showSignalToast(signal, notify = true) {
            const toast = document.getElementById('SignalToast');
            if (!toast) return;
            toast.innerHTML = `
                <strong>${htmlEncode(signal.ticker)} ${htmlEncode(signal.signalType)}</strong>
                <span>${htmlEncode(signal.reason || '')}</span>`;
            toast.classList.add('show');
            window.clearTimeout(showSignalToast.timer);
            showSignalToast.timer = window.setTimeout(() => toast.classList.remove('show'), 9000);

            if (notify && 'Notification' in window && Notification.permission === 'granted') {
                new Notification(`${signal.ticker} eligible`, {
                    body: signal.reason || signal.signalType,
                    tag: `tradingflow-${signal.id || signal.ticker}`
                });
            }
        }

        function updateSignalRows(signals, alertOnNew) {
            document.querySelectorAll('[data-quote-row]').forEach(row => {
                row.classList.remove('eligible-row');
                const badge = row.querySelector('[data-signal-badge]');
                const status = row.querySelector('[data-signal-status]');
                if (badge) {
                    badge.textContent = 'Watching';
                    badge.classList.remove('eligible');
                    badge.classList.add('watching');
                }
                if (status) {
                    status.textContent = 'Waiting for VWAP/EMA/MACD/volume conditions.';
                }
            });

            (signals || []).forEach(signal => {
                const ticker = (signal.ticker || '').toUpperCase();
                const row = Array.from(document.querySelectorAll('[data-quote-row]'))
                    .find(candidate => (candidate.dataset.quoteRow || '').toUpperCase() === ticker);
                if (!row) return;

                row.classList.add('eligible-row');
                const badge = row.querySelector('[data-signal-badge]');
                const status = row.querySelector('[data-signal-status]');
                if (badge) {
                    badge.textContent = 'Eligible';
                    badge.classList.remove('watching');
                    badge.classList.add('eligible');
                }
                if (status) {
                    status.textContent = signal.reason || signal.signalType || 'Base signal matched.';
                }

                if (alertOnNew && signal.id && !seenSignalIds.has(signal.id)) {
                    seenSignalIds.add(signal.id);
                    showSignalToast(signal, true);
                }
            });
        }

        function setQuoteText(row, field, text, hasValue) {
            const element = row.querySelector(`[data-quote-field="${field}"]`);
            if (!element) return;
            element.textContent = text || '--';
            element.classList.toggle('empty', !hasValue);
        }

        function applyQuoteUpdate(quote) {
            const ticker = (quote.ticker || '').toUpperCase();
            const row = Array.from(document.querySelectorAll('[data-quote-row]'))
                .find(candidate => (candidate.dataset.quoteRow || '').toUpperCase() === ticker);
            if (!row) return;

            setQuoteText(row, 'mid', quote.midText, quote.midPrice !== null && quote.midPrice !== undefined);
            setQuoteText(row, 'bid', quote.bidText, quote.bidPrice !== null && quote.bidPrice !== undefined);
            setQuoteText(row, 'ask', quote.askText, quote.askPrice !== null && quote.askPrice !== undefined);

            const buyInput = row.querySelector('[data-quote-input="buy"]');
            const sellInput = row.querySelector('[data-quote-input="sell"]');
            const buyButton = row.querySelector('[data-quote-button="buy"]');
            const sellButton = row.querySelector('[data-quote-button="sell"]');
            if (buyInput) buyInput.value = quote.askPrice ?? '';
            if (sellInput) sellInput.value = quote.bidPrice ?? '';
            if (buyButton) {
                buyButton.textContent = quote.buyCaption || 'Buy';
                buyButton.disabled = quote.askPrice === null || quote.askPrice === undefined;
            }
            if (sellButton) {
                sellButton.textContent = quote.sellCaption || 'Sell';
                sellButton.disabled = quote.bidPrice === null || quote.bidPrice === undefined;
            }
        }

        function renderSignals(signals) {
            const container = document.getElementById('TechnicalSignalsList');
            if (!container) return;
            if (!signals || signals.length === 0) {
                container.innerHTML = '<div class="empty-state">No recent technical signals.</div>';
                return;
            }

            container.innerHTML = signals.map(signal => `
                <div class="rail-item" data-signal-id="${htmlEncode(signal.id)}">
                    <div class="rail-line"><span class="rail-ticker">${htmlEncode(signal.ticker)}</span><span class="muted">${htmlEncode(signal.detectedAtText)}</span></div>
                    <div class="rail-title">${htmlEncode(signal.signalType)}</div>
                    <div class="rail-summary">${htmlEncode(signal.reason)}</div>
                </div>`).join('');
            updateSignalRows(signals, false);
        }

        function renderNews(items) {
            const container = document.getElementById('RelatedNewsList');
            if (!container) return;
            if (!items || items.length === 0) {
                container.innerHTML = '<div class="empty-state">No related news in the rolling window.</div>';
                return;
            }

            container.innerHTML = items.map(item => {
                const source = item.source ? ` - ${htmlEncode(item.source)}` : '';
                const body = `
                    <div class="rail-line"><span class="rail-ticker">${htmlEncode(item.ticker)}</span><span class="muted">${htmlEncode(item.timestampText)}</span></div>
                    <div class="rail-title">${htmlEncode(item.headline)}</div>
                    ${item.summary ? `<div class="rail-summary">${htmlEncode(item.summary)}</div>` : ''}
                    <div class="rail-summary">${htmlEncode(item.provider)}${source}</div>`;
                return item.url
                    ? `<a class="rail-item news-link-card" href="${htmlEncode(item.url)}" target="_blank" rel="noopener noreferrer">${body}</a>`
                    : `<div class="rail-item">${body}</div>`;
            }).join('');
        }

        if (selectedWishlistId) {
            const quoteSource = new EventSource(`/api/wishlists/${selectedWishlistId}/quotes/stream`);
            quoteSource.addEventListener('quotes', event => {
                try {
                    JSON.parse(event.data).forEach(applyQuoteUpdate);
                } catch (error) {
                    console.warn('Failed to apply quote update.', error);
                }
            });

            const activitySource = new EventSource(`/api/wishlists/${selectedWishlistId}/activity/stream`);
            activitySource.addEventListener('activity', event => {
                try {
                    const data = JSON.parse(event.data);
                    renderSignals(data.signals);
                    updateSignalRows(data.signals, true);
                    renderNews(data.news);
                } catch (error) {
                    console.warn('Failed to apply wishlist activity update.', error);
                }
            });
        }
    </script>
}
