@page "/TradeDesk"
@model TradingFlow.Web.Pages.TradeDeskModel
@{
    ViewData["Title"] = "Trade Desk";
    var selectedId = Model.SelectedWishlist?.Id;
    var selectedName = Model.SelectedWishlist?.Name ?? "No wishlist";
    var status = Model.OperationalStatus;
    var selected = Model.SelectedRow;

    static string PlClass(decimal value) => value > 0 ? "good" : value < 0 ? "bad" : "muted";
    static string StateClass(string value) => value.ToLowerInvariant() switch
    {
        "connected" or "ready" or "allowed" or "regular" => "status-ok",
        "delayed" or "attention" or "premarket" or "afterhours" or "after-hours" or "overnight" => "status-warn",
        "stale" or "disconnected" or "blocked" or "closed" => "status-bad",
        _ => "status-neutral"
    };
    static string SourceLabel(string source) => source switch
    {
        "stockpulse" => "Stock Pulse",
        "wishlist" => "Wishlist",
        "manual" => "Manual",
        _ => source
    };
}

<header class="page-header compact-page-header">
    <div>
        <h1>Trade Desk</h1>
        <p>Monitor candidates, inspect evidence, and move deliberately into an order or strategy workflow.</p>
    </div>
    <div class="actions">
        <a class="button secondary" asp-page="/Wishlists" asp-route-id="@selectedId">Manage Wishlist</a>
        <button class="secondary" type="button" id="EnableDeskAlertsButton">Enable Alerts</button>
    </div>
</header>

@if (!String.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="status-banner" role="status">@Model.StatusMessage</div>
}
@if (!String.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="status-banner error" role="alert">@Model.ErrorMessage</div>
}

<div id="DeskConnectionAnnouncement" class="visually-hidden" role="status" aria-live="polite"></div>
<div id="SignalToast" class="signal-toast" role="status" aria-live="polite"></div>

<section class="operational-strip" aria-label="Trading operational status">
    <div class="operational-item">
        <span>Environment</span>
        <strong class="environment-badge">@status.Environment</strong>
    </div>
    <div class="operational-item">
        <span>Market</span>
        <strong class="@StateClass(status.MarketSession)" title="@status.MarketSessionDetail">@status.MarketSession</strong>
    </div>
    <div class="operational-item operational-clock">
        <span>Market time</span>
        <strong>@status.NewYorkTime.ToString("yyyy-MM-dd HH:mm:ss") NY</strong>
        <small>@status.ObservedAtUtc.ToString("HH:mm:ss") UTC</small>
    </div>
    <div class="operational-item">
        <span>Quotes</span>
        <strong id="DeskQuoteConnection" class="@StateClass(status.QuoteStatus)" title="@status.QuoteDetail">@status.QuoteStatus</strong>
        <small id="DeskQuoteFreshness">@status.QuoteDetail · @status.QuoteFeed</small>
    </div>
    <div class="operational-item">
        <span>Model</span>
        <strong class="status-neutral">@status.ModelStatus</strong>
    </div>
    <div class="operational-item">
        <span>Broker sync</span>
        <strong class="@StateClass(status.BrokerStatus)" title="@status.BrokerDetail">@status.BrokerStatus</strong>
    </div>
    <div class="operational-item">
        <span>Entry gate</span>
        <strong class="@StateClass(status.AdmissionStatus)" title="@status.AdmissionDetail">@status.AdmissionStatus</strong>
    </div>
</section>

<section class="panel desk-controls">
    <form method="get" class="trade-desk-toolbar">
        <div>
            <label for="WishlistSelect">Wishlist</label>
            <select id="WishlistSelect" name="id">
                @foreach (var wishlist in Model.Wishlists)
                {
                    <option value="@wishlist.Id" selected="@(Model.SelectedWishlist?.Id == wishlist.Id)">@wishlist.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="StrategyPath">Strategy context</label>
            <select id="StrategyPath" name="strategyPath">
                @foreach (var strategy in Model.Strategies)
                {
                    <option value="@strategy.Path" selected="@(Model.SelectedStrategyPath == strategy.Path)">@strategy.Definition.StrategyName</option>
                }
            </select>
        </div>
        <div>
            <label for="Source">View</label>
            <select id="Source" name="source">
                @foreach (var (key, label) in TradeDeskModel.Filters)
                {
                    <option value="@key" selected="@(Model.Source.Equals(key, StringComparison.OrdinalIgnoreCase))">@label</option>
                }
            </select>
        </div>
        <button type="submit">Apply</button>
    </form>
    <div class="desk-summary" aria-label="Desk summary">
        <span><strong>@selectedName</strong></span>
        <span>@Model.Rows.Count symbol@(Model.Rows.Count == 1 ? "" : "s")</span>
        <span>Open P/L <strong class="@PlClass(Model.TotalPl)">@Model.TotalPl.ToString("C2")</strong></span>
        @if (Model.SelectedWishlist is not null)
        {
            <form method="post" asp-page-handler="SetObserved">
                <input type="hidden" name="WishlistId" value="@Model.SelectedWishlist.Id" />
                <input type="hidden" name="IsObserved" value="@(Model.SelectedWishlist.IsObserved ? "false" : "true")" />
                <input type="hidden" name="Source" value="@Model.Source" />
                <input type="hidden" name="StrategyPath" value="@Model.SelectedStrategyPath" />
                <input type="hidden" name="Ticker" value="@Model.Ticker" />
                <button class="secondary compact-command" type="submit">@(Model.SelectedWishlist.IsObserved ? "Pause observer" : "Start observer")</button>
            </form>
        }
    </div>
</section>

<nav class="source-tabs" aria-label="Trade Desk filters">
    @foreach (var (key, label) in TradeDeskModel.Filters)
    {
        var active = Model.Source.Equals(key, StringComparison.OrdinalIgnoreCase);
        <a asp-page="/TradeDesk"
           asp-route-id="@selectedId"
           asp-route-source="@key"
           asp-route-strategyPath="@Model.SelectedStrategyPath"
           asp-route-ticker="@Model.Ticker"
           class="@(active ? "active" : null)"
           aria-current="@(active ? "page" : null)">@label</a>
    }
</nav>

<section class="trade-desk-layout" data-desk-root data-wishlist-id="@selectedId" data-selected-ticker="@Model.Ticker">
    <div class="trade-desk-main">
        <section class="panel desk-market-panel" aria-labelledby="market-list-heading">
            <div class="panel-header compact">
                <div>
                    <h2 id="market-list-heading">Markets</h2>
                    <p>Rows are read-only. Select a symbol to inspect it before taking action.</p>
                </div>
                <a class="text-link" asp-page="/Wishlists" asp-route-id="@selectedId">Edit symbols</a>
            </div>

            @if (Model.Rows.Count == 0)
            {
                <div class="empty-state" data-desk-empty>
                    <strong>No symbols match this view.</strong>
                    <span>Change the filter or manage the selected wishlist.</span>
                </div>
            }
            else
            {
                <div class="desk-desktop-table table-scroll" role="region" aria-label="Watchlist markets" tabindex="0">
                    <table class="trade-desk-table">
                        <thead>
                            <tr>
                                <th scope="col">Market</th>
                                <th scope="col">Bid / Ask</th>
                                <th scope="col">Eligibility</th>
                                <th scope="col">Position</th>
                                <th scope="col"><span class="visually-hidden">Select</span></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var isSelected = selected?.Ticker.Equals(row.Ticker, StringComparison.OrdinalIgnoreCase) == true;
                            <tr data-symbol-row data-symbol="@row.Ticker.ToUpperInvariant()" data-quote-row="@row.Ticker.ToUpperInvariant()" class="operator-row @(isSelected ? "selected-row" : null)">
                                <td>
                                    <strong>@row.Ticker</strong>
                                    <span class="market-name">@row.DisplayName</span>
                                </td>
                                <td class="quote-cell">
                                    <span><small>Bid</small><strong data-quote-field="bid">@row.Quote.DisplayBid</strong></span>
                                    <span><small>Ask</small><strong data-quote-field="ask">@row.Quote.DisplayAsk</strong></span>
                                    <small data-quote-age>@(row.Quote.Timestamp is null ? "No quote" : "Quote received")</small>
                                </td>
                                <td>
                                    <span class="signal-badge @(row.HasSignal ? "eligible" : "watching")" data-signal-badge>@row.EligibilityLabel</span>
                                    <span class="cell-detail" data-signal-status>@row.EligibilityReason</span>
                                </td>
                                <td>
                                    @if (row.Trade is null)
                                    {
                                        <span class="muted">No open trade</span>
                                    }
                                    else
                                    {
                                        <strong>@SourceLabel(row.Trade.Source)</strong>
                                        <span class="cell-detail">@row.Trade.Quantity.ToString("0.####") sh @@ @row.Trade.EntryPrice.ToString("C2")</span>
                                        <span class="@PlClass(row.Trade.UnrealizedPl)">@row.Trade.UnrealizedPl.ToString("C2")</span>
                                    }
                                </td>
                                <td>
                                    <a class="button secondary compact-command"
                                       asp-page="/TradeDesk"
                                       asp-route-id="@selectedId"
                                       asp-route-source="@Model.Source"
                                       asp-route-strategyPath="@Model.SelectedStrategyPath"
                                       asp-route-ticker="@row.Ticker"
                                       aria-current="@(isSelected ? "true" : null)">View</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <div class="desk-mobile-list" aria-label="Watchlist markets">
                    @foreach (var row in Model.Rows)
                    {
                        var isSelected = selected?.Ticker.Equals(row.Ticker, StringComparison.OrdinalIgnoreCase) == true;
                        <article class="mobile-market-row @(isSelected ? "selected-row" : null)" data-symbol-row data-symbol="@row.Ticker.ToUpperInvariant()" data-quote-row="@row.Ticker.ToUpperInvariant()">
                            <a class="mobile-market-select"
                               asp-page="/TradeDesk"
                               asp-route-id="@selectedId"
                               asp-route-source="@Model.Source"
                               asp-route-strategyPath="@Model.SelectedStrategyPath"
                               asp-route-ticker="@row.Ticker"
                               aria-current="@(isSelected ? "true" : null)">
                                <span class="mobile-market-identity"><strong>@row.Ticker</strong><small>@row.DisplayName</small></span>
                                <span class="mobile-market-quote">
                                    <strong data-quote-field="mid">@row.Quote.DisplayPrice</strong>
                                    <small><span data-quote-field="bid">@row.Quote.DisplayBid</span> / <span data-quote-field="ask">@row.Quote.DisplayAsk</span></small>
                                </span>
                                <span class="signal-badge @(row.HasSignal ? "eligible" : "watching")" data-signal-badge>@row.EligibilityLabel</span>
                            </a>
                            <span class="mobile-market-reason" data-signal-status>@row.EligibilityReason</span>
                        </article>
                    }
                </div>
            }
        </section>
    </div>

    <aside id="symbol-detail" class="symbol-detail-rail" aria-label="Selected symbol detail">
        @if (selected is null)
        {
            <section class="panel empty-state">
                <strong>Select a symbol</strong>
                <span>Choose a market to inspect its quote, signal, position, and symbol-specific news.</span>
            </section>
        }
        else
        {
            <section class="panel symbol-overview" data-selected-symbol="@selected.Ticker.ToUpperInvariant()">
                <div class="symbol-heading">
                    <div>
                        <span class="eyebrow">Selected market</span>
                        <h2>@selected.Ticker</h2>
                        <p>@selected.DisplayName</p>
                    </div>
                    <span class="signal-badge @(selected.HasSignal ? "eligible" : "watching")" data-selected-signal-badge>@selected.EligibilityLabel</span>
                </div>
                <div class="selected-quote-grid">
                    <div><span>Bid</span><strong data-selected-quote="bid">@selected.Quote.DisplayBid</strong></div>
                    <div><span>Mid</span><strong data-selected-quote="mid">@selected.Quote.DisplayPrice</strong></div>
                    <div><span>Ask</span><strong data-selected-quote="ask">@selected.Quote.DisplayAsk</strong></div>
                </div>
                <div class="evidence-block">
                    <h3>TradingFlow decision</h3>
                    <p data-selected-signal-reason>@selected.EligibilityReason</p>
                    <strong data-selected-signal-type>@(selected.LatestSignal?.SignalType ?? "No active setup")</strong>
                </div>
                <div class="evidence-block">
                    <h3>Position</h3>
                    @if (selected.Trade is null)
                    {
                        <p>No open tracked position.</p>
                    }
                    else
                    {
                        <p>@SourceLabel(selected.Trade.Source) · @selected.Trade.Quantity.ToString("0.####") shares @@ @selected.Trade.EntryPrice.ToString("C2")</p>
                        <p>@selected.Trade.ProtectionSummary</p>
                        <strong class="@PlClass(selected.Trade.UnrealizedPl)">@selected.Trade.UnrealizedPl.ToString("C2")</strong>
                    }
                </div>
                <div class="symbol-actions">
                    <a class="button" asp-page="/Paper" asp-route-wishlistId="@selectedId">Review strategy run</a>
                    <a class="button secondary" asp-page="/RunningTrades">Open positions</a>
                </div>
            </section>

            <section class="panel evidence-block" aria-labelledby="selected-signal-heading">
                <h3 id="selected-signal-heading">Latest signal</h3>
                <div data-selected-signal-state>
                    <strong data-selected-signal-title>@(selected.LatestSignal?.SignalType ?? "No recent signal")</strong>
                    <p data-selected-signal-summary>@(selected.LatestSignal?.Reason ?? "The observer has not emitted a signal for this symbol in the current window.")</p>
                    <time data-selected-signal-time datetime="@selected.LatestSignal?.DetectedAtUtc.ToString("O")">
                        @(selected.LatestSignal is null ? "No timestamp" : $"{selected.LatestSignal.DetectedAtUtc:HH:mm:ss} UTC")
                    </time>
                </div>
            </section>

            <section class="panel evidence-block" aria-labelledby="selected-news-heading">
                <h3 id="selected-news-heading">Selected Symbol News</h3>
                <div data-selected-news-state>
                    @if (selected.LatestNews is null)
                    {
                        <strong data-selected-news-title>No recent related news</strong>
                        <p data-selected-news-summary>Nothing matched this symbol in the rolling four-hour feed.</p>
                        <span data-selected-news-source></span>
                        <a data-selected-news-link hidden>Open article</a>
                    }
                    else
                    {
                        <strong data-selected-news-title>@selected.LatestNews.Headline</strong>
                        <p data-selected-news-summary>@selected.LatestNews.Summary</p>
                        <span data-selected-news-source>@selected.LatestNews.Provider @selected.LatestNews.Source · @selected.LatestNews.Timestamp.ToString("HH:mm:ss") UTC</span>
                        <a data-selected-news-link
                           href="@selected.LatestNews.Url"
                           hidden="@(String.IsNullOrWhiteSpace(selected.LatestNews.Url))"
                           target="_blank"
                           rel="noopener noreferrer">Open article</a>
                    }
                </div>
            </section>
        }

        <section class="panel evidence-block wishlist-news-panel" aria-labelledby="wishlist-news-heading">
            <div class="section-heading compact-heading">
                <div>
                    <h3 id="wishlist-news-heading">Wishlist News</h3>
                    <p>Newest stories across every symbol in @selectedName.</p>
                </div>
                <span class="count-label" data-wishlist-news-count>@Model.RelatedNews.Count</span>
            </div>
            <p class="empty-copy" data-wishlist-news-empty hidden="@(Model.RelatedNews.Count > 0)">
                No wishlist news matched the rolling four-hour window.
            </p>
            <div class="wishlist-news-list" data-wishlist-news-list aria-label="Wishlist news timeline">
                @foreach (var news in Model.RelatedNews)
                {
                    var hasSafeUrl = Uri.TryCreate(news.Url, UriKind.Absolute, out var articleUri) &&
                        (articleUri.Scheme == Uri.UriSchemeHttp || articleUri.Scheme == Uri.UriSchemeHttps);
                    var newsKey = hasSafeUrl ? news.Url : news.Headline + "|" + news.Timestamp.ToString("O");
                    <article data-news-item
                             data-news-url="@(hasSafeUrl ? news.Url : null)"
                             data-news-key="@newsKey"
                             data-news-timestamp="@news.Timestamp.ToString("O")">
                        <div class="news-timeline-meta">
                            <strong data-news-tickers>@news.Ticker</strong>
                            <time data-news-time datetime="@news.Timestamp.ToString("O")">@news.Timestamp.ToString("HH:mm:ss") UTC</time>
                        </div>
                        <strong data-news-headline>@news.Headline</strong>
                        @if (!String.IsNullOrWhiteSpace(news.Summary))
                        {
                            <p data-news-summary>@news.Summary</p>
                        }
                        <span data-news-source>@news.Provider @news.Source</span>
                        @if (hasSafeUrl)
                        {
                            <a data-news-link href="@news.Url" target="_blank" rel="noopener noreferrer">Open article</a>
                        }
                    </article>
                }
            </div>
        </section>
    </aside>
</section>

@section Scripts {
    <script type="module" src="~/js/trading-flow-desk.js" asp-append-version="true"></script>
}
