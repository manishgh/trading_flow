@page "{id:guid}"
@model TradingFlow.Web.Pages.PaperJobModel
@{
    ViewData["Title"] = "Paper Job";
}

@section Scripts {
    <script>
        (function () {
            const jobId = window.tradingFlowJobId;
            if (!jobId) return;

            const statusEl = document.getElementById('jobStatus');
            const startedAtEl = document.getElementById('startedAt');
            const marketDataFeedEl = document.getElementById('marketDataFeed');
            const metricsLastRefreshEl = document.getElementById('metricsLastRefresh');
            const eventsEl = document.getElementById('recentEvents');
            const auditsBody = document.getElementById('recentAuditsBody');
            const auditsTable = document.getElementById('recentAuditsTable');
            const auditsEmpty = document.getElementById('recentAuditsEmpty');
            const metricsBody = document.getElementById('liveMetricsBody');
            const metricsTable = document.getElementById('liveMetricsTable');
            const metricsEmpty = document.getElementById('liveMetricsEmpty');
            const ordersBody = document.getElementById('openOrdersBody');
            const ordersTable = document.getElementById('openOrdersTable');
            const ordersEmpty = document.getElementById('openOrdersEmpty');
            const positionsBody = document.getElementById('openPositionsBody');
            const positionsTable = document.getElementById('openPositionsTable');
            const positionsEmpty = document.getElementById('openPositionsEmpty');
            const profilerTitle = document.getElementById('profilerTitle');
            const profilerBody = document.getElementById('profilerBody');
            const currencyFormatter = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
            const numberFormatter = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 });
            const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

            function escapeHtml(value) {
                return String(value ?? '')
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }

            async function refreshSnapshot() {
                let data;
                try {
                    const response = await fetch(`?handler=Snapshot&id=${encodeURIComponent(jobId)}`, { cache: 'no-store' });
                    if (!response.ok) return;
                    data = await response.json();
                } catch {
                    return;
                }

                if (!data.success) return;

                if (statusEl) {
                    statusEl.textContent = data.status;
                    statusEl.className = `status ${data.status}`;
                }

                if (startedAtEl) {
                    startedAtEl.textContent = data.startedAt;
                }

                if (marketDataFeedEl) {
                    marketDataFeedEl.textContent = data.marketDataFeed;
                }

                if (metricsLastRefreshEl) {
                    metricsLastRefreshEl.textContent = data.refreshedAt;
                }

                if (eventsEl) {
                    eventsEl.innerHTML = data.events.map(eventText => `<div>${escapeHtml(eventText)}</div>`).join('');
                }

                if (metricsBody && metricsTable && metricsEmpty) {
                    const metrics = data.metrics ?? [];
                    metricsEmpty.hidden = metrics.length !== 0;
                    metricsTable.hidden = metrics.length === 0;
                    metricsBody.innerHTML = metrics.map(point => `<tr title="${escapeHtml(`Profile: ${point.marketEvidenceProfileVersion ?? 'unknown'}; cohort: ${point.relativeVolumeCohort ?? 'unknown'}; feed: ${point.dataFeed ?? 'unknown'}; adjustment: ${point.adjustmentPolicy ?? 'unknown'}; reliability: ${point.marketEvidenceReliability ?? 'unknown'}`)}">
                        <td>${escapeHtml(point.time)}</td>
                        <td><strong>${escapeHtml(point.ticker)}</strong></td>
                        <td>${escapeHtml(point.timeframe)}</td>
                        <td>${formatCurrency(point.close)}</td>
                        <td>${formatDecimal(point.rsi)}</td>
                        <td>${formatWholeNumber(point.volume)}</td>
                        <td>${formatWholeNumber(point.slotMedianVolume)}</td>
                        <td>${formatDecimal(point.slotRelativeVolume)}</td>
                        <td>${formatWholeNumber(point.cumulativeSameTimeMedianVolume)}</td>
                        <td>${formatDecimal(point.relativeVolume)}</td>
                        <td>${formatWholeNumber(point.relativeVolumeSampleCount)}</td>
                        <td>${formatCurrency(point.vwap)}</td>
                    </tr>`).join('');
                }

                if (auditsBody && auditsTable && auditsEmpty) {
                    const audits = data.audits ?? [];
                    auditsEmpty.hidden = audits.length !== 0;
                    auditsTable.hidden = audits.length === 0;
                    auditsBody.innerHTML = audits.map(audit => {
                        const decisionClass = audit.decision === 'Accepted'
                            ? 'value-good'
                            : (audit.decision === 'Rejected' ? 'value-bad' : 'value-flat');
                        const raw = audit.rawReason ? `<br /><code>${escapeHtml(audit.rawReason)}</code>` : '';
                        return `<tr>
                            <td class="nowrap">${escapeHtml(audit.time)}</td>
                            <td class="text-bold">${escapeHtml(audit.ticker)}</td>
                            <td class="${decisionClass}">${escapeHtml(audit.decision)}</td>
                            <td class="muted-sm">${escapeHtml(audit.reason)}${raw}</td>
                        </tr>`;
                    }).join('');
                }

                if (ordersBody && ordersTable && ordersEmpty) {
                    updateOpenOrders(data.openOrders ?? []);
                }

                if (positionsBody && positionsTable && positionsEmpty) {
                    updateOpenPositions(data.openPositions ?? []);
                }

                if (profilerTitle && profilerBody) {
                    updateProfiler(data.profiler);
                }

                if (data.status !== 'queued' && data.status !== 'running') {
                    window.clearInterval(window.tradingFlowPaperJobRefresh);
                }
            }

            function formatCurrency(value) {
                return value === null || value === undefined ? 'N/A' : currencyFormatter.format(Number(value));
            }

            function formatDecimal(value) {
                return value === null || value === undefined ? 'N/A' : Number(value).toFixed(2);
            }

            function formatWholeNumber(value) {
                return value === null || value === undefined ? 'N/A' : numberFormatter.format(Number(value));
            }

            function updateProfiler(profile) {
                if (!profile || Number(profile.totalRequests ?? 0) === 0) {
                    profilerTitle.textContent = 'Alpaca API Profiler Latency & Performance Profiler';
                    profilerBody.innerHTML = '<p class="muted">No API requests recorded yet.</p>';
                    return;
                }

                profilerTitle.textContent = `${escapeHtml(profile.name)} Latency & Performance Profiler`;
                const endpointRows = (profile.endpoints ?? []).map(endpoint => `<tr>
                    <td class="route-cell">${escapeHtml(endpoint.route)}</td>
                    <td>${formatWholeNumber(endpoint.count)}</td>
                    <td>${formatDecimal(endpoint.avgDurationMs)} ms</td>
                    <td>${formatDecimal(endpoint.minDurationMs)} ms</td>
                    <td>${formatDecimal(endpoint.maxDurationMs)} ms</td>
                    <td class="${Number(endpoint.successRate) >= 99 ? 'value-good' : 'value-bad'}">${formatDecimal(endpoint.successRate)}%</td>
                </tr>`).join('');

                profilerBody.innerHTML = `
                    <div class="muted mb-md">Started at: ${escapeHtml(profile.appStartTime)}</div>
                    <div class="metric-panel">
                        <div class="metric-row">
                            <div class="code-block">
                                <div class="muted text-sm">Total Requests</div>
                                <div class="metric-value good">${formatWholeNumber(profile.totalRequests)}</div>
                            </div>
                            <div class="code-block">
                                <div class="muted text-sm">Avg Duration</div>
                                <div class="metric-value info">${formatDecimal(profile.avgDurationMs)} ms</div>
                            </div>
                            <div class="code-block">
                                <div class="muted text-sm">Max Duration</div>
                                <div class="metric-value warn">${formatDecimal(profile.maxDurationMs)} ms</div>
                            </div>
                            <div class="code-block">
                                <div class="muted text-sm">Success Rate</div>
                                <div class="metric-value ${Number(profile.successRate) >= 99 ? 'good' : 'bad'}">${formatDecimal(profile.successRate)}%</div>
                            </div>
                        </div>
                        <div class="scroll-y h-sm">
                            <table class="table data-grid-table">
                                <thead class="sticky">
                                    <tr>
                                        <th>Endpoint Route</th>
                                        <th>Count</th>
                                        <th>Avg Latency</th>
                                        <th>Min</th>
                                        <th>Max</th>
                                        <th>Success %</th>
                                    </tr>
                                </thead>
                                <tbody>${endpointRows}</tbody>
                            </table>
                        </div>
                    </div>`;
            }

            function updateOpenOrders(orders) {
                ordersEmpty.hidden = orders.length !== 0;
                ordersTable.hidden = orders.length === 0;
                ordersBody.innerHTML = orders.map(order => {
                    const side = String(order.side ?? '').toLowerCase();
                    const sideClass = side === 'buy' ? 'value-good' : 'value-bad';
                    const distance = order.distancePct === null || order.distancePct === undefined
                        ? '-'
                        : `${Number(order.distancePct).toFixed(2)}%`;
                    const distanceClass = Number(order.distancePct ?? 0) < 0 ? 'value-good' : 'muted';
                    return `<tr>
                        <td class="text-bold">${escapeHtml(order.ticker)}</td>
                        <td class="${sideClass}">${escapeHtml(side.toUpperCase())}</td>
                        <td>${escapeHtml(String(order.orderType || '-').toUpperCase())}</td>
                        <td>${formatDecimal(order.qty)}</td>
                        <td>${formatCurrency(order.limitPrice)}</td>
                        <td>${formatCurrency(order.currentPrice)}</td>
                        <td class="${distanceClass}">${escapeHtml(distance)}</td>
                        <td>${escapeHtml(order.status)}</td>
                    </tr>`;
                }).join('');
            }

            function updateOpenPositions(positions) {
                positionsEmpty.hidden = positions.length !== 0;
                positionsTable.hidden = positions.length === 0;
                positionsBody.innerHTML = positions.map(position => {
                    const pl = Number(position.unrealizedPl ?? 0);
                    const plClass = pl > 0 ? 'value-good' : (pl < 0 ? 'value-bad' : 'value-flat');
                    const plText = `${pl > 0 ? '+' : ''}${formatCurrency(pl)}`;
                    const ticker = String(position.ticker ?? '');
                    const closeAction = `?handler=ClosePosition&id=${encodeURIComponent(jobId)}&ticker=${encodeURIComponent(ticker)}`;
                    return `<tr>
                        <td class="text-bold">${escapeHtml(ticker)}</td>
                        <td>${escapeHtml(String(position.side || '').toUpperCase())}</td>
                        <td>${formatDecimal(position.qty)}</td>
                        <td>${formatCurrency(position.entryPrice)}</td>
                        <td>${formatCurrency(position.currentPrice)}</td>
                        <td class="${plClass}">${escapeHtml(plText)}</td>
                        <td>
                            <form class="m-0" method="post" action="${closeAction}">
                                <input name="__RequestVerificationToken" type="hidden" value="${escapeHtml(antiforgeryToken)}" />
                                <button type="submit" class="button danger-soft" onclick="return confirm('Market sell your entire position in ${escapeHtml(ticker)}?');">Close Position</button>
                            </form>
                        </td>
                    </tr>`;
                }).join('');
            }

            window.tradingFlowPaperJobRefresh = window.setInterval(refreshSnapshot, 5000);
            refreshSnapshot();
        })();
    </script>
}

<div class="section-title">
    <div>
        <h1>Paper Run: @Model.Job?.RunName</h1>
        <div class="muted">Live execution metrics and signals</div>
    </div>
    <div class="inline-row">
        @if (Model.Job?.Status is "queued" or "running")
        {
            <form class="m-0" method="post" asp-page-handler="CancelRun" asp-route-id="@Model.Job.JobId">
                <button type="submit" class="button secondary">Cancel Runner</button>
            </form>
        }
        <form class="m-0" method="post" asp-page-handler="CancelOrders" asp-route-id="@Model.Job?.JobId">
            <button type="submit" class="button secondary">Cancel All Broker Orders</button>
        </form>
        <a class="button secondary" asp-page="/Paper">Back to Lab</a>
    </div>
</div>

@if (Model.Job is null)
{
    <p class="warn">Job not found.</p>
}
else
{
    <div class="grid two">
        <section class="panel">
            <h2>Status: <span id="jobStatus" class="status @Model.Job.Status">@Model.Job.Status</span></h2>
            @if (!string.IsNullOrEmpty(Model.Job.ErrorMessage))
            {
                <div class="alert alert-danger">
                    <strong>Error:</strong> @Model.Job.ErrorMessage
                </div>
            }
            <p><strong>Config:</strong> @Model.Job.ConfigPath</p>
            <p><strong>Started:</strong> <span id="startedAt">@(Model.Job.StartedAt is null ? "Queued" : Model.FormatLocal(Model.Job.StartedAt.Value))</span> <span class="muted">@Model.LocalTimeZoneLabel</span></p>
            <div class="mt-md mb-md">
                <a asp-page="/Audit" asp-route-runName="@Model.Job.RunName" asp-route-returnUrl="@($"/PaperJob/{Model.Job.JobId}")" class="button">Open Audit Analyzer</a>
            </div>
            @if (Model.Strategy != null)
            {
                <div class="info-callout">
                    <h3 class="callout-title">@Model.Strategy.StrategyName v@(Model.Strategy.Version)</h3>
                    <div class="pair-grid">
                        <div><strong>Timeframe:</strong> @Model.Strategy.Timeframe</div>
                        <div><strong>Direction:</strong> @Model.Strategy.Direction</div>
                        @if (Model.Strategy.ExitRules != null)
                        {
                            <div><strong>ATR Stop:</strong> @Model.Strategy.ExitRules.StopAtrMultiple x</div>
                            <div><strong>Target R:</strong> @Model.Strategy.ExitRules.TargetRMultiple x</div>
                        }
                    </div>
                </div>
            }

            <h3 class="mt-md">Recent Events</h3>
            <div id="recentEvents" class="log-viewer">
                @foreach (var ev in Model.Job.Events.Reverse())
                {
                    <div>@ev</div>
                }
            </div>

            @if (Model.Job.Status is "queued" or "running")
            {
                <script>
                    window.tradingFlowJobId = '@Model.Job.JobId';
                </script>
            }
        </section>

        <section class="panel">
            <h2>Live Stock Metrics</h2>
            <div class="muted">Most recent values calculated by the engine for the latest bar. <span id="marketDataFeed">@Model.MarketDataFeedLabel</span>. Last refreshed: <span id="metricsLastRefresh">@Model.FormatLocal(DateTimeOffset.UtcNow)</span>.</div>
            <p id="liveMetricsEmpty" class="muted" hidden="@(!(Model.ChartDataList.Count == 0))">No data generated yet. Waiting for market data...</p>
            <table id="liveMetricsTable" class="table data-grid-table mt-md" hidden="@(Model.ChartDataList.Count == 0)">
                <thead>
                    <tr>
                        <th>Bar Time</th>
                        <th>Ticker</th>
                        <th>Candle</th>
                        <th>Close Price</th>
                        <th>RSI (14)</th>
                        <th>Volume</th>
                        <th title="Median volume for this same ticker, timeframe, market-session cohort, and New York-time candle slot across prior sessions. Diagnostic only.">Slot Median Vol</th>
                        <th title="Current completed candle volume divided by the same-slot median. Diagnostic acceleration evidence; not the primary participation gate.">Slot RVOL</th>
                        <th title="Median cumulative cohort volume through this same New York-time slot across prior sessions. This is the denominator for strategy RVOL.">Cumul Median Vol</th>
                        <th title="Primary strategy RVOL: current cohort cumulative volume divided by the historical median through the same New York-time slot.">Same-time RVOL</th>
                        <th title="Number of prior same-time sessions used for the RVOL baseline.">Samples</th>
                        <th>VWAP</th>
                    </tr>
                </thead>
                <tbody id="liveMetricsBody">
                    @foreach (var point in Model.ChartDataList.OrderBy(x => x.Ticker))
                    {
                        <tr title="Profile: @point.MarketEvidenceProfileVersion; cohort: @point.RelativeVolumeCohort; feed: @point.DataFeed; adjustment: @point.AdjustmentPolicy; reliability: @point.MarketEvidenceReliability">
                            <td>@Model.FormatMetricTimestamp(point.Timestamp, point.Timeframe)</td>
                            <td><strong>@point.Ticker</strong></td>
                            <td>@point.Timeframe</td>
                            <td>@point.Close.ToString("C2")</td>
                            <td>@(point.Rsi?.ToString("F2") ?? "N/A")</td>
                            <td>@point.Volume.ToString("N0")</td>
                            <td>@(point.SlotMedianVolume?.ToString("N0") ?? "n/a")</td>
                            <td>@(point.SlotRelativeVolume?.ToString("F2") ?? "N/A")</td>
                            <td>@(point.CumulativeSameTimeMedianVolume?.ToString("N0") ?? "n/a")</td>
                            <td>@(point.RelativeVolume?.ToString("F2") ?? "N/A")</td>
                            <td>@point.RelativeVolumeSampleCount</td>
                            <td>@(point.Vwap?.ToString("C2") ?? "N/A")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h3 class="mt-xl">Recent Strategy Evaluations</h3>
            <p id="recentAuditsEmpty" class="muted" hidden="@(!(Model.RecentAudits == null || Model.RecentAudits.Count == 0))">No recent strategy evaluations.</p>
            <div class="scroll-y h-lg">
                <table id="recentAuditsTable" class="table data-grid-table mt-md" hidden="@(Model.RecentAudits == null || Model.RecentAudits.Count == 0)">
                    <thead>
                        <tr>
                            <th>Local Time</th>
                            <th>Ticker</th>
                            <th>Decision</th>
                            <th>Rejection Reason</th>
                        </tr>
                    </thead>
                    <tbody id="recentAuditsBody">
                    @foreach (var audit in Model.RecentAudits ?? Enumerable.Empty<TradingFlow.Domain.Audit.DecisionAuditRecord>())
                    {
                        var decisionClass = audit.Decision == "Accepted" ? "value-good" : (audit.Decision == "Rejected" ? "value-bad" : "value-flat");
                        <tr>
                            <td class="nowrap">@Model.FormatLocalTime(audit.Timestamp)</td>
                            <td class="text-bold">@audit.Ticker</td>
                            <td class="@decisionClass">@audit.Decision</td>
                            <td class="muted-sm">
                                @Model.FormatRejectionReason(audit.RejectionReason)
                                @if (!String.IsNullOrWhiteSpace(audit.RejectionReason))
                                {
                                    <br /><code>@audit.RejectionReason</code>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <h3 class="mt-xl">Live Broker Orders</h3>
            <p id="openOrdersEmpty" class="muted" hidden="@(!(Model.OpenOrders == null || Model.OpenOrders.Count == 0))">No open orders found.</p>
            <table id="openOrdersTable" class="table data-grid-table mt-md" hidden="@(Model.OpenOrders == null || Model.OpenOrders.Count == 0)">
                <thead>
                    <tr>
                        <th>Ticker</th>
                        <th>Side</th>
                        <th>Type</th>
                        <th>Qty</th>
                        <th>Limit Px</th>
                        <th>Current Px</th>
                        <th>Distance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="openOrdersBody">
                @foreach (var display in Model.OpenOrders ?? Array.Empty<OrderDisplayViewModel>())
                {
                    var order = display.Order;
                    <tr>
                        <td class="text-bold">@order.Ticker</td>
                        <td class="@(order.Side == "buy" ? "value-good" : "value-bad")">@order.Side.ToUpper()</td>
                        <td>@(string.IsNullOrEmpty(order.OrderType) ? "-" : order.OrderType.ToUpper())</td>
                        <td>@order.Qty</td>
                        <td>@(order.LimitPrice?.ToString("C2") ?? "-")</td>
                        <td>@(display.CurrentPrice?.ToString("C2") ?? "-")</td>
                        <td class="@(display.DistancePct < 0 ? "value-good" : "muted")">
                            @(display.DistancePct?.ToString("0.00") + "%" ?? "-")
                        </td>
                        <td>@order.Status</td>
                    </tr>
                }
                </tbody>
            </table>

            <h3 class="mt-xl">Live Portfolio (Positions)</h3>
            <p id="openPositionsEmpty" class="muted" hidden="@(!(Model.OpenPositions == null || Model.OpenPositions.Count == 0))">No open positions found.</p>
            <table id="openPositionsTable" class="table data-grid-table mt-md" hidden="@(Model.OpenPositions == null || Model.OpenPositions.Count == 0)">
                <thead>
                    <tr>
                        <th>Ticker</th>
                        <th>Side</th>
                        <th>Qty</th>
                        <th>Entry Px</th>
                        <th>Current Px</th>
                        <th>Unrealized P/L</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="openPositionsBody">
                @foreach (var pos in Model.OpenPositions ?? Array.Empty<TradingFlow.Domain.Orders.BrokerPosition>())
                {
                    var isProfit = pos.UnrealizedPl > 0;
                    var plClass = isProfit ? "value-good" : (pos.UnrealizedPl < 0 ? "value-bad" : "value-flat");
                    <tr>
                        <td class="text-bold">@pos.Ticker</td>
                        <td>@pos.Side.ToUpper()</td>
                        <td>@pos.Qty</td>
                        <td>@pos.EntryPrice.ToString("C2")</td>
                        <td>@pos.CurrentPrice.ToString("C2")</td>
                        <td class="@plClass">
                            @(pos.UnrealizedPl > 0 ? "+" : "")@pos.UnrealizedPl.ToString("C2")
                        </td>
                        <td>
                            <form class="m-0" method="post" asp-page-handler="ClosePosition" asp-route-id="@Model.Job?.JobId" asp-route-ticker="@pos.Ticker">
                                <button type="submit" class="button danger-soft" onclick="return confirm('Market sell your entire position in @pos.Ticker?');">Close Position</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            <h3 class="mt-xl" id="profilerTitle">@(Model.LatencyProfile?.Name ?? "Alpaca API Profiler") Latency & Performance Profiler</h3>
            <div id="profilerBody">
            @if (Model.LatencyProfile == null || Model.LatencyProfile.TotalRequests == 0)
            {
                <p class="muted">No API requests recorded yet.</p>
            }
            else
            {
                <div class="muted mb-md">Started at: @Model.LatencyProfile.AppStartTime.ToString("yyyy-MM-dd HH:mm:ss")</div>
                <div class="metric-panel">
                    <div class="metric-row">
                        <div class="code-block">
                            <div class="muted text-sm">Total Requests</div>
                            <div class="metric-value good">@Model.LatencyProfile.TotalRequests</div>
                        </div>
                        <div class="code-block">
                            <div class="muted text-sm">Avg Duration</div>
                            <div class="metric-value info">@Model.LatencyProfile.AvgDurationMs.ToString("F1") ms</div>
                        </div>
                        <div class="code-block">
                            <div class="muted text-sm">Max Duration</div>
                            <div class="metric-value warn">@Model.LatencyProfile.MaxDurationMs.ToString("F1") ms</div>
                        </div>
                        <div class="code-block">
                            <div class="muted text-sm">Success Rate</div>
                            <div class="metric-value @(Model.LatencyProfile.SuccessRate >= 99.0 ? "good" : "bad")">@Model.LatencyProfile.SuccessRate.ToString("F1")%</div>
                        </div>
                    </div>

                    <div class="scroll-y h-sm">
                        <table class="table data-grid-table">
                            <thead class="sticky">
                                <tr>
                                    <th>Endpoint Route</th>
                                    <th>Count</th>
                                    <th>Avg Latency</th>
                                    <th>Min</th>
                                    <th>Max</th>
                                    <th>Success %</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var endpoint in Model.LatencyProfile.Endpoints)
                            {
                                <tr>
                                    <td class="route-cell">@endpoint.Route</td>
                                    <td>@endpoint.Count</td>
                                    <td>@endpoint.AvgDurationMs.ToString("F1") ms</td>
                                    <td>@endpoint.MinDurationMs.ToString("F1") ms</td>
                                    <td>@endpoint.MaxDurationMs.ToString("F1") ms</td>
                                    <td class="@(endpoint.SuccessRate >= 99.0 ? "value-good" : "value-bad")">@endpoint.SuccessRate.ToString("F1")%</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            </div>
        </section>
    </div>
}
