@page "{id:guid}"
@model TradingFlow.Web.Pages.PaperJobModel
@{
    ViewData["Title"] = "Paper Job";
}

@section Scripts {
    <script>
        (function () {
            const jobId = window.tradingFlowJobId;
            if (!jobId) return;

            const statusEl = document.getElementById('jobStatus');
            const startedAtEl = document.getElementById('startedAt');
            const marketDataFeedEl = document.getElementById('marketDataFeed');
            const metricsLastRefreshEl = document.getElementById('metricsLastRefresh');
            const eventsEl = document.getElementById('recentEvents');
            const auditsBody = document.getElementById('recentAuditsBody');
            const auditsTable = document.getElementById('recentAuditsTable');
            const auditsEmpty = document.getElementById('recentAuditsEmpty');
            const metricsBody = document.getElementById('liveMetricsBody');
            const metricsTable = document.getElementById('liveMetricsTable');
            const metricsEmpty = document.getElementById('liveMetricsEmpty');
            const ordersBody = document.getElementById('openOrdersBody');
            const ordersTable = document.getElementById('openOrdersTable');
            const ordersEmpty = document.getElementById('openOrdersEmpty');
            const positionsBody = document.getElementById('openPositionsBody');
            const positionsTable = document.getElementById('openPositionsTable');
            const positionsEmpty = document.getElementById('openPositionsEmpty');
            const profilerTitle = document.getElementById('profilerTitle');
            const profilerBody = document.getElementById('profilerBody');
            const currencyFormatter = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
            const numberFormatter = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 });
            const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

            function escapeHtml(value) {
                return String(value ?? '')
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }

            async function refreshSnapshot() {
                let data;
                try {
                    const response = await fetch(`?handler=Snapshot&id=${encodeURIComponent(jobId)}`, { cache: 'no-store' });
                    if (!response.ok) return;
                    data = await response.json();
                } catch {
                    return;
                }

                if (!data.success) return;

                if (statusEl) {
                    statusEl.textContent = data.status;
                    statusEl.className = `status ${data.status}`;
                }

                if (startedAtEl) {
                    startedAtEl.textContent = data.startedAt;
                }

                if (marketDataFeedEl) {
                    marketDataFeedEl.textContent = data.marketDataFeed;
                }

                if (metricsLastRefreshEl) {
                    metricsLastRefreshEl.textContent = data.refreshedAt;
                }

                if (eventsEl) {
                    eventsEl.innerHTML = data.events.map(eventText => `<div>${escapeHtml(eventText)}</div>`).join('');
                }

                if (metricsBody && metricsTable && metricsEmpty) {
                    const metrics = data.metrics ?? [];
                    metricsEmpty.style.display = metrics.length === 0 ? 'block' : 'none';
                    metricsTable.style.display = metrics.length === 0 ? 'none' : 'table';
                    metricsBody.innerHTML = metrics.map(point => `<tr>
                        <td>${escapeHtml(point.time)}</td>
                        <td><strong>${escapeHtml(point.ticker)}</strong></td>
                        <td>${escapeHtml(point.timeframe)}</td>
                        <td>${formatCurrency(point.close)}</td>
                        <td>${formatDecimal(point.rsi)}</td>
                        <td>${formatWholeNumber(point.volume)}</td>
                        <td>${formatWholeNumber(point.averageVolume)}</td>
                        <td>${formatDecimal(point.slotRelativeVolume)}</td>
                        <td>${formatWholeNumber(point.cumulativeAverageVolume)}</td>
                        <td>${formatDecimal(point.relativeVolume)}</td>
                        <td>${formatWholeNumber(point.relativeVolumeSampleCount)}</td>
                        <td>${formatCurrency(point.vwap)}</td>
                    </tr>`).join('');
                }

                if (auditsBody && auditsTable && auditsEmpty) {
                    const audits = data.audits ?? [];
                    auditsEmpty.style.display = audits.length === 0 ? 'block' : 'none';
                    auditsTable.style.display = audits.length === 0 ? 'none' : 'table';
                    auditsBody.innerHTML = audits.map(audit => {
                        const color = audit.decision === 'Accepted'
                            ? '#4caf50'
                            : (audit.decision === 'Rejected' ? '#f44336' : '#aaa');
                        const raw = audit.rawReason ? `<br /><code>${escapeHtml(audit.rawReason)}</code>` : '';
                        return `<tr style="border-bottom: 1px solid #333;">
                            <td style="white-space: nowrap;">${escapeHtml(audit.time)}</td>
                            <td style="font-weight: bold;">${escapeHtml(audit.ticker)}</td>
                            <td style="color: ${color}; font-weight: bold;">${escapeHtml(audit.decision)}</td>
                            <td style="color: #aaa; font-size: 0.9em;">${escapeHtml(audit.reason)}${raw}</td>
                        </tr>`;
                    }).join('');
                }

                if (ordersBody && ordersTable && ordersEmpty) {
                    updateOpenOrders(data.openOrders ?? []);
                }

                if (positionsBody && positionsTable && positionsEmpty) {
                    updateOpenPositions(data.openPositions ?? []);
                }

                if (profilerTitle && profilerBody) {
                    updateProfiler(data.profiler);
                }

                if (data.status !== 'queued' && data.status !== 'running') {
                    window.clearInterval(window.tradingFlowPaperJobRefresh);
                }
            }

            function formatCurrency(value) {
                return value === null || value === undefined ? 'N/A' : currencyFormatter.format(Number(value));
            }

            function formatDecimal(value) {
                return value === null || value === undefined ? 'N/A' : Number(value).toFixed(2);
            }

            function formatWholeNumber(value) {
                return value === null || value === undefined ? 'N/A' : numberFormatter.format(Number(value));
            }

            function updateProfiler(profile) {
                if (!profile || Number(profile.totalRequests ?? 0) === 0) {
                    profilerTitle.textContent = 'Alpaca API Profiler Latency & Performance Profiler';
                    profilerBody.innerHTML = '<p class="muted">No API requests recorded yet.</p>';
                    return;
                }

                profilerTitle.textContent = `${escapeHtml(profile.name)} Latency & Performance Profiler`;
                const endpointRows = (profile.endpoints ?? []).map(endpoint => `<tr style="border-bottom: 1px solid #333;">
                    <td style="font-family: monospace; color: #66b3ff;">${escapeHtml(endpoint.route)}</td>
                    <td>${formatWholeNumber(endpoint.count)}</td>
                    <td>${formatDecimal(endpoint.avgDurationMs)} ms</td>
                    <td>${formatDecimal(endpoint.minDurationMs)} ms</td>
                    <td>${formatDecimal(endpoint.maxDurationMs)} ms</td>
                    <td style="color: ${Number(endpoint.successRate) >= 99 ? '#4caf50' : '#ff5722'}">${formatDecimal(endpoint.successRate)}%</td>
                </tr>`).join('');

                profilerBody.innerHTML = `
                    <div class="muted" style="margin-bottom: 1rem;">Started at: ${escapeHtml(profile.appStartTime)}</div>
                    <div style="background: #222; padding: 1rem; border-radius: 4px; margin-top: 1rem;">
                        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1rem; text-align: center;">
                            <div style="background: #2b2b2b; padding: 0.5rem; border-radius: 4px;">
                                <div class="muted" style="font-size: 0.8rem;">Total Requests</div>
                                <div style="font-size: 1.5rem; font-weight: bold; color: #4caf50;">${formatWholeNumber(profile.totalRequests)}</div>
                            </div>
                            <div style="background: #2b2b2b; padding: 0.5rem; border-radius: 4px;">
                                <div class="muted" style="font-size: 0.8rem;">Avg Duration</div>
                                <div style="font-size: 1.5rem; font-weight: bold; color: #00bcd4;">${formatDecimal(profile.avgDurationMs)} ms</div>
                            </div>
                            <div style="background: #2b2b2b; padding: 0.5rem; border-radius: 4px;">
                                <div class="muted" style="font-size: 0.8rem;">Max Duration</div>
                                <div style="font-size: 1.5rem; font-weight: bold; color: #ff9800;">${formatDecimal(profile.maxDurationMs)} ms</div>
                            </div>
                            <div style="background: #2b2b2b; padding: 0.5rem; border-radius: 4px;">
                                <div class="muted" style="font-size: 0.8rem;">Success Rate</div>
                                <div style="font-size: 1.5rem; font-weight: bold; color: ${Number(profile.successRate) >= 99 ? '#4caf50' : '#ff5722'};">${formatDecimal(profile.successRate)}%</div>
                            </div>
                        </div>
                        <div style="max-height: 260px; overflow-y: auto;">
                            <table class="table" style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                                <thead style="position: sticky; top: 0; background: #222; z-index: 1;">
                                    <tr style="border-bottom: 1px solid #444; text-align: left;">
                                        <th>Endpoint Route</th>
                                        <th>Count</th>
                                        <th>Avg Latency</th>
                                        <th>Min</th>
                                        <th>Max</th>
                                        <th>Success %</th>
                                    </tr>
                                </thead>
                                <tbody>${endpointRows}</tbody>
                            </table>
                        </div>
                    </div>`;
            }

            function updateOpenOrders(orders) {
                ordersEmpty.style.display = orders.length === 0 ? 'block' : 'none';
                ordersTable.style.display = orders.length === 0 ? 'none' : 'table';
                ordersBody.innerHTML = orders.map(order => {
                    const side = String(order.side ?? '').toLowerCase();
                    const sideColor = side === 'buy' ? '#4caf50' : '#f44336';
                    const distance = order.distancePct === null || order.distancePct === undefined
                        ? '-'
                        : `${Number(order.distancePct).toFixed(2)}%`;
                    const distanceColor = Number(order.distancePct ?? 0) < 0 ? '#4caf50' : '#aaa';
                    return `<tr style="border-bottom: 1px solid #333;">
                        <td style="font-weight: bold;">${escapeHtml(order.ticker)}</td>
                        <td style="color: ${sideColor}">${escapeHtml(side.toUpperCase())}</td>
                        <td>${escapeHtml(String(order.orderType || '-').toUpperCase())}</td>
                        <td>${formatDecimal(order.qty)}</td>
                        <td>${formatCurrency(order.limitPrice)}</td>
                        <td>${formatCurrency(order.currentPrice)}</td>
                        <td style="color: ${distanceColor}">${escapeHtml(distance)}</td>
                        <td>${escapeHtml(order.status)}</td>
                    </tr>`;
                }).join('');
            }

            function updateOpenPositions(positions) {
                positionsEmpty.style.display = positions.length === 0 ? 'block' : 'none';
                positionsTable.style.display = positions.length === 0 ? 'none' : 'table';
                positionsBody.innerHTML = positions.map(position => {
                    const pl = Number(position.unrealizedPl ?? 0);
                    const plColor = pl > 0 ? '#4caf50' : (pl < 0 ? '#f44336' : '#aaa');
                    const plText = `${pl > 0 ? '+' : ''}${formatCurrency(pl)}`;
                    const ticker = String(position.ticker ?? '');
                    const closeAction = `?handler=ClosePosition&id=${encodeURIComponent(jobId)}&ticker=${encodeURIComponent(ticker)}`;
                    return `<tr style="border-bottom: 1px solid #333;">
                        <td style="font-weight: bold;">${escapeHtml(ticker)}</td>
                        <td>${escapeHtml(String(position.side || '').toUpperCase())}</td>
                        <td>${formatDecimal(position.qty)}</td>
                        <td>${formatCurrency(position.entryPrice)}</td>
                        <td>${formatCurrency(position.currentPrice)}</td>
                        <td style="color: ${plColor}; font-weight: bold;">${escapeHtml(plText)}</td>
                        <td>
                            <form method="post" action="${closeAction}" style="margin: 0;">
                                <input name="__RequestVerificationToken" type="hidden" value="${escapeHtml(antiforgeryToken)}" />
                                <button type="submit" class="button secondary" style="background: #3a1a1a; color: #ff6666; border-color: #662222;" onclick="return confirm('Market sell your entire position in ${escapeHtml(ticker)}?');">Close Position</button>
                            </form>
                        </td>
                    </tr>`;
                }).join('');
            }

            window.tradingFlowPaperJobRefresh = window.setInterval(refreshSnapshot, 5000);
            refreshSnapshot();
        })();
    </script>
}

<div class="section-title">
    <div>
        <h1>Paper Run: @Model.Job?.RunName</h1>
        <div class="muted">Live execution metrics and signals</div>
    </div>
    <div style="display: flex; gap: 1rem; align-items: center;">
        @if (Model.Job?.Status is "queued" or "running")
        {
            <form method="post" asp-page-handler="CancelRun" asp-route-id="@Model.Job.JobId" style="margin: 0;">
                <button type="submit" class="button secondary">Cancel Runner</button>
            </form>
        }
        <form method="post" asp-page-handler="CancelOrders" asp-route-id="@Model.Job?.JobId" style="margin: 0;">
            <button type="submit" class="button secondary">Cancel All Broker Orders</button>
        </form>
        <a class="button secondary" asp-page="/Paper">Back to Lab</a>
    </div>
</div>

@if (Model.Job is null)
{
    <p class="warn">Job not found.</p>
}
else
{
    <div class="grid two">
        <section class="panel">
            <h2>Status: <span id="jobStatus" class="status @Model.Job.Status">@Model.Job.Status</span></h2>
            @if (!string.IsNullOrEmpty(Model.Job.ErrorMessage))
            {
                <div class="alert alert-danger" style="background: #f8d7da; color: #721c24; padding: 1rem; border-radius: 4px; margin-bottom: 1rem;">
                    <strong>Error:</strong> @Model.Job.ErrorMessage
                </div>
            }
            <p><strong>Config:</strong> @Model.Job.ConfigPath</p>
            <p><strong>Started:</strong> <span id="startedAt">@(Model.Job.StartedAt is null ? "Queued" : Model.FormatLocal(Model.Job.StartedAt.Value))</span> <span class="muted">@Model.LocalTimeZoneLabel</span></p>
            <div style="margin-top: 1rem; margin-bottom: 1rem;">
                <a asp-page="/Audit" asp-route-runName="@Model.Job.RunName" asp-route-returnUrl="@($"/PaperJob/{Model.Job.JobId}")" class="button" style="background: #007acc; color: white;">Open Audit Analyzer</a>
            </div>
            @if (Model.Strategy != null)
            {
                <div style="background: #2a2a2a; border-left: 4px solid #007acc; padding: 1rem; margin-top: 1rem; border-radius: 4px;">
                    <h3 style="margin-top: 0; color: #66b3ff;">@Model.Strategy.StrategyName v@(Model.Strategy.Version)</h3>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 0.5rem;">
                        <div><strong>Timeframe:</strong> @Model.Strategy.Timeframe</div>
                        <div><strong>Direction:</strong> @Model.Strategy.Direction</div>
                        @if (Model.Strategy.ExitRules != null)
                        {
                            <div><strong>ATR Stop:</strong> @Model.Strategy.ExitRules.StopAtrMultiple x</div>
                            <div><strong>Target R:</strong> @Model.Strategy.ExitRules.TargetRMultiple x</div>
                        }
                    </div>
                </div>
            }

            <h3 style="margin-top: 1rem;">Recent Events</h3>
            <div id="recentEvents" class="log-viewer" style="height: 300px; overflow-y: auto; background: #1e1e1e; color: #fff; padding: 1rem; border-radius: 4px; font-family: monospace;">
                @foreach (var ev in Model.Job.Events.Reverse())
                {
                    <div>@ev</div>
                }
            </div>

            @if (Model.Job.Status is "queued" or "running")
            {
                <script>
                    window.tradingFlowJobId = '@Model.Job.JobId';
                </script>
            }
        </section>

        <section class="panel">
            <h2>Live Stock Metrics</h2>
            <div class="muted">Most recent values calculated by the engine for the latest bar. <span id="marketDataFeed">@Model.MarketDataFeedLabel</span>. Last refreshed: <span id="metricsLastRefresh">@Model.FormatLocal(DateTimeOffset.UtcNow)</span>.</div>
            <p id="liveMetricsEmpty" class="muted" style="display: @(Model.ChartDataList.Count == 0 ? "block" : "none");">No data generated yet. Waiting for market data...</p>
            <table id="liveMetricsTable" class="table" style="width: 100%; margin-top: 1rem; border-collapse: collapse; display: @(Model.ChartDataList.Count == 0 ? "none" : "table");">
                <thead>
                    <tr style="border-bottom: 1px solid #444; text-align: left;">
                        <th>Bar Time</th>
                        <th>Ticker</th>
                        <th>Candle</th>
                        <th>Close Price</th>
                        <th>RSI (14)</th>
                        <th>Volume</th>
                        <th title="Average volume for this same ticker, timeframe, and exchange-time candle slot from prior sessions. Diagnostic only.">Slot Avg Vol</th>
                        <th title="Current candle volume divided by the same slot average. Diagnostic only; not the primary strategy RVOL.">Slot RVOL</th>
                        <th title="Average cumulative session volume at this same exchange-time candle slot from prior sessions. This is the denominator for strategy RVOL.">Cumul Avg Vol</th>
                        <th title="Primary strategy RVOL: current session cumulative volume divided by average cumulative session volume at this same exchange-time slot across prior sessions.">RVOL</th>
                        <th title="Number of prior same-time sessions used for the RVOL baseline.">Samples</th>
                        <th>VWAP</th>
                    </tr>
                </thead>
                <tbody id="liveMetricsBody">
                    @foreach (var point in Model.ChartDataList.OrderBy(x => x.Ticker))
                    {
                        <tr>
                            <td>@Model.FormatMetricTimestamp(point.Timestamp, point.Timeframe)</td>
                            <td><strong>@point.Ticker</strong></td>
                            <td>@point.Timeframe</td>
                            <td>@point.Close.ToString("C2")</td>
                            <td>@(point.Rsi?.ToString("F2") ?? "N/A")</td>
                            <td>@point.Volume.ToString("N0")</td>
                            <td>@point.SlotAverageVolume.ToString("N0")</td>
                            <td>@point.SlotRelativeVolume.ToString("F2")</td>
                            <td>@point.CumulativeAverageVolume.ToString("N0")</td>
                            <td>@point.RelativeVolume.ToString("F2")</td>
                            <td>@point.RelativeVolumeSampleCount</td>
                            <td>@(point.Vwap?.ToString("C2") ?? "N/A")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h3 style="margin-top: 2rem;">Recent Strategy Evaluations</h3>
            <p id="recentAuditsEmpty" class="muted" style="display: @(Model.RecentAudits == null || Model.RecentAudits.Count == 0 ? "block" : "none")">No recent strategy evaluations.</p>
            <div style="max-height: 300px; overflow-y: auto;">
                <table id="recentAuditsTable" class="table" style="width: 100%; margin-top: 1rem; border-collapse: collapse; display: @(Model.RecentAudits == null || Model.RecentAudits.Count == 0 ? "none" : "table")">
                    <thead style="position: sticky; top: 0; background: #1e1e1e; z-index: 1;">
                        <tr style="border-bottom: 1px solid #444; text-align: left;">
                            <th>Local Time</th>
                            <th>Ticker</th>
                            <th>Decision</th>
                            <th>Rejection Reason</th>
                        </tr>
                    </thead>
                    <tbody id="recentAuditsBody">
                    @foreach (var audit in Model.RecentAudits ?? Enumerable.Empty<TradingFlow.Domain.Audit.DecisionAuditRecord>())
                    {
                        var color = audit.Decision == "Accepted" ? "#4caf50" : (audit.Decision == "Rejected" ? "#f44336" : "#aaa");
                        <tr style="border-bottom: 1px solid #333;">
                            <td style="white-space: nowrap;">@Model.FormatLocalTime(audit.Timestamp)</td>
                            <td style="font-weight: bold;">@audit.Ticker</td>
                            <td style="color: @color; font-weight: bold;">@audit.Decision</td>
                            <td style="color: #aaa; font-size: 0.9em;">
                                @Model.FormatRejectionReason(audit.RejectionReason)
                                @if (!String.IsNullOrWhiteSpace(audit.RejectionReason))
                                {
                                    <br /><code>@audit.RejectionReason</code>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <h3 style="margin-top: 2rem;">Live Broker Orders</h3>
            <p id="openOrdersEmpty" class="muted" style="display: @(Model.OpenOrders == null || Model.OpenOrders.Count == 0 ? "block" : "none");">No open orders found.</p>
            <table id="openOrdersTable" class="table" style="width: 100%; margin-top: 1rem; border-collapse: collapse; display: @(Model.OpenOrders == null || Model.OpenOrders.Count == 0 ? "none" : "table");">
                <thead>
                    <tr style="border-bottom: 1px solid #444; text-align: left;">
                        <th>Ticker</th>
                        <th>Side</th>
                        <th>Type</th>
                        <th>Qty</th>
                        <th>Limit Px</th>
                        <th>Current Px</th>
                        <th>Distance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="openOrdersBody">
                @foreach (var display in Model.OpenOrders ?? Array.Empty<OrderDisplayViewModel>())
                {
                    var order = display.Order;
                    <tr style="border-bottom: 1px solid #333;">
                        <td style="font-weight: bold;">@order.Ticker</td>
                        <td style="color: @(order.Side == "buy" ? "#4caf50" : "#f44336")">@order.Side.ToUpper()</td>
                        <td>@(string.IsNullOrEmpty(order.OrderType) ? "-" : order.OrderType.ToUpper())</td>
                        <td>@order.Qty</td>
                        <td>@(order.LimitPrice?.ToString("C2") ?? "-")</td>
                        <td>@(display.CurrentPrice?.ToString("C2") ?? "-")</td>
                        <td style="color: @(display.DistancePct < 0 ? "#4caf50" : "#aaa")">
                            @(display.DistancePct?.ToString("0.00") + "%" ?? "-")
                        </td>
                        <td>@order.Status</td>
                    </tr>
                }
                </tbody>
            </table>

            <h3 style="margin-top: 2rem;">Live Portfolio (Positions)</h3>
            <p id="openPositionsEmpty" class="muted" style="display: @(Model.OpenPositions == null || Model.OpenPositions.Count == 0 ? "block" : "none");">No open positions found.</p>
            <table id="openPositionsTable" class="table" style="width: 100%; margin-top: 1rem; border-collapse: collapse; display: @(Model.OpenPositions == null || Model.OpenPositions.Count == 0 ? "none" : "table");">
                <thead>
                    <tr style="border-bottom: 1px solid #444; text-align: left;">
                        <th>Ticker</th>
                        <th>Side</th>
                        <th>Qty</th>
                        <th>Entry Px</th>
                        <th>Current Px</th>
                        <th>Unrealized P/L</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="openPositionsBody">
                @foreach (var pos in Model.OpenPositions ?? Array.Empty<TradingFlow.Domain.Orders.BrokerPosition>())
                {
                    var isProfit = pos.UnrealizedPl > 0;
                    var color = isProfit ? "#4caf50" : (pos.UnrealizedPl < 0 ? "#f44336" : "#aaa");
                    <tr style="border-bottom: 1px solid #333;">
                        <td style="font-weight: bold;">@pos.Ticker</td>
                        <td>@pos.Side.ToUpper()</td>
                        <td>@pos.Qty</td>
                        <td>@pos.EntryPrice.ToString("C2")</td>
                        <td>@pos.CurrentPrice.ToString("C2")</td>
                        <td style="color: @color; font-weight: bold;">
                            @(pos.UnrealizedPl > 0 ? "+" : "")@pos.UnrealizedPl.ToString("C2")
                        </td>
                        <td>
                            <form method="post" asp-page-handler="ClosePosition" asp-route-id="@Model.Job?.JobId" asp-route-ticker="@pos.Ticker" style="margin: 0;">
                                <button type="submit" class="button secondary" style="background: #3a1a1a; color: #ff6666; border-color: #662222;" onclick="return confirm('Market sell your entire position in @pos.Ticker?');">Close Position</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            <h3 id="profilerTitle" style="margin-top: 2rem;">@(Model.LatencyProfile?.Name ?? "Alpaca API Profiler") Latency & Performance Profiler</h3>
            <div id="profilerBody">
            @if (Model.LatencyProfile == null || Model.LatencyProfile.TotalRequests == 0)
            {
                <p class="muted">No API requests recorded yet.</p>
            }
            else
            {
                <div class="muted" style="margin-bottom: 1rem;">Started at: @Model.LatencyProfile.AppStartTime.ToString("yyyy-MM-dd HH:mm:ss")</div>
                <div style="background: #222; padding: 1rem; border-radius: 4px; margin-top: 1rem;">
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1rem; text-align: center;">
                        <div style="background: #2b2b2b; padding: 0.5rem; border-radius: 4px;">
                            <div class="muted" style="font-size: 0.8rem;">Total Requests</div>
                            <div style="font-size: 1.5rem; font-weight: bold; color: #4caf50;">@Model.LatencyProfile.TotalRequests</div>
                        </div>
                        <div style="background: #2b2b2b; padding: 0.5rem; border-radius: 4px;">
                            <div class="muted" style="font-size: 0.8rem;">Avg Duration</div>
                            <div style="font-size: 1.5rem; font-weight: bold; color: #00bcd4;">@Model.LatencyProfile.AvgDurationMs.ToString("F1") ms</div>
                        </div>
                        <div style="background: #2b2b2b; padding: 0.5rem; border-radius: 4px;">
                            <div class="muted" style="font-size: 0.8rem;">Max Duration</div>
                            <div style="font-size: 1.5rem; font-weight: bold; color: #ff9800;">@Model.LatencyProfile.MaxDurationMs.ToString("F1") ms</div>
                        </div>
                        <div style="background: #2b2b2b; padding: 0.5rem; border-radius: 4px;">
                            <div class="muted" style="font-size: 0.8rem;">Success Rate</div>
                            <div style="font-size: 1.5rem; font-weight: bold; color: @(Model.LatencyProfile.SuccessRate >= 99.0 ? "#4caf50" : "#ff5722");">@Model.LatencyProfile.SuccessRate.ToString("F1")%</div>
                        </div>
                    </div>

                    <div style="max-height: 260px; overflow-y: auto;">
                        <table class="table" style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                            <thead style="position: sticky; top: 0; background: #222; z-index: 1;">
                                <tr style="border-bottom: 1px solid #444; text-align: left;">
                                    <th>Endpoint Route</th>
                                    <th>Count</th>
                                    <th>Avg Latency</th>
                                    <th>Min</th>
                                    <th>Max</th>
                                    <th>Success %</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var endpoint in Model.LatencyProfile.Endpoints)
                            {
                                <tr style="border-bottom: 1px solid #333;">
                                    <td style="font-family: monospace; color: #66b3ff;">@endpoint.Route</td>
                                    <td>@endpoint.Count</td>
                                    <td>@endpoint.AvgDurationMs.ToString("F1") ms</td>
                                    <td>@endpoint.MinDurationMs.ToString("F1") ms</td>
                                    <td>@endpoint.MaxDurationMs.ToString("F1") ms</td>
                                    <td style="color: @(endpoint.SuccessRate >= 99.0 ? "#4caf50" : "#ff5722")">@endpoint.SuccessRate.ToString("F1")%</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            </div>
        </section>
    </div>
}
