@page
@using TradingFlow.Web.Pages.Shared
@model TradingFlow.Web.Pages.EarningsModel
@{
    ViewData["Title"] = "Earnings";
    ViewData["MainClass"] = "earnings-page market-workspace";
    // Three clocks on this screen: the print is scheduled in New York, the
    // operator reads it locally, and everything is stored in UTC.
    ViewData["ShowOperatorClock"] = true;
    // Reopen secondary filters when the URL carries a nondefault constraint or view.
    var secondaryDefaults = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["sector"] = "",
        ["view"] = "timeline",
        ["schedule"] = "",
        ["result"] = "",
        ["minMarketCap"] = "",
        ["maxMarketCap"] = "",
        ["minEventReturn"] = "",
        ["maxEventReturn"] = "",
        ["minPriceReaction"] = "",
        ["maxPriceReaction"] = "",
        ["minEpsEstimate"] = "",
        ["maxEpsEstimate"] = "",
        ["minEpsActual"] = "",
        ["maxEpsActual"] = "",
        ["minRevenueEstimate"] = "",
        ["maxRevenueEstimate"] = "",
        ["minRevenueActual"] = "",
        ["maxRevenueActual"] = "",
        ["provider"] = "",
        ["newsProvider"] = "",
        ["day"] = "",
        ["breakout"] = "",
        ["minEpsSurprise"] = "",
        ["maxEpsSurprise"] = "",
        ["minRevenueSurprise"] = "",
        ["maxRevenueSurprise"] = "",
        ["minSentiment"] = "",
        ["maxSentiment"] = "",
        ["onlyGroups"] = "false",
        ["groupId"] = "",
        ["from"] = "",
        ["to"] = "",
        ["session"] = "all",
        ["marketCap"] = "all",
        ["onlyHeld"] = "false",
        ["hasNews"] = "false",
        ["minSurprise"] = "",
        ["sort"] = "breakout"
    };
    var hasSecondaryFilters = Request.Query.Any(pair =>
        secondaryDefaults.TryGetValue(pair.Key, out var defaultValue) &&
        !String.IsNullOrWhiteSpace(pair.Value.ToString()) &&
        !String.Equals(pair.Value.ToString(), defaultValue, StringComparison.OrdinalIgnoreCase));
}

<link rel="stylesheet" href="~/css/market-workspace.css" asp-append-version="true" />

<header class="page-header market-page-header">
    <div>
        <h1>Earnings monitor</h1>
        <p>Reporting calendar, results and breakout evidence.</p>
    </div>
</header>

@* The compact monitor keeps freshness and advisory authority visible. *@
<section class="metric-strip earnings-monitor" aria-live="polite" aria-atomic="true">
    <div class="market-authority"><span class="micro-label">Authority</span><span class="metric-value">Advisory only · cannot route orders</span></div>
    <div>
        <span class="micro-label">Monitor</span>
        <span class="metric-value" id="earnings-status">Loading…</span>
    </div>
    <div>
        <span class="micro-label">Last analysis</span>
        <span class="metric-value" id="earnings-updated">—</span>
    </div>
    <div>
        <span class="micro-label">Evidence window</span>
        <span class="metric-value" id="earnings-news-window">—</span>
    </div>
    <div>
        <span class="micro-label">Next reporting day</span>
        <span class="metric-value" id="earnings-next-day">—</span>
    </div>
</section>

@* ===========================================================================
   Attention band - 3 counted lanes
   The whole point of the screen: what has already beaten and broken out, what
   is about to report, and what is reporting that the operator already holds.
   Clicking a lane intersects with the other filters; it does not replace them.
   =========================================================================== *@
<div class="earnings-lanes" id="earnings-lanes" role="group" aria-label="Attention lanes"
     data-held-tickers="@String.Join(",", Model.HeldTickers)">
    <button type="button" class="earnings-lane" data-lane="breakout" aria-pressed="false">
        <span class="earnings-lane-head">
            <partial name="_Icon" model='new IconModel("trending-up", 19)' />
            <span class="earnings-lane-count" data-lane-count>0</span>
            <span class="earnings-lane-label">Beat + confirmed breakout</span>
        </span>
        <span class="earnings-lane-rule">
            Beat result · completed close above the pre-release reference high · elevated slot volume.
        </span>
        <span class="earnings-lane-tickers" data-lane-tickers>None</span>
    </button>
    <button type="button" class="earnings-lane" data-lane="imminent" aria-pressed="false">
        <span class="earnings-lane-head">
            <partial name="_Icon" model='new IconModel("clock", 19)' />
            <span class="earnings-lane-count" data-lane-count>0</span>
            <span class="earnings-lane-label">Reporting in 30 min</span>
        </span>
        <span class="earnings-lane-rule">
            Within the next half hour · confirmed or estimated slot · no result evidence yet.
        </span>
        <span class="earnings-lane-tickers" data-lane-tickers>None</span>
    </button>
    <button type="button" class="earnings-lane" data-lane="held" aria-pressed="false">
        <span class="earnings-lane-head">
            <partial name="_Icon" model='new IconModel("briefcase", 19)' />
            <span class="earnings-lane-count" data-lane-count>0</span>
            <span class="earnings-lane-label">Held stocks reporting</span>
        </span>
        <span class="earnings-lane-rule">
            Open positions · reporting today or the next reporting day.
        </span>
        <span class="earnings-lane-tickers" data-lane-tickers>None</span>
    </button>
</div>

@* Keep date, search and result assessment visible; secondary filters retain their existing form association. *@
<section class="earnings-filters market-filter-panel" aria-label="Earnings filters">
    <div class="market-primary-toolbar">
        <div class="tab-strip" id="earnings-date-scope" role="group" aria-label="Earnings date scope">
            <button type="button" data-scope-value="today" aria-current="page">Today</button>
            <button type="button" data-scope-value="nextBusinessDay">Next reporting day</button>
            <button type="button" id="earnings-this-week">This week · NY</button>
        </div>
            <label class="earnings-inline-field">
                <span>Ticker</span>
                <input class="input" type="search" id="earnings-search" name="search" form="earnings-advanced" maxlength="200" placeholder="Ticker or company" autocomplete="off" />
            </label>
            <button type="button" class="btn btn-secondary btn-md" id="earnings-refresh">
                <partial name="_Icon" model='new IconModel("refresh-cw", 14)' />Refresh
            </button>
            <div id="earnings-spinner" class="earnings-spinner" hidden>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="earnings-loading-icon">
                    <line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
                </svg>
                <span class="earnings-loading-label" role="status">Updating…</span>
            </div>
    </div>
    <div class="market-assessment-toolbar">
        <div class="tab-strip" id="earnings-assessment-filters" role="group" aria-label="Result assessment">
            <button type="button" data-assessment-value="all" aria-current="page">All results</button>
            <button type="button" data-assessment-value="beat">Beat</button>
            <button type="button" data-assessment-value="miss">Miss</button>
            <button type="button" data-assessment-value="inline">In line</button>
            <button type="button" data-assessment-value="pending">Pending</button>
        </div>

            <span class="note earnings-count" id="earnings-count">—</span>
    </div>
</section>

<details class="panel market-more-filters" open="@hasSecondaryFilters">
    <summary>More earnings filters and views</summary>
    <div class="market-secondary-filters">
    <div class="earnings-filter-row">
        <span class="micro-label">Custom dates</span>
        <div class="earnings-range">
            <label class="visually-hidden" for="earnings-from">From date</label>
            <input class="input earnings-date" id="earnings-from" type="date" aria-label="From date" />
            <span aria-hidden="true">to</span>
            <label class="visually-hidden" for="earnings-to">To date</label>
            <input class="input earnings-date" id="earnings-to" type="date" aria-label="To date" />
            <button type="button" class="btn btn-secondary btn-md" id="earnings-range-apply">Apply</button>
            <button type="button" class="btn btn-secondary btn-md" id="earnings-range-clear">Clear range</button>
        </div>
    </div>

    <div class="earnings-filter-row">
        <span class="micro-label">Session</span>
        <div class="tab-strip" id="earnings-session-filters" role="group" aria-label="Release session">
            <button type="button" data-filter-value="all" aria-current="page">All sessions</button>
            <button type="button" data-filter-value="beforeMarketOpen">Pre-market</button>
            <button type="button" data-filter-value="duringMarket">Market hours</button>
            <button type="button" data-filter-value="afterMarketClose">Post-market</button>
        </div>
    </div>

    <div class="earnings-filter-row">
        <span class="micro-label">Market cap</span>
        <div class="tab-strip" id="earnings-cap-filters" role="group" aria-label="Market capitalization">
            <button type="button" data-filter-value="all" aria-current="page">All caps</button>
            <button type="button" data-filter-value="under2b">Under $2B</button>
            <button type="button" data-filter-value="2bPlus">$2B+</button>
            <button type="button" data-filter-value="10bPlus">$10B+</button>
            <button type="button" data-filter-value="50bPlus">$50B+</button>
            <button type="button" data-filter-value="100bPlus">$100B+</button>
            <button type="button" data-filter-value="unknown">Cap unknown</button>
        </div>
    </div>

    @* Sector and primary search submit with the advanced form. *@
    <div class="earnings-filter-row">
        <span class="micro-label">Sector</span>
        <div class="earnings-refine">
            <label class="earnings-inline-field">
                <span>Sector</span>
                <select class="input" id="earnings-sector" name="sector" form="earnings-advanced">
                    <option value="">All sectors</option>
                </select>
            </label>
        </div>
    </div>
    <div class="earnings-filter-row">
        <span class="micro-label">Refine</span>
        <div class="earnings-refine">
            @* Square controls: two independent booleans, not a choice of one. *@
            <div class="check-strip">
                <button type="button" class="check-chip" id="earnings-only-held" aria-pressed="false">
                    <partial name="_Icon" model='new IconModel("check", 13)' />Only symbols I hold
                </button>
                <button type="button" class="check-chip" id="earnings-has-news" aria-pressed="false">
                    <partial name="_Icon" model='new IconModel("check", 13)' />Has news evidence
                </button>
            </div>
            <label class="earnings-inline-field">
                <span>Min |EPS surprise| %</span>
                <input class="input" type="number" id="earnings-min-surprise" min="0" step="1" inputmode="decimal" />
            </label>
            <label class="earnings-inline-field">
                <span>Sort</span>
                <select class="input" id="earnings-sort">
                    <option value="breakout">Breakouts first</option>
                    <option value="time">Scheduled time</option>
                    <option value="cap">Market cap</option>
                    <option value="surprise">EPS surprise</option>
                    <option value="move">Event move</option>
                    <option value="revenue">Revenue surprise</option>
                </select>
            </label>
        </div>
    </div>
    </div>
    <h2 class="market-filter-subheading">Evidence &amp; display</h2>
    <form id="earnings-advanced" class="news-filter-bar market-advanced-grid">
        <div><label for="earnings-view">View</label><select id="earnings-view" name="view"><option value="timeline">Timeline</option><option value="week">Calendar by New York date</option></select></div>
        <div><label for="earnings-schedule">Schedule certainty</label><select id="earnings-schedule" name="schedule"><option value="">All schedules</option><option value="estimated">Estimated schedule</option><option value="reported">Provider-reported schedule</option></select></div>
        <div><label for="earnings-result">Observed result data</label><select id="earnings-result" name="result"><option value="">All results</option><option value="observed">Actuals or first-seen result</option><option value="pending">No observed result</option></select></div>
        <div><label for="earnings-minMarketCap">Minimum cap · USD millions</label><input id="earnings-minMarketCap" name="minMarketCap" type="number" step="any" min="0" /></div>
        <div><label for="earnings-maxMarketCap">Maximum cap · USD millions</label><input id="earnings-maxMarketCap" name="maxMarketCap" type="number" step="any" min="0" /></div>
        <div><label for="earnings-minEventReturn">Minimum event return %</label><input id="earnings-minEventReturn" name="minEventReturn" type="number" step="any" /></div>
        <div><label for="earnings-maxEventReturn">Maximum event return %</label><input id="earnings-maxEventReturn" name="maxEventReturn" type="number" step="any" /></div>
        <div><label for="earnings-minPriceReaction">Minimum provider one-day reaction %</label><input id="earnings-minPriceReaction" name="minPriceReaction" type="number" step="any" /></div>
        <div><label for="earnings-maxPriceReaction">Maximum provider one-day reaction %</label><input id="earnings-maxPriceReaction" name="maxPriceReaction" type="number" step="any" /></div>
        <div><label for="earnings-minEpsEstimate">Minimum EPS estimate · USD/share</label><input id="earnings-minEpsEstimate" name="minEpsEstimate" type="number" step="any" /></div>
        <div><label for="earnings-maxEpsEstimate">Maximum EPS estimate · USD/share</label><input id="earnings-maxEpsEstimate" name="maxEpsEstimate" type="number" step="any" /></div>
        <div><label for="earnings-minEpsActual">Minimum EPS actual · USD/share</label><input id="earnings-minEpsActual" name="minEpsActual" type="number" step="any" /></div>
        <div><label for="earnings-maxEpsActual">Maximum EPS actual · USD/share</label><input id="earnings-maxEpsActual" name="maxEpsActual" type="number" step="any" /></div>
        <div><label for="earnings-minRevenueEstimate">Minimum revenue estimate · USD millions</label><input id="earnings-minRevenueEstimate" name="minRevenueEstimate" type="number" step="any" min="0" /></div>
        <div><label for="earnings-maxRevenueEstimate">Maximum revenue estimate · USD millions</label><input id="earnings-maxRevenueEstimate" name="maxRevenueEstimate" type="number" step="any" min="0" /></div>
        <div><label for="earnings-minRevenueActual">Minimum revenue actual · USD millions</label><input id="earnings-minRevenueActual" name="minRevenueActual" type="number" step="any" min="0" /></div>
        <div><label for="earnings-maxRevenueActual">Maximum revenue actual · USD millions</label><input id="earnings-maxRevenueActual" name="maxRevenueActual" type="number" step="any" min="0" /></div>
        <div><label for="earnings-provider">Earnings provider</label><input id="earnings-provider" name="provider" /></div>
        <div><label for="earnings-news-provider">News provider</label><input id="earnings-news-provider" name="newsProvider" /></div>
        <div><label for="earnings-day">Reporting bucket (operator date)</label><select id="earnings-day" name="day"><option value="">All days</option><option value="today">Today</option><option value="nextBusinessDay">Next reporting day</option><option value="other">Other days</option></select></div>
        <div><label for="earnings-breakout">Breakout evidence</label><select id="earnings-breakout" name="breakout"><option value="">All evidence states</option><option value="AwaitingEarningsRelease">Awaiting release</option><option value="BreakoutDataInsufficient">Insufficient data</option><option value="PossibleBreakout">Possible breakout</option><option value="BreakoutNotConfirmed">Not confirmed</option></select></div>
        <div><label for="earnings-minEpsSurprise">Minimum EPS surprise %</label><input id="earnings-minEpsSurprise" name="minEpsSurprise" type="number" step="any" /></div>
        <div><label for="earnings-maxEpsSurprise">Maximum EPS surprise %</label><input id="earnings-maxEpsSurprise" name="maxEpsSurprise" type="number" step="any" /></div>
        <div><label for="earnings-minRevenueSurprise">Minimum revenue surprise %</label><input id="earnings-minRevenueSurprise" name="minRevenueSurprise" type="number" step="any" /></div>
        <div><label for="earnings-maxRevenueSurprise">Maximum revenue surprise %</label><input id="earnings-maxRevenueSurprise" name="maxRevenueSurprise" type="number" step="any" /></div>
        <div><label for="earnings-minSentiment">Minimum news sentiment (−1 to 1)</label><input id="earnings-minSentiment" name="minSentiment" type="number" step="any" /></div>
        <div><label for="earnings-maxSentiment">Maximum news sentiment (−1 to 1)</label><input id="earnings-maxSentiment" name="maxSentiment" type="number" step="any" /></div>
        @if (User.Identity?.IsAuthenticated == true) {
            <label class="checkbox-field"><input name="onlyGroups" type="checkbox" value="true" />Only my groups</label>
            <div><label for="earnings-group">Group</label><select id="earnings-group" name="groupId"><option value="">Any group</option></select></div>
        }
        <button type="submit" class="button secondary">Apply filters and view</button>
    </form>
</details>

@* ===========================================================================
   Body - timeline and evidence rail
   =========================================================================== *@
<div class="earnings-body">
    <section id="earnings-feed" class="earnings-timeline" aria-label="Chronological earnings calendar"></section>

    <aside class="earnings-rail" aria-labelledby="earnings-news-title">
        <header class="earnings-rail-head">
            <div>
                <h2 id="earnings-news-title" class="section-heading">
                    <partial name="_Icon" model='new IconModel("newspaper", 16)' />News &amp; evidence
                </h2>
                <p class="note" id="earnings-news-caption">Loading evidence…</p>
            </div>
            <span class="tag tag-neutral" id="earnings-news-count">0</span>
        </header>
        <button type="button" class="btn btn-secondary btn-md" id="earnings-news-scope-clear" hidden>
            Show all evidence
        </button>
        <div id="earnings-news-feed" class="earnings-news-feed" aria-live="polite"></div>
    </aside>
</div>

<template id="earnings-empty-template">
    <p class="empty-state">No earnings events or evidence are available for this period.</p>
</template>

<partial name="_GroupActions" />

@section Scripts {
    <script src="~/js/earnings.js" asp-append-version="true"></script>
    <script type="module" src="~/js/group-actions.js" asp-append-version="true"></script>
}
