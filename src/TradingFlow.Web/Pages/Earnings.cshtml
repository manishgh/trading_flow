@page
@using TradingFlow.Web.Pages.Shared
@model TradingFlow.Web.Pages.EarningsModel
@{
    ViewData["Title"] = "Earnings";
    ViewData["MainClass"] = "shell-flush earnings-page";
    // Three clocks on this screen: the print is scheduled in New York, the
    // operator reads it locally, and everything is stored in UTC.
    ViewData["ShowOperatorClock"] = true;
}

<h1 class="visually-hidden">Earnings monitor</h1>

@* ===========================================================================
   Monitor strip - 5 cells
   The Authority cell is not decoration. The monitor is advisory and cannot
   place an order; the screen says so rather than leaving it to be inferred.
   =========================================================================== *@
<section class="metric-strip earnings-monitor" aria-live="polite" aria-atomic="true">
    <div>
        <span class="micro-label">Monitor</span>
        <span class="metric-value" id="earnings-status">Loading…</span>
    </div>
    <div>
        <span class="micro-label">Last analysis</span>
        <span class="metric-value" id="earnings-updated">—</span>
    </div>
    <div>
        <span class="micro-label">Evidence window</span>
        <span class="metric-value" id="earnings-news-window">—</span>
    </div>
    <div>
        <span class="micro-label">Next reporting day</span>
        <span class="metric-value" id="earnings-next-day">—</span>
    </div>
    <div>
        <span class="micro-label">Authority</span>
        <span class="metric-value accent-note">Advisory only · cannot route</span>
    </div>
</section>

@* ===========================================================================
   Attention band - 3 counted lanes
   The whole point of the screen: what has already beaten and broken out, what
   is about to report, and what is reporting that the operator already holds.
   Clicking a lane intersects with the other filters; it does not replace them.
   =========================================================================== *@
<div class="earnings-lanes" id="earnings-lanes" role="group" aria-label="Attention lanes"
     data-held-tickers="@String.Join(",", Model.HeldTickers)">
    <button type="button" class="earnings-lane" data-lane="breakout" aria-pressed="false">
        <span class="earnings-lane-head">
            <partial name="_Icon" model='new IconModel("trending-up", 19)' />
            <span class="earnings-lane-count" data-lane-count>0</span>
            <span class="earnings-lane-label">Beat + breakout confirmed</span>
        </span>
        <span class="earnings-lane-rule">
            Result beat and a completed bar closed above the pre-release reference high on elevated slot volume.
        </span>
        <span class="earnings-lane-tickers" data-lane-tickers>None</span>
    </button>
    <button type="button" class="earnings-lane" data-lane="imminent" aria-pressed="false">
        <span class="earnings-lane-head">
            <partial name="_Icon" model='new IconModel("clock", 19)' />
            <span class="earnings-lane-count" data-lane-count>0</span>
            <span class="earnings-lane-label">Reporting within 30 minutes</span>
        </span>
        <span class="earnings-lane-rule">
            Confirmed or estimated slot inside the next half hour. No result evidence exists yet.
        </span>
        <span class="earnings-lane-tickers" data-lane-tickers>None</span>
    </button>
    <button type="button" class="earnings-lane" data-lane="held" aria-pressed="false">
        <span class="earnings-lane-head">
            <partial name="_Icon" model='new IconModel("briefcase", 19)' />
            <span class="earnings-lane-count" data-lane-count>0</span>
            <span class="earnings-lane-label">Symbols you hold reporting</span>
        </span>
        <span class="earnings-lane-rule">
            Open positions in the trading group with a print today or on the next reporting day.
        </span>
        <span class="earnings-lane-tickers" data-lane-tickers>None</span>
    </button>
</div>

@* ===========================================================================
   Filter bar - four rows
   =========================================================================== *@
<section class="earnings-filters" aria-label="Earnings filters">
    <div class="earnings-filter-row">
        <span class="micro-label">Dates</span>
        <div class="tab-strip" id="earnings-date-scope" role="group" aria-label="Earnings date scope">
            <button type="button" data-scope-value="today" aria-current="page">Today</button>
            <button type="button" data-scope-value="nextBusinessDay">Next reporting day</button>
        </div>
    </div>

    <div class="earnings-filter-row">
        <span class="micro-label">Custom dates</span>
        <div class="earnings-range">
            <label class="visually-hidden" for="earnings-from">From date</label>
            <input class="input" style="width: auto;" id="earnings-from" type="date" aria-label="From date" />
            <span aria-hidden="true">to</span>
            <label class="visually-hidden" for="earnings-to">To date</label>
            <input class="input" style="width: auto;" id="earnings-to" type="date" aria-label="To date" />
            <button type="button" class="btn btn-secondary btn-md" id="earnings-range-apply">Apply</button>
            <button type="button" class="btn btn-secondary btn-md" id="earnings-range-clear">Clear range</button>
            <div id="earnings-spinner" style="display: none; align-items: center; gap: 6px; margin-left: 12px; color: var(--color-accent);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="animation: spin 1s linear infinite;">
                    <line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
                </svg>
                <span style="font-size: 12px;">Loading...</span>
            </div>
            <style>
                @@keyframes spin { 100% { transform: rotate(360deg); } }
            </style>
        </div>
    </div>

    <div class="earnings-filter-row">
        <span class="micro-label">Session</span>
        <div class="tab-strip" id="earnings-session-filters" role="group" aria-label="Release session">
            <button type="button" data-filter-value="all" aria-current="page">All sessions</button>
            <button type="button" data-filter-value="beforeMarketOpen">Pre-market</button>
            <button type="button" data-filter-value="duringMarket">Market hours</button>
            <button type="button" data-filter-value="afterMarketClose">Post-market</button>
        </div>
    </div>

    <div class="earnings-filter-row">
        <span class="micro-label">Market cap</span>
        <div class="tab-strip" id="earnings-cap-filters" role="group" aria-label="Market capitalization">
            <button type="button" data-filter-value="all" aria-current="page">All caps</button>
            <button type="button" data-filter-value="under10b">Under $10B</button>
            <button type="button" data-filter-value="10bTo50b">$10B-$50B</button>
            <button type="button" data-filter-value="50bTo100b">$50B-$100B</button>
            <button type="button" data-filter-value="100bPlus">$100B+</button>
            <button type="button" data-filter-value="unknown">Cap unknown</button>
        </div>
    </div>

    <div class="earnings-filter-row">
        <span class="micro-label">Result</span>
        <div class="tab-strip" id="earnings-assessment-filters" role="group" aria-label="Result assessment">
            <button type="button" data-assessment-value="all" aria-current="page">All results</button>
            <button type="button" data-assessment-value="beat">Beat</button>
            <button type="button" data-assessment-value="miss">Miss</button>
            <button type="button" data-assessment-value="inline">In line</button>
            <button type="button" data-assessment-value="pending">Pending</button>
        </div>
    </div>

    <div class="earnings-filter-row">
        <span class="micro-label">Refine</span>
        <div class="earnings-refine">
            @* Square controls: two independent booleans, not a choice of one. *@
            <div class="check-strip">
                <button type="button" class="check-chip" id="earnings-only-held" aria-pressed="false">
                    <partial name="_Icon" model='new IconModel("check", 13)' />Only symbols I hold
                </button>
                <button type="button" class="check-chip" id="earnings-has-news" aria-pressed="false">
                    <partial name="_Icon" model='new IconModel("check", 13)' />Has news evidence
                </button>
            </div>
            <label class="earnings-inline-field">
                <span>Min |EPS surprise| %</span>
                <input class="input" type="number" id="earnings-min-surprise" min="0" step="1" inputmode="decimal" />
            </label>
            <label class="earnings-inline-field">
                <span>Sort</span>
                <select class="input" id="earnings-sort">
                    <option value="time">Scheduled time</option>
                    <option value="cap">Market cap</option>
                    <option value="surprise">EPS surprise</option>
                    <option value="move">Event move</option>
                    <option value="rvol">Relative volume</option>
                </select>
            </label>
            <span class="note earnings-count" id="earnings-count">—</span>
            <button type="button" class="btn btn-secondary btn-md" id="earnings-refresh">
                <partial name="_Icon" model='new IconModel("refresh-cw", 14)' />Refresh
            </button>
        </div>
    </div>
</section>

@* ===========================================================================
   Body - timeline and evidence rail
   =========================================================================== *@
<style>
    .earnings-body { transition: opacity 0.1s ease; }
    .earnings-body.is-loading { opacity: 0.3 !important; pointer-events: none; }
</style>
<div class="earnings-body">
    <section id="earnings-feed" class="earnings-timeline" aria-label="Chronological earnings calendar"></section>

    <aside class="earnings-rail" aria-labelledby="earnings-news-title">
        <header class="earnings-rail-head">
            <div>
                <h2 id="earnings-news-title" class="section-heading">
                    <partial name="_Icon" model='new IconModel("newspaper", 16)' />News &amp; evidence
                </h2>
                <p class="note" id="earnings-news-caption">Loading the current evidence window…</p>
            </div>
            <span class="tag tag-neutral" id="earnings-news-count">0</span>
        </header>
        <button type="button" class="btn btn-secondary btn-md" id="earnings-news-scope-clear" hidden>
            Show all evidence
        </button>
        <div id="earnings-news-feed" class="earnings-news-feed" aria-live="polite"></div>
    </aside>
</div>

<template id="earnings-empty-template">
    <p class="empty-state">No earnings events or evidence are available for this period.</p>
</template>

@section Scripts {
    <script src="~/js/earnings.js" asp-append-version="true"></script>
}
