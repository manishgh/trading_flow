@page
@model TradingFlow.Web.Pages.RunningTradesModel
@{
    ViewData["Title"] = "Running Trades";
    string PlColor(decimal value) => value > 0 ? "#067647" : value < 0 ? "#B42318" : "#475467";
    string SourceBadge(string source) => source switch
    {
        "wishlist" => "Wishlist",
        "stockpulse" => "Stock Pulse",
        "manual" => "Manual",
        _ => source
    };
}

<section class="trade-book">
    <div class="page-header">
        <div>
            <h1>Running Trades</h1>
            <p>One live book for wishlist, Stock Pulse, and manual paper positions.</p>
        </div>
        <div class="actions">
            <a class="button secondary" asp-page="/Wishlists">Wishlists</a>
            <a class="button secondary" asp-page="/Paper">Paper Lab</a>
        </div>
    </div>

    <div class="trade-summary-grid">
        <div class="summary-card">
            <span>Total P/L</span>
            <strong style="color:@PlColor(Model.TotalPl);">@Model.TotalPl.ToString("C2")</strong>
        </div>
        <div class="summary-card">
            <span>Open Trades</span>
            <strong>@Model.Trades.Count</strong>
        </div>
        <div class="summary-card">
            <span>Source Filter</span>
            <strong>@SourceBadge(Model.Source)</strong>
        </div>
    </div>

    <nav class="source-tabs">
        @foreach (var (key, label) in TradingFlow.Web.Pages.RunningTradesModel.Sources)
        {
            var active = string.Equals(Model.Source, key, StringComparison.OrdinalIgnoreCase);
            <a asp-page="/RunningTrades" asp-route-source="@key"
               class="@(active ? "active" : null)">
                @label
            </a>
        }
    </nav>

    @if (Model.Trades.Count == 0)
    {
        <div class="empty-state">
            No running trades for this source.
        </div>
    }
    else
    {
        <div class="table-scroll panel">
        <table class="trade-table">
            <thead>
                <tr>
                    <th>Ticker</th>
                    <th>Source</th>
                    <th class="num">Qty</th>
                    <th class="num">Entry</th>
                    <th class="num">Last</th>
                    <th class="num">P/L</th>
                    <th class="num">P/L %</th>
                    <th>Strategy</th>
                    <th>Protection</th>
                    <th>Run</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var trade in Model.Trades)
                {
                    <tr>
                        <td><strong>@trade.Ticker</strong></td>
                        <td><span class="source-chip">@SourceBadge(trade.Source)</span></td>
                        <td class="num">@trade.Quantity.ToString("0.####")</td>
                        <td class="num">@trade.EntryPrice.ToString("C2")</td>
                        <td class="num">@trade.CurrentPrice.ToString("C2")</td>
                        <td class="num" style="font-weight:700;color:@PlColor(trade.UnrealizedPl);">@trade.UnrealizedPl.ToString("C2")</td>
                        <td class="num" style="color:@PlColor(trade.UnrealizedPl);">@trade.UnrealizedPlPct.ToString("0.00")%</td>
                        <td>@trade.StrategyName</td>
                        <td>@trade.ProtectionSummary</td>
                        <td class="muted">@trade.Reference</td>
                        <td class="num">
                            <form method="post" asp-page-handler="Close" style="margin:0;">
                                <input type="hidden" name="Source" value="@Model.Source" />
                                <input type="hidden" name="closeKind" value="@trade.CloseKind" />
                                <input type="hidden" name="jobId" value="@(trade.JobId?.ToString())" />
                                <input type="hidden" name="sessionId" value="@(trade.SessionId?.ToString())" />
                                <input type="hidden" name="ticker" value="@trade.Ticker" />
                                <button type="submit" class="danger mini-button" onclick="return confirm('Sell @trade.Ticker now?');">
                                    Sell
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    <p class="muted" style="font-size:12px;margin-top:16px;">Auto-refreshes every 10 seconds.</p>
</section>

@section Scripts {
    <script>
        setTimeout(function () { window.location.reload(); }, 10000);
    </script>
}
