@page
@model TradingFlow.Web.Pages.RunningTradesModel
@{
    ViewData["Title"] = "Running Trades";
    string PlColor(decimal value) => value > 0 ? "#067647" : value < 0 ? "#B42318" : "#475467";
    string SourceBadge(string source) => source switch
    {
        "wishlist" => "Wishlist",
        "stockpulse" => "Stock Pulse",
        "manual" => "Manual",
        _ => source
    };
    string TradeKey(TradingFlow.Web.Models.MobileRunningTrade trade) =>
        $"{trade.CloseKind}:{trade.JobId?.ToString() ?? trade.SessionId?.ToString() ?? "none"}:{trade.Ticker}";
}

<section class="trade-book" data-running-trades data-source="@Model.Source">
    <div class="page-header">
        <div>
            <h1>Running Trades</h1>
            <p>One live book for wishlist, Stock Pulse, and manual paper positions.</p>
        </div>
        <div class="actions">
            <a class="button secondary" asp-page="/Wishlists">Wishlists</a>
            <a class="button secondary" asp-page="/Paper">Paper Lab</a>
            <button class="button secondary" type="button" data-trades-refresh>Refresh positions</button>
        </div>
    </div>

    <div class="trade-summary-grid">
        <div class="summary-card">
            <span>Total P/L</span>
            <strong data-total-pl style="color:@PlColor(Model.TotalPl);">@Model.TotalPl.ToString("C2")</strong>
        </div>
        <div class="summary-card">
            <span>Open Trades</span>
            <strong data-trade-count>@Model.Trades.Count</strong>
        </div>
        <div class="summary-card">
            <span>Source Filter</span>
            <strong>@SourceBadge(Model.Source)</strong>
        </div>
    </div>

    <nav class="source-tabs">
        @foreach (var (key, label) in TradingFlow.Web.Pages.RunningTradesModel.Sources)
        {
            var active = string.Equals(Model.Source, key, StringComparison.OrdinalIgnoreCase);
            <a asp-page="/RunningTrades" asp-route-source="@key"
               class="@(active ? "active" : null)">
                @label
            </a>
        }
    </nav>

    @if (Model.Trades.Count == 0)
    {
        <div class="empty-state">
            No running trades for this source.
        </div>
    }
    else
    {
        <div class="table-scroll panel" role="region" aria-label="Open positions table" tabindex="0">
        <table class="trade-table">
            <thead>
                <tr>
                    <th>Ticker</th>
                    <th>Source</th>
                    <th class="num">Qty</th>
                    <th class="num">Entry</th>
                    <th class="num">Last</th>
                    <th class="num">P/L</th>
                    <th class="num">P/L %</th>
                    <th>Strategy</th>
                    <th>Protection</th>
                    <th>Run</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var trade in Model.Trades)
                {
                    <tr data-trade-key="@TradeKey(trade)">
                        <td><strong>@trade.Ticker</strong></td>
                        <td><span class="source-chip">@SourceBadge(trade.Source)</span></td>
                        <td class="num">@trade.Quantity.ToString("0.####")</td>
                        <td class="num">@trade.EntryPrice.ToString("C2")</td>
                        <td class="num" data-trade-current>@trade.CurrentPrice.ToString("C2")</td>
                        <td class="num" data-trade-pl style="font-weight:700;color:@PlColor(trade.UnrealizedPl);">@trade.UnrealizedPl.ToString("C2")</td>
                        <td class="num" data-trade-pl-pct style="color:@PlColor(trade.UnrealizedPl);">@trade.UnrealizedPlPct.ToString("0.00")%</td>
                        <td>@trade.StrategyName</td>
                        <td data-trade-protection>@trade.ProtectionSummary</td>
                        <td class="muted">@trade.Reference</td>
                        <td class="num">
                            <button type="button"
                                    class="danger mini-button"
                                    data-review-exit
                                    data-ticker="@trade.Ticker"
                                    data-close-kind="@trade.CloseKind"
                                    data-job-id="@(trade.JobId?.ToString())"
                                    data-session-id="@(trade.SessionId?.ToString())"
                                    data-quantity="@trade.Quantity.ToString("0.####")"
                                    data-current-price="@trade.CurrentPrice.ToString("0.####")"
                                    data-protection="@trade.ProtectionSummary">
                                Review exit
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    <p id="TradesConnection" class="muted" role="status" aria-live="polite" style="font-size:12px;margin-top:16px;">
        Position values update every 10 seconds without replacing focused controls.
    </p>
</section>

<dialog id="ExitReviewDialog" class="review-dialog" aria-labelledby="ExitReviewHeading">
    <form method="post" asp-page-handler="Close">
        <input type="hidden" name="Source" value="@Model.Source" />
        <input type="hidden" name="closeKind" data-exit-close-kind />
        <input type="hidden" name="jobId" data-exit-job-id />
        <input type="hidden" name="sessionId" data-exit-session-id />
        <input type="hidden" name="ticker" data-exit-ticker />
        <h2 id="ExitReviewHeading">Review paper exit</h2>
        <p data-exit-summary></p>
        <dl class="review-grid">
            <div><dt>Environment</dt><dd>PAPER</dd></div>
            <div><dt>Action</dt><dd>Close the complete position</dd></div>
            <div><dt>Protection</dt><dd data-exit-protection></dd></div>
        </dl>
        <p class="warning-text">The server will re-read the selected run or automation session before requesting the broker exit.</p>
        <div class="actions">
            <button type="button" class="button secondary" data-exit-cancel>Keep position</button>
            <button type="submit" class="button danger">Confirm paper exit</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/running-trades.js" asp-append-version="true"></script>
}
