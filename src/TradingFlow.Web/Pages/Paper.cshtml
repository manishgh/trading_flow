@page "/Paper"
@model TradingFlow.Web.Pages.PaperModel
@{
    ViewData["Title"] = "Paper Trading Lab";
    var selectedConfig = Model.Configs.FirstOrDefault(c => c.Path == Model.ConfigPath);
    var selectedStrategy = Model.Strategies.FirstOrDefault(s => s.Path == Model.SelectedStrategyPath);
    var researchParameterDefaultsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.ResearchStrategies.Select(strategy => new
        {
            path = strategy.Path,
            parameters = TradingFlow.Web.Models.PaperExperimentParameterInput.From(strategy.Definition)
        }),
        new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
    string AuditLine(TradingFlow.Web.Models.StrategyOption strategy)
    {
        var audit = strategy.Audit;
        return audit is null
            ? "Audit: not available"
            : $"Audit: {audit.ReturnPct:+0.##;-0.##;0}% / DD {audit.MaxDrawdownPct:0.##}% / {audit.Trades} trades / win {audit.WinRatePct:0.#}% / avg hold {audit.AverageHold}";
    }
}

<div class="paper-page">
<div class="section-title">
    <div>
        <h1>Paper Trading Lab</h1>
        <div class="muted">Test strategies live against real-time market data in paper mode.</div>
    </div>
</div>

<div asp-validation-summary="All" class="paper-validation" role="alert"></div>

<form method="post">
<div class="grid two">
    <!-- LEFT COLUMN: Environment & Strategy -->
    <div>
        <div class="panel">
            <h2>Wishlist + Finviz</h2>
            <div class="muted mb-md">Paper trading universe is the selected wishlist plus optional Finviz screener results.</div>
            <input type="hidden" name="BaseConfigPath" id="BaseConfigPath" value="@Model.ConfigPath" />
            <input type="hidden" asp-for="ConfigPath" />

            <label for="WishlistId">Wishlist <span class="tf-help" title="Named ticker group stored in the database. This replaces the old paper-config ticker list.">?</span></label>
            <select name="WishlistId" id="WishlistId" onchange="window.location='?wishlistId=' + encodeURIComponent(this.value) + '&paperExecutionMode=' + encodeURIComponent(document.getElementById('PaperExecutionMode')?.value || 'shadow') + '&strategyPath=' + encodeURIComponent(document.getElementById('SelectedStrategyDropdown')?.value || '')">
                @foreach (var wishlist in Model.Wishlists)
                {
                    <option value="@wishlist.Id" selected="@(Model.SelectedWishlist?.Id == wishlist.Id)">@wishlist.Name</option>
                }
            </select>

            <div class="mt-md">
                <label>Active Tickers</label>
                <div class="ticker-chip-row">
                    @if (Model.SelectedWishlist is null || String.IsNullOrWhiteSpace(Model.WishlistTickersCsv))
                    {
                        <span class="muted">No active tickers. Add them from Wishlists.</span>
                    }
                    else
                    {
                        @foreach (var ticker in Model.WishlistTickersCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <span class="ticker-chip">@ticker</span>
                        }
                    }
                </div>
            </div>

            @* A screener is a universe in its own right, not an addition to a
               wishlist. Choosing Screener runs against exactly what the screen
               returns and ignores the wishlist, so a screen can be traded without
               promoting its symbols into a curated list first. *@
            <label class="mt-md" for="UniverseSource">Universe source</label>
            <select name="UniverseSource" id="UniverseSource">
                <option value="wishlist" selected="@(Model.UniverseSource == "wishlist")">Wishlist only</option>
                <option value="screener" selected="@(Model.UniverseSource == "screener")">Screener only</option>
                <option value="both" selected="@(Model.UniverseSource == "both")">Wishlist and screener</option>
            </select>
            <div class="muted mt-xs">
                Screener only ignores the wishlist entirely and trades exactly what the screen returns.
            </div>

            <label class="mt-md" for="ScreenerFilter">Finviz screen <span class="tf-help" title="A saved screen name, or a Finviz Elite query or URL.">?</span></label>
            @* Saved screens are offered by name: Finviz has no endpoint that
               lists the screens saved in its own interface. *@
            <input type="text" name="ScreenerFilter" id="ScreenerFilter" list="PaperSavedScreens"
                   value="@Model.ScreenerFilter" placeholder="A saved screen name, or v=111&f=cap_smallover,sh_relvol_o2" />
            <datalist id="PaperSavedScreens">
                @foreach (var preset in Model.ScreenerPresets)
                {
                    <option value="@preset.Name">@preset.Category · @preset.FilterQuery</option>
                }
            </datalist>
            <div class="muted mt-xs">
                Name a screen on the Wishlists page to pick it here, or paste a Finviz query or URL for a one-off.
            </div>

            <div class="actions mt-md">
                <a class="button secondary" asp-page="/Wishlists" asp-route-id="@Model.SelectedWishlist?.Id">Manage Wishlist</a>
            </div>
        </div>

        <div class="panel mt-lg">
            <h2>Strategy Configuration</h2>
            <div class="muted mb-md">Choose an explicit authorization mode. Experiment runs never count as promotion evidence.</div>

            <label for="PaperExecutionMode">Paper authorization</label>
            <select name="PaperExecutionMode" id="PaperExecutionMode" class="mb-md"
                    onchange="window.location='?wishlistId=@Model.SelectedWishlist?.Id&paperExecutionMode=' + encodeURIComponent(this.value)">
                <option value="shadow" selected="@(Model.PaperExecutionMode == "shadow")">Paper shadow (evidence-authorized)</option>
                <option value="experiment" selected="@(Model.PaperExecutionMode == "experiment")">Paper experiment (operator-labelled)</option>
            </select>

            @if (Model.Strategies.Count == 0)
            {
                <div class="paper-validation" role="status">
                    @(Model.PaperExecutionMode == "experiment"
                        ? "No registered paper-experiment strategy is available. Create an immutable experiment artifact before starting a run."
                        : "No paper-shadow strategy is available. Complete research review and authorize an exact version and content hash.")
                </div>
            }
            else
            {
                <label for="SelectedStrategyDropdown">Authorized strategy <span class="tf-help" title="The exact authorized version and content hash used by the shared decision engine.">?</span></label>
                <select name="SelectedStrategyPath" id="SelectedStrategyDropdown" onchange="loadStrategyDetails(this.value)">
                    @foreach (var strategy in Model.Strategies)
                    {
                        <option value="@strategy.Path" selected="@(strategy.Path == Model.SelectedStrategyPath)">
                            @strategy.Definition.StrategyName · @strategy.Identity.SemanticVersion · @strategy.Lifecycle
                        </option>
                    }
                </select>
                @if (selectedStrategy is not null)
                {
                    <div class="muted mt-xs">
                        @AuditLine(selectedStrategy) · hash @selectedStrategy.Identity.ContentSha256[..12]
                    </div>
                }
            }

            @if (Model.PaperExecutionMode == "experiment")
            {
                <div class="paper-experiment-registration mt-md">
                    <h3>Register immutable experiment</h3>
                    <div class="muted mb-md">
                        Start from a reviewed research artifact. Leaving the version blank preserves the source version;
                        changed parameters require a new semantic version.
                    </div>
                    <label for="ExperimentSourceStrategyPath">Research source</label>
                    <select id="ExperimentSourceStrategyPath" name="ExperimentSourceStrategyPath"
                            onchange="loadExperimentParameterDefaults(this.value)">
                        @foreach (var strategy in Model.ResearchStrategies)
                        {
                            <option value="@strategy.Path" selected="@(strategy.Path == Model.ExperimentSourceStrategyPath)">
                                @strategy.Definition.StrategyName · @strategy.Identity.SemanticVersion
                            </option>
                        }
                    </select>
                    <label class="mt-md" for="ExperimentSemanticVersion">Experiment version</label>
                    <input id="ExperimentSemanticVersion" name="ExperimentSemanticVersion"
                           value="@Model.ExperimentSemanticVersion"
                           placeholder="Use source version" />
                    <label class="checkbox-field mt-md" for="ExperimentParameters_ApplyOverrides">
                        <input asp-for="ExperimentParameters.ApplyOverrides" type="checkbox"
                               onchange="toggleExperimentOverrides()" />
                        <span>Derive with edited parameters</span>
                    </label>
                    <details id="ExperimentOverrideDetails" class="mt-md" open="@Model.ExperimentParameters.ApplyOverrides">
                        <summary>Experiment parameter overrides</summary>
                        <div class="muted mb-md">
                            Values begin with the selected source strategy. Enabling overrides requires a new version;
                            the source remains unchanged and the complete diff is stored with the artifact.
                        </div>
                        <div class="compact-form-grid">
                            <label asp-for="ExperimentParameters.MinVolumeSpike">
                                Minimum volume ratio
                                <input asp-for="ExperimentParameters.MinVolumeSpike" type="number" min="0" step="0.01" />
                            </label>
                            <label asp-for="ExperimentParameters.MaxVwapExtensionAtr">
                                Maximum VWAP extension (ATR)
                                <input asp-for="ExperimentParameters.MaxVwapExtensionAtr" type="number" min="0.01" step="0.01" />
                            </label>
                            <label asp-for="ExperimentParameters.MinEntryRsi">
                                Minimum entry RSI
                                <input asp-for="ExperimentParameters.MinEntryRsi" type="number" min="0" max="100" step="0.1" />
                            </label>
                            <label asp-for="ExperimentParameters.MaxEntryRsi">
                                Maximum entry RSI
                                <input asp-for="ExperimentParameters.MaxEntryRsi" type="number" min="0" max="100" step="0.1" />
                            </label>
                            <label class="checkbox-field" asp-for="ExperimentParameters.ConfluenceEnabled">
                                <input asp-for="ExperimentParameters.ConfluenceEnabled" type="checkbox" />
                                <span>Enable higher-timeframe confluence</span>
                            </label>
                            <label asp-for="ExperimentParameters.ConfluenceTimeframe">
                                Confluence timeframe
                                <input asp-for="ExperimentParameters.ConfluenceTimeframe" placeholder="15m, 1h, 1d" />
                            </label>
                            <label asp-for="ExperimentParameters.ConfluenceEmaPeriod">
                                Confluence EMA period
                                <input asp-for="ExperimentParameters.ConfluenceEmaPeriod" type="number" min="1" step="1" />
                            </label>
                            <label asp-for="ExperimentParameters.ExecutionTimeframe">
                                Execution timeframe
                                <input asp-for="ExperimentParameters.ExecutionTimeframe" placeholder="1m, 5m, 1h" />
                            </label>
                            <label asp-for="ExperimentParameters.StopAtrMultiple">
                                Initial stop (ATR)
                                <input asp-for="ExperimentParameters.StopAtrMultiple" type="number" min="0.01" step="0.01" />
                            </label>
                            <label asp-for="ExperimentParameters.TargetRMultiple">
                                Profit target (R)
                                <input asp-for="ExperimentParameters.TargetRMultiple" type="number" min="0.01" step="0.01" />
                            </label>
                            <label asp-for="ExperimentParameters.MaxHoldHours">
                                Maximum hold (hours)
                                <input asp-for="ExperimentParameters.MaxHoldHours" type="number" min="0.25" step="0.25" />
                            </label>
                            <label asp-for="ExperimentParameters.MinHoldBarsBeforeTechnicalExit">
                                Minimum bars before technical exit
                                <input asp-for="ExperimentParameters.MinHoldBarsBeforeTechnicalExit" type="number" min="0" step="1" />
                            </label>
                            <label class="checkbox-field" asp-for="ExperimentParameters.EnableAtrTrailingStop">
                                <input asp-for="ExperimentParameters.EnableAtrTrailingStop" type="checkbox" />
                                <span>Enable ATR trailing stop</span>
                            </label>
                            <label asp-for="ExperimentParameters.TrailingStopAtrMultiple">
                                Trailing distance (ATR)
                                <input asp-for="ExperimentParameters.TrailingStopAtrMultiple" type="number" min="0.01" step="0.01" />
                            </label>
                            <label asp-for="ExperimentParameters.TrailingActivationR">
                                Trail activation (R)
                                <input asp-for="ExperimentParameters.TrailingActivationR" type="number" min="0" step="0.01" />
                            </label>
                            <label asp-for="ExperimentParameters.SlippageBps">
                                Slippage (bps)
                                <input asp-for="ExperimentParameters.SlippageBps" type="number" min="0" step="0.1" />
                            </label>
                        </div>
                    </details>
                    <input type="hidden" name="ExperimentRegistrationOperationId"
                           value="@Model.ExperimentRegistrationOperationId" />
                    <input type="hidden" name="ExperimentRegistrationRequestedAtUtc"
                           value="@Model.ExperimentRegistrationRequestedAtUtc.ToString("O")" />
                    <button type="submit" asp-page-handler="CreateExperiment" class="button secondary mt-md"
                            disabled="@(Model.ResearchStrategies.Count == 0)">
                        Register experiment
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- RIGHT COLUMN: Live Runner -->
    <div>
        <div class="panel highlight-border">
            <h2>Paper Runner</h2>
            <div class="muted mb-md">Run the selected strategy on the wishlist plus optional Finviz screener universe.</div>

            <label for="OrderExpirationDropdown">Order Expiration Strategy <span class="tf-help" title="Controls how long submitted broker orders remain active: GTC, day-only, or active cancellation behavior.">?</span></label>
            <select class="mb-md" id="OrderExpirationDropdown" name="OrderExpiration">
                <option value="gtc" selected="@(Model.OrderExpiration == "gtc")">Good 'Til Canceled (GTC)</option>
                <option value="day" selected="@(Model.OrderExpiration == "day")">Day Orders (Cancel at Market Close)</option>
                <option value="active_cancel" selected="@(Model.OrderExpiration == "active_cancel")">Active Cancellation (GTC + 30-min Auto-Cancel)</option>
            </select>

            <label for="EntryOrderTypeDropdown">Entry Order Type <span class="tf-help" title="Limit waits for a controlled fill price; market enters immediately but may slip. Swing entries normally use a validated limit price.">?</span></label>
            <select class="mb-md" id="EntryOrderTypeDropdown" name="EntryOrderType">
                <option value="limit" selected="@(Model.EntryOrderType == "limit")">Limit Order (Waits for pullback/discount)</option>
                <option value="market" selected="@(Model.EntryOrderType == "market")">Market Order (Enters immediately at current price)</option>
            </select>

            <div class="paper-toggle">
                <label title="Allows orders and market data decisions during Alpaca-supported pre-market and post-market sessions.">
                    <input type="checkbox" id="AllowExtendedHoursTradingCheckbox" name="AllowExtendedHoursTrading" value="true" checked="@Model.AllowExtendedHoursTrading" />
                    <span>Enable Extended Hours (Pre/Post-Market)</span>
                    <span class="tf-help" title="When checked, paper orders may be submitted in extended hours if the broker and order type support it.">?</span>
                </label>
                <div id="ExtendedHoursTradingHint" class="muted small-help">
                    Extended-hours entries require an explicit limit order with DAY expiration.
                </div>
            </div>

            <div class="paper-toggle">
                <label title="Only available when the selected strategy actually uses news/catalyst fields.">
                    <input type="checkbox" id="NewsEnabledCheckbox" name="NewsEnabled" value="true" checked="@Model.NewsEnabled" disabled="@(!Model.SelectedStrategyUsesNews)" />
                    <span>Enable News Catalyst / Veto</span>
                    <span class="tf-help" title="Enables configured news provider and veto/catalyst checks. No-news strategies keep this off.">?</span>
                </label>
                <div id="NewsEnabledHint" class="muted small-help"></div>
            </div>

            <label for="RunName">Run Name <span class="tf-help" title="Unique name for this paper run. It scopes logs, audits, profiler metrics, results, and run-specific broker order tags.">?</span></label>
            <input name="RunName" id="RunName" value="@Model.SuggestedRunName" />

            <div class="actions mt-md">
                <button type="submit" asp-page-handler="RunLive" class="button go"
                        disabled="@(Model.Strategies.Count == 0)"
                        title="Starts a paper LiveRunner job using the selected exact authorization.">Start Paper Trading</button>
            </div>
        </div>
        </form>

        <section class="panel mt-md">
            <div class="section-title">
                <h2>Paper Jobs</h2>
                <a class="button secondary" asp-page="/Paper" asp-route-wishlistId="@Model.SelectedWishlist?.Id" asp-route-strategyPath="@Model.SelectedStrategyPath" asp-route-paperExecutionMode="@Model.PaperExecutionMode" title="Reloads the paper lab and job list without starting a new run.">Refresh</a>
            </div>

            @if (Model.LiveJobs.Count == 0)
            {
                <div class="muted">No paper jobs running.</div>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Run Name</th>
                            <th>Status</th>
                            <th>Started</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.LiveJobs)
                        {
                            <tr>
                                <td>@job.RunName</td>
                                <td><span class="status @job.Status">@job.Status</span></td>
                                <td>@(job.StartedAt is null ? "-" : Model.FormatLocalTime(job.StartedAt.Value))</td>
                                <td><a asp-page="/PaperJob" asp-route-id="@job.JobId">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    </div>
</div>

<section class="panel mt-md">
    <div class="section-title">
        <h2>Environment Check <span class="tf-help" title="Validates paper credentials and read-only broker dependencies without placing orders.">?</span></h2>
        @if (Model.PaperSnapshot is not null)
        {
            <span class="status">Checked</span>
        }
    </div>
    @if (Model.PaperSnapshot is null)
    {
        <p class="muted">Run validation to check demo keys and read-only paper dependencies for your selected broker. No orders are placed.</p>
        <form method="post" asp-page-handler="">
            <input type="hidden" id="EnvironmentCheckConfigPath" name="BaseConfigPath" value="@Model.ConfigPath" />
            <input type="hidden" id="EnvironmentCheckStrategyPath" name="SelectedStrategyPath" value="@Model.SelectedStrategyPath" />
            <button type="submit" title="Checks configured paper broker credentials and read-only account dependencies.">Validate Environment</button>
        </form>
    }
    else
    {
        @if (Model.Selected.Config.Execution.Broker.Equals("alpaca", StringComparison.OrdinalIgnoreCase))
        {
            <table>
                <tr><th>ALPACA_KEY_ID</th><td>@(Model.PaperSnapshot.AlpacaKeyIdPresent ? "present" : "missing")</td></tr>
                <tr><th>ALPACA_SECRET_KEY</th><td>@(Model.PaperSnapshot.AlpacaSecretKeyPresent ? "present" : "missing")</td></tr>
            </table>
            @if (Model.PaperSnapshot.AlpacaReadOnlyCheck is null)
            {
                <p class="warn">Set Alpaca credentials in appsettings.local.json or ALPACA_KEY_ID / ALPACA_SECRET_KEY to run Alpaca checks.</p>
            }
            else
            {
                <pre>@Model.AlpacaCheckJson</pre>
            }
        }
        else
        {
            <p class="warn">Unknown broker specified in the configuration: @Model.Selected.Config.Execution.Broker</p>
        }
    }
</section>
</div>
@section Scripts {
    <script>
        let currentStrategyUsesNews = @Model.SelectedStrategyUsesNews.ToString().ToLowerInvariant();
        let currentConfigNewsEnabled = @((selectedConfig?.Config.News.Enabled ?? true).ToString().ToLowerInvariant());
        const researchParameterDefaults = @Html.Raw(researchParameterDefaultsJson);

        function toggleExperimentOverrides() {
            const enabled = document.getElementById('ExperimentParameters_ApplyOverrides')?.checked === true;
            const details = document.getElementById('ExperimentOverrideDetails');
            if (details) {
                details.open = enabled;
                details.querySelectorAll('input, select').forEach(control => control.disabled = !enabled);
            }
        }

        function loadExperimentParameterDefaults(strategyPath) {
            const selected = researchParameterDefaults.find(item => item.path.toLowerCase() === strategyPath.toLowerCase());
            if (!selected) return;

            const parameters = selected.parameters;
            const fields = {
                'ExperimentParameters_MinVolumeSpike': 'minVolumeSpike',
                'ExperimentParameters_MinEntryRsi': 'minEntryRsi',
                'ExperimentParameters_MaxEntryRsi': 'maxEntryRsi',
                'ExperimentParameters_MaxVwapExtensionAtr': 'maxVwapExtensionAtr',
                'ExperimentParameters_ConfluenceTimeframe': 'confluenceTimeframe',
                'ExperimentParameters_ConfluenceEmaPeriod': 'confluenceEmaPeriod',
                'ExperimentParameters_StopAtrMultiple': 'stopAtrMultiple',
                'ExperimentParameters_TargetRMultiple': 'targetRMultiple',
                'ExperimentParameters_MaxHoldHours': 'maxHoldHours',
                'ExperimentParameters_TrailingStopAtrMultiple': 'trailingStopAtrMultiple',
                'ExperimentParameters_TrailingActivationR': 'trailingActivationR',
                'ExperimentParameters_MinHoldBarsBeforeTechnicalExit': 'minHoldBarsBeforeTechnicalExit',
                'ExperimentParameters_ExecutionTimeframe': 'executionTimeframe',
                'ExperimentParameters_SlippageBps': 'slippageBps'
            };
            Object.entries(fields).forEach(([id, property]) => {
                const input = document.getElementById(id);
                if (input) input.value = parameters[property] ?? '';
            });

            document.getElementById('ExperimentParameters_ConfluenceEnabled').checked = Boolean(parameters.confluenceEnabled);
            document.getElementById('ExperimentParameters_EnableAtrTrailingStop').checked = Boolean(parameters.enableAtrTrailingStop);
            document.getElementById('ExperimentParameters_ApplyOverrides').checked = false;
            document.getElementById('ExperimentSemanticVersion').value = '';
            toggleExperimentOverrides();
        }

        function updateNewsToggle() {
            const checkbox = document.getElementById('NewsEnabledCheckbox');
            const hint = document.getElementById('NewsEnabledHint');
            if (!checkbox) return;

            checkbox.disabled = !currentStrategyUsesNews;
            checkbox.checked = currentStrategyUsesNews && currentConfigNewsEnabled;
            if (hint) {
                hint.textContent = currentStrategyUsesNews
                    ? 'News is available for this strategy and will be included when enabled.'
                    : 'Selected strategy has no news/catalyst rules, so news is disabled for the run.';
            }
        }

        function loadStrategyDetails(strategyPath) {
            const environmentStrategy = document.getElementById('EnvironmentCheckStrategyPath');
            if (environmentStrategy) {
                environmentStrategy.value = strategyPath;
            }

            const paperMode = document.getElementById('PaperExecutionMode')?.value || 'shadow';
            fetch('?handler=StrategyDetails&strategyPath=' + encodeURIComponent(strategyPath) + '&paperExecutionMode=' + encodeURIComponent(paperMode))
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        currentStrategyUsesNews = Boolean(data.usesNews);
                        updateNewsToggle();
                    }
                });
        }

        function loadConfigDetails(configPath) {
            const environmentConfig = document.getElementById('EnvironmentCheckConfigPath');
            if (environmentConfig) {
                environmentConfig.value = configPath;
            }

            fetch('?handler=ConfigDetails&configPath=' + encodeURIComponent(configPath))
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('OrderExpirationDropdown').value = data.orderExpiration || 'gtc';
                        document.getElementById('EntryOrderTypeDropdown').value = data.entryOrderType || 'limit';
                        document.getElementById('AllowExtendedHoursTradingCheckbox').checked = Boolean(data.allowExtendedHoursTrading);
                        updateExtendedHoursExecution();
                        currentConfigNewsEnabled = Boolean(data.newsEnabled);
                        updateNewsToggle();
                        document.getElementById('ScreenerFilter').value = data.screenerFilter || '';
                    }
                });
        }

        function updateExtendedHoursExecution() {
            const checkbox = document.getElementById('AllowExtendedHoursTradingCheckbox');
            const expiration = document.getElementById('OrderExpirationDropdown');
            const entryType = document.getElementById('EntryOrderTypeDropdown');
            const hint = document.getElementById('ExtendedHoursTradingHint');
            if (!checkbox || !expiration || !entryType) return;

            if (checkbox.checked) {
                expiration.value = 'day';
                entryType.value = 'limit';
            }

            const constrained = checkbox.checked;
            for (const option of expiration.options) {
                option.disabled = constrained && option.value !== 'day';
            }
            for (const option of entryType.options) {
                option.disabled = constrained && option.value !== 'limit';
            }
            if (hint) {
                hint.textContent = constrained
                    ? 'Extended-hours enabled: Limit + DAY is required and selected.'
                    : 'Extended-hours entries require an explicit limit order with DAY expiration.';
            }
        }

        document.getElementById('AllowExtendedHoursTradingCheckbox')
            ?.addEventListener('change', updateExtendedHoursExecution);
        document.getElementById('OrderExpirationDropdown')
            ?.addEventListener('change', updateExtendedHoursExecution);
        document.getElementById('EntryOrderTypeDropdown')
            ?.addEventListener('change', updateExtendedHoursExecution);
        updateExtendedHoursExecution();
        updateNewsToggle();
        toggleExperimentOverrides();
    </script>
}
