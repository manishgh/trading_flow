@page "/Paper"
@model TradingFlow.Web.Pages.PaperModel
@{
    ViewData["Title"] = "Paper runs";
    var selectedConfig = Model.Configs.FirstOrDefault(c => c.Path == Model.ConfigPath);
    var selectedStrategy = Model.Strategies.FirstOrDefault(s => s.Path == Model.SelectedStrategyPath);
    var wishlistTickers = String.IsNullOrWhiteSpace(Model.WishlistTickersCsv)
        ? Array.Empty<string>()
        : Model.WishlistTickersCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var experimentMode = Model.PaperExecutionMode == "experiment";
    var startBlockedReason = Model.Strategies.Count == 0
        ? experimentMode
            ? "No paper experiment is registered yet. Register one under Experiments, then start the run."
            : "No strategy is authorized for paper shadow runs yet. Choose Paper experiment under Authorization, or authorize a reviewed strategy first."
        : null;
    var researchParameterDefaultsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.ResearchStrategies.Select(strategy => new
        {
            path = strategy.Path,
            parameters = TradingFlow.Web.Models.PaperExperimentParameterInput.From(strategy.Definition)
        }),
        new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
    string AuditLine(TradingFlow.Web.Models.StrategyOption strategy)
    {
        var audit = strategy.Audit;
        return audit is null
            ? "No backtest summary recorded"
            : $"Backtest: {audit.ReturnPct:+0.##;-0.##;0}% return · {audit.MaxDrawdownPct:0.##}% worst drawdown · {audit.Trades} trades · {audit.WinRatePct:0.#}% winners · average hold {audit.AverageHold}";
    }
}

<div class="paper-page">
<div class="paper-head">
    <div>
        <h1>Paper runs</h1>
        <p class="muted">Run an authorized strategy on your stocks with paper money. Nothing here uses the live account.</p>
    </div>
    <details class="paper-limits" data-trading-limits data-mode="paper">
        <summary>Account limits: <span data-trading-limits-summary>loading…</span> <span class="paper-edit">Edit</span></summary>
        <form data-trading-limits-form class="paper-limits-form">
            <label for="DailyNewStockLimit">New stocks a day
                <input class="input" id="DailyNewStockLimit" name="maxNewStocksPerDay" type="number" min="1" step="1" required />
            </label>
            <label for="AccountOpenPositionLimit">Open positions at once
                <input class="input" id="AccountOpenPositionLimit" name="maxOpenPositions" type="number" min="1" step="1" required />
            </label>
            <button class="button secondary" type="submit">Save limits</button>
        </form>
        <p class="muted paper-note" data-trading-limits-rule></p>
        <p class="muted paper-note" role="status" data-trading-limits-status>Loading account limits…</p>
    </details>
</div>

<div asp-validation-summary="All" class="paper-validation" role="alert"></div>

<div class="paper-layout">
<form method="post" data-run-workflow class="paper-card paper-start" aria-labelledby="paper-start-title">
    <h2 id="paper-start-title">Start a paper run</h2>
    <input type="hidden" name="BaseConfigPath" id="BaseConfigPath" value="@Model.ConfigPath" />
    <input type="hidden" asp-for="ConfigPath" />

    <div class="paper-steps">
        <div class="paper-step-label">1 · Stocks</div>
        <div class="paper-step-fields">
            @* Finviz screen alone trades exactly what the screen returns and ignores the wishlist. *@
            <fieldset class="paper-segmented" id="UniverseSource">
                <legend>Stocks from</legend>
                <label><input type="radio" name="UniverseSource" value="wishlist" checked="@(Model.UniverseSource == "wishlist")" /><span>Wishlist</span></label>
                <label><input type="radio" name="UniverseSource" value="screener" checked="@(Model.UniverseSource == "screener")" /><span>Finviz screen</span></label>
                <label><input type="radio" name="UniverseSource" value="both" checked="@(Model.UniverseSource == "both")" /><span>Both</span></label>
            </fieldset>
            <div data-source-part="wishlist">
                <label for="WishlistId">Wishlist</label>
                <select name="WishlistId" id="WishlistId" onchange="window.location='?wishlistId=' + encodeURIComponent(this.value) + '&paperExecutionMode=' + encodeURIComponent(document.getElementById('PaperExecutionMode')?.value || 'shadow') + '&strategyPath=' + encodeURIComponent(document.getElementById('SelectedStrategyDropdown')?.value || '')">
                    @foreach (var wishlist in Model.Wishlists)
                    {
                        <option value="@wishlist.Id" selected="@(Model.SelectedWishlist?.Id == wishlist.Id)">@wishlist.Name</option>
                    }
                </select>
                <p class="muted paper-note" data-wishlist-tickers data-count="@wishlistTickers.Length">
                    @if (wishlistTickers.Length == 0)
                    {
                        <span>This wishlist has no stocks. <a asp-page="/Wishlists" asp-route-id="@Model.SelectedWishlist?.Id">Add stocks in Manage wishlists</a>.</span>
                    }
                    else
                    {
                        <span>@wishlistTickers.Length stocks: @String.Join(" · ", wishlistTickers)</span>
                    }
                </p>
            </div>
            @* Saved screens are offered by name: Finviz has no endpoint that lists the screens saved in its own interface. *@
            <div data-source-part="screener">
                <label for="ScreenerFilter">Finviz screen</label>
                <input type="text" name="ScreenerFilter" id="ScreenerFilter" list="PaperSavedScreens"
                       value="@Model.ScreenerFilter" placeholder="Saved screen name, or a Finviz query or URL" />
                <datalist id="PaperSavedScreens">
                    @foreach (var preset in Model.ScreenerPresets)
                    {
                        <option value="@preset.Name">@preset.Category · @preset.FilterQuery</option>
                    }
                </datalist>
                <p class="muted paper-note">Save screens by name in <a asp-page="/Wishlists" asp-route-id="@Model.SelectedWishlist?.Id">Manage wishlists</a>, or paste a Finviz query for a one-off run.</p>
            </div>
        </div>

        <div class="paper-step-label">2 · Strategy</div>
        <div class="paper-step-fields">
            <div class="paper-pair">
                <div>
                    <label for="PaperExecutionMode">Authorization</label>
                    <select name="PaperExecutionMode" id="PaperExecutionMode" data-query-select="paperExecutionMode">
                        <option value="shadow" selected="@(Model.PaperExecutionMode == "shadow")">Paper shadow</option>
                        <option value="experiment" selected="@(Model.PaperExecutionMode == "experiment")">Paper experiment</option>
                    </select>
                </div>
                <div>
                    <label for="SelectedStrategyDropdown">Strategy</label>
                    @if (Model.Strategies.Count == 0)
                    {
                        <select id="SelectedStrategyDropdown" disabled><option value="">None available</option></select>
                    }
                    else
                    {
                        <select name="SelectedStrategyPath" id="SelectedStrategyDropdown" onchange="loadStrategyDetails(this.value)">
                            @foreach (var strategy in Model.Strategies)
                            {
                                <option value="@strategy.Path" selected="@(strategy.Path == Model.SelectedStrategyPath)">@strategy.Definition.StrategyName · @strategy.Identity.SemanticVersion</option>
                            }
                        </select>
                    }
                </div>
            </div>
            <p class="muted paper-note">
                @(experimentMode
                    ? "Experiment runs are labelled as experiments and never count as evidence for promoting a strategy."
                    : "Shadow runs use a strategy whose exact version was authorized after research review.")
                @if (selectedStrategy is not null)
                {
                    <br /><span>@AuditLine(selectedStrategy) · content hash @selectedStrategy.Identity.ContentSha256[..12]</span>
                }
            </p>
            <label class="checkbox-field paper-check">
                <input type="checkbox" id="NewsEnabledCheckbox" name="NewsEnabled" value="true" checked="@Model.NewsEnabled" disabled="@(!Model.SelectedStrategyUsesNews)" />
                <span>Use news catalysts and vetoes</span>
            </label>
            <p id="NewsEnabledHint" class="muted paper-note"></p>
        </div>

        <div class="paper-step-label">3 · Orders</div>
        <div class="paper-step-fields">
            <div class="paper-pair">
                <div>
                    <label for="EntryOrderTypeDropdown">Entry order</label>
                    <select id="EntryOrderTypeDropdown" name="EntryOrderType">
                        <option value="limit" selected="@(Model.EntryOrderType == "limit")">Limit</option>
                        <option value="market" selected="@(Model.EntryOrderType == "market")">Market</option>
                    </select>
                </div>
                <div>
                    <label for="OrderExpirationDropdown">Expires</label>
                    <select id="OrderExpirationDropdown" name="OrderExpiration">
                        <option value="gtc" selected="@(Model.OrderExpiration == "gtc")">When cancelled</option>
                        <option value="day" selected="@(Model.OrderExpiration == "day")">End of day</option>
                        <option value="active_cancel" selected="@(Model.OrderExpiration == "active_cancel")">After 30 minutes</option>
                    </select>
                </div>
            </div>
            <label class="checkbox-field paper-check">
                <input type="checkbox" id="AllowExtendedHoursTradingCheckbox" name="AllowExtendedHoursTrading" value="true" checked="@Model.AllowExtendedHoursTrading" />
                <span>Trade pre-market and after hours</span>
            </label>
            <p id="ExtendedHoursTradingHint" class="muted paper-note"></p>
        </div>

        <div class="paper-step-label">4 · Name</div>
        <div class="paper-step-fields">
            <label for="RunName">Run name</label>
            <input name="RunName" id="RunName" value="@Model.SuggestedRunName" />
            <p class="muted paper-note">Logs, results and broker order tags for this run carry this name.</p>
        </div>
    </div>

    <div class="paper-start-bar">
        <p class="muted" id="PaperRunSummary" data-blocked="@(startBlockedReason is not null ? "true" : "false")">@(startBlockedReason ?? "")</p>
        <button type="submit" asp-page-handler="RunLive" class="button go"
                disabled="@(Model.Strategies.Count == 0)"
                aria-describedby="PaperRunSummary">Start paper run</button>
    </div>
</form>

<div class="paper-side">
    <section class="paper-card" aria-labelledby="paper-runs-title">
        <div class="paper-card-head">
            <h2 id="paper-runs-title">Running and recent</h2>
            <a class="button secondary" asp-page="/Paper" asp-route-wishlistId="@Model.SelectedWishlist?.Id" asp-route-strategyPath="@Model.SelectedStrategyPath" asp-route-paperExecutionMode="@Model.PaperExecutionMode" asp-route-preparationKey="@Request.Query["preparationKey"]">Refresh</a>
        </div>
        @if (Model.LiveJobs.Count == 0)
        {
            <p class="muted">No paper runs yet. Started runs appear here with their status.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr><th scope="col">Run</th><th scope="col">Status</th><th scope="col">Started</th></tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.LiveJobs)
                    {
                        <tr>
                            <td><a asp-page="/PaperJob" asp-route-id="@job.JobId">@job.RunName</a></td>
                            <td><span class="status @job.Status">@job.Status</span></td>
                            <td>@(job.StartedAt is null ? "–" : Model.FormatLocalTime(job.StartedAt.Value))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="paper-card" aria-labelledby="paper-experiments-title">
        <h2 id="paper-experiments-title">Experiments</h2>
        <p class="muted">Register a research strategy as a labelled paper experiment. The research file itself never changes.</p>
        <details class="paper-experiment-registration" open="@(experimentMode && (Model.ExperimentParameters.ApplyOverrides || !ViewData.ModelState.IsValid))">
            <summary>Register an experiment</summary>
            @if (Model.ResearchStrategies.Count == 0)
            {
                <p class="muted">No research strategy is available to register.</p>
            }
            else
            {
                <form method="post" asp-page-handler="CreateExperiment">
                    <input type="hidden" name="ConfigPath" value="@Model.ConfigPath" />
                    <input type="hidden" name="WishlistId" value="@Model.SelectedWishlist?.Id" />
                    <input type="hidden" name="ExperimentRegistrationOperationId" value="@Model.ExperimentRegistrationOperationId" />
                    <input type="hidden" name="ExperimentRegistrationRequestedAtUtc" value="@Model.ExperimentRegistrationRequestedAtUtc.ToString("O")" />
                    <div class="paper-pair">
                        <div>
                            <label for="ExperimentSourceStrategyPath">Research strategy</label>
                            <select id="ExperimentSourceStrategyPath" name="ExperimentSourceStrategyPath" onchange="loadExperimentParameterDefaults(this.value)">
                                @foreach (var strategy in Model.ResearchStrategies)
                                {
                                    <option value="@strategy.Path" selected="@(strategy.Path == Model.ExperimentSourceStrategyPath)">@strategy.Definition.StrategyName · @strategy.Identity.SemanticVersion</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label for="ExperimentSemanticVersion">Version</label>
                            <input id="ExperimentSemanticVersion" name="ExperimentSemanticVersion" value="@Model.ExperimentSemanticVersion" placeholder="Same as research" />
                        </div>
                    </div>
                    <label class="checkbox-field paper-check" for="ExperimentParameters_ApplyOverrides">
                        <input asp-for="ExperimentParameters.ApplyOverrides" type="checkbox" onchange="toggleExperimentOverrides()" />
                        <span>Change settings (needs a new version)</span>
                    </label>
                    <div id="ExperimentOverrideDetails" class="paper-overrides" hidden="@(!Model.ExperimentParameters.ApplyOverrides)">
                        <p class="muted paper-note">Values start from the research strategy. The full list of changes is stored with the experiment.</p>
                        <div class="paper-pair">
                            <label asp-for="ExperimentParameters.MinVolumeSpike">Minimum volume ratio<input asp-for="ExperimentParameters.MinVolumeSpike" type="number" min="0" step="0.01" /></label>
                            <label asp-for="ExperimentParameters.MaxVwapExtensionAtr">Most above VWAP (ATR)<input asp-for="ExperimentParameters.MaxVwapExtensionAtr" type="number" min="0.01" step="0.01" /></label>
                            <label asp-for="ExperimentParameters.MinEntryRsi">Lowest entry RSI<input asp-for="ExperimentParameters.MinEntryRsi" type="number" min="0" max="100" step="0.1" /></label>
                            <label asp-for="ExperimentParameters.MaxEntryRsi">Highest entry RSI<input asp-for="ExperimentParameters.MaxEntryRsi" type="number" min="0" max="100" step="0.1" /></label>
                            <label asp-for="ExperimentParameters.ExecutionTimeframe">Execution timeframe<input asp-for="ExperimentParameters.ExecutionTimeframe" placeholder="1m, 5m, 1h" /></label>
                            <label asp-for="ExperimentParameters.SlippageBps">Slippage (basis points)<input asp-for="ExperimentParameters.SlippageBps" type="number" min="0" step="0.1" /></label>
                            <label asp-for="ExperimentParameters.ConfluenceTimeframe">Confirmation timeframe<input asp-for="ExperimentParameters.ConfluenceTimeframe" placeholder="15m, 1h, 1d" /></label>
                            <label asp-for="ExperimentParameters.ConfluenceEmaPeriod">Confirmation EMA period<input asp-for="ExperimentParameters.ConfluenceEmaPeriod" type="number" min="1" step="1" /></label>
                            <label asp-for="ExperimentParameters.StopAtrMultiple">Initial stop (ATR)<input asp-for="ExperimentParameters.StopAtrMultiple" type="number" min="0.01" step="0.01" /></label>
                            <label asp-for="ExperimentParameters.TargetRMultiple">Profit target (R)<input asp-for="ExperimentParameters.TargetRMultiple" type="number" min="0.01" step="0.01" /></label>
                            <label asp-for="ExperimentParameters.MaxHoldHours">Longest hold (hours)<input asp-for="ExperimentParameters.MaxHoldHours" type="number" min="0.25" step="0.25" /></label>
                            <label asp-for="ExperimentParameters.MinHoldBarsBeforeTechnicalExit">Bars before a technical exit<input asp-for="ExperimentParameters.MinHoldBarsBeforeTechnicalExit" type="number" min="0" step="1" /></label>
                            <label asp-for="ExperimentParameters.TrailingStopAtrMultiple">Trailing distance (ATR)<input asp-for="ExperimentParameters.TrailingStopAtrMultiple" type="number" min="0.01" step="0.01" /></label>
                            <label asp-for="ExperimentParameters.TrailingActivationR">Trail starts at (R)<input asp-for="ExperimentParameters.TrailingActivationR" type="number" min="0" step="0.01" /></label>
                        </div>
                        <label class="checkbox-field paper-check"><input asp-for="ExperimentParameters.ConfluenceEnabled" type="checkbox" /><span>Require higher-timeframe confirmation</span></label>
                        <label class="checkbox-field paper-check"><input asp-for="ExperimentParameters.EnableAtrTrailingStop" type="checkbox" /><span>Use an ATR trailing stop</span></label>
                    </div>
                    <div class="paper-actions-end">
                        <button type="submit" class="button secondary">Register experiment</button>
                    </div>
                </form>
            }
        </details>
    </section>

    <details class="paper-card paper-broker-check" open="@(Model.PaperSnapshot is not null)">
        <summary>Check the paper broker connection</summary>
        @if (Model.PaperSnapshot is null)
        {
            <p class="muted">Reads the paper account to confirm the Alpaca keys work. No orders are placed.</p>
            <form method="post" asp-page-handler="">
                <input type="hidden" id="EnvironmentCheckConfigPath" name="BaseConfigPath" value="@Model.ConfigPath" />
                <input type="hidden" id="EnvironmentCheckStrategyPath" name="SelectedStrategyPath" value="@Model.SelectedStrategyPath" />
                <button type="submit" class="button secondary">Check connection</button>
            </form>
        }
        else if (Model.Selected.Config.Execution.Broker.Equals("alpaca", StringComparison.OrdinalIgnoreCase))
        {
            <p>Alpaca key ID @(Model.PaperSnapshot.AlpacaKeyIdPresent ? "present" : "missing") · secret key @(Model.PaperSnapshot.AlpacaSecretKeyPresent ? "present" : "missing")</p>
            @if (Model.PaperSnapshot.AlpacaReadOnlyCheck is null)
            {
                <p class="warn">Set the Alpaca keys in appsettings.local.json, or ALPACA_KEY_ID and ALPACA_SECRET_KEY, to run the check.</p>
            }
            else
            {
                <pre class="paper-broker-result">@Model.AlpacaCheckJson</pre>
            }
        }
        else
        {
            <p class="warn">The configuration names a broker this page cannot check: @Model.Selected.Config.Execution.Broker</p>
        }
    </details>
</div>
</div>
</div>
@section Scripts {
    <script src="~/js/trading-limits.js" asp-append-version="true" defer></script>
    <script src="~/js/run-workflow.js" asp-append-version="true" defer></script>
    <script>
        let currentStrategyUsesNews = @Model.SelectedStrategyUsesNews.ToString().ToLowerInvariant();
        const currentConfigNewsEnabled = @((selectedConfig?.Config.News.Enabled ?? true).ToString().ToLowerInvariant());
        const researchParameterDefaults = @Html.Raw(researchParameterDefaultsJson);

        function toggleExperimentOverrides() {
            const enabled = document.getElementById('ExperimentParameters_ApplyOverrides')?.checked === true;
            const details = document.getElementById('ExperimentOverrideDetails');
            if (!details) return;
            details.hidden = !enabled;
            details.querySelectorAll('input, select').forEach(control => control.disabled = !enabled);
        }

        function loadExperimentParameterDefaults(strategyPath) {
            const selected = researchParameterDefaults.find(item => item.path.toLowerCase() === strategyPath.toLowerCase());
            if (!selected) return;
            const parameters = selected.parameters;
            const fields = {
                'ExperimentParameters_MinVolumeSpike': 'minVolumeSpike',
                'ExperimentParameters_MinEntryRsi': 'minEntryRsi',
                'ExperimentParameters_MaxEntryRsi': 'maxEntryRsi',
                'ExperimentParameters_MaxVwapExtensionAtr': 'maxVwapExtensionAtr',
                'ExperimentParameters_ConfluenceTimeframe': 'confluenceTimeframe',
                'ExperimentParameters_ConfluenceEmaPeriod': 'confluenceEmaPeriod',
                'ExperimentParameters_StopAtrMultiple': 'stopAtrMultiple',
                'ExperimentParameters_TargetRMultiple': 'targetRMultiple',
                'ExperimentParameters_MaxHoldHours': 'maxHoldHours',
                'ExperimentParameters_TrailingStopAtrMultiple': 'trailingStopAtrMultiple',
                'ExperimentParameters_TrailingActivationR': 'trailingActivationR',
                'ExperimentParameters_MinHoldBarsBeforeTechnicalExit': 'minHoldBarsBeforeTechnicalExit',
                'ExperimentParameters_ExecutionTimeframe': 'executionTimeframe',
                'ExperimentParameters_SlippageBps': 'slippageBps'
            };
            Object.entries(fields).forEach(([id, property]) => {
                const input = document.getElementById(id);
                if (input) input.value = parameters[property] ?? '';
            });
            document.getElementById('ExperimentParameters_ConfluenceEnabled').checked = Boolean(parameters.confluenceEnabled);
            document.getElementById('ExperimentParameters_EnableAtrTrailingStop').checked = Boolean(parameters.enableAtrTrailingStop);
            document.getElementById('ExperimentParameters_ApplyOverrides').checked = false;
            document.getElementById('ExperimentSemanticVersion').value = '';
            toggleExperimentOverrides();
        }

        function updateNewsToggle() {
            const checkbox = document.getElementById('NewsEnabledCheckbox');
            const hint = document.getElementById('NewsEnabledHint');
            if (!checkbox) return;
            checkbox.disabled = !currentStrategyUsesNews;
            checkbox.checked = currentStrategyUsesNews && currentConfigNewsEnabled;
            if (hint) {
                hint.textContent = currentStrategyUsesNews
                    ? 'This strategy has news rules; they apply when ticked.'
                    : 'This strategy has no news rules, so news is off for the run.';
            }
        }

        function loadStrategyDetails(strategyPath) {
            const environmentStrategy = document.getElementById('EnvironmentCheckStrategyPath');
            if (environmentStrategy) environmentStrategy.value = strategyPath;
            const paperMode = document.getElementById('PaperExecutionMode')?.value || 'shadow';
            window.tradingFlowFetch('?handler=StrategyDetails&strategyPath=' + encodeURIComponent(strategyPath) + '&paperExecutionMode=' + encodeURIComponent(paperMode))
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        currentStrategyUsesNews = Boolean(data.usesNews);
                        updateNewsToggle();
                    }
                    updateRunSummary();
                });
        }

        // Extended-hours entries must be limit orders that expire at the end of the day, so ticking it switches both fields.
        function updateExtendedHoursExecution() {
            const checkbox = document.getElementById('AllowExtendedHoursTradingCheckbox');
            const expiration = document.getElementById('OrderExpirationDropdown');
            const entryType = document.getElementById('EntryOrderTypeDropdown');
            const hint = document.getElementById('ExtendedHoursTradingHint');
            if (!checkbox || !expiration || !entryType) return;
            const constrained = checkbox.checked;
            if (constrained) {
                expiration.value = 'day';
                entryType.value = 'limit';
            }
            for (const option of expiration.options) option.disabled = constrained && option.value !== 'day';
            for (const option of entryType.options) option.disabled = constrained && option.value !== 'limit';
            if (hint) {
                hint.textContent = constrained
                    ? 'Extended hours needs a limit order that expires at the end of the day, so both fields are set to that.'
                    : 'Extended hours needs a limit order that expires at the end of the day; ticking it sets both fields.';
            }
        }

        function selectedSource() {
            return document.querySelector('input[name="UniverseSource"]:checked')?.value || 'wishlist';
        }

        // Shows only the fields the chosen stock source uses.
        function updateSourceParts() {
            const source = selectedSource();
            document.querySelectorAll('[data-source-part]').forEach(part => {
                part.hidden = part.dataset.sourcePart === 'wishlist' ? source === 'screener' : source === 'wishlist';
            });
            updateRunSummary();
        }

        function updateRunSummary() {
            const summary = document.getElementById('PaperRunSummary');
            if (!summary || summary.dataset.blocked === 'true') return;
            const source = selectedSource();
            const count = Number(document.querySelector('[data-wishlist-tickers]')?.dataset.count || 0);
            const wishlist = document.getElementById('WishlistId')?.selectedOptions[0]?.textContent.trim() || 'the wishlist';
            const screen = document.getElementById('ScreenerFilter')?.value.trim();
            const strategy = document.getElementById('SelectedStrategyDropdown')?.selectedOptions[0]?.textContent.trim() || 'the selected strategy';
            const parts = [];
            if (source !== 'screener') parts.push(count + ' stocks from ' + wishlist);
            if (source !== 'wishlist') parts.push(screen ? 'the Finviz screen “' + screen + '”' : 'a Finviz screen (enter one above)');
            summary.textContent = 'Runs ' + strategy + ' on ' + parts.join(' plus ') + ' · paper account';
        }

        document.querySelectorAll('input[name="UniverseSource"]').forEach(radio => radio.addEventListener('change', updateSourceParts));
        document.getElementById('ScreenerFilter')?.addEventListener('input', updateRunSummary);
        document.getElementById('AllowExtendedHoursTradingCheckbox')?.addEventListener('change', updateExtendedHoursExecution);
        updateExtendedHoursExecution();
        updateNewsToggle();
        toggleExperimentOverrides();
        updateSourceParts();
    </script>
}
