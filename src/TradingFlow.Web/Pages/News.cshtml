@page
@model TradingFlow.Web.Pages.NewsModel
@{
    ViewData["Title"] = "News";
    string PageUrl(int number) => Url.Page("/News", new { hours = Model.Hours, ticker = Model.Ticker,
        provider = Model.Provider, source = Model.Source, classification = Model.Classification,
        sentiment = Model.Sentiment, search = Model.Search, linkedOnly = Model.LinkedOnly,
        stockSource = Model.StockSource, view = Model.View, pageNumber = number, pageSize = Model.PageSize, stocksPage = Model.StocksPage })!;
    string StocksUrl(int number) => Url.Page("/News", new { hours = Model.Hours, ticker = Model.Ticker,
        provider = Model.Provider, source = Model.Source, classification = Model.Classification,
        sentiment = Model.Sentiment, search = Model.Search, linkedOnly = Model.LinkedOnly,
        stockSource = Model.StockSource, view = Model.View, pageNumber = Model.PageNumber, pageSize = Model.PageSize, stocksPage = number })!;
}

<header class="page-header compact-page-header">
    <div>
        <h1>News</h1>
        <p>Catalyst timeline across every tracked symbol, filtered by window, scope, source, and tone.</p>
    </div>
    <div class="actions">
        <a class="button secondary" asp-page="/TradeDesk">Open Desk</a>
    </div>
</header>

<section class="panel">
    <form method="get" class="news-filter-bar">
        <div>
            <label for="Hours">Window</label>
            <select id="Hours" name="hours">
                @foreach (var (hours, label) in TradingFlow.Web.Pages.NewsModel.Windows)
                {
                    <option value="@hours" selected="@(Model.Hours == hours)">@label</option>
                }
            </select>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
        <div>
            <label for="GroupId">Stock source</label>
            <select id="GroupId" name="stockSource">
                @foreach (var choice in Model.StockSources.Where(x => x.Group == "")) {
                    <option value="@choice.Key" selected="@(Model.StockSource == choice.Key)">@choice.Name</option>
                }
                @foreach (var group in Model.StockSources.Where(x => x.Group != "").GroupBy(x => x.Group))
                {
                    <optgroup label="@group.Key">
                    @foreach (var choice in group) {
                        <option value="@choice.Key" selected="@(Model.StockSource == choice.Key)">@choice.Name</option>
                    }
                    </optgroup>
                }
            </select>
            <small class="muted">Choose a stock universe; Ticker narrows it to one stock. Finviz selection filters stored news.</small>
        </div>
        }
        <div>
            <label for="Ticker">Ticker</label>
            <input id="Ticker" name="ticker" value="@Model.Ticker" placeholder="NVDA" autocomplete="off" />
        </div>
        <div>
            <label for="Provider">News provider</label>
            <input id="Provider" name="provider" value="@Model.Provider" placeholder="Any provider" />
        </div>
        <div>
            <label for="Sentiment">Tone</label>
            <select id="Sentiment" name="sentiment">
                @foreach (var (key, label) in TradingFlow.Web.Pages.NewsModel.SentimentBands)
                {
                    <option value="@key" selected="@(String.Equals(Model.Sentiment, key, StringComparison.OrdinalIgnoreCase))">@label</option>
                }
            </select>
        </div>
        <div>
            <label for="Search">Search</label>
            <input id="Search" name="search" type="search" value="@Model.Search" placeholder="Keyword" autocomplete="off" />
        </div>
        <label class="checkbox-field">
            <input type="checkbox" name="linkedOnly" value="true" checked="@Model.LinkedOnly" />
            Only stories with an article link
        </label>
        <div><label for="NewsSource">Publisher / source</label><input id="NewsSource" name="source" value="@Model.Source" placeholder="Any publisher" /></div>
        <div><label for="NewsClassification">Evidence classification</label><select id="NewsClassification" name="classification">
            <option value="">All classifications</option>
            @foreach (var category in new[] { "Company", "SEC filing", "Fed", "Macro", "Market" }) {
                <option value="@category" selected="@(String.Equals(Model.Classification, category, StringComparison.OrdinalIgnoreCase))">@category</option>
            }
        </select><small class="muted">Derived from provider, symbol and headline; strategy catalyst qualification is unavailable here.</small></div>
        <div><label for="NewsView">View</label><select id="NewsView" name="view">
            <option value="timeline" selected="@(Model.View != "ticker")">Chronological</option>
            <option value="ticker" selected="@(Model.View == "ticker")">Grouped by symbols</option>
        </select></div>
        <div class="news-filter-actions">
            <button type="submit">Apply</button>
            <a class="button secondary" asp-page="/News">Clear</a>
        </div>
    </form>
</section>

@if (Model.StockList is { } stocks) {
    <section class="panel" aria-labelledby="source-stock-heading">
        <h2 id="source-stock-heading">Stocks in this source</h2>
        <p>@stocks.Total stocks · wishlist names show overlap with the selected Finviz list. This is membership, not a trading signal.</p>
        <ul class="source-stock-list">
            @foreach (var stock in stocks.Items) {
                <li><strong>@stock.Symbol</strong>
                    @if (stock.Wishlists.Count > 0) { <span> · @String.Join(", ", stock.Wishlists)</span> }
                    @if (stock.InFinviz == true) { <span> · Finviz</span> }
                    @if (stock.InFinviz == false) { <span> · Not in the selected Finviz result</span> }
                </li>
            }
        </ul>
        @if (stocks.Items.Count == 0) { <p>No stocks match the selected source and ticker.</p> }
        @if (stocks.PageCount > 1) {
            <nav class="actions" aria-label="Source stock pages">
                @if (stocks.Page > 1) { <a class="button secondary" href="@StocksUrl(stocks.Page - 1)">Previous stocks</a> }
                <span>Stock page @stocks.Page of @stocks.PageCount</span>
                @if (stocks.Page < stocks.PageCount) { <a class="button secondary" href="@StocksUrl(stocks.Page + 1)">Next stocks</a> }
            </nav>
        }
    </section>
}

<section class="panel" aria-labelledby="news-results-heading">
    <div class="section-heading compact-heading">
        <div>
            <h2 id="news-results-heading">Timeline</h2>
            <p>@Model.FeedDescription</p>
        </div>
        <span class="count-label">@Model.Items.Count articles on this page · @Model.TotalBeforeFilters matching records</span>
    </div>

    @if (!Model.FeedEnabled)
    {
        <div class="empty-state"><strong>News scope unavailable.</strong><span>@Model.FeedDescription</span></div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <strong>No stories match these filters.</strong>
            <span>Widen the window or clear a filter.</span>
        </div>
    }
    else
    {
        <div class="news-timeline">
            @{ string? previousSymbols = null; }
            @foreach (var item in Model.Items)
            {
                if (Model.View == "ticker" && previousSymbols != item.Ticker) {
                    <h3>@item.Ticker</h3>
                    previousSymbols = item.Ticker;
                }
                <partial name="_NewsEvidence" model="TradingFlow.Web.Models.NewsPresentation.From(item)" />
            }
        </div>
    }
</section>

<nav class="actions" aria-label="News pages">
    @if (Model.PageNumber > 1) { <a class="button secondary" href="@PageUrl(Model.PageNumber - 1)">Previous</a> }
    <span>Page @Model.PageNumber of @Model.PageCount</span>
    @if (Model.PageNumber < Model.PageCount) { <a class="button secondary" href="@PageUrl(Model.PageNumber + 1)">Next</a> }
</nav>
<partial name="_GroupActions" />
