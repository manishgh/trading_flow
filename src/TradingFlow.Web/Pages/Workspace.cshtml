@page
@{
    ViewData["Title"] = "Workspace";
}
<header class="page-header">
    <div><h1>Workspace</h1><p>Market news and earnings are available without signing in.</p></div>
</header>
<section class="panel" aria-labelledby="workspace-market">
    <h2 id="workspace-market">Market overview</h2>
    <div class="actions">
        <a class="button" asp-page="/News">News</a>
        <a class="button" asp-page="/Earnings">Earnings</a>
    </div>
</section>
<section class="panel" aria-labelledby="workspace-review">
    <h2 id="workspace-review">Daily review</h2>
    <p>Sign in for preparation, candidate review and your account.</p>
    <div class="actions">
        <a class="button secondary" asp-page="/Preparation">Preparation</a>
        <a class="button secondary" asp-page="/TradeDesk">Candidates</a>
        <a class="button secondary" asp-page="/Login">Sign in</a>
    </div>
</section>
