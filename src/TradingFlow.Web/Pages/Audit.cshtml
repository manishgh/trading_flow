@page "{runName}"
@model TradingFlow.Web.Pages.AuditModel
@{
    ViewData["Title"] = "Decision Tree Audit - " + Model.RunName;
}
@section Scripts {
    <script>
        (function () {
            const snapshotUrl = `${window.location.pathname}?handler=Snapshot`;
            const refreshedAtEl = document.getElementById('auditRefreshedAt');
            const emptyEl = document.getElementById('auditEmpty');
            const evaluationsEl = document.getElementById('auditEvaluations');
            const acceptedEl = document.getElementById('auditAccepted');
            const rejectedEl = document.getElementById('auditRejected');
            const coverageEl = document.getElementById('auditCoverage');
            const reasonCardsEl = document.getElementById('auditReasonCards');
            const reasonPanelEl = document.getElementById('auditReasonPanel');
            const recordsBodyEl = document.getElementById('auditRecordsBody');
            const decisionFilterEl = document.getElementById('decisionFilter');
            const reasonFilterEl = document.getElementById('reasonFilter');
            const tickerFilterEl = document.getElementById('tickerFilter');

            function escapeHtml(value) {
                return String(value ?? '')
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }

            function decisionClass(decision) {
                const normalized = String(decision ?? '').toLowerCase();
                if (normalized === 'accepted' || normalized === 'exitsubmitted') return 'accepted';
                if (normalized === 'rejected' || normalized === 'exitrejected') return 'rejected';
                return 'pending';
            }

            function renderReasonCards(reasons) {
                if (!reasonPanelEl || !reasonCardsEl) return;
                reasonPanelEl.hidden = reasons.length === 0;
                reasonCardsEl.innerHTML = reasons.map(reason => `<button type="button" class="audit-reason-card" data-reason-card="${escapeHtml(reason.reasonKey)}">
                    <div class="audit-reason-title">${escapeHtml(reason.displayReason)}</div>
                    <div class="muted">${escapeHtml(reason.count)} rejected (${Number(reason.percentOfRejected ?? 0).toFixed(1)}%)</div>
                    <code>${escapeHtml(reason.exampleReason)}</code>
                </button>`).join('');
                reasonCardsEl.querySelectorAll('[data-reason-card]').forEach(card => {
                    card.addEventListener('click', () => {
                        reasonFilterEl.value = card.getAttribute('data-reason-card') ?? '';
                        applyFilters();
                    });
                });
            }

            function updateReasonFilter(reasons) {
                if (!reasonFilterEl) return;
                const selected = reasonFilterEl.value;
                reasonFilterEl.innerHTML = '<option value="">All rejection reasons</option>' +
                    reasons.map(reason => `<option value="${escapeHtml(reason.reasonKey)}">${escapeHtml(reason.displayReason)} (${escapeHtml(reason.count)})</option>`).join('');
                if ([...reasonFilterEl.options].some(option => option.value === selected)) {
                    reasonFilterEl.value = selected;
                }
            }

            function renderRecords(records) {
                if (!recordsBodyEl) return;
                recordsBodyEl.innerHTML = records.map(record => {
                    const chips = (record.chips ?? []).map(renderChip).join('');
                    const rawReason = record.rawReason ? `<code>${escapeHtml(record.rawReason)}</code>` : '';
                    const gates = (record.gateEvidence ?? []).length === 0 ? '' :
                        `<table class="gate-evidence"><thead><tr><th>Gate</th><th>Measured</th><th>Required</th></tr></thead><tbody>` +
                        record.gateEvidence.map(gate => `<tr><td>${escapeHtml(gate.label)}</td>`+
                            `<td class="num">${escapeHtml(gate.actual)}</td>`+
                            `<td class="num">${escapeHtml(gate.operator)} ${escapeHtml(gate.threshold)}</td></tr>`).join('') +
                        `</tbody></table>`;
                    return `<tr class="audit-table-row" data-decision="${escapeHtml(String(record.decision ?? '').toLowerCase())}" data-reason="${escapeHtml(record.reasonKey)}" data-ticker="${escapeHtml(record.ticker)}">
                        <td class="audit-cell nowrap">${escapeHtml(record.localTime)}</td>
                        <td class="audit-cell strong">${escapeHtml(record.ticker)}</td>
                        <td class="audit-cell">${escapeHtml(record.strategy)}</td>
                        <td class="audit-decision ${decisionClass(record.decision)}">${escapeHtml(record.decision)}</td>
                        <td class="audit-cell">
                            <div>${escapeHtml(record.reason)}</div>
                            ${rawReason}
                            ${gates}
                            <div class="muted audit-note">${escapeHtml(record.explanation)}</div>
                            <div>${chips}</div>
                        </td>
                        <td class="audit-cell wide">
                            <details>
                                <summary>View Signal Evaluation</summary>
                                <pre class="audit-json">${escapeHtml(record.signalJson)}</pre>
                            </details>
                        </td>
                    </tr>`;
                }).join('');
                applyFilters();
            }

            function renderChip(chip) {
                const value = String(chip.value ?? '').toLowerCase();
                if (value === 'true' || value === 'false') {
                    const checked = value === 'true' ? 'checked' : '';
                    return `<span class="audit-chip bool ${chip.passed ? '' : 'fail'}"><input type="checkbox" disabled ${checked} aria-label="${escapeHtml(chip.label)}" /><span>${escapeHtml(chip.label)}</span></span>`;
                }

                return `<span class="audit-chip ${chip.passed ? '' : 'fail'}">${escapeHtml(chip.label)}: ${escapeHtml(chip.value)}</span>`;
            }

            function applyFilters() {
                const decision = decisionFilterEl?.value ?? '';
                const reason = reasonFilterEl?.value ?? '';
                const ticker = (tickerFilterEl?.value ?? '').trim().toUpperCase();
                let visible = 0;
                recordsBodyEl?.querySelectorAll('tr.audit-table-row').forEach(row => {
                    const matchesDecision = !decision || row.dataset.decision === decision;
                    const matchesReason = !reason || row.dataset.reason === reason;
                    const matchesTicker = !ticker || String(row.dataset.ticker ?? '').toUpperCase().includes(ticker);
                    const show = matchesDecision && matchesReason && matchesTicker;
                    row.hidden = !show;
                    if (show) visible++;
                });
                if (emptyEl) {
                    emptyEl.hidden = visible !== 0;
                }
            }

            async function refreshAudit() {
                let data;
                try {
                    const response = await fetch(snapshotUrl, { cache: 'no-store' });
                    if (!response.ok) return;
                    data = await response.json();
                } catch {
                    return;
                }

                if (!data.success) return;
                if (refreshedAtEl) refreshedAtEl.textContent = data.refreshedAt;
                if (evaluationsEl) evaluationsEl.textContent = data.evaluations;
                if (acceptedEl) acceptedEl.textContent = data.accepted;
                if (rejectedEl) rejectedEl.textContent = data.rejected;
                if (coverageEl) coverageEl.textContent = `${data.tickerCount} tickers / ${data.strategyCount} strategies`;
                const reasons = data.reasons ?? [];
                updateReasonFilter(reasons);
                renderReasonCards(reasons);
                renderRecords(data.records ?? []);
            }

            decisionFilterEl?.addEventListener('change', applyFilters);
            reasonFilterEl?.addEventListener('change', applyFilters);
            tickerFilterEl?.addEventListener('input', applyFilters);
            document.getElementById('clearAuditFilters')?.addEventListener('click', () => {
                if (decisionFilterEl) decisionFilterEl.value = '';
                if (reasonFilterEl) reasonFilterEl.value = '';
                if (tickerFilterEl) tickerFilterEl.value = '';
                applyFilters();
            });

            window.tradingFlowAuditRefresh = window.setInterval(refreshAudit, 5000);
            applyFilters();
            refreshAudit();
        })();
    </script>
}

<div class="container audit-page audit-container">
    <div class="audit-heading">
        <div>
            <h1>Audit Analyzer: @Model.RunName</h1>
            <p class="muted">Decision tree audit for strategy signal evaluations. Times shown in @Model.LocalTimeZoneLabel. Last refreshed: <span id="auditRefreshedAt">@Model.FormatLocal(DateTimeOffset.UtcNow)</span>.</p>
        </div>
        <div class="actions">
                <a href="@Url.Page("/Audit", "Export", new { runName = Model.RunName })" class="button secondary">Export CSV</a>
                <a href="@Model.BackUrl" class="button">Back</a>
            </div>
    </div>

    <div id="auditEmpty" class="audit-panel audit-stack" hidden="@(Model.Records.Count != 0)">
        <strong>No matching audit records found.</strong>
        <span class="muted">The run may still be evaluating, or filters may be hiding rows.</span>
    </div>

        <div class="audit-summary-grid">
            <div class="audit-card">
                <div class="muted">Evaluations</div>
                <div id="auditEvaluations" class="audit-card-value">@Model.Records.Count</div>
            </div>
            <div class="audit-card">
                <div class="muted">Accepted</div>
                <div id="auditAccepted" class="audit-card-value good">@Model.AcceptedCount</div>
            </div>
            <div class="audit-card">
                <div class="muted">Rejected</div>
                <div id="auditRejected" class="audit-card-value bad">@Model.RejectedCount</div>
            </div>
            <div class="audit-card">
                <div class="muted">Coverage</div>
                <div id="auditCoverage" class="audit-card-value compact">@Model.TickerCount tickers / @Model.StrategyCount strategies</div>
            </div>
        </div>

            <div class="audit-panel audit-stack">
                <h2>Compare runs</h2>
                <form method="get" class="audit-compare-form">
                    <label for="CompareWith">Compare against run</label>
                    <input id="CompareWith" name="compareWith" value="@Model.CompareWith"
                           placeholder="another run name" autocomplete="off" />
                    <button type="submit">Compare</button>
                    @if (Model.Comparison.Count > 0)
                    {
                        <a class="button secondary" href="@Url.Page("/Audit", new { runName = Model.RunName })">Clear</a>
                    }
                </form>
                @if (Model.Comparison.Count > 0)
                {
                    <table class="data-grid-table mt-md">
                        <thead>
                            <tr>
                                <th scope="col">Metric</th>
                                <th scope="col" class="num">@Model.RunName</th>
                                <th scope="col" class="num">@Model.ComparisonRunName</th>
                                <th scope="col" class="num">Delta</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Comparison)
                        {
                            <tr>
                                <td>@row.Label</td>
                                <td class="num">@row.Current.ToString("0.##")</td>
                                <td class="num">@row.Other.ToString("0.##")</td>
                                <td class="num @row.DeltaClass">@row.DeltaText</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else if (!String.IsNullOrWhiteSpace(Model.CompareWith))
                {
                    <p class="muted">No decisions found for that run name.</p>
                }
            </div>

            @if (Model.Funnel.Count > 0)
            {
                <div class="audit-panel audit-stack">
                    <h2>Decision funnel</h2>
                    <p class="muted">
                        Candidates surviving each stage. The widest drop is the reason most
                        entries never happened.
                    </p>
                    <ol class="audit-funnel">
                        @foreach (var stage in Model.Funnel)
                        {
                            <li>
                                <div class="audit-funnel-head">
                                    <span>@stage.Label</span>
                                    <strong>@stage.Remaining<span class="muted"> / @stage.Total</span></strong>
                                </div>
                                <div class="audit-funnel-track">
                                    <div class="audit-funnel-fill progress-fill"
                                         style="--progress:@stage.RemainingPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                                @if (stage.Removed > 0)
                                {
                                    <small class="muted">Removed @stage.Removed here</small>
                                }
                            </li>
                        }
                    </ol>
                </div>
            }

            <div id="auditReasonPanel" class="audit-panel audit-stack" hidden="@(Model.TopRejectionReasons.Count == 0)">
                <h2>Top Rejection Reasons</h2>
                <div id="auditReasonCards" class="audit-reason-grid">
                    @foreach (var reason in Model.TopRejectionReasons)
                    {
                        <button type="button" class="audit-reason-card" data-reason-card="@reason.ReasonKey">
                            <div class="audit-reason-title">@reason.DisplayReason</div>
                            <div class="muted">@reason.Count rejected (@reason.PercentOfRejected.ToString("0.0")%)</div>
                            <code>@reason.ExampleReason</code>
                        </button>
                    }
                </div>
            </div>

        <div class="audit-panel audit-stack">
            <div class="audit-filter-bar">
                <div>
                    <label for="decisionFilter">Decision</label>
                    <select id="decisionFilter">
                        <option value="">All decisions</option>
                        <option value="accepted">Accepted</option>
                        <option value="rejected">Rejected</option>
                        <option value="skipped">Skipped</option>
                        <option value="nosignal">No Signal</option>
                        <option value="exitsubmitted">Exit Submitted</option>
                        <option value="exitrejected">Exit Rejected</option>
                    </select>
                </div>
                <div>
                    <label for="reasonFilter">Rejection Reason</label>
                    <select id="reasonFilter">
                        <option value="">All rejection reasons</option>
                        @foreach (var reason in Model.TopRejectionReasons)
                        {
                            <option value="@reason.ReasonKey">@reason.DisplayReason (@reason.Count)</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="tickerFilter">Ticker</label>
                    <input id="tickerFilter" placeholder="e.g. CRDO" />
                </div>
            </div>
            <button id="clearAuditFilters" type="button" class="button secondary">Clear Filters</button>
        </div>

        <div class="audit-panel audit-table-panel">
            <table class="table audit-records-table">
                <thead>
                    <tr>
                        <th>Local Time</th>
                        <th>Ticker</th>
                        <th>Strategy</th>
                        <th>Decision</th>
                        <th>Reason</th>
                        <th>Decision Tree Matrix</th>
                    </tr>
                </thead>
                <tbody id="auditRecordsBody">
                @foreach (var view in Model.RecordViews)
                {
                    <tr class="audit-table-row" data-decision="@view.Decision.ToLowerInvariant()" data-reason="@view.ReasonKey" data-ticker="@view.Ticker">
                        <td class="audit-cell nowrap">@view.LocalTime</td>
                        <td class="audit-cell strong">@view.Ticker</td>
                        <td class="audit-cell">@view.StrategyName</td>
                        <td class="audit-decision @(view.Decision is "Accepted" or "ExitSubmitted" ? "accepted" : view.Decision is "Rejected" or "ExitRejected" ? "rejected" : "pending")">
                            @view.Decision
                        </td>
                        <td class="audit-cell">
                            <div>@view.DisplayReason</div>
                            @if (!String.IsNullOrWhiteSpace(view.RawReason))
                            {
                                <code>@view.RawReason</code>
                            }
                            @if (view.GateEvidence.Count > 0)
                            {
                                <table class="gate-evidence">
                                    <caption class="visually-hidden">Matched values against thresholds</caption>
                                    <thead>
                                        <tr><th scope="col">Gate</th><th scope="col">Measured</th><th scope="col">Required</th></tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var gate in view.GateEvidence)
                                    {
                                        <tr>
                                            <td>@gate.Label</td>
                                            <td class="num">@gate.Actual</td>
                                            <td class="num">@gate.Operator @gate.Threshold</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            }
                            <div class="muted audit-note">@view.Explanation</div>
                            <div>
                                @foreach (var chip in view.Chips)
                                {
                                    @if (chip.Value.Equals("true", StringComparison.OrdinalIgnoreCase) ||
                                         chip.Value.Equals("false", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="audit-chip bool @(chip.Passed ? "" : "fail")">
                                            <input type="checkbox" disabled checked="@chip.Value.Equals("true", StringComparison.OrdinalIgnoreCase)" aria-label="@chip.Label" />
                                            <span>@chip.Label</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="audit-chip @(chip.Passed ? "" : "fail")">@chip.Label: @chip.Value</span>
                                    }
                                }
                            </div>
                        </td>
                        <td class="audit-cell wide">
                            <details>
                                <summary>View Signal Evaluation</summary>
                                <pre class="audit-json">
@view.FormattedSignalJson
                                </pre>
                            </details>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
</div>
