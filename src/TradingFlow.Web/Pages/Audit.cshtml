@page "{runName}"
@model TradingFlow.Web.Pages.AuditModel
@{
    ViewData["Title"] = "Decision Tree Audit - " + Model.RunName;
    string PageUrl(int number, string? sort = null) => Url.Page("/Audit", new {
        runName = Model.RunName, decision = Model.Decision, ticker = Model.Ticker, reason = Model.Reason,
        sort = sort ?? Model.Sort, descending = sort is null ? Model.Descending : sort == Model.Sort ? !Model.Descending : false,
        pageNumber = number, pageSize = Model.PageSize, compareWith = Model.CompareWith, returnUrl = Model.BackUrl
    })!;
    string SortState(string key) => Model.Sort == key ? Model.Descending ? "descending" : "ascending" : "none";
}
@section Scripts {
    <script type="module" src="~/js/audit-page.js" asp-append-version="true"></script>
}

<div class="container audit-page audit-container">
    <div class="audit-heading">
        <div>
            <h1>Audit Analyzer: @Model.RunName</h1>
            <p class="muted">Decision tree audit for strategy signal evaluations. Times shown in @Model.LocalTimeZoneLabel. Last refreshed: <span id="auditRefreshedAt">@Model.FormatLocal(DateTimeOffset.UtcNow)</span>.</p>
        </div>
        <div class="actions">
                <a href="@Url.Page("/Audit", "Export", new { runName = Model.RunName, decision = Model.Decision, ticker = Model.Ticker, reason = Model.Reason })" class="button secondary" data-audit-export="csv">Export CSV</a>
                <a href="@Url.Page("/Audit", "Export", new { runName = Model.RunName, format = "json", decision = Model.Decision, ticker = Model.Ticker, reason = Model.Reason })" class="button secondary" data-audit-export="json">Export JSON</a>
                <a href="@Model.BackUrl" class="button">Back</a>
            </div>
    </div>

    <div id="auditEmpty" class="audit-panel audit-stack" hidden="@(Model.Records.Count != 0)">
        <strong>No matching audit records found.</strong>
        <span class="muted">The run may still be evaluating, or filters may be hiding rows.</span>
    </div>

        <div class="audit-summary-grid">
            <div class="audit-card">
                <div class="muted">Evaluations</div>
                <div id="auditEvaluations" class="audit-card-value">@Model.Summary.Total</div>
            </div>
            <div class="audit-card">
                <div class="muted">Accepted</div>
                <div id="auditAccepted" class="audit-card-value good">@Model.AcceptedCount</div>
            </div>
            <div class="audit-card">
                <div class="muted">Rejected</div>
                <div id="auditRejected" class="audit-card-value bad">@Model.RejectedCount</div>
            </div>
            <div class="audit-card">
                <div class="muted">Coverage</div>
                <div id="auditCoverage" class="audit-card-value compact">@Model.TickerCount tickers / @Model.StrategyCount strategies</div>
            </div>
        </div>

            <div class="audit-panel audit-stack">
                <h2>Compare runs</h2>
                <form method="get" class="audit-compare-form">
                    <label for="CompareRuns">Compare up to three additional runs</label>
                    <input id="CompareRuns" name="compareRuns" value="@Model.CompareRuns" maxlength="363" placeholder="run-one, run-two, run-three" />
                    <button type="submit">Compare summaries and realised equity</button>
                </form>
                @if(Model.MultiRuns.Count > 0){
                    <div class="table-scroll"><table class="data-grid-table"><thead><tr><th>Run</th><th>Evaluated</th><th>Accepted</th><th>Rejected</th><th>Tickers</th></tr></thead><tbody>
                    @foreach(var run in Model.MultiRuns){<tr><th scope="row">@run.Name</th><td>@(run.Found ? run.Summary.Total.ToString() : "unavailable")</td><td>@(run.Found ? run.Summary.Accepted.ToString() : "—")</td><td>@(run.Found ? run.Summary.Rejected.ToString() : "—")</td><td>@(run.Found ? run.Summary.Tickers.ToString() : "—")</td></tr>}
                    </tbody></table></div>
                    <h3>Realised equity overlay</h3>
                    <p class="muted">Return % against each strategy's starting capital, aligned by UTC exit date. This omits unrealised and within-position drawdown. Completed published artifacts only; no curves inferred from audit counts. Reload to change the selected completed runs.</p>
                    @if(Model.EquitySeries.Count > 0){
                        <svg viewBox="0 0 320 200" class="audit-equity-chart" role="img" aria-label="Realised equity overlay; details listed below">
                            @for(var i=0;i<Model.EquitySeries.Count;i++){<path d="@Model.CurvePath(Model.EquitySeries[i])" class="audit-equity-line series-@(i%4)" />}
                        </svg>
                        <ul>@for(var i=0;i<Model.EquitySeries.Count;i++){var curve=Model.EquitySeries[i];<li class="series-@(i%4)">@curve.RunName · @curve.Strategy · @curve.Points.First().Date to @curve.Points.Last().Date · final @curve.Points.Last().ReturnPercent.ToString("0.##")% · @curve.Points.Count points @(curve.Reduced ? "(reduced)" : "")</li>}</ul>
                    }
                    @foreach(var detail in Model.EquityDetails){<p class="note">@detail</p>}
                }
                <form method="get" class="audit-compare-form">
                    <label for="CompareWith">Compare against run</label>
                    <input id="CompareWith" name="compareWith" value="@Model.CompareWith"
                           placeholder="another run name" autocomplete="off" />
                    <button type="submit">Compare</button>
                    @if (Model.Comparison.Count > 0)
                    {
                        <a class="button secondary" href="@Url.Page("/Audit", new { runName = Model.RunName })">Clear</a>
                    }
                </form>
                    <table id="auditComparison" class="data-grid-table mt-md" hidden="@(Model.Comparison.Count == 0)">
                        <thead>
                            <tr>
                                <th scope="col">Metric</th>
                                <th scope="col" class="num">@Model.RunName</th>
                                <th id="auditComparisonName" scope="col" class="num">@Model.ComparisonRunName</th>
                                <th scope="col" class="num">Delta</th>
                            </tr>
                        </thead>
                        <tbody id="auditComparisonBody">
                        @foreach (var row in Model.Comparison)
                        {
                            <tr>
                                <td>@row.Label</td>
                                <td class="num">@row.Current.ToString("0.##")</td>
                                <td class="num">@row.Other.ToString("0.##")</td>
                                <td class="num @row.DeltaClass">@row.DeltaText</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <p id="auditComparisonEmpty" class="muted" hidden="@(Model.Comparison.Count > 0 || String.IsNullOrWhiteSpace(Model.CompareWith))">No decisions found for that run name.</p>
            </div>

                <div id="auditOutcomePanel" class="audit-panel audit-stack" hidden="@(Model.Funnel.Count == 0)">
                    <h2>Decision outcomes</h2>
                    <p class="muted">
                        Full-run outcomes grouped by rejection frequency. This breakdown
                        does not describe the engine’s gate execution order.
                    </p>
                    <ol id="auditFunnel" class="audit-funnel">
                        @foreach (var stage in Model.Funnel)
                        {
                            <li>
                                <div class="audit-funnel-head">
                                    <span>@stage.Label</span>
                                    <strong>@stage.Remaining<span class="muted"> / @stage.Total</span></strong>
                                </div>
                                <div class="audit-funnel-track">
                                    <div class="audit-funnel-fill progress-fill"
                                         style="--progress:@stage.RemainingPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                                @if (stage.Removed > 0)
                                {
                                    <small class="muted">@stage.Removed decisions in this group</small>
                                }
                            </li>
                        }
                    </ol>
                </div>

            <div id="auditReasonPanel" class="audit-panel audit-stack" hidden="@(Model.TopRejectionReasons.Count == 0)">
                <h2>Top Rejection Reasons</h2>
                <div id="auditReasonCards" class="audit-reason-grid">
                    @foreach (var reason in Model.TopRejectionReasons)
                    {
                        <button type="button" class="audit-reason-card" data-reason-card="@reason.ReasonKey">
                            <div class="audit-reason-title">@reason.DisplayReason</div>
                            <div class="muted">@reason.Count rejected (@reason.PercentOfRejected.ToString("0.0")%)</div>
                            <code>@reason.ExampleReason</code>
                        </button>
                    }
                </div>
            </div>

        <div class="audit-panel audit-stack">
            <form id="auditFilterForm" method="get" class="audit-filter-bar">
                <div>
                    <label for="decisionFilter">Decision</label>
                    <select id="decisionFilter" name="decision">
                        <option value="">All decisions</option>
                        <option value="accepted" selected="@(Model.Decision?.ToLowerInvariant() == "accepted")">Accepted</option>
                        <option value="rejected" selected="@(Model.Decision?.ToLowerInvariant() == "rejected")">Rejected</option>
                        <option value="skipped" selected="@(Model.Decision?.ToLowerInvariant() == "skipped")">Skipped</option>
                        <option value="nosignal" selected="@(Model.Decision?.ToLowerInvariant() == "nosignal")">No Signal</option>
                        <option value="exitsubmitted" selected="@(Model.Decision?.ToLowerInvariant() == "exitsubmitted")">Exit Submitted</option>
                        <option value="exitrejected" selected="@(Model.Decision?.ToLowerInvariant() == "exitrejected")">Exit Rejected</option>
                    </select>
                </div>
                <div>
                    <label for="reasonFilter">Rejection Reason</label>
                    <input id="reasonFilter" name="reason" value="@Model.Reason" list="auditReasonOptions" placeholder="Any recorded reason key" />
                    <datalist id="auditReasonOptions">
                    @foreach (var reason in Model.TopRejectionReasons) {
                        <option value="@reason.ReasonKey" label="@reason.DisplayReason"></option>
                    }
                    </datalist>
                </div>
                <div>
                    <label for="tickerFilter">Ticker</label>
                    <input id="tickerFilter" name="ticker" value="@Model.Ticker" placeholder="e.g. CRDO" />
                </div>
                <div><label for="auditPageSize">Rows per page</label><select id="auditPageSize" name="pageSize">
                    @foreach (var size in new[] { 25, 50, 100, 200 }) { <option value="@size" selected="@(size == Model.PageSize)">@size</option> }
                </select></div>
                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="descending" value="@Model.Descending.ToString().ToLowerInvariant()" />
                <button type="submit" class="button">Apply filters</button>
            </form>
            <button id="clearAuditFilters" type="button" class="button secondary">Clear Filters</button>
        </div>

        <nav class="actions" aria-label="Audit pages">
            <a id="auditPrevious" data-audit-nav class="button secondary" href="@PageUrl(Math.Max(1, Model.PageNumber - 1))" aria-disabled="@((Model.PageNumber <= 1).ToString().ToLowerInvariant())">Previous</a>
            <span id="auditPageStatus" role="status">Page @Model.PageNumber of @Model.PageCount · @Model.TotalMatching matching decisions</span>
            <a id="auditNext" data-audit-nav class="button secondary" href="@PageUrl(Model.PageNumber + 1)" aria-disabled="@((Model.PageNumber >= Model.PageCount).ToString().ToLowerInvariant())">Next</a>
        </nav>
        <p id="auditReadStatus" role="status"></p>
        <div class="audit-panel audit-table-panel">
            <table class="table audit-records-table">
                <thead>
                    <tr>
                        <th data-audit-sort="time" aria-sort="@SortState("time")"><a data-audit-nav href="@PageUrl(1, "time")">Local Time</a></th>
                        <th data-audit-sort="ticker" aria-sort="@SortState("ticker")"><a data-audit-nav href="@PageUrl(1, "ticker")">Ticker</a></th>
                        <th data-audit-sort="strategy" aria-sort="@SortState("strategy")"><a data-audit-nav href="@PageUrl(1, "strategy")">Strategy</a></th>
                        <th data-audit-sort="decision" aria-sort="@SortState("decision")"><a data-audit-nav href="@PageUrl(1, "decision")">Decision</a></th>
                        <th data-audit-sort="reason" aria-sort="@SortState("reason")"><a data-audit-nav href="@PageUrl(1, "reason")">Reason</a></th>
                        <th>Decision Tree Matrix</th>
                    </tr>
                </thead>
                <tbody id="auditRecordsBody">
                @foreach (var view in Model.RecordViews)
                {
                    <tr class="audit-table-row" data-id="@view.Id" data-decision="@view.Decision.ToLowerInvariant()" data-reason="@view.ReasonKey" data-ticker="@view.Ticker">
                        <td class="audit-cell nowrap">@view.LocalTime</td>
                        <td class="audit-cell strong">@view.Ticker</td>
                        <td class="audit-cell">@view.StrategyName</td>
                        <td class="audit-decision @(view.Decision is "Accepted" or "ExitSubmitted" ? "accepted" : view.Decision is "Rejected" or "ExitRejected" ? "rejected" : "pending")">
                            @view.Decision
                        </td>
                        <td class="audit-cell">
                            <div>@view.DisplayReason</div>
                            @if (!String.IsNullOrWhiteSpace(view.RawReason))
                            {
                                <code>@view.RawReason</code>
                            }
                            @if (view.GateEvidence.Count > 0)
                            {
                                <table class="gate-evidence">
                                    <caption class="visually-hidden">Matched values against thresholds</caption>
                                    <thead>
                                        <tr><th scope="col">Gate</th><th scope="col">Measured</th><th scope="col">Required</th></tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var gate in view.GateEvidence)
                                    {
                                        <tr>
                                            <td>@gate.Label</td>
                                            <td class="num">@gate.Actual</td>
                                            <td class="num">@gate.Operator @gate.Threshold</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            }
                            <div class="muted audit-note">@view.Explanation</div>
                            <div>
                                @foreach (var chip in view.Chips)
                                {
                                    @if (chip.Value.Equals("true", StringComparison.OrdinalIgnoreCase) ||
                                         chip.Value.Equals("false", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="audit-chip bool @(chip.Passed ? "" : "fail")">
                                            <input type="checkbox" disabled checked="@chip.Value.Equals("true", StringComparison.OrdinalIgnoreCase)" aria-label="@chip.Label" />
                                            <span>@chip.Label</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="audit-chip @(chip.Passed ? "" : "fail")">@chip.Label: @chip.Value</span>
                                    }
                                }
                            </div>
                        </td>
                        <td class="audit-cell wide">
                            <details>
                                <summary>View Signal Evaluation</summary>
                                <pre class="audit-json">
@view.FormattedSignalJson
                                </pre>
                            </details>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
</div>
