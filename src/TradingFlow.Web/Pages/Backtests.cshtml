@page "/Backtests"
@using TradingFlow.Domain.Backtesting
@using TradingFlow.Domain.Strategies
@using TradingFlow.Web.Pages.Shared
@model TradingFlow.Web.Pages.BacktestsModel
@{
    ViewData["Title"] = "Strategy Lab";
    ViewData["MainClass"] = "shell-flush lab-page";
    var job = Model.SelectedJob;
    var result = job?.Result;
    var drilled = Model.DrilledStrategy;
    var gates = Model.Gates;
    var profile = Model.Configs.FirstOrDefault(item => item.Path == Model.SelectedConfigPath)?.Config;
}

@functions {
    static string Signed(decimal value, string suffix = "%", string format = "0.00") =>
        (value > 0 ? "+" : value < 0 ? "−" : String.Empty) + Math.Abs(value).ToString(format) + suffix;

    static string SignedClass(decimal value) =>
        value > 0 ? "value-signed up" : value < 0 ? "value-signed down" : "value-signed flat";
}

<div class="page-head lab-head">
    <div>
        <span class="eyebrow">Backtesting research</span>
        <h1>Strategy Lab</h1>
        <p class="standfirst">
            Select strategies and stocks from a wishlist or saved Finviz list, then compare independent portfolio
            results. A profitable run is not a promotion — the preregistered gates below decide that.
        </p>
    </div>
    <div class="lab-head-tail">
        @* The integrated decision, not a summary of the return. *@
        <span class="tag tag-outline">Research decision · @(gates?.Decision ?? ResearchPromotionAssessment.RetainResearch)</span>
        <div class="seg lab-phases" role="group" aria-label="Run phase">
            <a class="seg-opt" asp-page="/Backtests" asp-route-wishlistId="@Model.WishlistId"
               aria-current="@(Model.Phase == "configure" ? "true" : null)">Configure</a>
            <span class="seg-opt" aria-current="@(Model.Phase == "running" ? "true" : null)">Running</span>
            <span class="seg-opt" aria-current="@(Model.Phase == "results" ? "true" : null)">Results</span>
        </div>
    </div>
</div>

<div class="lab-shell">
    @* =======================================================================
       Left rail - configuration
       ======================================================================= *@
    <form class="lab-rail" novalidate method="post" asp-page-handler="RunBacktest">
        <details class="research-configuration" open="@(Model.Phase == "configure")"><summary>@(Model.Phase == "configure" ? "Configure backtest" : "Configure another run")</summary>
        <label for="SelectedConfigPath">Backtest profile</label>
        <select class="input" id="SelectedConfigPath" name="SelectedConfigPath">
            @foreach (var config in Model.Configs)
            {
                <option value="@config.Path" selected="@(config.Path == Model.SelectedConfigPath)"
                        data-starting-capital="@config.Config.Portfolio.StartingCapital.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                        data-account-risk="@config.Config.Portfolio.AccountRiskBudgetPct.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                        data-position-notional="@config.Config.Portfolio.MaxPositionNotionalPct.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                        data-open-positions="@config.Config.Portfolio.MaxConcurrentPositions"
                        data-lookback-days="@config.Config.TimeWindow.LookbackDays"
                        data-cache-policy="@config.Config.CachePolicy">@config.FileName</option>
            }
        </select>

        <label for="ExecutionReplayPolicyId">Research execution assumptions</label>
        <select class="input" id="ExecutionReplayPolicyId" name="ExecutionReplayPolicyId">
            @foreach (var choice in TradingFlow.Web.Services.BacktestExecutionProfileResolver.Choices)
            {
                <option value="@choice.PolicyId">@choice.Name</option>
            }
        </select>
        <p class="note">The strategy supplies its horizon. Day and swing strategies use separate saved plans; the preview freezes the selected fill assumptions.</p>

        <div data-run-validation hidden role="alert" tabindex="-1"></div>
        <fieldset class="lab-block">
            <legend class="section-heading">
                <partial name="_Icon" model='new IconModel("layers", 15)' />Universe
            </legend>
            <div class="field">
                <label for="StockSource">Stock source</label>
                <select class="input" id="StockSource" name="StockSource">
                    @foreach (var group in Model.StockSources.GroupBy(source => source.Kind))
                    {
                        <optgroup label="@(TradingFlow.Contracts.V1.BacktestStockSource.GroupName(group.Key))">
                            @foreach (var source in group)
                            {
                                <option value="@source.Key" data-source-kind="@source.Kind" data-source-key="@source.Key"
                                    data-wishlist-id="@source.WishlistId" data-query="@source.Query" selected="@(source.WishlistId == Model.WishlistId && source.WishlistId is not null)">@source.Name</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            @* The single most important sentence on this screen: it is why the
               promotion gate fails, and it must not be dropped. *@
            <p class="note">
                Point-in-time membership is required for a promotable run. Preview shows the exact returned
                stocks in each group. Current wishlist and Finviz membership is research-only; it does not
                establish which stocks belonged to a list months ago.
            </p>
        </fieldset>

        <fieldset class="lab-block">
            <legend class="section-heading">Strategies</legend>
            <div class="lab-strategy-list">
                @foreach (var strategy in Model.Strategies)
                {
                    <label class="lab-strategy">
                        @* Square, because these are independent multi-select. *@
                        <input type="checkbox" name="StrategyPaths" value="@strategy.Path"
                               checked="@(Model.SelectedStrategyPath == strategy.Path)" />
                        <span class="lab-strategy-body">
                            <span class="lab-strategy-name">@strategy.Definition.StrategyName · @strategy.Identity.SemanticVersion</span>
                            <span class="lab-strategy-meta">
                                @StrategyHorizonResolver.Resolve(strategy.Definition) · @strategy.Definition.Direction · @strategy.Definition.Timeframe / @strategy.Definition.Execution.Timeframe
                            </span>
                            @if (strategy.Audit is { } audit)
                            {
                                <span class="lab-strategy-audit">
                                    Monthly audit requires a dated report /
                                    @audit.Trades trades / win @audit.WinRatePct.ToString("0.0")%
                                </span>
                            }
                            @* Research-only strategies must never reach paper or live.
                               Labelling the distinction here is how the operator learns it. *@
                            <span class="tag tag-neutral">@(strategy.Lifecycle == StrategyLifecycleState.Research ? "RESEARCH ONLY" : strategy.Lifecycle.ToString().ToUpperInvariant())</span>
                            <span class="lab-strategy-meta" style="overflow-wrap:anywhere">SHA-256 @strategy.Identity.ContentSha256</span>
                            @if (strategy.Artifact.DerivedFromIdentity is { } parent)
                            {
                                <span class="lab-strategy-meta" style="overflow-wrap:anywhere">Parent: @parent.StrategyId @parent.SemanticVersion · @parent.ContentSha256</span>
                            }
                            <span class="lab-strategy-meta">Admission: @strategy.Artifact.AdmissionProfile.ProfileId @strategy.Artifact.AdmissionProfile.ProfileVersion</span>
                            <span class="lab-strategy-meta">Execution: @strategy.Artifact.AdmissionProfile.ExecutionTimingPolicy</span>
                        </span>
                    </label>
                }
            </div>
            <p class="note">
                Select at least one strategy. A run with no strategy produces no evidence.
            </p>
        </fieldset>

        <fieldset class="lab-block">
            <legend class="section-heading">Decision-context evidence</legend>
            <label for="DecisionContextEvidence">Optional approved evidence</label>
            <select class="input" id="DecisionContextEvidence" name="DecisionContextEvidence" data-evidence-picker>
                <option value="">No evidence selected</option>
            </select>
            <p class="note" data-evidence-availability aria-live="polite"></p>
            <div class="note" data-evidence-summary style="overflow-wrap:anywhere"></div>
        </fieldset>

        <fieldset class="lab-block">
            <legend class="section-heading">Test window</legend>
            <div class="lab-parameters">
                <div class="field">
                    <label for="RunName">Run name</label>
                    <input class="input" id="RunName" name="RunName" maxlength="100" aria-describedby="RunNameHelp" value="lab-run" />
                    <p class="note" id="RunNameHelp">Use letters, digits, hyphens or underscores, or leave blank for a generated name.</p>
                </div>
                <div class="field">
                    <label for="TestWindowStartUtc">From UTC</label>
                    <input class="input" id="TestWindowStartUtc" name="TestWindowStartUtc" type="datetime-local" step="60" aria-describedby="TestWindowHelp" />
                </div>
                <div class="field">
                    <label for="TestWindowEndUtc">To UTC</label>
                    <input class="input" id="TestWindowEndUtc" name="TestWindowEndUtc" type="datetime-local" step="60" aria-describedby="TestWindowHelp" />
                </div>
                <div class="field">
                    <label for="LookbackDays">Fallback lookback (days)</label>
                    <input class="input" id="LookbackDays" name="LookbackDays" type="number" min="5" max="1825" step="1" value="@profile?.TimeWindow.LookbackDays" aria-describedby="TestWindowHelp" />
                </div>
            </div>
            <p class="note" id="TestWindowHelp">Enter both dates in UTC, regardless of your device timezone. Leave both blank to use the lookback ending now. The end must follow the start and cannot be in the future.</p>
        </fieldset>
        <fieldset class="lab-block">
            <legend class="section-heading">Stock groups</legend>
            <label for="ExcludedSymbols">Exclude stocks</label>
            <input class="input" id="ExcludedSymbols" name="ExcludedSymbols" aria-describedby="ExcludedSymbolsHelp" />
            <p class="note" id="ExcludedSymbolsHelp">Optional comma-separated stock symbols to exclude from this plan. The original wishlist or saved Finviz list stays unchanged.</p>
            <label for="GroupSize">Stocks per group</label>
            <input class="input" id="GroupSize" name="GroupSize" type="number" min="1" step="1" />
            <div class="lab-parameters">
                <div class="field">
                    <label for="GroupOrder">Group order</label>
                    <select class="input" id="GroupOrder" name="GroupOrder" aria-describedby="GroupOrderHelp">
                        <option value="alphabetical" selected>Alphabetical</option>
                        <option value="random">Random (seeded)</option>
                    </select>
                </div>
                <div class="field">
                    <label for="GroupSeed">Random seed</label>
                    <input class="input" id="GroupSeed" name="GroupSeed" type="number" min="0" step="1" aria-describedby="GroupOrderHelp" />
                </div>
            </div>
            <p class="note" id="GroupOrderHelp">Random order shuffles the stocks by seed before splitting them into groups. The same seed always rebuilds the same groups, and the seed is saved with the plan.</p>
            <label for="ManualCohorts">Or enter your own groups</label>
            <textarea class="input" id="ManualCohorts" name="ManualCohorts" rows="4" aria-describedby="ManualCohortsHelp"></textarea>
            <p class="note" id="ManualCohortsHelp">One group per line: name | starting capital | stock symbols separated by commas. Leave stocks per group blank when entering your own groups. Automatic groups use the chosen order and keep the final smaller group. Each strategy and group has separate capital.</p>
        </fieldset>
        <fieldset class="lab-block">
            <legend class="section-heading">Daily eligibility</legend>
            <div class="lab-parameters">
                <div class="field">
                    <label for="EligibilityMinPrice">Minimum price (USD)</label>
                    <input class="input" id="EligibilityMinPrice" name="EligibilityMinPrice" type="number" min="0" step="any" aria-describedby="EligibilityHelp" />
                </div>
                <div class="field">
                    <label for="EligibilityPriceBasis">Price compared</label>
                    <select class="input" id="EligibilityPriceBasis" name="EligibilityPriceBasis">
                        <option value="prior_close" selected>Previous close</option>
                        <option value="session_open">That day's open</option>
                    </select>
                </div>
                <div class="field">
                    <label for="EligibilityAverageSessions">Average over (sessions)</label>
                    <input class="input" id="EligibilityAverageSessions" name="EligibilityAverageSessions" type="number" min="1" step="1" value="20" />
                </div>
                <div class="field">
                    <label for="EligibilityMinAverageVolume">Minimum average volume (shares)</label>
                    <input class="input" id="EligibilityMinAverageVolume" name="EligibilityMinAverageVolume" type="number" min="0" step="any" />
                </div>
                <div class="field">
                    <label for="EligibilityMinAverageDollarVolume">Minimum average dollar volume (USD)</label>
                    <input class="input" id="EligibilityMinAverageDollarVolume" name="EligibilityMinAverageDollarVolume" type="number" min="0" step="any" />
                </div>
                <div class="field">
                    <label for="EligibilityAtrPeriod">ATR period (sessions)</label>
                    <input class="input" id="EligibilityAtrPeriod" name="EligibilityAtrPeriod" type="number" min="1" step="1" />
                </div>
                <div class="field">
                    <label for="EligibilityMinAtr">Minimum ATR (USD)</label>
                    <input class="input" id="EligibilityMinAtr" name="EligibilityMinAtr" type="number" min="0" step="any" />
                </div>
                <div class="field">
                    <label for="EligibilityMinHistorySessions">Minimum history (sessions)</label>
                    <input class="input" id="EligibilityMinHistorySessions" name="EligibilityMinHistorySessions" type="number" min="1" step="1" value="20" />
                </div>
            </div>
            <p class="note" id="EligibilityHelp">Optional. Enter a minimum price to switch it on. Each stock may then trade only on days it passes these rules, judged from completed earlier sessions (and that day's open when chosen). Blank thresholds are not applied. Every stock's eligible days are saved with the results.</p>
        </fieldset>
        <fieldset class="lab-block">
            <legend class="section-heading">Portfolio limits</legend>
            <div class="lab-parameters">
                <div class="field">
                    <label for="StartingCapital">Starting capital (USD)</label>
                    <input class="input" id="StartingCapital" name="StartingCapital" type="number" min="0.01" step="any" value="@profile?.Portfolio.StartingCapital.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
                <div class="field">
                    <label for="AccountRiskBudgetPct">Account risk (% of equity)</label>
                    <input class="input" id="AccountRiskBudgetPct" name="AccountRiskBudgetPct" type="number" min="0.01" max="100" step="any" value="@profile?.Portfolio.AccountRiskBudgetPct.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
                <div class="field">
                    <label for="MaxPositionNotionalPct">Max position notional (% of equity)</label>
                    <input class="input" id="MaxPositionNotionalPct" name="MaxPositionNotionalPct" type="number" min="0.01" max="100" step="any" value="@profile?.Portfolio.MaxPositionNotionalPct.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
                <div class="field">
                    <label for="MaxConcurrentPositions">Max concurrent positions (count)</label>
                    <input class="input" id="MaxConcurrentPositions" name="MaxConcurrentPositions" type="number" min="1" max="1000" step="1" value="@profile?.Portfolio.MaxConcurrentPositions" />
                </div>
                <div class="field">
                    <label for="CachePolicy">Market data</label>
                    <select class="input" id="CachePolicy" name="CachePolicy" aria-describedby="CachePolicyHelp">
                        <option value="use_cache" selected="@(profile?.CachePolicy == "use_cache")">Use cache</option>
                        <option value="refresh" selected="@(profile?.CachePolicy == "refresh")">Refresh</option>
                    </select>
                    <p class="note" id="CachePolicyHelp">Use cached candles where available, or request a provider refresh. Neither option fills missing evidence with invented values.</p>
                </div>
            </div>
            <p class="note">Risk and notional limits must be greater than zero and at most 100% of equity. Completed-bar features, later-bar confirmation and next-bar execution are mandatory.</p>
        </fieldset>

        </details>
        <section class="lab-block lab-run">
            @if (Model.Phase == "running" && job is not null)
            {
                <button class="btn btn-secondary btn-block btn-xl" type="submit"
                        asp-page-handler="CancelBacktest" asp-route-id="@job.JobId">
                    <partial name="_Icon" model='new IconModel("square", 15)' />Cancel run
                </button>
            }
            else
            {
                <button class="btn btn-primary btn-block btn-xl" type="submit">
                    <partial name="_Icon" model='new IconModel("play", 15)' />Preview groups
                </button>
                <button class="btn btn-secondary btn-block" type="submit" data-backtest-action="save" disabled>Save plan</button>
                <label for="SavedBacktestPlan">Saved plans</label>
                <select class="input" id="SavedBacktestPlan" data-saved-backtest-plan><option value="">Select a saved plan</option></select>
                <button class="btn btn-primary btn-block" type="button" data-start-backtest-plan disabled>Start saved plan</button>
                <div data-backtest-plan-preview aria-live="polite" style="overflow-wrap:anywhere"></div>
            }
            <p class="note">
                Generated run configs are audit artifacts. They are not hand-maintained ticker lists.
            </p>
        </section>
    </form>

    @* =======================================================================
       Main column - one of three phases
       ======================================================================= *@
    <div class="lab-main">
        @if (job is not null)
        {
            <section class="lab-panel" data-job-evidence="@job.JobId" hidden style="overflow-wrap:anywhere">
                <h2 class="section-heading">Decision-context evidence</h2>
                <div data-job-evidence-summary></div>
            </section>
        }
        @if (Model.Phase == "configure")
        {
            <section class="lab-panel">
                <h2 class="section-heading">Research snapshots</h2>
                @if (Model.ResearchSnapshots.Count == 0)
                {
                    <p class="empty-state">No research snapshot has been written yet.</p>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="grid-table">
                            <thead>
                                <tr>
                                    <th scope="col">Run</th>
                                    <th scope="col">Strategy</th>
                                    <th scope="col">Universe</th>
                                    <th scope="col">Monthly evidence</th>
                                    <th scope="col">Evidence scope</th>
                                    <th scope="col" class="num">Trades</th>
                                    <th scope="col">Decision</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var snapshot in Model.ResearchSnapshots)
                                {
                                    <tr>
                                        <td class="mono">@snapshot.RunId</td>
                                        <td>@snapshot.StrategyName</td>
                                        <td>@snapshot.UniverseSource</td>
                                        <td>Open the dated monthly strategy report</td>
                                        <td>Legacy snapshot; monthly valuation required</td>
                                        <td class="num">@snapshot.AcceptedTradeCount</td>
                                        <td>
                                            <span class="tag @(snapshot.Decision == "PROMOTED" ? "tag-promoted" : "tag-research")">@snapshot.Decision</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <p class="note">
                    These older summaries report completed trades. Current native daily
                    results retain actual partial fills and positions still open at the test end.
                </p>
            </section>

            <section class="lab-panel">
                <h2 class="section-heading">Recent runs</h2>
                @if (Model.BacktestJobs.Count == 0)
                {
                    <p class="empty-state">No backtest has been started in this session.</p>
                }
                else
                {
                    <ul class="lab-run-list">
                        @foreach (var recent in Model.BacktestJobs)
                        {
                            <li>
                                <a asp-page="/Backtests" asp-route-jobId="@recent.JobId" asp-route-wishlistId="@Model.WishlistId">
                                    <strong>@recent.RunName</strong>
                                    <span class="tag @(recent.Status == "completed" ? "tag-neutral" : "tag-accent")">@recent.Status</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
        else if (job is not null && Model.Phase == "running")
        {
            <partial name="_LabRunning" model="job" />
        }
        else if (job is not null && result is not null && drilled is not null && gates is not null)
        {
            <partial name="_LabResults" model="new LabResultsModel(Model, job, result, drilled, gates)" />
        }
        else
        {
            <p class="empty-state">This run completed without a result payload.</p>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/run-workflow.js" asp-append-version="true" defer></script>
    @if (Model.Phase == "running" && job is not null)
    {
        <script src="~/js/lab-progress.js" asp-append-version="true" data-job-id="@job.JobId" defer></script>
    }
}
