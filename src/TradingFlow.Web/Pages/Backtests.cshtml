@page "/Backtests"
@using TradingFlow.Domain.Backtesting
@using TradingFlow.Web.Pages.Shared
@model TradingFlow.Web.Pages.BacktestsModel
@{
    ViewData["Title"] = "Strategy Lab";
    ViewData["MainClass"] = "shell-flush lab-page";
    var job = Model.SelectedJob;
    var result = job?.Result;
    var drilled = Model.DrilledStrategy;
    var gates = Model.Gates;
    var promotedRoot = System.IO.Path.Combine("configs", "strategies");
}

@functions {
    static string Signed(decimal value, string suffix = "%", string format = "0.00") =>
        (value > 0 ? "+" : value < 0 ? "−" : String.Empty) + Math.Abs(value).ToString(format) + suffix;

    static string SignedClass(decimal value) =>
        value > 0 ? "value-signed up" : value < 0 ? "value-signed down" : "value-signed flat";
}

<div class="page-head lab-head">
    <div>
        <span class="eyebrow">Backtesting research</span>
        <h1>Strategy Lab</h1>
        <p class="standfirst">
            Select strategies, run them against one wishlist universe, and compare portfolio-level
            results. A profitable run is not a promotion — the preregistered gates below decide that.
        </p>
    </div>
    <div class="lab-head-tail">
        @* The integrated decision, not a summary of the return. *@
        <span class="tag tag-outline">Research decision · @(gates?.Decision ?? ResearchPromotionAssessment.RetainResearch)</span>
        <div class="seg lab-phases" role="group" aria-label="Run phase">
            <a class="seg-opt" asp-page="/Backtests" asp-route-wishlistId="@Model.WishlistId"
               aria-current="@(Model.Phase == "configure" ? "true" : null)">Configure</a>
            <span class="seg-opt" aria-current="@(Model.Phase == "running" ? "true" : null)">Running</span>
            <span class="seg-opt" aria-current="@(Model.Phase == "results" ? "true" : null)">Results</span>
        </div>
    </div>
</div>

<div class="lab-shell">
    @* =======================================================================
       Left rail - configuration
       ======================================================================= *@
    <form class="lab-rail" method="post" asp-page-handler="RunBacktest">
        <input type="hidden" name="SelectedConfigPath" value="@Model.SelectedConfigPath" />

        <section class="lab-block">
            <h2 class="section-heading">
                <partial name="_Icon" model='new IconModel("layers", 15)' />Universe
            </h2>
            <div class="field">
                <label for="WishlistId">Wishlist</label>
                <select class="input" id="WishlistId" name="WishlistId">
                    @foreach (var wishlist in Model.Wishlists)
                    {
                        <option value="@wishlist.Id" selected="@(Model.WishlistId == wishlist.Id)">
                            @wishlist.Name · @wishlist.Items.Count(item => item.Active) active
                        </option>
                    }
                </select>
            </div>
            @if (Model.SelectedWishlist is { } selectedWishlist)
            {
                <div class="lab-symbols">
                    @foreach (var item in selectedWishlist.Items.Where(entry => entry.Active).Take(40))
                    {
                        <span class="tag tag-neutral">@item.Ticker</span>
                    }
                </div>
            }
            @* The single most important sentence on this screen: it is why the
               promotion gate fails, and it must not be dropped. *@
            <p class="note">
                Point-in-time membership is required for a promotable run. This wishlist is a current
                list, so the run is marked research-only.
            </p>
        </section>

        <section class="lab-block">
            <h2 class="section-heading">Strategies</h2>
            <div class="lab-strategy-list">
                @foreach (var strategy in Model.Strategies)
                {
                    var isPromoted = strategy.Path.Contains(promotedRoot, StringComparison.OrdinalIgnoreCase);
                    <label class="lab-strategy">
                        @* Square, because these are independent multi-select. *@
                        <input type="checkbox" name="StrategyPaths" value="@strategy.Path"
                               checked="@(Model.SelectedStrategyPath == strategy.Path)" />
                        <span class="lab-strategy-body">
                            <span class="lab-strategy-name">@strategy.Definition.StrategyName v@strategy.Definition.Version</span>
                            <span class="lab-strategy-meta">
                                @strategy.Definition.Direction · @strategy.Definition.Timeframe / @strategy.Definition.Execution.Timeframe
                            </span>
                            @if (strategy.Audit is { } audit)
                            {
                                <span class="lab-strategy-audit">
                                    Audit @Signed(audit.ReturnPct) / DD @audit.MaxDrawdownPct.ToString("0.00")% /
                                    @audit.Trades trades / win @audit.WinRatePct.ToString("0.0")%
                                </span>
                            }
                            @* Research-only strategies must never reach paper or live.
                               Labelling the distinction here is how the operator learns it. *@
                            <span class="tag @(isPromoted ? "tag-accent" : "tag-neutral")">
                                @(isPromoted ? "PROMOTED" : "RESEARCH ONLY")
                            </span>
                        </span>
                    </label>
                }
            </div>
            <p class="note">
                Select at least one strategy. A run with no strategy produces no evidence.
            </p>
        </section>

        <section class="lab-block">
            <h2 class="section-heading">Run parameters</h2>
            <div class="lab-parameters">
                <div class="field">
                    <label for="RunName">Run name</label>
                    <input class="input" id="RunName" name="RunName" value="lab-run" />
                </div>
                <div class="field">
                    <label for="LookbackDays">Lookback days</label>
                    <input class="input" id="LookbackDays" name="LookbackDays" type="number" min="5" max="1825" value="180" />
                </div>
                <div class="field">
                    <label for="StartingCapital">Starting capital</label>
                    <input class="input" id="StartingCapital" name="StartingCapital" type="number" step="100" value="10000" />
                </div>
                <div class="field">
                    <label for="AccountRiskBudgetPct">Account risk %</label>
                    <input class="input" id="AccountRiskBudgetPct" name="AccountRiskBudgetPct" type="number" step="0.1" value="1" />
                </div>
                <div class="field">
                    <label for="MaxPositionNotionalPct">Max position notional %</label>
                    <input class="input" id="MaxPositionNotionalPct" name="MaxPositionNotionalPct" type="number" step="1" value="25" />
                </div>
                <div class="field">
                    <label for="MaxConcurrentPositions">Max positions</label>
                    <input class="input" id="MaxConcurrentPositions" name="MaxConcurrentPositions" type="number" min="1" value="4" />
                </div>
                <div class="field">
                    <label for="CachePolicy">Market data</label>
                    <select class="input" id="CachePolicy" name="CachePolicy">
                        <option value="use_cache">Use cache</option>
                        <option value="refresh">Refresh</option>
                    </select>
                </div>
            </div>
            <p class="note">
                Completed-bar features, later-bar confirmation and next-bar execution are mandatory
                and not configurable.
            </p>
        </section>

        <section class="lab-block lab-run">
            @if (Model.Phase == "running" && job is not null)
            {
                <button class="btn btn-secondary btn-block btn-xl" type="submit"
                        asp-page-handler="CancelBacktest" asp-route-id="@job.JobId">
                    <partial name="_Icon" model='new IconModel("square", 15)' />Cancel run
                </button>
            }
            else
            {
                <button class="btn btn-primary btn-block btn-xl" type="submit">
                    <partial name="_Icon" model='new IconModel("play", 15)' />Run backtest
                </button>
            }
            <p class="note">
                Generated run configs are audit artifacts. They are not hand-maintained ticker lists.
            </p>
        </section>
    </form>

    @* =======================================================================
       Main column - one of three phases
       ======================================================================= *@
    <div class="lab-main">
        @if (Model.Phase == "configure")
        {
            <section class="lab-panel">
                <h2 class="section-heading">Research snapshots</h2>
                @if (Model.ResearchSnapshots.Count == 0)
                {
                    <p class="empty-state">No research snapshot has been written yet.</p>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="grid-table">
                            <thead>
                                <tr>
                                    <th scope="col">Run</th>
                                    <th scope="col">Best strategy</th>
                                    <th scope="col">Universe</th>
                                    <th scope="col" class="num">Return</th>
                                    <th scope="col" class="num">Max DD</th>
                                    <th scope="col" class="num">Trades</th>
                                    <th scope="col">Decision</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var snapshot in Model.ResearchSnapshots)
                                {
                                    <tr>
                                        <td class="mono">@snapshot.RunId</td>
                                        <td>@snapshot.BestStrategyName</td>
                                        <td>@snapshot.UniverseSource</td>
                                        <td class="num @SignedClass(snapshot.TotalReturnPct)">@Signed(snapshot.TotalReturnPct)</td>
                                        <td class="num">@snapshot.MaxDrawdownPct.ToString("0.00")%</td>
                                        <td class="num">@snapshot.AcceptedTradeCount</td>
                                        <td>
                                            <span class="tag @(snapshot.Decision == "PROMOTED" ? "tag-promoted" : "tag-research")">@snapshot.Decision</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <p class="note">
                    Partial exits are not modelled. A backtest supports one entry and one full-position
                    exit, so strategies that scale out will read differently here than in paper.
                </p>
            </section>

            <section class="lab-panel">
                <h2 class="section-heading">Recent runs</h2>
                @if (Model.BacktestJobs.Count == 0)
                {
                    <p class="empty-state">No backtest has been started in this session.</p>
                }
                else
                {
                    <ul class="lab-run-list">
                        @foreach (var recent in Model.BacktestJobs)
                        {
                            <li>
                                <a asp-page="/Backtests" asp-route-jobId="@recent.JobId" asp-route-wishlistId="@Model.WishlistId">
                                    <strong>@recent.RunName</strong>
                                    <span class="tag @(recent.Status == "completed" ? "tag-neutral" : "tag-accent")">@recent.Status</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
        else if (job is not null && Model.Phase == "running")
        {
            <partial name="_LabRunning" model="job" />
        }
        else if (job is not null && result is not null && drilled is not null && gates is not null)
        {
            <partial name="_LabResults" model="new LabResultsModel(Model, job, result, drilled, gates)" />
        }
        else
        {
            <p class="empty-state">This run completed without a result payload.</p>
        }
    </div>
</div>

@section Scripts {
    @if (Model.Phase == "running" && job is not null)
    {
        <script src="~/js/lab-progress.js" asp-append-version="true" data-job-id="@job.JobId" defer></script>
    }
}
