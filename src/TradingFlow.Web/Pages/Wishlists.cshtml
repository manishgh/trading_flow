@page "/Wishlists"
@model TradingFlow.Web.Pages.WishlistsModel
@{
    ViewData["Title"] = "Wishlist Management";
    var selected = Model.SelectedWishlist;
    var selectedName = selected?.Name ?? String.Empty;
}

<header class="page-header compact-page-header">
    <div>
        <h1>Wishlist Management</h1>
        <p>Create groups, maintain ticker context, control observation, and import a Finviz universe.</p>
    </div>
    <div class="actions">
        <a class="button" asp-page="/TradeDesk" asp-route-id="@selected?.Id">Open Desk</a>
        <a class="button secondary" asp-page="/Wishlists" asp-route-id="@selected?.Id">Refresh</a>
    </div>
</header>

@if (!String.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="status-banner" role="status">@Model.StatusMessage</div>
}
@if (!String.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="status-banner error" role="alert">@Model.ErrorMessage</div>
}

<section class="panel">
    <form id="wishlistOpenForm" method="get" class="wishlist-toolbar">
        <div>
            <label for="WishlistCombo">Wishlist</label>
            <input id="WishlistCombo" list="WishlistOptions" value="@selectedName" autocomplete="off" />
            <input id="WishlistId" type="hidden" name="id" value="@selected?.Id" />
            <datalist id="WishlistOptions">
                @foreach (var wishlist in Model.Wishlists)
                {
                    <option value="@wishlist.Name" data-id="@wishlist.Id"></option>
                }
            </datalist>
        </div>
        <button type="submit">Open</button>
        <button id="CreateWishlistButton" class="secondary" type="button">Add New</button>
    </form>
    <form id="createWishlistForm" method="post" asp-page-handler="CreateWishlist">
        <input id="CreateWishlistName" type="hidden" name="WishlistName" />
    </form>
</section>

@if (selected is null)
{
    <section class="panel empty-state">
        <strong>No wishlist selected.</strong>
        <span>Type a new name above and choose Add New.</span>
    </section>
}
else
{
    <section class="wishlist-management-layout">
        <div class="wishlist-management-main">
            <section class="panel">
                <div class="panel-header compact">
                    <div>
                        <h2>@selected.Name</h2>
                        <p>@Model.ActiveItems.Count active symbol@(Model.ActiveItems.Count == 1 ? "" : "s").</p>
                    </div>
                    <form method="post" asp-page-handler="SetObserved">
                        <input type="hidden" name="WishlistId" value="@selected.Id" />
                        <input type="hidden" name="IsObserved" value="@(selected.IsObserved ? "false" : "true")" />
                        <button class="secondary" type="submit">@(selected.IsObserved ? "Pause observer" : "Start observer")</button>
                    </form>
                </div>

                <form method="post" asp-page-handler="SaveWishlist" class="wishlist-settings-grid">
                    <input type="hidden" name="WishlistId" value="@selected.Id" />
                    <div>
                        <label for="WishlistName">Name</label>
                        <input id="WishlistName" name="WishlistName" value="@selected.Name" required />
                    </div>
                    <div>
                        <label for="WishlistDescription">Description</label>
                        <input id="WishlistDescription" name="Description" value="@selected.Description" />
                    </div>
                    <label class="toggle-field"><input type="checkbox" name="IsDefault" value="true" checked="@selected.IsDefault" /> Default wishlist</label>
                    <label class="toggle-field"><input type="checkbox" name="IncludeExtendedHours" value="true" checked="@selected.IncludeExtendedHours" /> Include extended hours</label>
                    <input type="hidden" name="IsObserved" value="@selected.IsObserved.ToString().ToLowerInvariant()" />
                    <button type="submit">Save settings</button>
                </form>
            </section>

            <section class="panel">
                <h2>Add Symbols</h2>
                <form method="post" asp-page-handler="AddTicker" class="add-ticker-strip">
                    <input type="hidden" name="TargetWishlistId" value="@selected.Id" />
                    <div><label for="TickerTop">Ticker</label><input id="TickerTop" name="Ticker" placeholder="RGTI" autocomplete="off" required /></div>
                    <div><label for="DisplayNameTop">Name</label><input id="DisplayNameTop" name="DisplayName" placeholder="Optional" /></div>
                    <div><label for="NotesTop">Notes</label><input id="NotesTop" name="Notes" placeholder="Catalyst, setup, risk" /></div>
                    <button type="submit">Add Ticker</button>
                </form>
                <form method="post" asp-page-handler="ImportFinviz" class="finviz-import-strip">
                    <input type="hidden" name="TargetWishlistId" value="@selected.Id" />
                    <div>
                        <label for="FinvizFilter">Finviz screener URL or query</label>
                        <input id="FinvizFilter" name="FinvizFilter" placeholder="Paste Finviz Elite URL or query" />
                        <small>Adds returned symbols without removing existing entries.</small>
                    </div>
                    <button class="secondary" type="submit">Import</button>
                </form>
            </section>

            <section class="panel">
                <div class="panel-header compact"><div><h2>Symbols</h2><p>Edit context or remove inactive ideas.</p></div></div>
                @if (Model.ActiveItems.Count == 0)
                {
                    <div class="empty-state"><strong>No active symbols.</strong><span>Add one above or import a Finviz screen.</span></div>
                }
                else
                {
                    <div class="table-scroll" role="region" aria-label="Wishlist symbol management" tabindex="0">
                        <table class="management-table">
                            <thead><tr><th scope="col">Ticker</th><th scope="col">Name</th><th scope="col">Notes</th><th scope="col">Actions</th></tr></thead>
                            <tbody>
                            @foreach (var item in Model.ActiveItems)
                            {
                                var formId = $"edit_{item.Id:N}";
                                <tr>
                                    <td><strong>@item.Ticker</strong><input form="@formId" type="hidden" name="Ticker" value="@item.Ticker" /></td>
                                    <td><input form="@formId" name="DisplayName" value="@item.DisplayName" aria-label="@item.Ticker display name" /></td>
                                    <td><input form="@formId" name="Notes" value="@item.Notes" aria-label="@item.Ticker notes" /></td>
                                    <td class="management-actions">
                                        <form id="@formId" method="post" asp-page-handler="AddTicker">
                                            <input type="hidden" name="TargetWishlistId" value="@selected.Id" />
                                            <button class="secondary compact-command" type="submit">Save</button>
                                        </form>
                                        <form method="post" asp-page-handler="RemoveTicker">
                                            <input type="hidden" name="WishlistId" value="@selected.Id" />
                                            <input type="hidden" name="Ticker" value="@item.Ticker" />
                                            <button class="danger compact-command" type="submit" data-confirm="Remove @item.Ticker from this wishlist?">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>

        <aside class="panel wishlist-safety-panel">
            <h2>Management only</h2>
            <p>This page cannot submit broker orders or start a strategy. Open Trade Desk to review live evidence first.</p>
            <dl>
                <dt>Observer</dt><dd>@(selected.IsObserved ? "Running" : "Paused")</dd>
                <dt>Extended hours data</dt><dd>@(selected.IncludeExtendedHours ? "Included" : "Regular session only")</dd>
                <dt>Default</dt><dd>@(selected.IsDefault ? "Yes" : "No")</dd>
            </dl>
            <form method="post" asp-page-handler="DeleteWishlist">
                <input type="hidden" name="WishlistId" value="@selected.Id" />
                <button class="danger" type="submit" data-confirm="Delete wishlist @selected.Name?">Delete wishlist</button>
            </form>
        </aside>
    </section>
}

@section Scripts {
    <script type="module" src="~/js/wishlist-management.js" asp-append-version="true"></script>
}
