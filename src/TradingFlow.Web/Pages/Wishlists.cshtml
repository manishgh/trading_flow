@page "/Wishlists"
@model TradingFlow.Web.Pages.WishlistsModel
@{
    ViewData["Title"] = "Stock groups";
    ViewData["MainClass"] = "wishlists-page";
    var selected = Model.SelectedWishlist;
}

@functions {
    // One message line, shown beside the section whose action produced it.
    private Microsoft.AspNetCore.Html.IHtmlContent Message(string area)
    {
        if (!Model.MessageFor(area)) return Microsoft.AspNetCore.Html.HtmlString.Empty;
        var builder = new Microsoft.AspNetCore.Html.HtmlContentBuilder();
        if (!String.IsNullOrWhiteSpace(Model.ErrorMessage))
            builder.AppendHtml("<p class=\"wl-message error\" role=\"alert\">").Append(Model.ErrorMessage).AppendHtml("</p>");
        if (!String.IsNullOrWhiteSpace(Model.StatusMessage))
            builder.AppendHtml("<p class=\"wl-message\" role=\"status\">").Append(Model.StatusMessage).AppendHtml("</p>");
        return builder;
    }
}

<header class="stock-groups-header"><span class="eyebrow">YOUR UNIVERSE</span><h1>Stock groups</h1><p class="muted">Organize the stocks you follow. Discovery groups do not authorize trades.</p></header>
<div class="wl-layout">
    <aside class="wl-lists" aria-labelledby="wl-lists-title">
        <h2 id="wl-lists-title">Stock groups</h2>
        <nav aria-label="Stock groups">
            @foreach (var wishlist in Model.Wishlists)
            {
                var active = selected?.Id == wishlist.Id;
                <a asp-page="/Wishlists" asp-route-id="@wishlist.Id" aria-current="@(active ? "page" : null)">
                    <span>@wishlist.Name</span>
                    <span class="wl-count">@wishlist.Items.Count(item => item.Active)</span>
                </a>
            }
        </nav>
        <form method="post" asp-page-handler="CreateWishlist" class="wl-create">
            <label for="CreateWishlistName">New stock group</label>
            <div class="wl-inline">
                <input id="CreateWishlistName" name="WishlistName" placeholder="Name" autocomplete="off" required />
                <button class="button secondary" type="submit">Add new</button>
            </div>
        </form>
        @Message("lists")
    </aside>

    @if (selected is null)
    {
        <section class="wl-main">
            <h2>Create your first group</h2>
            <p class="muted">There is no stock group yet. Name one under New stock group and choose Add new.</p>
        </section>
    }
    else
    {
        var stockCount = Model.ActiveItems.Count;
        <section class="wl-main" aria-labelledby="wl-title">
            <div class="wl-head">
                <div>
                    <h2 id="wl-title">@selected.Name</h2>
                    <p class="muted">
                        @stockCount @(stockCount == 1 ? "stock" : "stocks")@(selected.IsDefault ? " · default list" : "") · @(selected.IncludeExtendedHours ? "watched pre-market and after hours" : "regular session only")
                    </p>
                </div>
                <div class="wl-head-actions">
                    <a class="button" asp-page="/Desk" asp-route-source="@("wishlist:" + selected.Id)">Open on Desk</a>
                    <details class="wl-settings">
                        <summary class="button secondary">Settings</summary>
                        <div class="wl-settings-panel">
                            <form method="post" asp-page-handler="SaveWishlist">
                                <input type="hidden" name="WishlistId" value="@selected.Id" />
                                <input type="hidden" name="IsObserved" value="@selected.IsObserved.ToString().ToLowerInvariant()" />
                                <label for="WishlistName">Name</label>
                                <input id="WishlistName" name="WishlistName" value="@selected.Name" required />
                                <label for="WishlistDescription">Description</label>
                                <input id="WishlistDescription" name="Description" value="@selected.Description" />
                                <label class="checkbox-field"><input type="checkbox" name="IsDefault" value="true" checked="@selected.IsDefault" /><span>Default stock group</span></label>
                                <label class="checkbox-field"><input type="checkbox" name="IncludeExtendedHours" value="true" checked="@selected.IncludeExtendedHours" /><span>Watch pre-market and after hours</span></label>
                                <div class="wl-inline wl-end">
                                    <button class="button" type="submit">Save settings</button>
                                </div>
                            </form>
                            <form method="post" asp-page-handler="DeleteWishlist" class="wl-delete">
                                <input type="hidden" name="WishlistId" value="@selected.Id" />
                                <p class="muted">Deleting removes the list only. Open positions, orders and recorded signals stay.</p>
                                <button class="button secondary wl-danger" type="submit"
                                        data-confirm="Delete the stock group @selected.Name? Open positions, orders and recorded signals are not deleted.">Delete stock group</button>
                            </form>
                        </div>
                    </details>
                </div>
            </div>
            @Message("settings")

            <nav class="wl-tabs" aria-label="Stock group views">
                <a asp-page="/Wishlists" asp-route-id="@selected.Id" aria-current="@(Model.ShowScreens ? null : "page")">Stocks</a>
                <a asp-page="/Wishlists" asp-route-id="@selected.Id" asp-route-view="screens" aria-current="@(Model.ShowScreens ? "page" : null)">Saved Finviz screens</a>
            </nav>

            @if (!Model.ShowScreens)
            {
                <div class="wl-add">
                    <form method="post" asp-page-handler="AddTickers" class="wl-add-form">
                        <input type="hidden" name="TargetWishlistId" value="@selected.Id" />
                        <label for="BulkTickers">Add stocks</label>
                        <div class="wl-inline">
                            <input id="BulkTickers" name="Tickers" placeholder="One or many tickers, e.g. AAPL, MSFT NVDA" autocomplete="off" required />
                            <button class="button" type="submit">Add</button>
                        </div>
                    </form>
                    <details class="wl-import">
                        <summary class="button secondary">Import from Finviz</summary>
                        @* Saved screens are offered by name; the box still takes a raw URL or query for a one-off. *@
                        <form method="post" asp-page-handler="ImportFinviz" class="wl-import-form">
                            <input type="hidden" name="TargetWishlistId" value="@selected.Id" />
                            <label for="FinvizFilter">Saved screen, Finviz URL or query</label>
                            <div class="wl-inline">
                                <input id="FinvizFilter" name="FinvizFilter" list="SavedScreens" required
                                       placeholder="A saved screen name, or https://elite.finviz.com/screener.ashx?f=…" />
                                <button class="button secondary" type="submit">Import</button>
                            </div>
                            <datalist id="SavedScreens">
                                @foreach (var preset in Model.Presets)
                                {
                                    <option value="@preset.Name">@preset.FilterQuery</option>
                                }
                            </datalist>
                            <p class="muted wl-note">Adds the stocks the screen returns; nothing already in the list is removed.</p>
                        </form>
                    </details>
                </div>
                @Message("stocks")

                @if (stockCount == 0)
                {
                    <p class="muted wl-empty">No stocks yet. Add tickers above or import a Finviz screen.</p>
                }
                else
                {
                    @* One form holds the selection; removal, copying and moving go through the undoable wishlist dialog. *@
                    <form data-bulk-form class="wl-stocks" onsubmit="return false">
                        <div class="wl-bulk-bar" data-bulk-bar hidden>
                            <span><strong><span data-bulk-count>0</span> selected</strong> <span class="muted" data-bulk-names></span></span>
                            <span class="wl-inline">
                                <button class="button secondary" type="button" data-group-action="copy" data-source-id="@selected.Id">Copy to…</button>
                                <button class="button secondary" type="button" data-group-action="move" data-source-id="@selected.Id">Move to…</button>
                                <button class="button secondary wl-danger" type="button" data-group-action="remove" data-source-id="@selected.Id">Remove</button>
                                <button class="button secondary" type="button" data-bulk-clear>Clear</button>
                            </span>
                        </div>
                        <div class="table-scroll" role="region" aria-label="Stocks in @selected.Name" tabindex="0">
                            <table class="wl-table">
                                <thead>
                                    <tr>
                                        <th scope="col" class="select-column"><input type="checkbox" data-bulk-toggle-all aria-label="Select all stocks" /></th>
                                        <th scope="col">Symbol</th>
                                        <th scope="col">Name</th>
                                        <th scope="col">Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ActiveItems)
                                    {
                                        <tr data-ticker="@item.Ticker">
                                            <td class="select-column"><input type="checkbox" name="Tickers" value="@item.Ticker" data-bulk-item aria-label="Select @item.Ticker" /></td>
                                            <td><strong>@item.Ticker</strong></td>
                                            <td><input class="wl-cell-input" data-inline-name value="@item.DisplayName" placeholder="—" aria-label="@item.Ticker name" /></td>
                                            <td><input class="wl-cell-input" data-inline-notes value="@item.Notes" placeholder="—" aria-label="@item.Ticker notes" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="muted wl-note" data-inline-status role="status">Click a name or note to edit it; it saves when you leave the field.</p>
                    </form>

                    <form id="editMembershipForm" method="post" asp-page-handler="AddTicker" hidden>
                        <input type="hidden" name="TargetWishlistId" value="@selected.Id" />
                        <input type="hidden" name="Ticker" />
                        <input type="hidden" name="DisplayName" />
                        <input type="hidden" name="Notes" />
                    </form>
                }
            }
            else
            {
                @* Finviz Elite has no endpoint that lists the screens saved in its own interface, so they are named here once. *@
                <p class="muted">Name a Finviz screen once and pick it by name in Import, Strategies and the Desk. Screens are shared by every stock group.</p>
                <form method="post" asp-page-handler="SavePreset" class="wl-preset-form">
                    <input type="hidden" name="id" value="@selected.Id" />
                    <input type="hidden" name="presetScope" value="swing" />
                    <div>
                        <label for="PresetName">Name</label>
                        <input id="PresetName" name="presetName" placeholder="Gap and go" required />
                    </div>
                    <div>
                        <label for="PresetQuery">Finviz URL or filter query</label>
                        <input id="PresetQuery" name="presetQuery" placeholder="sh_price_o5,sh_avgvol_o500,ta_change_u5" required />
                    </div>
                    <button class="button" type="submit">Save screen</button>
                </form>
                @Message("screens")

                @if (Model.Presets.Count == 0)
                {
                    <p class="muted wl-empty">No screen is saved yet.</p>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="wl-table">
                            <thead>
                                <tr>
                                    <th scope="col">Name</th>
                                    <th scope="col">Filter</th>
                                    <th scope="col">Predictor score</th>
                                    <th scope="col"><span class="visually-hidden">Delete</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var preset in Model.Presets)
                                {
                                    <tr>
                                        <td><strong>@preset.Name</strong></td>
                                        <td class="mono wl-filter">@preset.FilterQuery</td>
                                        @* Advisory only: it cannot qualify, prioritise or veto a strategy candidate. *@
                                        <td>@(preset.IsVerified ? $"average {preset.AverageMlScore:P1} (advisory)" : "not scored yet")</td>
                                        <td class="wl-row-action">
                                            <form method="post" asp-page-handler="DeletePreset">
                                                <input type="hidden" name="presetId" value="@preset.Id" />
                                                <input type="hidden" name="id" value="@selected.Id" />
                                                <button class="button secondary wl-danger" type="submit" data-confirm="Delete the saved screen @preset.Name?">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </section>
    }
</div>

<partial name="_GroupActions" />

@section Scripts {
    <script type="module" src="~/js/wishlist-management.js" asp-append-version="true"></script>
}
