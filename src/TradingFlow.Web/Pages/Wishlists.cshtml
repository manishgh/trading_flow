@page "/Wishlists"
@using TradingFlow.Web.Pages.Shared
@model TradingFlow.Web.Pages.WishlistsModel
@{
    ViewData["Title"] = "Wishlists";
    ViewData["MainClass"] = "shell-flush wishlists-page";
    var selected = Model.SelectedWishlist;
}

<div class="page-head">
    <div>
        <span class="eyebrow">Universe management</span>
        <h1>Wishlists</h1>
        <p class="standfirst">
            Create groups, maintain ticker context, and import a Finviz universe.
            This page cannot submit an order or start a strategy.
        </p>
    </div>
    @* The whole point of this page is to feed the desk, so that is the primary. *@
    <a class="btn btn-primary btn-md" asp-page="/Desk" asp-route-source="@(selected is null ? "all" : "wishlist:" + selected.Id)">Open desk</a>
</div>

@if (!String.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="status-banner" role="status">@Model.StatusMessage</div>
}
@if (!String.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="status-banner error" role="alert">@Model.ErrorMessage</div>
}

@* Group tabs replace the previous combobox and datalist. A datalist gives no
   sense of how many groups exist or which is observed; three or four tabs do. *@
<div class="wishlist-groups">
    <nav class="wishlist-group-tabs" aria-label="Wishlists">
        @foreach (var wishlist in Model.Wishlists)
        {
            var active = selected?.Id == wishlist.Id;
            <a asp-page="/Wishlists" asp-route-id="@wishlist.Id" aria-current="@(active ? "page" : null)">
                <strong>@wishlist.Name</strong>
                <span>@wishlist.Items.Count(item => item.Active) active stocks</span>
            </a>
        }
    </nav>
    <form method="post" asp-page-handler="CreateWishlist" class="wishlist-create">
        <label class="visually-hidden" for="CreateWishlistName">New wishlist name</label>
        <input class="input" id="CreateWishlistName" name="WishlistName" placeholder="New wishlist name" autocomplete="off" required />
        <button class="btn btn-secondary btn-md" type="submit">Add new</button>
    </form>
</div>

@if (selected is null)
{
    <p class="empty-state">No wishlist selected. Name one above and choose Add new.</p>
}
else
{
    <div class="wishlists-body">
        <div class="wishlists-main">
            <section class="wishlist-block" aria-labelledby="SettingsHeading">
                <div class="wishlist-block-head">
                    <h2 id="SettingsHeading" class="section-heading">Settings</h2>
                    <a class="btn btn-secondary btn-md" asp-page="/Desk" asp-route-source="@("wishlist:" + selected.Id)">Select a strategy on Desk</a>
                </div>

                <form method="post" asp-page-handler="SaveWishlist" class="wishlist-settings">
                    <input type="hidden" name="WishlistId" value="@selected.Id" />
                    <div class="field">
                        <label for="WishlistName">Name</label>
                        <input class="input" id="WishlistName" name="WishlistName" value="@selected.Name" required />
                    </div>
                    <div class="field">
                        <label for="WishlistDescription">Description</label>
                        <input class="input" id="WishlistDescription" name="Description" value="@selected.Description" />
                    </div>
                    @* Square controls for independent booleans, never round radio
                       dots: these are two unrelated switches, not a choice of one. *@
                    <div class="check-strip">
                        <label class="check-chip">
                            <input type="checkbox" name="IsDefault" value="true" checked="@selected.IsDefault" />
                            <partial name="_Icon" model='new IconModel("check", 13)' />
                            <span>Default wishlist</span>
                        </label>
                        <label class="check-chip">
                            <input type="checkbox" name="IncludeExtendedHours" value="true" checked="@selected.IncludeExtendedHours" />
                            <partial name="_Icon" model='new IconModel("check", 13)' />
                            <span>Include extended hours</span>
                        </label>
                    </div>
                    <input type="hidden" name="IsObserved" value="@selected.IsObserved.ToString().ToLowerInvariant()" />
                    <button class="btn btn-secondary btn-md" type="submit">Save settings</button>
                </form>
            </section>

            <section class="wishlist-block" aria-labelledby="AddHeading">
                <h2 id="AddHeading" class="section-heading">Add symbols</h2>

                <form method="post" asp-page-handler="AddTicker" class="wishlist-add-single">
                    <input type="hidden" name="TargetWishlistId" value="@selected.Id" />
                    <div class="field">
                        <label for="TickerTop">Ticker</label>
                        <input class="input" id="TickerTop" name="Ticker" placeholder="RGTI" autocomplete="off" required />
                    </div>
                    <div class="field">
                        <label for="DisplayNameTop">Name</label>
                        <input class="input" id="DisplayNameTop" name="DisplayName" placeholder="Optional" />
                    </div>
                    <div class="field">
                        <label for="NotesTop">Notes</label>
                        <input class="input" id="NotesTop" name="Notes" placeholder="Catalyst, setup, risk" />
                    </div>
                    <button class="btn btn-secondary btn-md" type="submit">Add ticker</button>
                </form>

                <form method="post" asp-page-handler="AddTickers" class="wishlist-add-bulk">
                    <input type="hidden" name="TargetWishlistId" value="@selected.Id" />
                    <div class="field">
                        <label for="BulkTickers">Paste many symbols</label>
                        <textarea class="input" id="BulkTickers" name="Tickers" rows="2" placeholder="AAPL, MSFT, NVDA"></textarea>
                        <span class="note">Separate with commas, spaces or new lines. Adding is idempotent.</span>
                    </div>
                    <button class="btn btn-secondary btn-md" type="submit">Add all</button>
                </form>

                <form method="post" asp-page-handler="ImportFinviz" class="wishlist-import">
                    <input type="hidden" name="TargetWishlistId" value="@selected.Id" />
                    <div class="field">
                        <label for="FinvizFilter">Saved screen, Finviz URL, or query</label>
                        <input class="input input-mono" id="FinvizFilter" name="FinvizFilter"
                               list="SavedScreens"
                               placeholder="A saved screen name, or https://elite.finviz.com/screener.ashx?f=..." />
                        @* Saved screens are offered by name; the box still takes a
                           raw URL or query for a one-off. *@
                        <datalist id="SavedScreens">
                            @foreach (var preset in Model.Presets)
                            {
                                <option value="@preset.Name">@preset.Category</option>
                            }
                        </datalist>
                        <span class="note">Adds returned symbols without removing existing entries.</span>
                    </div>
                    <button class="btn btn-secondary btn-md" type="submit">
                        <partial name="_Icon" model='new IconModel("download", 14)' />Import
                    </button>
                </form>
            </section>

            <section class="wishlist-block" aria-labelledby="ScreensHeading">
                <h2 id="ScreensHeading" class="section-heading">Saved screens</h2>
                @* Finviz Elite has one screener call: hand it filters, get a CSV.
                   There is no endpoint that lists the screens saved in the Finviz
                   UI, so the named list lives here. *@
                <p class="note">
                    Finviz does not expose the screens you saved in its own interface, so name them here
                    once and pick them by name afterwards. TradingFlow screens swing candidates only.
                </p>

                <form method="post" asp-page-handler="SavePreset" class="wishlist-preset-form">
                    <input type="hidden" name="id" value="@selected.Id" />
                    <div class="field">
                        <label for="PresetName">Name</label>
                        <input class="input" id="PresetName" name="presetName" placeholder="Gap and go" required />
                    </div>
                    <input type="hidden" name="presetScope" value="swing" />
                    <div class="field">
                        <label for="PresetQuery">Finviz URL or filter query</label>
                        <input class="input input-mono" id="PresetQuery" name="presetQuery"
                               placeholder="sh_price_o5,sh_avgvol_o500,ta_change_u5" required />
                    </div>
                    <button class="btn btn-secondary btn-md" type="submit">Save screen</button>
                </form>

                @if (Model.Presets.Count == 0)
                {
                    <p class="empty-state">No screen is saved yet.</p>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="grid-table">
                            <thead>
                                <tr>
                                    <th scope="col">Name</th>
                                    <th scope="col">Horizon</th>
                                    <th scope="col">Filter</th>
                                    <th scope="col">Predictor review (advisory)</th>
                                    <th scope="col"><span class="visually-hidden">Delete</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var preset in Model.Presets)
                                {
                                    <tr>
                                        <td><strong>@preset.Name</strong></td>
                                        <td><span class="tag tag-neutral">@preset.Category</span></td>
                                        <td class="mono">@preset.FilterQuery</td>
                                        @* Predictor review is advisory and cannot authorize,
                                           prioritize, or veto a strategy candidate. *@
                                        <td class="@(preset.IsVerified ? null : "unknown")">
                                            @if (preset.IsVerified)
                                            {
                                                @($"yes · avg {preset.AverageMlScore:P1}")
                                            }
                                            else
                                            {
                                                @:not scored yet
                                            }
                                        </td>
                                        <td>
                                            <form method="post" asp-page-handler="DeletePreset">
                                                <input type="hidden" name="presetId" value="@preset.Id" />
                                                <input type="hidden" name="id" value="@selected.Id" />
                                                <button class="btn btn-danger btn-sm" type="submit"
                                                        data-confirm="Delete the saved screen @preset.Name?">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="wishlist-block" aria-labelledby="SymbolsHeading">
                <h2 id="SymbolsHeading" class="section-heading">Symbols</h2>
                @if (Model.ActiveItems.Count == 0)
                {
                    <p class="empty-state">No active symbols. Add one above or import a Finviz screen.</p>
                }
                else
                {
                    @* One form for the whole table. The previous markup rendered a form
                       and a button per row, which made bulk work impossible and produced
                       57 controls on a 28-symbol group. *@
                    <form method="post" asp-page-handler="RemoveTickers" data-bulk-form>
                        <input type="hidden" name="WishlistId" value="@selected.Id" />
                        <div class="wishlist-bulk-bar" data-bulk-bar hidden>
                            <strong><span data-bulk-count>0</span> selected</strong>
                            <button class="btn btn-danger btn-sm" type="button" data-group-action="remove" data-source-id="@selected.Id">Review removal</button>
                            <button class="btn btn-secondary btn-sm" type="button" data-group-action="copy" data-source-id="@selected.Id">Copy to group</button>
                            <button class="btn btn-secondary btn-sm" type="button" data-group-action="move" data-source-id="@selected.Id">Move to group</button>
                            <button class="btn btn-secondary btn-sm" type="button" data-group-action="tag" data-source-id="@selected.Id">Tag</button>
                            <button class="btn btn-secondary btn-sm" type="button" data-group-action="untag" data-source-id="@selected.Id">Remove tag</button>
                            <button class="btn btn-secondary btn-sm" type="button" data-bulk-clear>Clear</button>
                        </div>
                        <div class="table-scroll" role="region" aria-label="Wishlist symbol management" tabindex="0">
                            <table class="grid-table management-table">
                                <thead>
                                    <tr>
                                        <th scope="col" class="select-column">
                                            <input type="checkbox" data-bulk-toggle-all aria-label="Select all symbols" />
                                        </th>
                                        <th scope="col">Ticker</th>
                                        <th scope="col">Name</th>
                                        <th scope="col">Notes</th>
                                        <th scope="col">Added</th>
                                        <th scope="col"><span class="visually-hidden">Save</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ActiveItems)
                                    {
                                        <tr>
                                            <td class="select-column">
                                                <input type="checkbox" name="Tickers" value="@item.Ticker"
                                                       data-bulk-item aria-label="Select @item.Ticker" />
                                            </td>
                                            <td>
                                                <strong>@item.Ticker</strong>

                                            </td>
                                            <td><input class="input" data-inline-name value="@item.DisplayName" aria-label="@item.Ticker display name" /></td>
                                            <td><input class="input" data-inline-notes value="@item.Notes" aria-label="@item.Ticker notes" /><small class="muted">Tags: @String.Join(", ", System.Text.Json.JsonSerializer.Deserialize<string[]>(item.TagsJson) ?? [])</small></td>
                                            <td class="cell-sub">@item.AddedAtUtc.UtcDateTime.ToString("yyyy-MM-dd")</td>
                                            <td class="management-actions">
                                                <button class="btn btn-secondary btn-sm" data-inline-edit="@item.Ticker" type="button">Save</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </form>

                    <form id="editMembershipForm" method="post" asp-page-handler="AddTicker" hidden>
                        <input type="hidden" name="TargetWishlistId" value="@selected.Id" />
                        <input type="hidden" name="Ticker" />
                        <input type="hidden" name="DisplayName" />
                        <input type="hidden" name="Notes" />
                    </form>
                }
            </section>
        </div>

        <aside class="wishlists-rail">
            <h2 class="section-heading">Management only</h2>
            <p class="note">
                This page cannot submit broker orders or start a strategy. Open the desk to review live
                evidence first.
            </p>
            <dl class="fact-list">
                <dt>Observer</dt>
                <dd>@(selected.IsObserved ? "Running" : "Paused")</dd>
                <dt>Extended hours</dt>
                <dd>@(selected.IncludeExtendedHours ? "Included" : "Regular session only")</dd>
                <dt>Default</dt>
                <dd>@(selected.IsDefault ? "Yes" : "No")</dd>
                <dt>Active symbols</dt>
                <dd>@Model.ActiveItems.Count</dd>
                <dt>Last import</dt>
                <dd>
                    @if (Model.LastImport is { } import)
                    {
                        @($"{import.Name} · {import.Symbols.Count} hit(s)")
                    }
                    else
                    {
                        <span class="unknown">none this session</span>
                    }
                </dd>
            </dl>

            @* This is the sentence that stops a current list being projected
               backward into a backtest and read as evidence. *@
            <p class="callout">
                A current wishlist may drive today's operation but may not be projected backward.
                Backtests built on it are marked research-only.
            </p>

            <form method="post" asp-page-handler="DeleteWishlist">
                <input type="hidden" name="WishlistId" value="@selected.Id" />
                <button class="btn btn-danger btn-md" type="submit"
                        data-confirm="Delete wishlist @selected.Name? Open positions, orders and persisted signals are not deleted.">Delete wishlist</button>
            </form>
        </aside>
    </div>
}

<partial name="_GroupActions" />

@section Scripts {
    <script type="module" src="~/js/wishlist-management.js" asp-append-version="true"></script>
}
