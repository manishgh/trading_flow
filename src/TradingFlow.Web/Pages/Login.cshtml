@page
@model TradingFlow.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["MainClass"] = "auth-shell";
}

<section class="panel auth-panel" aria-labelledby="login-heading">
    <header>
        <p class="eyebrow">TradingFlow access</p>
        <h1 id="login-heading">Sign in</h1>
        <p>Use your local operator account. Earnings remains available without signing in.</p>
    </header>

    <form method="post" class="form-grid">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <label asp-for="Input.UserName"></label>
        <input asp-for="Input.UserName" autocomplete="username" autofocus />
        <span asp-validation-for="Input.UserName" class="field-validation"></span>

        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="field-validation"></span>

        <label class="checkbox-row" asp-for="Input.RememberMe">
            <input asp-for="Input.RememberMe" />
            <span>Keep me signed in on this device</span>
        </label>

        <button type="submit" class="primary">Sign in</button>
    </form>
</section>
