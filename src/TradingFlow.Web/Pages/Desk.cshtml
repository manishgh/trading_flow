@page
@inject TradingFlow.Web.Services.TradingEnvironmentService Environments
@{ ViewData["Title"] = "Desk"; ViewData["MainClass"] = "watch-desk-shell"; ViewData["ShowOperatorClock"] = true;
   var environment = Environments.GetState(Environments.Parse(Request.Query["env"])); }
@* A locked environment shows why it is locked and renders no order control at all. *@
@if (!environment.IsEnabled)
{
    <h1 class="visually-hidden">Desk</h1>
    <partial name="_EnvironmentLock" model="environment" />
    return;
}
<section class="watch-desk" aria-label="Stock desk"
         data-operator="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)"
         data-administrator="@User.IsInRole(TradingFlow.Data.Identity.TradingFlowRoles.Administrator).ToString().ToLowerInvariant()">
  <h1 class="visually-hidden">Desk</h1>
  <span id="watch-session" class="sr-only">Reading market session…</span>
  <span id="watch-connection" class="sr-only" role="status">Connecting · live quotes</span>
  <partial name="_PreparationSummary" />
  <p id="watch-prepared-source" class="watch-fine" role="status" hidden></p>
  <h2 id="watch-title" class="sr-only">All followed stocks</h2>
  <p id="watch-description" class="sr-only">Active stocks across your stock groups.</p>
  <div class="watch-toolbar">
    <label class="watch-source-label"><span>Group</span><select id="watch-source"><option value="all">All followed stocks</option></select></label>
    <div class="watch-strategy-group">
      <label class="watch-strategy-label"><span>Strategy</span><select id="watch-strategy"><option value="">Select a strategy</option></select></label>
      <button type="button" id="watch-strategy-refresh" class="btn btn-secondary btn-sm watch-inline-btn" title="Refresh strategy checks" hidden>↻ Refresh</button>
      <button type="button" id="watch-strategy-cancel" class="btn btn-secondary btn-sm watch-inline-btn" title="Cancel strategy checks" hidden>Cancel</button>
    </div>
    <label class="watch-search-label"><span>Find</span><input id="watch-search" type="search" maxlength="80" placeholder="Symbol or company" autocomplete="off" /></label>
    <label class="watch-sort-label"><span>Sort</span><select id="watch-sort"><option value="symbol">Symbol A–Z</option><option value="held">Held first</option><option value="news">Latest news</option></select></label>
    <div class="watch-view-switch" role="group" aria-label="Show stocks"><button type="button" data-view="all" aria-pressed="true">All</button><button type="button" data-view="signals" aria-pressed="false">Signals <span data-view-count="signals"></span></button><button type="button" data-view="held" aria-pressed="false">Held <span data-view-count="held"></span></button><button type="button" data-view="rejected" aria-pressed="false">Rejected <span data-view-count="rejected"></span></button></div>
    <div class="watch-toolbar-tail">
      <span id="watch-count" class="watch-count-pill">— stocks</span>
      <button type="button" id="watch-density-toggle" class="btn btn-secondary btn-sm" aria-pressed="true" title="Showing fewer columns (keeps News); click for all columns">Fewer columns</button>
      <button type="button" id="watch-add-open" class="btn btn-secondary btn-sm watch-ghost-btn">+ Stock</button>
      <button type="button" id="watch-import-open" class="btn btn-secondary btn-sm watch-ghost-btn">+ Screen</button>
      <a asp-page="/Wishlists" class="watch-manage">Groups ↗</a>
      <button type="button" id="watch-retry" class="btn btn-secondary btn-sm watch-inline-btn" hidden>Retry connection</button>
    </div>
  </div>
  <p id="watch-strategy-status" class="watch-fine watch-strategy-status-line" role="status" hidden>Select a strategy to collect data and see its checks for each stock.</p>
  @* Any symbol can join an own stock group; the server first checks with Alpaca that it is an active, tradable US stock. *@
  <form id="watch-add" class="watch-import" hidden>
    <div><strong>Add a stock to your group</strong><p>Type any symbol. Alpaca first confirms it is an active, tradable US stock. Adding a stock does not start a strategy or place an order.</p></div>
    <label>Symbol<input name="symbol" required maxlength="11" placeholder="AAPL" autocomplete="off" autocapitalize="characters" spellcheck="false" /></label><label>Stock group<select id="watch-add-list" name="wishlistId" required></select></label><button class="btn btn-primary" type="submit">Add stock</button><button class="btn btn-secondary" type="button" id="watch-add-close">Close</button><p role="status" id="watch-add-status"></p>
  </form>
  <form id="watch-import" class="watch-import" hidden>
    <div><strong>Add a saved Elite screen</strong><p>Copy its Finviz URL here. Only the filters are saved locally; private Elite presets are not automatically synced.</p></div>
    <label>Screen name<input name="name" required maxlength="120" placeholder="My momentum screen" /></label><label>Finviz URL or filters<input name="url" required maxlength="4000" placeholder="https://elite.finviz.com/screener.ashx?f=…" /></label><button class="btn btn-primary" type="submit">Save screen</button><button class="btn btn-secondary" type="button" id="watch-import-close">Close</button><p role="status" id="watch-import-status"></p>
  </form>
  <p id="watch-warning" class="watch-warning" role="status" hidden></p>
  <div class="watch-grid" data-active-pane="chart">
    <section class="watch-stocks" aria-label="Followed stocks">
      <div class="watch-table-scroll" role="region" aria-label="Stock table" tabindex="0"><table class="watch-table" data-scanner-density="compact" data-has-strategy="false"><caption class="sr-only">Stock prices, order actions, news, and completed daily indicators</caption>
        <colgroup><col class="watch-stock-col" /><col class="watch-price-col" /><col class="watch-trade-col" /><col class="watch-strategy-col" /><col class="watch-position-col" /><col class="watch-news-col" /><col class="watch-technical-col" /><col class="watch-rvol-col" /><col class="watch-volume-col" /></colgroup>
        <thead><tr><th scope="col">Stock</th><th scope="col" title="Bid/ask midpoint and daily percent change vs previous close (full bid/ask, spread, and quote age in row tooltip)">Mid · Day %</th><th scope="col">Trade</th><th scope="col">Strategy</th><th scope="col">Position</th><th scope="col" title="Stored stories in the last hour (partial coverage)">News</th><th scope="col">Daily technicals</th><th scope="col" title="Completed 1d relative volume and 1d ATR">RVOL · ATR</th><th scope="col">Volume</th></tr></thead>
        <tbody id="watch-rows"></tbody>
      </table></div>
      <div id="watch-empty" class="watch-empty"><strong>Loading your stocks…</strong><p>Your stock groups, screeners and holdings come together here.</p></div>
      <div class="watch-pagination" id="watch-pagination" hidden><button type="button" id="watch-prev" class="btn btn-secondary" disabled>← Previous</button><span id="watch-page">Page 1</span><button type="button" id="watch-next" class="btn btn-secondary" disabled>Next →</button></div>
      <footer class="watch-table-note" hidden>Buy shows the ask and Sell the bid. News counts cover the last hour of stored stories. Select a stock for source details.</footer>
    </section>
    <div class="watch-mid-tabs" role="tablist" aria-label="Desk detail view">
      <button type="button" role="tab" data-desk-pane="chart" aria-selected="true">Chart</button>
      <button type="button" role="tab" data-desk-pane="inspector" aria-selected="false">Why &amp; News</button>
    </div>
    <aside class="watch-detail" aria-label="Selected stock chart" id="watch-detail">
      <header class="watch-focus-head">
        <div class="watch-focus-identity">
          <h2 id="watch-symbol">Choose a stock</h2>
          <strong id="watch-mid" class="num">—</strong>
          <span id="watch-prev-close" class="watch-focus-change"></span>
          <button type="button" id="watch-focus-info" class="watch-info-badge" aria-label="Quote and chart series details" title="" hidden>ⓘ</button>
          <div class="watch-focus-trade" id="watch-focus-trade" hidden>
            <a id="watch-buy" class="btn btn-primary btn-sm" title="Buy shows the ask.">Buy</a>
            <a id="watch-sell" class="btn btn-secondary btn-sm" title="Sell shows the bid.">Sell</a>
          </div>
          <span id="watch-name" class="sr-only">Select a row to see its price, holding and news.</span>
          <span id="watch-quote-detail" class="sr-only"></span>
        </div>
        <div class="watch-focus-controls" id="watch-focus-controls" hidden>
          <div id="watch-interval-quick" class="watch-interval-quick" role="group" aria-label="Quick chart interval">
            <button type="button" class="watch-interval-btn" data-quick-interval="1d" aria-pressed="true">1d</button>
            <button type="button" class="watch-interval-btn" data-quick-interval="1w" aria-pressed="false">1w</button>
            <button type="button" class="watch-interval-btn" data-quick-interval="5m" aria-pressed="false">5m</button>
          </div>
          <div id="watch-chart-controls-slot" class="watch-chart-controls-slot"></div>
          <div id="watch-chart-summary" class="watch-chart-summary"></div>
        </div>
      </header>
      <div id="watch-focus-content" hidden>
        <div class="watch-chart-window" id="watch-chart-window">
          <partial name="_StockChart" model="String.Empty" />
          <div class="watch-chart-indicators" id="watch-technicals-block" aria-label="Key moving averages, today support, ATR and volatility">
            <div class="watch-chart-indicators-strip">
              <span class="watch-ind-pill" id="watch-sma20" role="button" tabindex="0" aria-pressed="false" data-highlight-key="sma20" data-tooltip="">SMA20 —</span>
              <span class="watch-ind-pill" id="watch-sma50" role="button" tabindex="0" aria-pressed="false" data-highlight-key="sma50" data-tooltip="">SMA50 —</span>
              <span class="watch-ind-pill" id="watch-sma200" role="button" tabindex="0" aria-pressed="false" data-highlight-key="sma200" data-tooltip="">SMA200 —</span>
              <span class="watch-ind-pill" id="watch-today-support" role="button" tabindex="0" aria-pressed="false" data-highlight-key="support" data-tooltip="">Today support —</span>
              <span class="watch-ind-pill" id="watch-atr" tabindex="0" data-tooltip="">ATR —</span>
              <span class="watch-ind-pill" id="watch-volatility" tabindex="0" data-tooltip="Stock price swing range (High − Low ÷ Close): 1D = last completed session, 1W = 5 sessions, 1M = 21 sessions">Vol 1D — · 1W — · 1M —</span>
            </div>
          </div>
        </div>
        <article class="watch-options-card watch-options-selected-strip" id="desk-options-selected" data-options-slot="selected" hidden aria-label="Selected stock OPRA options context">
          <div class="watch-options-card-head">
            <span class="watch-options-prefix">Options</span>
            <strong data-options-field="symbol" class="sr-only">—</strong>
            <span class="watch-options-badge" data-options-field="badge" tabindex="0" data-tooltip="">—</span>
          </div>
          <dl class="watch-options-metrics">
            <div tabindex="0" title="Expected ±% stock swing by the nearest options expiration, priced from the at-the-money Call + Put straddle. Compare against your stop-loss distance." data-tooltip="Expected ±% stock swing by the nearest options expiration, priced from the at-the-money Call + Put straddle. Compare against your stop-loss distance."><dt title="Expected ±% stock swing by the nearest options expiration, priced from the at-the-money Call + Put straddle. Compare against your stop-loss distance.">Expected move</dt><dd data-options-field="move">—</dd></div>
            <div tabindex="0" title="Downside Put IV minus upside Call IV (~25 delta). Positive (+) = traders paying up for downside protection; Negative (−) = upside call chasing; '—' = no liquid 25-delta pair." data-tooltip="Downside Put IV minus upside Call IV (~25 delta). Positive (+) = traders paying up for downside protection; Negative (−) = upside call chasing; '—' = no liquid 25-delta pair."><dt title="Downside Put IV minus upside Call IV (~25 delta). Positive (+) = traders paying up for downside protection; Negative (−) = upside call chasing; '—' = no liquid 25-delta pair.">Put vs Call fear</dt><dd data-options-field="skew">—</dd></div>
            <div tabindex="0" title="Near-term implied volatility minus ~30-day implied volatility (vol points). Positive (+) = immediate catalyst/event or gap risk priced in; Negative (−) = calm normal market." data-tooltip="Near-term implied volatility minus ~30-day implied volatility (vol points). Positive (+) = immediate catalyst/event or gap risk priced in; Negative (−) = calm normal market."><dt title="Near-term implied volatility minus ~30-day implied volatility (vol points). Positive (+) = immediate catalyst/event or gap risk priced in; Negative (−) = calm normal market.">Near vs 30d IV</dt><dd data-options-field="term">—</dd></div>
            <div tabindex="0" title="Today's traded Call volume divided by Put volume across liquid strikes (>1.0x = more Calls than Puts; <1.0x = more Puts than Calls)." data-tooltip="Today's traded Call volume divided by Put volume across liquid strikes (>1.0x = more Calls than Puts; <1.0x = more Puts than Calls)."><dt title="Today's traded Call volume divided by Put volume across liquid strikes (>1.0x = more Calls than Puts; <1.0x = more Puts than Calls).">Call/Put vol</dt><dd data-options-field="cpvol">—</dd></div>
          </dl>
          <p class="watch-fine" data-options-field="note" hidden></p>
        </article>
      </div>
    </aside>
    <aside class="watch-inspector" aria-label="Why or why not checklist and news" id="watch-inspector">
      <div id="watch-inspector-empty" class="watch-inspector-empty">Select a stock to inspect strategy checks, holding, and news.</div>
      <div id="watch-inspector-body" hidden>
        <div class="watch-detail-block" id="watch-strategy-block">
          <h3>Why / why not · <span id="watch-observation"></span></h3>
          <div id="watch-strategy-checks"></div>
          <p id="watch-ticket-plan-summary" class="watch-fine watch-ticket-plan-summary" hidden></p>
          <p id="watch-order-help" class="watch-fine" hidden></p>
          <p id="watch-exit-help" class="watch-fine" hidden></p>
        </div>
        <div class="watch-detail-block" id="watch-holding-block" hidden>
          <h3>Holding</h3>
          <dl class="watch-metrics"><dt>Shares</dt><dd id="watch-quantity">—</dd><dt>Average entry</dt><dd id="watch-entry">—</dd><dt>Market value</dt><dd id="watch-value">—</dd><dt>Unrealized P&amp;L</dt><dd id="watch-pl">—</dd></dl>
          <a asp-page="/RunningTrades">View positions and protection</a>
        </div>
        <details id="watch-evidence" class="watch-stock-evidence">
          <summary>Group &amp; catalyst tools</summary>
          <form id="watch-follow"><label>Follow in a stock group<select id="watch-follow-list" required></select></label><button class="btn btn-secondary" type="submit">Follow stock</button><p id="watch-follow-status" role="status"></p></form>
          <p class="watch-context-links"><a id="watch-stock-news" asp-page="/News">Open stock news</a> <a id="watch-stock-earnings" asp-page="/Earnings">Open earnings</a></p>
        </details>
      </div>
      <section class="watch-news" id="watch-news" aria-label="Relevant news">
        <div class="watch-news-head">
          <h2 id="watch-news-title">News for this view</h2>
          <span id="watch-news-drawer-count" class="watch-count-pill"></span>
          <button id="watch-news-all" class="btn btn-secondary btn-sm" type="button" hidden>All stocks in view</button>
        </div>
        <p id="watch-news-coverage" class="watch-fine"></p>
        <div id="watch-news-list"></div>
      </section>
    </aside>
  </div>
  <div class="watch-workflow-tools">
  @* Paper strategy runs record which stocks qualify and trigger; their signals authorize strategy entries. *@
  <details class="watch-runs" id="watch-runs"><summary><span class="watch-kicker">STRATEGY RUNS</span><strong>Start or open a paper strategy run</strong></summary><partial name="_CandidateWorkflow" /></details>
  </div>
  <p class="watch-footer" hidden>Discovery and preparation are advisory. Pre- and post-market monitoring does not enable extended-hours orders.</p>
</section>
<partial name="_OrderPopup" />
@section Styles {
    <link rel="stylesheet" href="~/css/watch-desk.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/stock-chart.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/order-popup.js" asp-append-version="true"></script>
    <partial name="_StockChartScripts" />
    <script src="~/js/watch-desk.js" asp-append-version="true"></script>
    <script src="~/js/desk-options.js" asp-append-version="true"></script>
    <script src="~/js/preparation-summary.js" asp-append-version="true" defer></script>
    <script src="~/js/candidate-workflow.js" asp-append-version="true" defer></script>
}
