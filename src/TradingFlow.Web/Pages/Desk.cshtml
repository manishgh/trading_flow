@page
@inject TradingFlow.Web.Services.TradingEnvironmentService Environments
@{ ViewData["Title"] = "Desk"; ViewData["MainClass"] = "watch-desk-shell"; ViewData["ShowOperatorClock"] = true;
   var environment = Environments.GetState(Environments.Parse(Request.Query["env"])); }
@* A locked environment shows why it is locked and renders no order control at all. *@
@if (!environment.IsEnabled)
{
    <h1 class="visually-hidden">Desk</h1>
    <partial name="_EnvironmentLock" model="environment" />
    return;
}
<section class="watch-desk" aria-label="Stock desk"
         data-operator="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)"
         data-administrator="@User.IsInRole(TradingFlow.Data.Identity.TradingFlowRoles.Administrator).ToString().ToLowerInvariant()">
  <header class="watch-head">
    <div><span class="eyebrow">MARKET WORKSPACE</span><h1>Desk<span class="watch-dot" aria-hidden="true"></span></h1><p>Your stocks, strategy checks and market context.</p></div>
    <div class="watch-session"><strong id="watch-session">Reading market session…</strong><span id="watch-connection" role="status">Connecting · live quotes</span><a asp-page="/Orders">Open trading ↗</a><button type="button" id="watch-retry" class="btn btn-secondary" hidden>Retry connection</button></div>
  </header>
  <partial name="_PreparationSummary" />
  <partial name="_OptionsSentimentPanel" />
  <p id="watch-prepared-source" class="watch-fine" role="status" hidden></p>
  <div class="watch-toolbar">
    <label class="watch-source-label">Stock group<select id="watch-source"><option value="all">All followed stocks</option></select></label>
    <label class="watch-source-label">Strategy<select id="watch-strategy"><option value="">Select a strategy</option></select></label>
    <label class="watch-search-label">Find a stock<input id="watch-search" type="search" maxlength="80" placeholder="Symbol or company" autocomplete="off" /></label>
    <label class="watch-sort-label">Sort<select id="watch-sort"><option value="symbol">Symbol A–Z</option><option value="held">Held first on this page</option><option value="news">Latest news on this page</option></select></label>
    <button type="button" id="watch-add-open" class="btn btn-secondary">+ Add stock</button>
    <button type="button" id="watch-import-open" class="btn btn-secondary">+ Saved Elite screen</button>
    <a asp-page="/Wishlists" class="watch-manage">Manage groups ↗</a>
  </div>
  <p id="watch-strategy-status" class="watch-fine" role="status">Select a strategy to collect data and see its checks for each stock.</p>
  <div class="watch-actions"><button type="button" id="watch-strategy-refresh" class="btn btn-secondary" hidden>Refresh strategy checks</button><button type="button" id="watch-strategy-cancel" class="btn btn-secondary" hidden>Cancel strategy checks</button></div>
  @* Any symbol can join an own stock group; the server first checks with Alpaca that it is an active, tradable US stock. *@
  <form id="watch-add" class="watch-import" hidden>
    <div><strong>Add a stock to your group</strong><p>Type any symbol. Alpaca first confirms it is an active, tradable US stock. Adding a stock does not start a strategy or place an order.</p></div>
    <label>Symbol<input name="symbol" required maxlength="11" placeholder="AAPL" autocomplete="off" autocapitalize="characters" spellcheck="false" /></label><label>Stock group<select id="watch-add-list" name="wishlistId" required></select></label><button class="btn btn-primary" type="submit">Add stock</button><button class="btn btn-secondary" type="button" id="watch-add-close">Close</button><p role="status" id="watch-add-status"></p>
  </form>
  <form id="watch-import" class="watch-import" hidden>
    <div><strong>Add a saved Elite screen</strong><p>Copy its Finviz URL here. Only the filters are saved locally; private Elite presets are not automatically synced.</p></div>
    <label>Screen name<input name="name" required maxlength="120" placeholder="My momentum screen" /></label><label>Finviz URL or filters<input name="url" required maxlength="4000" placeholder="https://elite.finviz.com/screener.ashx?f=…" /></label><button class="btn btn-primary" type="submit">Save screen</button><button class="btn btn-secondary" type="button" id="watch-import-close">Close</button><p role="status" id="watch-import-status"></p>
  </form>
  <div class="watch-view-switch" role="group" aria-label="Show stocks"><button type="button" data-view="all" aria-pressed="true">All</button><button type="button" data-view="signals" aria-pressed="false">Signals <span data-view-count="signals"></span></button><button type="button" data-view="held" aria-pressed="false">Held <span data-view-count="held"></span></button><button type="button" data-view="rejected" aria-pressed="false">Rejected <span data-view-count="rejected"></span></button></div>
  <div class="watch-view-head"><div><h2 id="watch-title">All followed stocks</h2><p id="watch-description">Active stocks across your stock groups.</p></div><span id="watch-count">— stocks</span></div>
  <p id="watch-warning" class="watch-warning" role="status" hidden></p>
  <div class="watch-grid">
    <section class="watch-stocks" aria-label="Followed stocks">
      <div class="watch-table-scroll" role="region" aria-label="Stock table" tabindex="0"><table class="watch-table"><caption class="sr-only">Stock prices, order actions, news, and completed daily indicators</caption>
        <colgroup><col class="watch-stock-col" /><col class="watch-price-col" /><col class="watch-trade-col" /><col class="watch-strategy-col" /><col class="watch-position-col" /><col class="watch-news-col" /><col class="watch-technical-col" /><col class="watch-rvol-col" /><col class="watch-volume-col" /><col class="watch-action-col" /></colgroup>
        <thead><tr><th scope="col">Stock</th><th scope="col" title="Bid/ask midpoint, not the last trade price">Mid price · age</th><th scope="col">Trade</th><th scope="col">Strategy</th><th scope="col">Position</th><th scope="col">News</th><th scope="col">Daily technicals</th><th scope="col">RVOL</th><th scope="col">Volume</th><th scope="col">Next action</th></tr></thead>
        <tbody id="watch-rows"></tbody>
      </table></div>
      <div id="watch-empty" class="watch-empty"><strong>Loading your stocks…</strong><p>Your stock groups, screeners and holdings come together here.</p></div>
      <div class="watch-pagination" id="watch-pagination" hidden><button type="button" id="watch-prev" class="btn btn-secondary" disabled>← Previous</button><span id="watch-page">Page 1</span><button type="button" id="watch-next" class="btn btn-secondary" disabled>Next →</button></div>
      <footer class="watch-table-note">Buy shows the ask and Sell the bid. News counts cover the last hour of stored stories. Select a stock for source details.</footer>
    </section>
    <aside class="watch-detail" aria-label="Selected stock" id="watch-detail">
      <header class="watch-focus-head">
        <div><h2 id="watch-symbol">Choose a stock</h2><p id="watch-name">Select a row to see its price, holding and news.</p><p id="watch-quote-detail" class="watch-fine"></p></div>
        <div id="watch-chart-summary" class="watch-chart-summary"></div>
        <div class="watch-focus-price"><strong id="watch-mid">—</strong><small id="watch-prev-close"></small></div>
        <div class="watch-focus-trade"><a id="watch-buy" class="btn btn-primary">Buy</a><a id="watch-sell" class="btn btn-secondary">Sell</a></div>
      </header>
      <div id="watch-focus-content" hidden>
        <partial name="_StockChart" model="String.Empty" />
        <p id="watch-order-help" class="watch-fine" hidden></p>
        <p id="watch-exit-help" class="watch-fine" hidden></p>
        <div class="watch-detail-block" id="watch-holding-block"><h3>Holding</h3><dl class="watch-metrics"><dt>Shares</dt><dd id="watch-quantity">—</dd><dt>Average entry</dt><dd id="watch-entry">—</dd><dt>Market value</dt><dd id="watch-value">—</dd><dt>Unrealized P&amp;L</dt><dd id="watch-pl">—</dd></dl><a asp-page="/RunningTrades">View positions and protection</a></div>
        <div class="watch-detail-block" id="watch-strategy-block"><h3>Strategy · <span id="watch-observation"></span></h3><div id="watch-strategy-checks"></div></div>
        <details id="watch-evidence" class="watch-stock-evidence">
          <summary>More technicals &amp; group tools</summary>
        <form id="watch-follow"><label>Follow in a stock group<select id="watch-follow-list" required></select></label><button class="btn btn-secondary" type="submit">Follow stock</button><p id="watch-follow-status" role="status"></p></form>
        <div class="watch-detail-block"><h3>Daily technicals</h3><p id="watch-tech-time" class="watch-fine"></p><dl class="watch-tech"><div><dt>SMA 10</dt><dd id="watch-sma10">—</dd></div><div><dt>SMA 20</dt><dd id="watch-sma20">—</dd></div><div><dt>SMA 50</dt><dd id="watch-sma50">—</dd></div><div><dt>SMA 200</dt><dd id="watch-sma200">—</dd></div><div><dt>RSI</dt><dd id="watch-rsi">—</dd></div><div><dt>EMA 20 / 50</dt><dd id="watch-ema">—</dd></div><div><dt>EMA 200</dt><dd id="watch-ema200">—</dd></div><div><dt>ATR</dt><dd id="watch-atr">—</dd></div><div><dt>RVOL</dt><dd id="watch-rvol">—</dd></div></dl><p id="watch-sip-volume" class="watch-fine"></p></div>
        <p class="watch-context-links"><a id="watch-stock-news" asp-page="/News">Open stock news</a> <a id="watch-stock-earnings" asp-page="/Earnings">Open earnings</a></p>
        </details>
      </div>
    </aside>
    <section class="watch-news" id="watch-news" aria-label="Relevant news"><div class="watch-news-head"><h2 id="watch-news-title">News for this view</h2><button id="watch-news-all" class="btn btn-secondary" type="button">All stocks in view</button></div><p id="watch-news-coverage" class="watch-fine"></p><div id="watch-news-list"></div></section>
  </div>
  <div class="watch-workflow-tools">
  @* Paper strategy runs record which stocks qualify and trigger; their signals authorize strategy entries. *@
  <details class="watch-runs" id="watch-runs"><summary><span class="watch-kicker">STRATEGY RUNS</span><strong>Start or open a paper strategy run</strong></summary><partial name="_CandidateWorkflow" /></details>
  </div>
  <p class="watch-footer">Discovery and preparation are advisory. Pre- and post-market monitoring does not enable extended-hours orders.</p>
</section>
<partial name="_OrderPopup" />
@section Styles {
    <link rel="stylesheet" href="~/css/watch-desk.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/stock-chart.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/order-popup.js" asp-append-version="true"></script>
    <partial name="_StockChartScripts" />
    <script src="~/js/watch-desk.js" asp-append-version="true"></script>
    <script src="~/js/desk-options.js" asp-append-version="true"></script>
    <script src="~/js/preparation-summary.js" asp-append-version="true" defer></script>
    <script src="~/js/candidate-workflow.js" asp-append-version="true" defer></script>
}
