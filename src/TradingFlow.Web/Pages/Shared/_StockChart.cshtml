@model string
@{
    var detailsTitleId = $"chart-details-{Guid.NewGuid():N}";
}
<section class="stock-chart" aria-label="Stock price chart" data-stock-chart data-symbol="@Model"
         data-chart-history="@Url.Content("~/api/v1/charts/history")" data-chart-hub="@Url.Content("~/api/v1/charts/hub")">
    <header class="stock-chart-head">
        <div>
            <h3>Price &amp; volume</h3>
            <p class="stock-chart-status" data-chart-status role="status">Loading completed candles…</p>
            <p class="stock-chart-note" data-chart-completed-note>Completed candles only</p>
        </div>
        @if (String.IsNullOrEmpty(Model))
        {
            <a class="btn btn-secondary" data-chart-full asp-page="/Chart" asp-route-env="@(Context.Request.Query["env"].ToString())">Full chart ↗</a>
        }
    </header>
    <div class="stock-chart-controls">
        <label>Candle interval
            <select class="input" data-chart-interval>
                <option value="1m">1 minute</option>
                <option value="5m" selected>5 minutes</option>
                <option value="15m">15 minutes</option>
                <option value="1d">1 day</option>
                <option value="1w">1 week</option>
            </select>
        </label>
        <label>Session
            <select class="input" data-chart-session>
                <option value="regular">Regular</option>
                <option value="extended">Extended</option>
            </select>
        </label>
        <label>Structure source
            <select class="input" data-chart-structure>
                <option value="auto">Auto</option>
                <option value="intraday">Intraday · 15m</option>
                <option value="daily">Daily · 1d</option>
            </select>
        </label>
        <label data-chart-lookback-control hidden>Daily lookback
            <select class="input" data-chart-lookback>
                <option value="swing">64 sessions</option>
                <option value="week">Week · 5 sessions</option>
                <option value="month">Month · 21 sessions</option>
                <option value="year">Year · 252 sessions</option>
            </select>
        </label>
    </div>
    <div class="stock-chart-study-toolbar">
        <label>Indicator preset
            <select class="input" data-chart-preset>
                <option value="custom">Custom</option>
                <option value="intraday">Intraday</option>
                <option value="swing">Swing · 1d</option>
            </select>
        </label>
        <button type="button" class="btn btn-secondary" data-chart-reset>Reset chart settings</button>
        <details class="stock-chart-library" data-chart-library>
            <summary>Indicator library</summary>
            <div class="stock-chart-study-picker">
                <label>Indicator
                    <select class="input" data-chart-study-choice></select>
                </label>
                <label data-chart-study-source-control hidden>Source interval
                    <select class="input" data-chart-study-source>
                        <option value="">Candle interval</option>
                        <option value="1d">Daily · 1d</option>
                    </select>
                </label>
                <label data-chart-study-display-control hidden>Display
                    <select class="input" data-chart-study-display>
                        <option value="readout">Readout</option>
                        <option value="">Separate pane</option>
                    </select>
                </label>
                <label data-chart-study-replace-control hidden>Replace indicator
                    <select class="input" data-chart-study-replace></select>
                </label>
                <button type="button" class="btn btn-secondary" data-chart-study-add>Add indicator</button>
            </div>
            <p class="stock-chart-study-description" data-chart-study-description></p>
            <p class="stock-chart-study-feedback" data-chart-study-feedback role="status"></p>
        </details>
    </div>
    <p class="visually-hidden" data-chart-settings-announcement role="status"></p>
    <ul class="stock-chart-studies" data-chart-studies aria-label="Selected indicators" hidden></ul>
    <p class="stock-chart-context" data-chart-context-label></p>
    <p class="stock-chart-note" data-chart-weekly-availability hidden>Indicators, price levels and session shading are available on daily or intraday charts.</p>
    <p class="stock-chart-source" data-chart-source></p>
    <p class="stock-chart-source" data-chart-forming-status role="status" hidden></p>
    <ul class="stock-chart-zone-key" data-chart-zone-key aria-label="Current support and resistance zones" hidden></ul>
    <label class="stock-chart-pane-control" data-chart-pane-control hidden>Visible indicator pane
        <select class="input" data-chart-pane-choice></select>
    </label>
    <div class="stock-chart-stage">
        <div class="stock-chart-plot" data-chart-plot tabindex="0" role="region"
             aria-label="Candlestick, volume and indicator plot. Use left and right arrows to inspect candles, or Home and End for the first and last loaded candle."></div>
        <div class="stock-chart-empty" data-chart-empty>Loading completed candles…</div>
    </div>
    <div class="stock-chart-navigation">
        <button type="button" class="btn btn-secondary" data-chart-older disabled>Load earlier</button>
        <button type="button" class="btn btn-secondary" data-chart-latest disabled>Go to latest</button>
        <button type="button" class="btn btn-secondary" data-chart-history-reload hidden>Reload earlier history</button>
        <button type="button" class="btn btn-secondary" data-chart-retry hidden>Retry chart</button>
        <button type="button" class="btn btn-secondary" data-chart-details-open aria-haspopup="dialog">Chart details</button>
        <span data-chart-history-status role="status"></span>
    </div>
    <div class="stock-chart-readout" data-chart-readout hidden>
        <div class="stock-chart-readout-head">
            <strong data-chart-candle-time></strong>
            <div class="stock-chart-candle-nav" aria-label="Inspect candles" role="group">
                <button type="button" class="btn btn-secondary" data-chart-prev aria-label="Previous candle">←</button>
                <button type="button" class="btn btn-secondary" data-chart-next aria-label="Next candle">→</button>
            </div>
        </div>
        <p class="visually-hidden" data-chart-inspection role="status"></p>
        <dl class="stock-chart-values" data-chart-values></dl>
    </div>
    <dialog class="stock-chart-details" data-chart-details aria-labelledby="@detailsTitleId">
        <header class="stock-chart-details-head">
            <h2 id="@detailsTitleId">Chart details</h2>
            <form method="dialog">
                <button type="submit" class="btn btn-secondary" data-chart-details-close autofocus>Close</button>
            </form>
        </header>
        <section class="stock-chart-detail-section">
            <h3>Indicator values</h3>
            <dl class="stock-chart-values stock-chart-study-values" data-chart-study-values hidden></dl>
            <p class="stock-chart-study-history" data-chart-study-history hidden></p>
        </section>
        <section class="stock-chart-detail-section">
            <h3>Data evidence</h3>
            <div class="stock-chart-evidence-section">
                <h4>Series</h4>
                <dl class="stock-chart-evidence" data-chart-evidence></dl>
            </div>
            <div class="stock-chart-evidence-section" data-chart-selected-candle hidden>
                <h4>Selected candle</h4>
                <dl class="stock-chart-evidence" data-chart-candle-evidence></dl>
            </div>
            <div class="stock-chart-evidence-section" data-chart-forming-section hidden>
                <h4>Forming candle preview</h4>
                <dl class="stock-chart-evidence" data-chart-forming-evidence></dl>
            </div>
            <div class="stock-chart-evidence-section" data-chart-selected-indicators hidden>
                <h4>Selected indicator evidence</h4>
                <ul class="stock-chart-detail-list" data-chart-indicator-evidence></ul>
            </div>
        </section>
        <section class="stock-chart-detail-section">
            <h3>Layers &amp; price levels</h3>
            <div class="stock-chart-toggles">
                <label><input type="checkbox" data-chart-layer="volume" checked /> Volume</label>
                <label title="Available on 1m, 5m and 15m charts"><input type="checkbox" data-chart-layer="forming" /> Forming candle preview</label>
                <label><input type="checkbox" data-chart-layer="sessions" checked /> Extended-hours shading</label>
                <label><input type="checkbox" data-chart-layer="support" checked /> Support</label>
                <label><input type="checkbox" data-chart-layer="resistance" checked /> Resistance</label>
                <label><input type="checkbox" data-chart-layer="news" checked /> News markers</label>
                <label><input type="checkbox" data-chart-layer="earnings" checked /> Earnings markers</label>
            </div>
            <ul class="stock-chart-detail-list" data-chart-zones></ul>
            <ul class="stock-chart-detail-list" data-chart-levels></ul>
            <div class="stock-chart-evidence-section" data-chart-selected-comparisons hidden>
                <h4>Selected candle comparisons</h4>
                <dl class="stock-chart-evidence" data-chart-distances></dl>
            </div>
        </section>
        <section class="stock-chart-detail-section">
            <h3>News &amp; earnings <span data-chart-event-count></span></h3>
            <ul class="stock-chart-detail-list" data-chart-events></ul>
        </section>
    </dialog>
    <footer class="stock-chart-footer"><a href="https://www.tradingview.com/" target="_blank" rel="noopener noreferrer">Charts by TradingView</a></footer>
</section>
