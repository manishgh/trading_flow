<section class="prep-page" data-preparation-owner="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
  <div class="page-head"><div><span class="eyebrow">Daily workspace</span>@if (ViewData["EmbeddedPreparation"] is true) { <h2>Preparation review</h2> } else { <h1>Daily review</h1> }<p>Review the latest preparation, then open candidates or a paper-run review.</p></div><a class="btn btn-secondary" asp-page="/TradeDesk">Open candidates</a></div>
  <p id="prep-status" role="status" aria-live="polite">Loading workflows…</p>
  <button id="prep-retry" type="button" hidden>Retry loading preparation</button>
  <div id="prep-setup" class="prep-card" hidden><h3>Set up your first preparation workflow</h3><p>Choose a wishlist or Finviz screen, save the workflow paused, then review its exchange-session schedule. Collection results appear here after a run completes.</p><button id="prep-setup-new" type="button" disabled>Configure preparation</button></div>
  <div class="prep-toolbar"><select id="prep-list" disabled aria-label="Workflow"></select><button id="prep-open" disabled>Open workflow</button><button id="prep-new" disabled>New workflow</button><button id="prep-refresh" disabled>Refresh history</button></div>
  <div class="view-switch" role="group" aria-label="Preparation view">
    <button type="button" data-prep-view="daily" aria-pressed="true">Latest review</button><button type="button" data-prep-view="history" disabled aria-pressed="false">History</button><button type="button" data-prep-view="settings" disabled aria-pressed="false">Workflow settings</button><button type="button" data-prep-view="alerts" disabled aria-pressed="false">Alerts</button>
  </div>
  <div data-prep-panel="daily">
    <p id="prep-update" role="status"></p><button id="prep-latest" hidden>Discard review changes and open latest result</button>
    <p id="prep-empty">No preparation selected. Open a workflow to see its latest result, or create one to begin.</p>
    <section id="prep-review" hidden><h2>Snapshot review</h2><div id="prep-audit"></div><div id="prep-members"></div><button id="prep-more" hidden>Show next 30</button>
      <div class="prep-next"><h2>Continue with this review</h2><label>Review reason <input id="prep-reason" maxlength="1000" placeholder="Reason for this accepted membership" /></label>
      <label>Research strategy <select id="prep-strategy"></select></label><button id="prep-handoff">Open research candidates with selected snapshot</button>
      <button id="prep-paper">Review authorized paper run with this snapshot</button><p>Fresh, complete members remain subject to strategy admission and execution authorization.</p></div>
      <details class="prep-card"><summary>Adjust reviewed membership</summary><label>Add symbols for a new collected revision <input id="prep-additions" placeholder="AAPL, MSFT" /></label><button id="prep-curate">Collect curated revision</button></details>
    </section>
    <details id="prep-schedule" class="prep-card" hidden><summary>Schedule and manual collection</summary><p id="prep-collection-status" role="status"></p><h2>Upcoming exchange sessions</h2><div id="prep-upcoming"></div><div class="prep-toolbar"><button id="prep-nightly" disabled>Run nightly now</button><button id="prep-morning" disabled>Run morning now</button></div></details>
  </div>
  <div data-prep-panel="history" hidden><h2>Preparation history</h2><div id="prep-history"></div></div>
  <div data-prep-panel="settings" hidden><form id="prep-editor"><h2>Workflow settings</h2><p id="prep-draft-note">Choose at least one discovery source. Save paused before enabling the schedule.</p>
    <label>Name <input id="prep-name" required maxlength="120" /></label><label>Membership <select id="prep-merge"><option value="union">Union: any selected source</option><option value="intersection">Intersection: every selected source</option></select></label>
    <h3>Discovery sources</h3><div id="prep-sources"></div><p id="prep-source-status" role="status"></p><div class="prep-toolbar"><select id="prep-wishlist" aria-label="Add wishlist"></select><button type="button" id="prep-add-wishlist">Add wishlist</button><input id="prep-query" maxlength="500" aria-label="Finviz query" placeholder="Saved Finviz query" /><button type="button" id="prep-add-query">Add Finviz query</button></div>
    <details class="prep-card"><summary>Schedule, evidence, filters and notifications</summary><p>US equity exchange calendar · America/New_York. Blank filters are disabled. Context thresholds annotate observations only.</p><div id="prep-fields" class="prep-fields"></div></details>
    <button id="prep-save" type="submit">Save paused workflow</button><button type="button" id="prep-toggle" disabled>Enable workflow</button><details><summary>Saved definition</summary><span id="prep-revision"></span></details>
  </form></div>
  <div data-prep-panel="alerts" hidden><h2>Preparation alerts</h2><button id="prep-alerts">Refresh alerts</button><div id="prep-notifications"></div></div>
</section>
