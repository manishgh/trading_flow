@if (User.Identity?.IsAuthenticated == true)
{
    <button id="groupActionResume" type="button" class="button secondary" hidden>Finish the unconfirmed wishlist change</button>
    <dialog id="groupActionDialog" class="group-action-dialog" aria-labelledby="groupActionTitle" data-operator-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
        <form method="dialog" class="stack">
            <h2 id="groupActionTitle">Change wishlists</h2>
            <p id="groupActionSummary"></p>
            <label id="groupActionSourceLabel" for="groupActionSource">From wishlist</label>
            <select id="groupActionSource"></select>
            <label id="groupActionTargetLabel" for="groupActionTarget">To wishlist</label>
            <select id="groupActionTarget"></select>
            <details id="groupActionCreatePanel" hidden>
                <summary>New wishlist</summary>
                <label for="groupActionCreateName">Name</label>
                <input id="groupActionCreateName" maxlength="120" autocomplete="off" />
                <div class="actions">
                    <button id="groupActionCreate" type="button" class="button secondary">Create wishlist</button>
                    <button id="groupActionCreateUndo" type="button" class="button secondary" hidden>Remove the new wishlist</button>
                </div>
            </details>
            <p id="groupActionStatus" role="status"></p>
            <div class="actions">
                <button id="groupActionApply" type="button">Apply</button>
                <button id="groupActionUndo" type="button" class="button secondary" hidden>Undo</button>
                <button id="groupActionClose" type="submit" class="button secondary">Close</button>
            </div>
        </form>
    </dialog>
    <script type="module" src="~/js/group-actions.js" asp-append-version="true"></script>
}
