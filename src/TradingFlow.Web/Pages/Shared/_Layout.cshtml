@inject TradingFlow.Web.Services.TradingEnvironmentService Environments
@using TradingFlow.Web.Pages.Shared
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? String.Empty;
    bool IsCurrent(params string[] pages) => pages.Any(page =>
        String.Equals(page, currentPage, StringComparison.OrdinalIgnoreCase));

    // The environment must be identifiable from the chrome alone, without reading
    // text. A live surface carries a full-width accent bar, not just a badge.
    var envSlug = Context.Request.Query["env"].ToString();
    var environment = Environments.GetState(Environments.Parse(envSlug));
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en" data-environment="@environment.Slug">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TradingFlow</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modernist.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/desk-grid.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="environment-rail" aria-hidden="true"></div>
    <header class="topbar">
        <a class="brand" asp-page="@(signedIn ? "/TradeDesk" : "/Earnings")"
           aria-label="TradingFlow">TRADINGFLOW</a>

        <nav class="primary-nav" aria-label="Primary navigation">
            @if (signedIn)
            {
                <a asp-page="/TradeDesk"
                   class="@(IsCurrent("/TradeDesk", "/Index") ? "active" : null)"
                   aria-current="@(IsCurrent("/TradeDesk", "/Index") ? "page" : null)">Desk</a>
                <a asp-page="/RunningTrades"
                   class="@(IsCurrent("/RunningTrades") ? "active" : null)"
                   aria-current="@(IsCurrent("/RunningTrades") ? "page" : null)">Positions</a>
                <a asp-page="/Orders"
                   class="@(IsCurrent("/Orders", "/OrderTicket") ? "active" : null)"
                   aria-current="@(IsCurrent("/Orders", "/OrderTicket") ? "page" : null)">Orders</a>
                <a asp-page="/News"
                   class="@(IsCurrent("/News") ? "active" : null)"
                   aria-current="@(IsCurrent("/News") ? "page" : null)">News</a>
            }
            <a asp-page="/Earnings"
               class="@(IsCurrent("/Earnings") ? "active" : null)"
               aria-current="@(IsCurrent("/Earnings") ? "page" : null)">Earnings</a>
            @if (signedIn)
            {
                <a asp-page="/Backtests"
                   class="@(IsCurrent("/Backtests", "/Job", "/OptimizationJob", "/Audit") ? "active" : null)"
                   aria-current="@(IsCurrent("/Backtests", "/Job", "/OptimizationJob", "/Audit") ? "page" : null)">Research</a>
                <a asp-page="/Operations"
                   class="@(IsCurrent("/Operations", "/Paper", "/PaperJob", "/Warmup", "/Wishlists") ? "active" : null)"
                   aria-current="@(IsCurrent("/Operations", "/Paper", "/PaperJob", "/Warmup", "/Wishlists") ? "page" : null)">Operations</a>
                @if (User.IsInRole(TradingFlow.Data.Identity.TradingFlowRoles.Administrator))
                {
                    <a asp-page="/Users"
                       class="@(IsCurrent("/Users") ? "active" : null)"
                       aria-current="@(IsCurrent("/Users") ? "page" : null)">Users</a>
                }
            }
        </nav>

        <div class="topbar-tail">
            @if (signedIn)
            {
                @* A locked environment renders as a locked option rather than
                   disappearing: the operator has to see that live exists, and why
                   it is unavailable, without being able to select it. *@
                <div class="seg environment-switch" role="group" aria-label="Trading environment">
                    @foreach (var candidate in Environments.All)
                    {
                        var isCurrent = candidate.Environment == environment.Environment;
                        if (candidate.IsEnabled)
                        {
                            <a class="seg-opt env-@candidate.Slug"
                               href="@($"{Context.Request.Path}?env={candidate.Slug}")"
                               aria-current="@(isCurrent ? "true" : null)"
                               title="@candidate.Label environment">@candidate.Label.ToUpperInvariant()</a>
                        }
                        else
                        {
                            <span class="seg-opt env-@candidate.Slug" data-locked
                                  title="@candidate.LockReason">@(candidate.Label.ToUpperInvariant() + " \U0001F512")</span>
                        }
                    }
                </div>
            }

            @* Clocks tick client-side every second. The market zone is the exchange
               zone, not the browser's, so a European operator reads the session in
               the time the session is defined in. *@
            <div class="topbar-clocks" aria-label="Market and local clocks">
                <span data-clock="@TradingFlow.Earnings.EarningsTimeZones.NewYorkClientId" data-clock-label="NY">
                    <strong>NY</strong><time>--:--:--</time>
                </span>
                @if (ViewData["ShowOperatorClock"] is true)
                {
                    <span data-clock="local" data-clock-label="Local"><strong>Local</strong><time>--:--:--</time></span>
                }
                <span data-clock="UTC" data-clock-label="UTC"><strong>UTC</strong><time>--:--:--</time></span>
            </div>

            @if (signedIn)
            {
                <button type="button" class="btn btn-secondary btn-md" id="AlertToggle"
                        aria-pressed="true" title="Mute or unmute signal alerts on this device">
                    <partial name="_Icon" model='new IconModel("bell", 14)' />
                    <span data-alert-label>Alerts on</span>
                </button>
            }

            <div class="theme-control">
                <label for="ThemeSelect">Theme</label>
                <select id="ThemeSelect" class="input">
                    <option value="system">System</option>
                    <option value="light">Modernist</option>
                    <option value="dark">Dark</option>
                    <option value="cvd">Colour-blind</option>
                </select>
            </div>

            <div class="identity-control">
                @if (signedIn)
                {
                    <span title="Signed-in user">@User.Identity!.Name</span>
                    <form method="post" asp-page="/Login" asp-page-handler="Logout">
                        <button type="submit" class="btn btn-secondary btn-md">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-secondary btn-md" asp-page="/Login">Sign in</a>
                }
            </div>
        </div>
    </header>
    <main id="main-content" class="shell @ViewData["MainClass"]" tabindex="-1">
        @RenderBody()
    </main>

    @* One toast for the whole app. Screens announce through it rather than each
       building their own, so an operator learns one place to look. *@
    <div id="SignalToast" class="toast" role="status" aria-live="polite" hidden></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/command-palette.js" asp-append-version="true" defer></script>
    <script src="~/js/desk-presets.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
