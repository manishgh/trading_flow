<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TradingFlow</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-page="/Index">Quant Workstation</a>
        <nav>
            <a asp-page="/Backtests">Backtest</a>
            <a asp-page="/Paper">Paper</a>
            <a asp-page="/Warmup">Warmup</a>
            <a href="#">Live</a>
        </nav>
    </header>
    <main class="shell">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
