@inject TradingFlow.Web.Services.TradingEnvironmentService Environments
@using TradingFlow.Web.Pages.Shared
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? String.Empty;
    // Route ownership keeps one persistent destination active on detail screens.
    bool IsCurrent(params string[] pages) => pages.Any(page =>
        String.Equals(page, currentPage, StringComparison.OrdinalIgnoreCase));

    // The environment must be identifiable from the chrome alone, without reading
    // text. A live surface carries a full-width accent bar, not just a badge.
    var envSlug = Context.Request.Query["env"].ToString();
    var environment = Environments.GetState(Environments.Parse(envSlug));
    var signedIn = User.Identity?.IsAuthenticated == true;
    var destination = IsCurrent("/News") ? "News" : IsCurrent("/Earnings") ? "Earnings"
        : IsCurrent("/RunningTrades", "/Orders", "/OrderTicket") ? "Trading"
        : IsCurrent("/Paper", "/PaperJob", "/Backtests", "/Job", "/OptimizationJob", "/Audit", "/CandidateAudit") ? "Strategies"
        : IsCurrent("/Wishlists") ? "Stock groups"
        : IsCurrent("/Operations", "/Warmup", "/Users") ? "System" : "Desk";
    var destinations = new[] { ("Desk", "/Desk", "columns-3"), ("Trading", "/Orders", "trending-up"),
        ("Strategies", "/Paper", "layers"), ("Earnings", "/Earnings", "calendar"),
        ("News", "/News", "newspaper"), ("Stock groups", "/Wishlists", "briefcase") };
    var systemPages = User.IsInRole(TradingFlow.Data.Identity.TradingFlowRoles.Administrator)
        ? new[] { ("Health", "/Operations"), ("Warm-up", "/Warmup"), ("Users", "/Users") }
        : new[] { ("Health", "/Operations"), ("Warm-up", "/Warmup") };
    // Preserve the current screen and filters when changing the account environment.
    string EnvironmentUrl(string slug) {
        var query = Context.Request.Query.ToDictionary(x => x.Key, x => (string?)x.Value.ToString(), StringComparer.OrdinalIgnoreCase);
        query["env"] = slug;
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path, query);
    }
}
<!DOCTYPE html>
<html lang="en" data-environment="@environment.Slug">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TradingFlow</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modernist.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/desk-grid.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/desk-universe.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orders-screen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/order-workflow.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/desk-theme.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body class="workspace-app @(signedIn ? "workspace-authenticated" : "workspace-public")">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="environment-rail" aria-hidden="true"></div>
    @if (signedIn)
    {
        <aside class="workspace-sidebar" aria-label="Workspace">
            <a class="brand" asp-page="/Desk" aria-label="TradingFlow"><span class="brand-mark" aria-hidden="true">t<span>f</span></span><span>TradingFlow<span class="brand-dot">.</span></span></a>
            <div class="workspace-label"><span class="workspace-avatar" aria-hidden="true">TF</span><span>Market workspace<small>Research &amp; execution</small></span></div>
            <span class="workspace-nav-label">WORKSPACE</span>
            <nav class="primary-nav" aria-label="Primary navigation">
                @foreach (var item in destinations)
                {
                    <a asp-page="@item.Item2" class="@(destination == item.Item1 ? "active" : null)" aria-current="@(destination == item.Item1 ? "page" : null)"><partial name="_Icon" model="new IconModel(item.Item3, 18)" /><span>@item.Item1</span></a>
                }
            </nav>
            <p class="workspace-sidebar-note">A clear view of the market.<br />Every decision in context.</p>
        </aside>
    }
    <header class="topbar">
        @if (signedIn)
        {
            <div class="workspace-location"><span>Workspace</span><span aria-hidden="true">/</span><strong>@destination</strong></div>
        }
        else
        {
            <a class="brand" asp-page="/News" aria-label="TradingFlow">TradingFlow<span class="brand-dot">.</span></a>
            <nav class="primary-nav" aria-label="Primary navigation">
                <a asp-page="/News" aria-current="@(IsCurrent("/News") ? "page" : null)">News</a>
                <a asp-page="/Earnings" aria-current="@(IsCurrent("/Earnings") ? "page" : null)">Earnings</a>
            </nav>
        }
        <div class="topbar-tail">
            @if (signedIn)
            {
                @* Exactly one environment is shown: the one this screen operates against. Switching
                   lives in the system menu so the badge can never read as two at once. *@
                <div class="account-strip" data-account-strip>
                    <span class="env-badge env-@environment.Slug" title="@environment.Label environment">@environment.Label</span>
                    @* The figures come from the paper account, so they only appear beside the PAPER badge. *@
                    @if (environment.Environment == TradingFlow.Web.Services.TradingEnvironment.Paper)
                    {
                        <span class="account-figures">
                            <span>Invested <strong data-account-invested>—</strong></span>
                            <span>Cash <strong data-account-cash>—</strong></span>
                        </span>
                    }
                </div>
            }

            @* Clocks tick client-side every second. The market zone is the exchange
               zone, not the browser's, so a European operator reads the session in
               the time the session is defined in. *@
            <div class="topbar-clocks" aria-label="Market and local clocks">
                <span data-clock="@TradingFlow.Earnings.EarningsTimeZones.NewYorkClientId" data-clock-label="NY">
                    <strong>NY</strong><time>--:--:--</time>
                </span>
                <span data-clock="local" data-clock-label="Local"><strong>Local</strong><time>--:--:--</time></span>
                <span data-clock="UTC" data-clock-label="UTC"><strong>UTC</strong><time>--:--:--</time></span>
            </div>

            @if (signedIn)
            {
                <button type="button" class="btn btn-secondary btn-md" id="AlertToggle"
                        aria-pressed="true" title="Mute or unmute signal alerts on this device">
                    <partial name="_Icon" model='new IconModel("bell", 14)' />
                    <span data-alert-label>Alerts on</span>
                </button>
            }

            <details class="system-menu">
                <summary class="btn btn-secondary btn-md" aria-label="System menu" title="Workspace settings">
                    <partial name="_Icon" model='new IconModel("settings", 16)' /><span>Settings</span>
                </summary>
                <div class="system-menu-panel">
                    @if (signedIn)
                    {
                        <span class="system-menu-label">System</span>
                        @foreach (var item in systemPages)
                        {
                            <a asp-page="@item.Item2" aria-current="@(IsCurrent(item.Item2) ? "page" : null)">@item.Item1</a>
                        }
                        <span class="system-menu-label">Environment</span>
                        @foreach (var candidate in Environments.All)
                        {
                            if (candidate.Environment == environment.Environment)
                            {
                                <span class="system-menu-locked" aria-current="true">@candidate.Label · current</span>
                            }
                            else if (candidate.IsEnabled)
                            {
                                <a href="@EnvironmentUrl(candidate.Slug)">Switch to @candidate.Label</a>
                            }
                            else
                            {
                                <span class="system-menu-locked" title="@candidate.LockReason">@candidate.Label locked</span>
                            }
                        }
                    }
                    <div class="theme-control">
                        <label for="ThemeSelect">Appearance</label>
                        <select id="ThemeSelect" class="input">
                            <option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option><option value="cvd">Colour-blind</option>
                        </select>
                    </div>
                    @if (signedIn)
                    {
                        <div class="workspace-user"><span title="Signed-in user">@User.Identity!.Name</span><form method="post" asp-page="/Login" asp-page-handler="Logout"><button type="submit" class="btn btn-secondary btn-md">Sign out</button></form></div>
                    }
                </div>
            </details>
            <div class="identity-control">
                @if (!signedIn)
                {
                    <a class="btn btn-secondary btn-md" asp-page="/Login">Sign in</a>
                }
            </div>
        </div>
    </header>
    <main id="main-content" class="shell @ViewData["MainClass"]" tabindex="-1">
        @if (signedIn && IsCurrent("/Paper", "/PaperJob", "/Backtests", "/Job", "/OptimizationJob", "/Audit"))
        {
            @* Strategy runs and their backtests share one destination and two local views. *@
            <nav class="strategy-local-nav" aria-label="Strategy views">
                <a asp-page="/Paper" aria-current="@(IsCurrent("/Paper", "/PaperJob") ? "page" : null)">Strategy runs</a>
                <a asp-page="/Backtests" aria-current="@(IsCurrent("/Backtests", "/Job", "/OptimizationJob", "/Audit") ? "page" : null)">Backtests</a>
            </nav>
        }
        @RenderBody()
    </main>

    @* One toast for the whole app. Screens announce through it rather than each
       building their own, so an operator learns one place to look. *@
    <div id="SignalToast" class="toast" role="status" aria-live="polite" hidden></div>

    <script src="~/js/api-client.js" asp-append-version="true"></script>
    <script src="~/js/news-evidence.js" asp-append-version="true"></script>
    <script src="~/js/workspace.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/command-palette.js" asp-append-version="true" defer></script>
    <script src="~/js/desk-presets.js" asp-append-version="true" defer></script>
    @if (signedIn)
    {
        <script src="~/js/account-strip.js" asp-append-version="true" defer></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
