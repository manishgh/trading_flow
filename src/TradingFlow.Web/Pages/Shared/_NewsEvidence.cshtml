@model TradingFlow.Web.Models.NewsPresentation
@{
    var inferredLabels = Model.CategoryLabels
        .Concat(Model.SectorLabels.Select(label => "Sector: " + label))
        .ToArray();
    var tooltipParts = new List<string>
    {
        $"Provider symbols: {Model.SymbolsLabel}",
        $"{Model.Provider} {Model.Source} · {Model.Classification}".Trim()
    };
    if (inferredLabels.Length > 0)
    {
        tooltipParts.Add("Inferred display labels: " + String.Join(", ", inferredLabels));
    }
    if (!String.IsNullOrWhiteSpace(Model.CategoryRationale))
    {
        tooltipParts.Add(Model.CategoryRationale);
    }
    var rowTooltip = String.Join(" · ", tooltipParts.Where(part => !String.IsNullOrWhiteSpace(part)));
}
<article class="news-entry news-item news-compact-row @Model.SentimentClass" data-news-item data-news-ticker="@Model.Tickers"
         data-news-key="@Model.Key" data-news-timestamp="@Model.Timestamp.ToString("O")" data-news-url="@Model.SafeUrl"
         title="@rowTooltip">
    <div class="news-row-main">
        <span class="news-sentiment-chip" data-news-sentiment>@Model.SentimentLabel @(Model.SentimentScore?.ToString("+0.00;-0.00;0.00", System.Globalization.CultureInfo.InvariantCulture))</span>
        <span class="sr-only">Provider symbols:</span>
        <strong class="news-row-tickers" data-news-tickers title="Provider symbols: @Model.SymbolsLabel">@Model.SymbolsLabel</strong>
        <strong class="news-headline" data-news-headline>@Model.Headline</strong>
        <time class="news-row-time" data-news-time datetime="@Model.Timestamp.ToString("O")">@Model.Timestamp.UtcDateTime.ToString("dd MMM HH:mm") UTC</time>
        <a class="news-row-link @(Model.LinkIsArticle ? "" : "is-related")" data-news-link href="@Model.SafeUrl" hidden="@(Model.SafeUrl is null)" target="_blank" rel="noopener noreferrer" title="@Model.LinkLabel" aria-label="@Model.LinkLabel">@(Model.LinkIsArticle ? "↗" : "↗?")</a>
    </div>
    <details class="news-row-more">
        <summary title="@rowTooltip">Details</summary>
        <div class="news-row-more-body">
            <p data-news-summary hidden="@(String.IsNullOrWhiteSpace(Model.Summary))">@Model.Summary</p>
            <p class="news-why" data-news-why hidden="@(String.IsNullOrWhiteSpace(Model.WhyItMatters))">@Model.WhyItMatters</p>
            <div class="news-topic-labels" data-news-topics hidden="@(!Model.HasTopics)" title="@Model.CategoryRationale" data-news-category-version="@Model.CategoryVersion">
                <small class="sr-only">Inferred display labels</small>
                <span data-news-categories>
                    @foreach (var label in Model.CategoryLabels) { <span class="news-topic-badge">@label</span> }
                </span>
                <span data-news-sectors>
                    @foreach (var label in Model.SectorLabels) { <span class="news-topic-badge">Sector: @label</span> }
                </span>
            </div>
            <div class="news-entry-footer">
                <span class="muted" data-news-source>@Model.Provider @Model.Source · @Model.Classification</span>
                <span class="muted" data-news-link-note hidden="@(Model.SafeUrl is null)">@Model.LinkLabel</span>
                @if (User.Identity?.IsAuthenticated == true) { <button type="button" class="button secondary btn-sm" data-group-action="add" data-tickers="@Model.GroupableTickers" hidden="@(Model.GroupableTickers.Length == 0)">Add symbols to group</button> }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @foreach (var symbol in Model.GroupableTickers.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                    {
                        <a asp-page="/Chart" asp-route-symbol="@symbol" stock-chart-symbol="@symbol" asp-route-env="@(Context.Request.Query["env"].ToString())" aria-label="Open chart for @symbol">@symbol chart</a>
                    }
                }
            </div>
        </div>
    </details>
</article>
