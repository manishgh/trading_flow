@*
    The results phase.

    Five blocks in one scrolling column. The gates block is the reason the rest
    exists: a good return is a reading, not a licence, and the decision above it
    stays in research until every gate has actually passed.
*@
@using TradingFlow.Domain.Backtesting
@model TradingFlow.Web.Pages.Shared.LabResultsModel
@{
    var lab = Model.Page;
    var result = Model.Result;
    var drilled = Model.Drilled;
    var monthTrades = lab.TradesForSelectedMonth(drilled);
}

@functions {
    static string Signed(decimal value, string suffix = "%", string format = "0.00") =>
        (value > 0 ? "+" : value < 0 ? "−" : String.Empty) + Math.Abs(value).ToString(format) + suffix;

    static string SignedMoney(decimal value) =>
        (value > 0 ? "+" : value < 0 ? "−" : String.Empty) + Math.Abs(value).ToString("C2");

    static string SignedClass(decimal value) =>
        value > 0 ? "value-signed up" : value < 0 ? "value-signed down" : "value-signed flat";

    static string Hold(TimeSpan? span) => span is null
        ? "—"
        : span.Value.TotalHours >= 24 ? $"{span.Value.TotalDays:0.0} d"
        : span.Value.TotalHours >= 1 ? $"{span.Value.TotalHours:0.0} h"
        : $"{span.Value.TotalMinutes:0} m";

    static string GateGlyph(GateOutcome outcome) => outcome switch
    {
        GateOutcome.Passed => "✓",
        GateOutcome.Failed => "✕",
        _ => "–"
    };

    static string GateClass(GateOutcome outcome) => outcome switch
    {
        GateOutcome.Passed => "is-pass",
        GateOutcome.Failed => "is-fail",
        _ => "is-unknown"
    };

}

<partial name="_PreparedMarketData" model="Model.Job" />

<section class="lab-panel">
    <h2 class="section-heading">Monthly strategy returns</h2>
    @if (Model.Job.Cohort is { } cohort)
    {
        <p class="note">Saved plan @cohort.PlanId · @cohort.CohortName · Starting capital USD @cohort.StartingCapital.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</p>
    }
    else
    {
        <p class="note">Starting capital USD @result.StartingCapital.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</p>
    }
    <p class="note">Each strategy and stock group has separate capital. Monthly percentages use that month's opening equity. The valuation method is shown for each result; realised closed-trade equity omits changes in open positions. Missing execution or valuation evidence is shown explicitly.</p>
    @if (lab.MonthlyRows.Count == 0)
    {
        <p class="empty-state">@lab.MonthlyUnavailable</p>
    }
    else
    {
        <form method="get">
            <input type="hidden" name="jobId" value="@Model.Job.JobId" />
            <input type="hidden" name="wishlistId" value="@lab.WishlistId" />
            <input type="hidden" name="drill" value="@lab.Drill" />
            <label for="resultMonth">Source-session month</label>
            <select class="input" id="resultMonth" name="month">
            @foreach(var month in lab.MonthlyRows.Select(row=>row.Month).Distinct().OrderDescending())
            {<option value="@month" selected="@(month==lab.SelectedMonth)">@month</option>}
            </select>
            <button class="btn btn-secondary" type="submit">Show month</button>
        </form>
        <div class="table-scroll"><table class="grid-table">
            <thead><tr><th>Strategy / version / group</th><th>Month / valuation</th><th class="num">Opening / closing equity</th><th class="num">Monthly return</th><th class="num">Monthly drawdown</th><th class="num">Monthly realized net / unrealized at month end</th><th class="num">Monthly fees / exposure at month end</th><th class="num">Closed / open / fills</th></tr></thead>
            <tbody>
            @foreach(var row in lab.MonthlyRows.Where(row=>row.Month==lab.SelectedMonth).OrderBy(row=>row.StrategyName ?? row.Strategy.StrategyId))
            {
                <tr aria-selected="@((row.StrategyAlias ?? row.Strategy.StrategyId)==drilled.StrategyId?"true":null)">
                    <td><a asp-page="/Backtests" asp-route-jobId="@Model.Job.JobId" asp-route-wishlistId="@lab.WishlistId" asp-route-drill="@(row.StrategyAlias ?? row.Strategy.StrategyId)" asp-route-month="@lab.SelectedMonth">@(row.StrategyName ?? row.Strategy.StrategyId) · @row.Strategy.SemanticVersion</a><span class="note">@row.CohortName · @row.Strategy.ContentSha256</span></td>
                    <td>@row.Month @(row.PartialMonth?"(partial month)":"")<span class="note" title="@row.ValuationBasis">@(row.ValuationBasis.StartsWith("marked_to_market_", StringComparison.Ordinal) ? "Daily close equity, including open positions" : row.ValuationBasis == "realized_closed_trade_equity" ? "Realized closed-trade equity" : "Valuation unavailable")</span></td>
                    <td class="num">@(row.OpeningEquity?.ToString("N2") ?? "unavailable") / @(row.ClosingEquity?.ToString("N2") ?? "unavailable")</td>
                    <td class="num">@(row.ReturnPct is { } value?Signed(value):"unavailable")<span class="note">@row.UnavailableReason</span></td>
                    <td class="num">@(row.MaxDrawdownPct is { } drawdown ? drawdown.ToString("0.00") + "%" : "unavailable")</td>
                    <td class="num">@(row.RealizedNetProfit?.ToString("N2") ?? "unavailable") / @(row.UnrealizedProfit?.ToString("N2") ?? "unavailable")</td>
                    <td class="num">@(row.Fees?.ToString("N2") ?? "unavailable") / @(row.GrossExposurePct?.ToString("0.00") ?? "unavailable")%</td>
                    <td class="num">@(row.ClosedTrades?.ToString() ?? "unavailable") / @(row.OpenPositions?.ToString() ?? "unavailable") / @(row.FillCount?.ToString() ?? "unavailable")</td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</section>

@if (Model.PortfolioState is { } portfolio)
{
    <partial name="_BacktestPortfolioState" model="portfolio" />
}
@if (Model.Page.ZoneEvaluations is { } trace)
{
    <section class="lab-panel">
        <h2 class="section-heading">Every evaluated zone candle</h2>
        <p class="note">@trace.TotalCount retained rows. Showing offset @trace.Offset, up to @trace.Limit rows. Rejected bars include the engine's original predicates and clocks. Planned costs and targets are estimates.</p>
        @if (trace.UnavailableReason is { } unavailable) { <p class="note">@unavailable</p> }
        @foreach (var row in trace.Rows)
        {
            <details><summary>@row.Ticker / @(row.ResolutionReason ?? "pattern admitted") / @(row.CandidateId ?? "no candidate")</summary>
            @foreach (var line in TradingFlow.Contracts.Presentation.ZoneEvaluationPresentation.Lines(row)) { <p class="note">@line</p> }
            </details>
        }
        @if (trace.Offset > 0) { <a asp-page="/Backtests" asp-route-jobId="@Model.Job.JobId" asp-route-drill="@Model.Drilled.StrategyId" asp-route-zoneOffset="@Math.Max(0, trace.Offset - trace.Limit)">Previous candles</a> }
        @if (trace.NextOffset is { } next) { <a asp-page="/Backtests" asp-route-jobId="@Model.Job.JobId" asp-route-drill="@Model.Drilled.StrategyId" asp-route-zoneOffset="@next">Next candles</a> }
    </section>
}
@if (Model.ZoneDecisions.Count > 0)
{
    <section class="lab-panel">
        <h2 class="section-heading">Zone entry and execution evidence</h2>
        <p class="note">Latest @Model.ZoneDecisions.Count hypotheses. Complete decision and execution journals retain all events; each row names its execution policy. Planned prices do not establish fills.</p>
        @foreach (var decision in Model.ZoneDecisions)
        {
            <details>
                <summary>@decision.Ticker / @decision.Pattern / @decision.Status</summary>
                @foreach (var line in TradingFlow.Contracts.Presentation.IntradayZoneDecisionPresentation.Lines(decision))
                {
                    <p class="note">@line</p>
                }
            </details>
        }
    </section>
}
@if (Model.HistoryEligibility.Count > 0)
{
    <section class="lab-panel">
        <h2 class="section-heading">Price history available for each stock — @drilled.StrategyName</h2>
        @foreach (var history in Model.HistoryEligibility)
        {
            var historyLabel = history.Status switch
            {
                "history_eligible" => "Enough history for this strategy",
                "still_warming_at_study_end" => "Not enough history by test end",
                _ => history.Status.Replace('_', ' ')
            };
            <p>@history.Ticker · @historyLabel · completed bars at start @history.AvailableAtStart; at cutoff @history.AvailableAtCutoff / @history.RequiredBars required · first eligible decision UTC @(history.FirstEligibleDecisionUtc?.ToString("u") ?? "not reached")</p>
        }
    </section>
}

@* --- 4. Promotion gates and analyzer ------------------------------------- *@
<section class="lab-gates-row">
    <div class="lab-gates">
        <h2 class="section-heading">Promotion gates</h2>
        <p class="note">
            A missing gate fails closed. The integrated decision stays RETAIN_RESEARCH until every one
            passes.
        </p>
        <ul class="check-list check-list-wide">
            @foreach (var gate in Model.Gates.Gates)
            {
                <li class="@GateClass(gate.Outcome)">
                    <span class="check-glyph">@GateGlyph(gate.Outcome)</span>
                    <span class="check-label">@gate.Label</span>
                    <span>@gate.Reason</span>
                </li>
            }
        </ul>
        <p class="note">
            @Model.Gates.PassedCount of @Model.Gates.Gates.Count passed ·
            @Model.Gates.NotEvaluatedCount not evaluated · decision @Model.Gates.Decision
        </p>
    </div>

    <div class="lab-analyzer">
        <h2 class="section-heading">Analyzer — @drilled.StrategyName · full-window counts</h2>
        @if (lab.DrilledDiagnostic is { } diagnostic)
        {
            <dl class="fact-list">
                <dt>Evaluated bars</dt>
                <dd>@diagnostic.EvaluatedBarCount.ToString("#,##0")</dd>
                <dt>Candidates</dt>
                <dd>@diagnostic.CandidateTradeCount.ToString("#,##0")</dd>
                <dt>Admitted orders</dt>
                <dd>@diagnostic.AcceptedTradeCount.ToString("#,##0")</dd>
            </dl>

            <h3 class="sub-heading">Top rejections</h3>
            @if (Model.TopRejections.Count == 0)
            {
                <p class="empty-state">No candidate was rejected.</p>
            }
            else
            {
                <ul class="lab-rejections">
                    @foreach (var rejection in Model.TopRejections)
                    {
                        <li>
                            <span class="lab-rejection-head">
                                <span>@rejection.Key.Replace('_', ' ')</span>
                                <span>@rejection.Value</span>
                            </span>
                            <span class="lab-bar">
                                <progress class="lab-bar-fill tf-progress is-neutral" max="@Model.LargestRejection"
                                          value="@rejection.Value" aria-label="@rejection.Key rejection count"></progress>
                            </span>
                        </li>
                    }
                </ul>
            }

            @if (diagnostic.Suggestions.Count > 0)
            {
                <p class="callout">@String.Join(" ", diagnostic.Suggestions)</p>
            }
        }
        else
        {
            <p class="empty-state">No diagnostic was recorded for this strategy.</p>
        }
    </div>
</section>

@* --- 5. Trades ----------------------------------------------------------- *@
<section class="lab-panel">
    <h2 class="section-heading">Trades — @drilled.StrategyName</h2>
    @if (monthTrades.Count == 0)
    {
        <p class="empty-state">No completed-position details are available in this view for the selected month. Monthly totals are shown above.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="grid-table">
                <thead>
                    <tr>
                        <th scope="col">Ticker</th>
                        <th scope="col">Side</th>
                        <th scope="col">Entry</th>
                        <th scope="col">Exit</th>
                        <th scope="col">Exit reason</th>
                        <th scope="col" class="num">Hold</th>
                        <th scope="col" class="num">R</th>
                        <th scope="col" class="num">Net</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trade in monthTrades.OrderByDescending(item => item.ExitTimestamp).Take(10))
                    {
                        var rMultiple = BacktestDerivedMetrics.RMultiple(trade);
                        <tr>
                            <td><strong>@trade.Ticker</strong></td>
                            <td>@trade.Direction</td>
                            <td>
                                @trade.EntryPrice.ToString("C2")
                                <span class="cell-sub">@trade.EntryTimestamp.UtcDateTime.ToString("dd MMM HH:mm")</span>
                            </td>
                            <td>
                                @trade.ExitPrice.ToString("C2")
                                <span class="cell-sub">@trade.ExitTimestamp.UtcDateTime.ToString("dd MMM HH:mm")</span>
                            </td>
                            <td>@trade.ExitReason</td>
                            <td class="num">@Hold(trade.ExitTimestamp - trade.EntryTimestamp)</td>
                            @* No stop distance means no R. Zero would read as a
                               break-even, which is a different claim. *@
                            <td class="num @(rMultiple is null ? "unknown" : SignedClass(rMultiple.Value))">
                                @(rMultiple is { } value ? Signed(value, "R") : "no stop")
                            </td>
                            <td class="num @SignedClass(trade.NetProfit)">@SignedMoney(trade.NetProfit)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="note">
            Showing up to 10 of @monthTrades.Count retained completed-position summaries in @lab.SelectedMonth.
            A completed position may include multiple entry or exit fills.
        </p>
    }
</section>
