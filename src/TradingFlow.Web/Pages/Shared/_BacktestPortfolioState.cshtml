@model TradingFlow.Contracts.V1.RunPortfolioStateResponse
<section class="lab-panel">
    <h2 class="section-heading">Portfolio at test end</h2>
    <p class="note" title="@Model.ValuationBasis">Cutoff UTC @Model.CutoffUtc.ToString("u") · Source-session equity, including open positions. Open at test end means the position has no completed exit. Waiting for execution means a known order or exit still needs a later executable slice.</p>
    <p>@Model.AdmittedOrderCount admitted orders · @Model.FilledCandidateCount entries filled · @Model.FillCount fills · @Model.ClosedTradeCount closed trades · @Model.OpenPositions.Count open positions</p>
    <dl class="fact-list">
        <dt>Cash / position value</dt><dd>@(Model.Cash?.ToString("N2") ?? "unavailable") / @(Model.PositionValue?.ToString("N2") ?? "unavailable")</dd>
        <dt>Equity / gross exposure</dt><dd>@(Model.Equity?.ToString("N2") ?? "unavailable") / @(Model.GrossExposurePct?.ToString("0.00") ?? "unavailable")%</dd>
        <dt>Realized net / unrealized profit</dt><dd>@(Model.RealizedNetProfit?.ToString("N2") ?? "unavailable") / @(Model.UnrealizedProfit?.ToString("N2") ?? "unavailable")</dd>
        <dt>Actual fees</dt><dd>@(Model.Fees?.ToString("N2") ?? "unavailable")</dd>
    </dl>
    @if (Model.UnavailableReason is { } reason) { <p class="callout">@reason</p> }
    @if (Model.OpenPositions.Count > 0)
    {
        <h3 class="sub-heading">Open at test end</h3>
        <div class="table-scroll"><table class="grid-table">
            <thead><tr><th>Ticker</th><th class="num">Signed quantity</th><th class="num">Entry basis</th><th class="num">Mark</th><th>Mark timestamp UTC</th><th class="num">Unrealized</th></tr></thead>
            <tbody>@foreach (var position in Model.OpenPositions)
            {
                <tr><td>@position.Ticker</td><td class="num">@position.SignedQuantity</td><td class="num">@position.EntryBasis.ToString("N2")</td><td class="num">@(position.MarkPrice?.ToString("N2") ?? "unavailable")</td><td>@(position.MarkTimestampUtc?.ToString("u") ?? "unavailable")</td><td class="num">@(position.UnrealizedProfit?.ToString("N2") ?? "unavailable")</td></tr>
            }</tbody>
        </table></div>
    }
    <h3 class="sub-heading">Waiting for execution</h3>
    @if (Model.PendingOrders.Count == 0 && Model.PendingExits.Count == 0) { <p class="note">No pending orders or exit intentions.</p> }
    @foreach (var order in Model.PendingOrders)
    {
        <p>@order.Ticker · @order.Side @order.OrderType · @order.RemainingQuantity remaining · @order.Status · reserved @order.ReservedNotional.ToString("N2") · known UTC @order.KnownAtUtc.ToString("u")</p>
    }
    @foreach (var exit in Model.PendingExits)
    {
        <p>@exit.Ticker · exit awaiting execution · @exit.Reason · known UTC @exit.KnownAtUtc.ToString("u")</p>
    }
    @if (Model.IntradayDecisionCount > 0)
    {
        <h3 class="sub-heading">Day entry and protection evidence</h3>
        <p class="note">Showing the latest @(Model.IntradayDecisions?.Count ?? 0) of @Model.IntradayDecisionCount observed hypotheses. Complete candidate and execution journals retain every event. Planned prices do not establish a fill.</p>
        @foreach (var decision in Model.IntradayDecisions ?? [])
        {
            <details>
                <summary>@decision.Ticker · @decision.EntryMethod · @decision.Status</summary>
                @foreach (var line in TradingFlow.Contracts.Presentation.IntradayDecisionPresentation.Lines(decision))
                {
                    <p class="note">@line</p>
                }
            </details>
        }
    }
    <p class="note">Realized net profit includes actual fees when charged. Intraday timestamps identify actual modeled execution times; native daily timestamps identify completed-bar availability. The source-session ledger supplies monthly attribution.</p>
</section>
