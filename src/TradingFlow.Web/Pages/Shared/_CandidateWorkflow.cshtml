<section class="panel candidate-workflow" data-candidate-workflow>
    <h2>Strategy candidates</h2>
    <p>Discovery records membership. Readiness, execution and audit evidence come from the shared decision engine.</p>
    <details data-candidate-controls><summary>Capture or open a candidate run</summary>
    <form data-candidate-create class="candidate-controls">
        <label>Mode <select name="mode"><option value="backtest">Research</option><option value="paper_shadow">Paper shadow</option><option value="paper_experiment">Paper experiment</option></select></label>
        <label>Wishlist <select name="wishlist" required></select></label>
        <label>Exact strategy <select name="strategy" required></select></label>
        <button type="submit">Capture candidates</button>
    </form>
    <form data-candidate-open class="candidate-controls">
        <label>Candidate run <input name="run" placeholder="Run identifier" required /></label><button>Open run</button>
    </form>
    </details>
    <p data-candidate-status role="status">Loading catalog…</p>
    <div data-candidate-rows class="candidate-rows"></div>
</section>
<style>
.candidate-workflow { margin:12px; min-width:0; }
.candidate-controls { display:flex; flex-wrap:wrap; gap:12px; align-items:end; margin:12px 0; }
.candidate-controls label { display:flex; flex-direction:column; flex:1 1 170px; min-width:0; }
.candidate-controls input,.candidate-controls select { width:100%; min-width:0; }
.candidate-rows { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr)); gap:8px; }
.candidate-row { border:1px solid var(--border,#ccc); padding:10px; min-width:0; overflow-wrap:anywhere; }
.candidate-row a { margin-right:12px; }
</style>
