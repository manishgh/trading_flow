@page "/"
@model TradingFlow.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Quant Workstation";
}

<div class="panel" style="max-width: 800px; margin: 2rem auto; text-align: center;">
    <h1 style="margin-bottom: 2rem;">Quant Workstation</h1>
    
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
        
        <a asp-page="/Backtests" style="text-decoration: none; color: inherit;">
            <div class="panel" style="padding: 2rem; border: 1px solid #ddd; border-radius: 8px; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';">
                <h2 style="margin-bottom: 1rem; color: #007bff;">Backtests</h2>
                <p class="muted">Design strategies, optimize parameters, and run historical backtests.</p>
            </div>
        </a>
        
        <a asp-page="/Paper" style="text-decoration: none; color: inherit;">
            <div class="panel" style="padding: 2rem; border: 1px solid #ddd; border-radius: 8px; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';">
                <h2 style="margin-bottom: 1rem; color: #28a745;">Paper</h2>
                <p class="muted">Forward-test strategies in a simulated environment using live market data.</p>
            </div>
        </a>
        
        <a href="#" style="text-decoration: none; color: inherit; opacity: 0.7; cursor: not-allowed;">
            <div class="panel" style="padding: 2rem; border: 1px solid #ddd; border-radius: 8px;">
                <h2 style="margin-bottom: 1rem; color: #dc3545;">Live</h2>
                <p class="muted">Execute trades automatically with a real broker. (Coming soon)</p>
            </div>
        </a>

    </div>
</div>
